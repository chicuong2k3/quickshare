        "src/QuickShare/Features/Workspaces/",
        "src/QuickShare/Features/Payments/",
        "src/QuickShare/Features/Uploads/"
      ],
      "tests": [
        "TenantIsolationTests"
      ]
    },
    {
      "note": "entity shape changes must keep the old shape behaving identically",
      "paths": [
        "src/QuickShare/Data/Entities/"
      ],
      "tests": [
        "MultiFileDeliveryTests",
        "AuditRegressionTests",
        "PageCoverageTests"
      ]
    },
    {

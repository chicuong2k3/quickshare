{
  "$comment": [
    "Mapping for scripts/test-impact.mjs — path prefixes -> test classes.",
    "Selection is a union with route/symbol matching, so a rule only ever widens.",
    "Every class named here MUST exist as a `public class ...Tests` in tests/;",
    "the script fails (exit 2) if one is renamed, because a filter naming a dead",
    "class matches zero tests and reports a green run that tested nothing.",
    "docs/TESTING.md drifted this way after the 'strip bloat feature surface'",
    "commit: it still lists LegalHoldTests, SamlSsoTests, StorageAndBackupTests",
    "and others that no file declares."
  ],
  "ignorePaths": [
    "docs/",
    "_bmad/",
    "_bmad-output/",
    ".github/",
    ".agents/",
    ".claude/",
    ".pi/",
    "vendor/",
    "ops/",
    "*.md",
    "*.sample",
    "QuickShare.slnx",
    "Directory.Build.props",
    ".editorconfig"
  ],
  "ignoreSymbols": [
    "Constants",
    "String",
    "Routes",
    "RoutePaths",
    "Options",
    "Request",
    "Response",
    "Endpoint",
    "Builder",
    "Handler"
  ],
  "rules": [
    {
      "note": "Upload pipeline: chunking, resume, R2 parts, quota",
      "paths": [
        "src/QuickShare/Features/Uploads/"
      ],
      "tests": [

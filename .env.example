# ── QuickShareCloud Environment Variables ──
# Copy to .env and fill in values. NEVER commit .env to git.

# PostgreSQL
DB_CONNECTION_STRING=Host=your-db.example.com;Port=5432;Database=quickshare;Username=quickshare;Password=your-password

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=



# Cloudflare R2 (optional — falls back to local disk)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=

# PayOS (Vietnam payment — optional)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=

# Email — SMTP relay (Brevo free tier: 300 mail/ngày). Bỏ trống = tắt email notify.
# User/Password lấy ở Brevo → SMTP & API → SMTP keys. From phải là domain đã verify.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=QuickShare

# Cloudflare Tunnel token (only if running cloudflared in Docker)
CF_TUNNEL_TOKEN=

# Admin email list for /admin/flags (comma-separated; first value wins if quoted)
ADMIN_EMAILS=

# ── Backup (ops/backup/*.sh — see docs/backup-restore-runbook.md) ──
# Consumed by the backup tooling ONLY, not by the QuickShare app.
# Backup bucket is a SEPARATE private R2 bucket with versioning on.
BACKUP_DB_CONNECTION_STRING=Host=your-db.example.com;Port=5432;Database=quickshare;Username=quickshare;Password=your-password
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_ACCESS_KEY_SECRET=
BACKUP_R2_BUCKET=quickshare-backups
# age recipient public key (age1...). Generate with `age-keygen`.
BACKUP_AGE_PUBLIC_KEY=
# Full age private key (age-keygen output) — for the restore drill. Keep offline.
BACKUP_AGE_PRIVATE_KEY=
BACKUP_RETENTION_DAYS=30
# Staging DB the quarterly restore drill restores into.
STAGING_DB_CONNECTION_STRING=

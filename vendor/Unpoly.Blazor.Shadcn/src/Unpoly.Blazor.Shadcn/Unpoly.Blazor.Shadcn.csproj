<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Unpoly.Blazor.Shadcn</RootNamespace>
    <AssemblyName>Unpoly.Blazor.Shadcn</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Unpoly.Blazor.Shadcn</PackageId>
    <Description>shadcn/ui for Blazor static SSR with Unpoly. Same tokens, same class strings, same data-slot contract, same ARIA.</Description>
    <PackageTags>blazor;shadcn;unpoly;ssr;tailwind;ui</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/chicuong2k3/Unpoly.Blazor.Shadcn</RepositoryUrl>
  </PropertyGroup>

  <!-- Components, Rendering, CompilerServices and Web are the only Blazor namespaces this library
       uses (verified from the compiled assembly references). They arrive by NuGet so the library
       also targets MAUI Blazor Hybrid (net10.0-android/ios/windows) — a FrameworkReference to
       Microsoft.AspNetCore.App only exists on plain `net10.0` and fails on mobile TFMs
       (NETSDK1082: no runtime pack for android). The consuming web head already supplies these. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TailwindMerge.NET" Version="1.4.0" />
  </ItemGroup>

</Project>

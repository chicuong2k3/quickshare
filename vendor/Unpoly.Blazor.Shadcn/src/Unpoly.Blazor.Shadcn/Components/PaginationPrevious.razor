@inherits UiComponentBase

<PaginationLink Href="@Href" Disabled="@Disabled" Size="default"
                 aria-label="@AriaLabel" Class="@Cn("gap-1 px-2.5 sm:ps-2.5", Class)"
                @attributes="AdditionalAttributes">
    <Icon Name="chevron-left" Class="rtl:rotate-180" />
    <span class="hidden sm:block">@Label</span>
</PaginationLink>

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "Previous";

    /// <summary>What a screen reader hears. Distinct from Label, which is hidden on small screens.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Go to previous page";
}

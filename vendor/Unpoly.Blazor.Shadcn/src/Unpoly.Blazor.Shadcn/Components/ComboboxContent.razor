@inherits UiComponentBase

<div id="@Id" popover data-slot="combobox-content" data-align="start" data-side="bottom"
     data-side-offset="4" class="@Classes"
     @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = default!;

    const string Base =
        "group/combobox-content max-h-96 w-(--anchor-width) max-w-(--available-width) " +
        "min-w-[calc(var(--anchor-width)+--spacing(7))] origin-(--transform-origin) " +
        "overflow-hidden rounded-md bg-popover text-popover-foreground shadow-md ring-1 " +
        "ring-foreground/10 duration-100 data-[chips=true]:min-w-(--anchor-width) " +
        "data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 " +
        "data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 " +
        "*:data-[slot=input-group]:m-1 *:data-[slot=input-group]:mb-0 " +
        "*:data-[slot=input-group]:h-8 *:data-[slot=input-group]:border-input/30 " +
        "*:data-[slot=input-group]:bg-input/30 *:data-[slot=input-group]:shadow-none " +
        "data-open:animate-in data-open:fade-in-0 data-open:zoom-in-95 " +
        "data-closed:animate-out data-closed:fade-out-0 data-closed:zoom-out-95 border z-50 " +
        "*:data-[slot=input-group]:w-auto";

    string Classes => Cn("bg-popover text-popover-foreground z-50 overflow-hidden rounded-md border shadow-md",
                         Base, Class);
}

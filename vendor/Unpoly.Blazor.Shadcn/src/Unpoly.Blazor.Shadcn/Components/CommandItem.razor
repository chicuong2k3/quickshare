@inherits UiComponentBase

@* An <a> when it goes somewhere, which is nearly always — that is what lets the palette work
   with scripting off, lets middle-click open a tab, and lets Unpoly follow it.

   Keywords are matched in addition to the visible text, so "billing" can find "Invoices". *@

@if (Href is not null)
{
    <a href="@Href" data-slot="command-item" role="option" data-keywords="@Keywords"
       data-disabled="@(Disabled ? "" : null)" class="@Classes"
       @attributes="AdditionalAttributes">@ChildContent</a>
}
else
{
    <button type="button" data-slot="command-item" role="option" data-keywords="@Keywords"
            data-disabled="@(Disabled ? "" : null)" disabled="@Disabled" class="@Classes"
            @attributes="AdditionalAttributes">@ChildContent</button>
}

@code {
    [Parameter] public string? Href { get; set; }

    /// <summary>Extra words this item should match. Space separated.</summary>
    [Parameter] public string? Keywords { get; set; }

    [Parameter] public bool Disabled { get; set; }

    const string Base =
        "relative flex cursor-default items-center gap-2 rounded-sm px-2 py-1.5 text-control " +
        "outline-hidden select-none data-[disabled=true]:pointer-events-none " +
        "data-[disabled=true]:opacity-50 data-[selected=true]:bg-accent " +
        "data-[selected=true]:text-accent-foreground [&_svg]:pointer-events-none " +
        "[&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 " +
        "[&_svg:not([class*='text-'])]:text-muted-foreground";

    string Classes => Cn(Base, Class);
}

@inherits UiComponentBase

@* Radix draws the tick itself and keeps the checked state in React. Here the state is a real
   <input type="checkbox"> inside the row, so the menu item posts with the form it belongs to and
   the tick is the platform's. *@

<label data-slot="menubar-checkbox-item" role="menuitemcheckbox"
       aria-checked="@(Checked ? "true" : "false")" tabindex="-1"
       data-disabled="@(Disabled ? "" : null)" class="@Classes"
       @attributes="AdditionalAttributes">
    <span class="pointer-events-none absolute end-2 flex size-4 items-center justify-center">
        <input type="checkbox" name="@Name" value="@Value" checked="@Checked"
               disabled="@Disabled" class="peer sr-only" />
        <Icon Name="check" Class="size-4 opacity-0 peer-checked:opacity-100" />
    </span>
    @ChildContent
</label>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string Value { get; set; } = "true";
    [Parameter] public bool Checked { get; set; }
    [Parameter] public bool Disabled { get; set; }

    const string Base =
        "relative flex cursor-default items-center gap-2 rounded-xs py-1.5 text-control " +
        "outline-hidden select-none focus:bg-accent focus:text-accent-foreground " +
        "data-[disabled]:pointer-events-none data-[disabled]:opacity-50 " +
        "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 " +
        "pe-8 ps-2";

    string Classes => Cn(Base, Class);
}

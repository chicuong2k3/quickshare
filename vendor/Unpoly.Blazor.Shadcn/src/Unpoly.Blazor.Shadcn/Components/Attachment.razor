@inherits UiComponentBase

@* A file attached to a message: its thumbnail, its name and size, and what you can do with it.

   shadcn ships this with its AI set. Nothing about it is specific to a model — it is the right
   shape for an email client, an issue tracker or a chat, and the demo's file manager and chat
   blocks both use it. *@

<div data-slot="attachment" data-size="@Size" data-orientation="@Orientation" data-state="@State" class="@Classes"
     @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    /// <summary>default | sm</summary>
    [Parameter] public string Size { get; set; } = "default";

    /// <summary>horizontal | vertical</summary>
    [Parameter] public string Orientation { get; set; } = "horizontal";

    /// <summary>Upload state, when there is one — uploading | error | complete. The caller knows
    /// it; nothing here can.</summary>
    [Parameter] public string? State { get; set; }

    const string Base =
        "group/attachment relative flex w-fit max-w-full min-w-0 shrink-0 flex-wrap " +
        "rounded-xl border bg-card text-card-foreground transition-colors focus-within:ring-1 " +
        "focus-within:ring-ring/50 data-[state=error]:border-destructive/30 " +
        "data-[state=idle]:border-dashed has-[>a]:hover:bg-muted/50 " +
        "has-[>button]:hover:bg-muted/50";

    string SizeClass => Size switch
    {
        "sm" => "gap-2.5 text-xs has-data-[slot=attachment-content]:px-2 has-data-[slot=attachment-content]:py-1.5 has-data-[slot=attachment-media]:p-1.5",
        "xs" => "gap-1.5 rounded-lg text-xs has-data-[slot=attachment-content]:px-1.5 has-data-[slot=attachment-content]:py-1 has-data-[slot=attachment-media]:p-1",
        _ => "gap-2 text-control has-data-[slot=attachment-content]:px-2.5 has-data-[slot=attachment-content]:py-2 has-data-[slot=attachment-media]:p-2",
    };

    string OrientationClass => Orientation switch
    {
        "vertical" => "w-24 flex-col has-data-[slot=attachment-content]:w-30",
        _ => "min-w-40 items-center",
    };

    string Classes => Cn(Base, SizeClass, OrientationClass, Class);
}

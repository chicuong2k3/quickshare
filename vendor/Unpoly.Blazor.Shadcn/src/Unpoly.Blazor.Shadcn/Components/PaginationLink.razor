@inherits UiComponentBase

@* A page link is an <a href> on purpose: it is a real, bookmarkable URL, Unpoly follows it as a
   fragment swap, and with scripting off the browser follows it as a page load. Disabled uses
   aria-disabled plus pointer-events-none rather than removing the href, so the control keeps
   its place in the row instead of the row reflowing at the ends. *@

@* data-active carries a string, not a bool: Blazor renders a true bool as a valueless attribute
   and drops a false one, so `data-active` would read as empty and CSS could not match on it. *@
<a href="@Href" data-slot="pagination-link" data-active="@(IsActive ? "true" : null)"
   aria-current="@(IsActive ? "page" : null)"
   aria-disabled="@(Disabled ? "true" : null)"
   tabindex="@(Disabled ? "-1" : null)"
   class="@Classes" @attributes="AdditionalAttributes">@ChildContent</a>

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>default | sm | lg | icon</summary>
    [Parameter] public string Size { get; set; } = "icon";

    string Classes => ButtonVariants.Of(
        IsActive ? "outline" : "ghost",
        Size,
        Cn(Disabled ? "pointer-events-none opacity-50" : null, Class));
}

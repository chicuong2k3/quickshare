@inherits UiComponentBase

<PaginationLink Href="@Href" Disabled="@Disabled" Size="default"
                aria-label="@AriaLabel" Class="@Cn("gap-1 px-2.5 sm:pe-2.5", Class)"
                @attributes="AdditionalAttributes">
    <span class="hidden sm:block">@Label</span>
    <Icon Name="chevron-right" Class="rtl:rotate-180" />
</PaginationLink>

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "Next";

    /// <summary>What a screen reader hears. Distinct from Label, which is hidden on small screens.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Go to next page";
}

@inherits UiComponentBase

@* <summary> is already a button to the accessibility tree, already focusable, already toggles
   on Enter and Space. The default disclosure triangle is removed in ui.behavior.css and the
   chevron below rotates from [open] — no state to track. *@

<summary data-slot="accordion-trigger" class="@Classes" @attributes="AdditionalAttributes">
    <span class="flex-1">@ChildContent</span>
    <Icon Name="chevron-down" data-chevron
          Class="text-muted-foreground pointer-events-none size-4 translate-y-0.5 transition-transform duration-200" />
</summary>

@code {
    const string Base =
        "flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-start " +
        "text-control font-medium transition-all outline-none hover:underline " +
        "focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 " +
        "disabled:pointer-events-none disabled:opacity-50 [&[data-state=open]>svg]:rotate-180";

    string Classes => Cn(Base, Class);
}

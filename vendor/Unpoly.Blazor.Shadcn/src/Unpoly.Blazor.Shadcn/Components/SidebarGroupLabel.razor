@inherits UiComponentBase

@* The heading over a group of rows. A <div>, as upstream — not an <h3>, because the sidebar's
   own heading level depends on the page it is on and a component cannot know it. Name the group
   with aria-labelledby if the structure matters. *@

<div data-slot="sidebar-group-label" class="@Classes"
     @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    const string Base =
        "flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium " +
        "text-sidebar-foreground/70 ring-sidebar-ring outline-hidden " +
        "transition-[margin,opacity] duration-200 ease-linear focus-visible:ring-2 " +
        "[&>svg]:size-4 [&>svg]:shrink-0 group-data-[collapsible=icon]:-mt-8 " +
        "group-data-[collapsible=icon]:opacity-0";

    string Classes => Cn(Base, Class);
}

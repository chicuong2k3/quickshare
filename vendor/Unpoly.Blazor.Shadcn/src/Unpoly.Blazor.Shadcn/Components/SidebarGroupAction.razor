@inherits UiComponentBase

@* The button at the end of a group heading — "add a project", usually. It needs a name of its
   own: "Add" beside five different headings is five buttons a screen reader cannot tell apart. *@

<button type="button" data-slot="sidebar-group-action" aria-label="@AriaLabel" class="@Classes"
        @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = default!;

    const string Base =
        "absolute top-3.5 end-3 flex aspect-square w-5 items-center justify-center rounded-md " +
        "p-0 text-sidebar-foreground ring-sidebar-ring outline-hidden transition-transform " +
        "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 " +
        "[&>svg]:size-4 [&>svg]:shrink-0 after:absolute after:-inset-2 md:after:hidden " +
        "group-data-[collapsible=icon]:hidden";

    string Classes => Cn(Base, Class);
}

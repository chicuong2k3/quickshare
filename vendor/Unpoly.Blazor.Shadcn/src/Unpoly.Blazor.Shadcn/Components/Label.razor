@inherits UiComponentBase

<label data-slot="label" class="@Classes" @attributes="AdditionalAttributes">@ChildContent</label>

@code {
    const string Base =
        "flex items-center gap-2 text-control leading-none font-medium select-none " +
        "group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 " +
        "peer-disabled:cursor-not-allowed peer-disabled:opacity-50";

    string Classes => Cn(Base, Class);
}

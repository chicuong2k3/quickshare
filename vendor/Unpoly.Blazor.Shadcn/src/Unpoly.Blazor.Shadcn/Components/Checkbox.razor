@inherits UiComponentBase

@* Radix draws a checkbox as <button role="checkbox"> with a hidden input beside it. On static
   SSR the real input is the only thing that posts and the only thing that works with scripting
   off, so it stays and wears the styling itself. The tick is a mask on ::after (ui.behavior.css)
   rather than a child element, because an <input> cannot have children. *@

@* Two-way binding via @bind / @bind-Checked. When the caller passes CheckedChanged, the input
   renders checked="@Checked" with an @onchange that raises it. The unbound branch renders
   checked="@Checked" as well: a bare `checked` binds to the Checked parameter and never
   reaches the splat, so omitting it here silently drops the caller's value. *@
@if (CheckedChanged.HasDelegate)
{
    <input type="checkbox" data-slot="checkbox" checked="@Checked" @onchange="OnChange"
           class="@Classes" @attributes="AdditionalAttributes" />
}
else
{
    <input type="checkbox" data-slot="checkbox" checked="@Checked" class="@Classes" @attributes="AdditionalAttributes" />
}

@code {
    /// <summary>The bound checked state, from <c>@bind</c>/<c>@bind-Checked</c>.</summary>
    [Parameter] public bool Checked { get; set; }

    /// <summary>Raises on change when bound. Its presence decides whether the component renders
    /// checked/@onchange or lets the <c>@attributes</c> splat do it.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    async Task OnChange(ChangeEventArgs e) =>
        await CheckedChanged.InvokeAsync(e.Value is not null && e.Value is not false
            && !(e.Value is string s && s == "false"));

    const string Base =
        "peer size-4 shrink-0 rounded-[4px] border border-input shadow-xs transition-shadow " +
        "outline-none focus-visible:border-ring focus-visible:ring-[3px] " +
        "focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 " +
        "aria-invalid:border-destructive aria-invalid:ring-destructive/20 " +
        "checked:border-primary checked:bg-primary checked:text-primary-foreground " +
        "dark:bg-input/30 dark:aria-invalid:ring-destructive/40 dark:checked:bg-primary";

    string Classes => Cn(Base, Class);
}

@inherits UiComponentBase

<div data-slot="drawer-header" class="@Classes"
     @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    const string Base =
        "flex flex-col gap-0.5 p-4 " +
        "group-data-[vaul-drawer-direction=bottom]/drawer-content:text-center " +
        "group-data-[vaul-drawer-direction=top]/drawer-content:text-center md:gap-1.5 " +
        "md:text-start";

    string Classes => Cn(Base, Class);
}

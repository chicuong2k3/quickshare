@inherits UiComponentBase

@* popovertarget is an ordinary HTML attribute, so this opens before any JavaScript has run and
   keeps working if ui.js fails to load. The compiler only adds positioning. *@

<button type="button" data-slot="popover-trigger" data-target="@Target" popovertarget="@Target"
        aria-haspopup="dialog" aria-expanded="false"
        class="@Classes" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    /// <summary>The id of the <see cref="PopoverContent"/> to open.</summary>
    [Parameter, EditorRequired] public string Target { get; set; } = default!;

    [Parameter] public string Variant { get; set; } = "outline";
    [Parameter] public string Size { get; set; } = "default";

    string Classes => ButtonVariants.Of(Variant, Size, Class);
}

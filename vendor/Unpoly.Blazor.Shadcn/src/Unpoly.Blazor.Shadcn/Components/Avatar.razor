@inherits UiComponentBase

@* No overflow-hidden, which upstream's new-york-v4 class string has and which cuts the badge's
   ring off at the circle. The round shape comes from the image and the fallback rounding
   themselves — shadcn's current style does it that way for the same reason.

   Radix swaps image for fallback in JS after the load event. Here the fallback sits behind the
   image and the image hides itself if it fails, so the exchange costs no script and survives a
   fragment swap. *@

<span data-slot="avatar" data-size="@Size" class="@Classes" @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    /// <summary>default | sm | lg. Read by the badge and the fallback through a group variant.</summary>
    [Parameter] public string Size { get; set; } = "default";

    string Classes => Cn("group/avatar relative flex size-8 shrink-0 rounded-full select-none data-[size=lg]:size-10 data-[size=sm]:size-6", Class);
}

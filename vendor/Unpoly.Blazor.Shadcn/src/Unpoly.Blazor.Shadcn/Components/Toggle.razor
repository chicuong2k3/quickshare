@inherits UiComponentBase

@* A button that stays pressed. Radix keeps that state in React; here it is a real
   <input type="checkbox"> so it posts with the form and survives a fragment swap, styled as a
   button and announced as one — aria-pressed is what a screen reader needs to hear, and a bare
   checkbox that looks like a button would say the wrong thing.

   The pressed appearance comes from `checked:` in the recipe rather than from data-state. *@

<label data-slot="toggle" class="@Classes" @attributes="AdditionalAttributes">
    @if (CheckedChanged.HasDelegate)
    {
        <input type="checkbox" class="sr-only peer" name="@Name" value="@Value" checked="@Checked"
               disabled="@Disabled" role="button" aria-pressed="@(Checked ? "true" : "false")" @onchange="OnChange" />
    }
    else
    {
        <input type="checkbox" class="sr-only peer" name="@Name" value="@Value" checked="@Checked"
               disabled="@Disabled" role="button" aria-pressed="@(Checked ? "true" : "false")" />
    }
    @ChildContent
</label>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string Value { get; set; } = "true";
    [Parameter] public bool Checked { get; set; }

    /// <summary>Raises on change when bound. Its presence decides whether the component renders
    /// checked/@onchange or lets the <c>@attributes</c> splat do it.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    async Task OnChange(ChangeEventArgs e) =>
        await CheckedChanged.InvokeAsync(e.Value is not null && e.Value is not false
            && !(e.Value is string s && s == "false"));

    /// <summary>default | outline</summary>
    [Parameter] public string Variant { get; set; } = "default";

    /// <summary>default | sm | lg</summary>
    [Parameter] public string Size { get; set; } = "default";

    const string Base =
        "inline-flex items-center justify-center gap-2 rounded-md text-control font-medium " +
        "whitespace-nowrap transition-[color,box-shadow] outline-none hover:bg-muted " +
        "hover:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] " +
        "focus-visible:ring-ring/50 aria-invalid:border-destructive " +
        "aria-invalid:ring-destructive/20 has-[:checked]:bg-accent " +
        "has-[:checked]:text-accent-foreground dark:aria-invalid:ring-destructive/40 " +
        "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 " +
        "bg-transparent h-control min-w-9 px-2 group/toggle " +
        "has-[:disabled]:pointer-events-none has-[:disabled]:opacity-50";

    // The variant and the size were both baked into the base — the default variant's
    // bg-transparent and the default size's h-9/min-w-9/px-2 — so Variant and Size were
    // parameters that changed nothing. An outline toggle had no border, and a small one was the
    // same height as a large one. Parity only ever renders a component with its defaults, which
    // is why a table that exists but is never consulted passes it.
    string VariantClass => Variant switch
    {
        "outline" => "border border-input bg-transparent shadow-xs hover:bg-accent " +
                     "hover:text-accent-foreground",
        _ => "bg-transparent",
    };

    /// <summary>Each keeps a square minimum, so an icon-only toggle stays square.</summary>
    string SizeClass => Size switch
    {
        "sm" => "h-8 min-w-8 px-1.5",
        "lg" => "h-10 min-w-10 px-2.5",
        _ => "h-control min-w-9 px-2",
    };

    string Classes => Cn(Base, VariantClass, SizeClass, Class);
}

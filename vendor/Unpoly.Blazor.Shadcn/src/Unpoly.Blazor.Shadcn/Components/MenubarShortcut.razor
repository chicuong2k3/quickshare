@inherits UiComponentBase

@* The keyboard hint on the right of a menu row. Decorative: the shortcut itself is bound
   elsewhere, and reading "⌘K" aloud after the label helps nobody. *@

<span data-slot="menubar-shortcut" aria-hidden="true" class="@Cn("ms-auto text-xs tracking-widest text-muted-foreground", Class)"
      @attributes="AdditionalAttributes">@ChildContent</span>

@inherits UiComponentBase

<div data-slot="combobox-list" role="listbox" class="@Classes"
     @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    const string Base =
        "max-h-[min(calc(--spacing(96)---spacing(9)),calc(var(--available-height)---spacing(9)))] " +
        "scroll-py-1 overflow-y-auto p-1 data-empty:p-0";

    string Classes => Cn(Base, Class);
}

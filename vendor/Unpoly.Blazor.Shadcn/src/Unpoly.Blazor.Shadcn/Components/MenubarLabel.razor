@inherits UiComponentBase

<div data-slot="menubar-label" data-inset="@(Inset ? "true" : null)" class="@Cn("px-2 py-1.5 text-control font-medium data-[inset]:ps-8", Class)" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    /// <summary>Indents the label to line up with rows that have an icon.</summary>
    [Parameter] public bool Inset { get; set; }
}

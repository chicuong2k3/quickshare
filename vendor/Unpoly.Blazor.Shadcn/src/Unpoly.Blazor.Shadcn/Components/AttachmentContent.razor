@inherits UiComponentBase

<div data-slot="attachment-content" class="@Classes"
     @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    const string Base =
        "max-w-full min-w-0 flex-1 leading-tight " +
        "group-data-[orientation=vertical]/attachment:px-1";

    string Classes => Cn(Base, Class);
}

@inherits UiComponentBase

<span data-slot="attachment-title" class="@Classes"
      @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    const string Base =
        "block max-w-full min-w-0 truncate font-medium " +
        "group-data-[state=processing]/attachment:shimmer " +
        "group-data-[state=uploading]/attachment:shimmer";

    string Classes => Cn(Base, Class);
}

@inherits UiComponentBase

@* One stop on a FloatingNav: the icon as ChildContent, Label under it from sm up — upstream hides
   the words on a phone and keeps them for a screen reader here, as sr-only, so an icon-only item
   is never nameless.

   With Href it is a link and Active marks the current page with aria-current, which is what a
   screen reader announces. Without Href it is a button, as upstream's are, and Active only says
   which one the pill starts under. *@

@if (Href is not null)
{
    <a data-slot="floating-nav-item" href="@Href" aria-current="@(Active ? "page" : null)"
       data-active="@(Active ? "true" : null)" class="@Classes" @attributes="AdditionalAttributes">@Body</a>
}
else
{
    <button type="button" data-slot="floating-nav-item" aria-pressed="@(Active ? "true" : "false")"
            data-active="@(Active ? "true" : null)" class="@Classes" @attributes="AdditionalAttributes">@Body</button>
}

@code {
    /// <summary>Where the item goes. Null renders a button instead of a link.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>The item's name: shown under the icon from sm up, read aloud everywhere.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The current item — the one the pill sits under when the page arrives.</summary>
    [Parameter] public bool Active { get; set; }

    RenderFragment Body => __builder =>
    {
        if (Active)
        {
            <span data-slot="floating-nav-indicator" aria-hidden="true"
                  class="absolute inset-y-1 inset-x-0 rounded-full bg-primary/10 dark:bg-primary/20"></span>
        }
        <span class="relative z-10 [&_svg]:size-[22px]" aria-hidden="true">@ChildContent</span>
        <span class="relative z-10 mt-1 hidden text-xs sm:block">@Label</span>
        <span class="sr-only sm:hidden">@Label</span>
    };

    // text-muted-foreground where upstream writes text-gray-600 / dark:text-gray-300.
    string Classes => Cn("relative flex flex-1 flex-col items-center justify-center rounded-full px-2 py-2 text-sm font-medium text-muted-foreground outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50", Class);
}

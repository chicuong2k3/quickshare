@inherits UiComponentBase

@* Lucide, the icon set shadcn/ui is drawn with. lucide-react ships one component per icon; here
   one component takes the name, because 2000 Razor files is not an icon set, it is a build
problem. The glyphs come from LucideIcons.g.cs, generated by the gen-icons .NET command.

   Accessibility follows lucide-react exactly: an icon is decorative unless it is given a Title.
   Most are — they sit beside a label that already says the same thing, and announcing "chevron
   down" after "Sort" is noise. An icon that IS the only label needs a Title, and then it gets
   role="img" and a <title> the accessible name comes from.

   Sizing is a class, not a parameter: every component's recipe already contains
   `[&_svg:not([class*='size-'])]:size-4`, which sizes any icon inside it and steps aside the
   moment the caller says otherwise. So <Icon Name="x" /> inside a Button is 16px without asking,
   and <Icon Name="x" Class="size-6" /> is not. *@

<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="@StrokeWidth"
     stroke-linecap="round" stroke-linejoin="round"
     class="@Classes"
     role="@(Title is null ? null : "img")"
     aria-hidden="@(Title is null ? "true" : null)"
     @attributes="AdditionalAttributes">@if (Title is not null)
                                        {
                                            <title>@Title</title>
                                        }@Body</svg>

@code {
    /// <summary>Kebab-case, as on lucide.dev — "chevron-down", "trash-2".</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = default!;

    /// <summary>Gives the icon an accessible name. Leave null when a label already says it.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Lucide's own default is 2. Raise it for very small sizes, lower it for large.</summary>
    [Parameter] public double StrokeWidth { get; set; } = 2;

    MarkupString Body => LucideIcons.All.TryGetValue(Name, out var markup)
        ? new MarkupString(markup)
        // An unknown name renders an empty box rather than throwing: a missing icon should not
// take a page down, and it is loud enough in review. Add it with the gen-icons .NET command.
        : default;

    string Classes => Cn("shrink-0", Class);
}

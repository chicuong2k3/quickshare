@inherits UiComponentBase

<button type="button" data-slot="sheet-trigger" data-target="@Target" aria-haspopup="dialog"
        class="@Classes" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    /// <summary>The id of the <see cref="Sheet"/> to open.</summary>
    [Parameter, EditorRequired] public string Target { get; set; } = default!;

    [Parameter] public string Variant { get; set; } = "outline";
    [Parameter] public string Size { get; set; } = "default";

    string Classes => ButtonVariants.Of(Variant, Size, Class);
}

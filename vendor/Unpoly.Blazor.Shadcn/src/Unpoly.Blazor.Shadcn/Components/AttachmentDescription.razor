@inherits UiComponentBase

<span data-slot="attachment-description" class="@Classes"
      @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    const string Base =
        "mt-0.5 block min-w-0 truncate text-xs text-muted-foreground " +
        "group-data-[state=error]/attachment:text-destructive/80 max-w-full";

    string Classes => Cn(Base, Class);
}

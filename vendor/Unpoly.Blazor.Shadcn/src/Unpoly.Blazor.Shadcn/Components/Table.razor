@inherits UiComponentBase

@* The scroll container is part of the component in shadcn, not an optional wrapper — a table
   that cannot be scrolled sideways on a phone is a table with columns nobody can read. *@

<div data-slot="table-container" class="relative w-full overflow-x-auto">
    <table data-slot="table" class="@Classes" @attributes="AdditionalAttributes">@ChildContent</table>
</div>

@code {
    string Classes => Cn("w-full caption-bottom text-control", Class);
}

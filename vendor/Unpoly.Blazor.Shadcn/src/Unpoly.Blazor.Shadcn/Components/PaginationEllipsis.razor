@inherits UiComponentBase

<span aria-hidden="true" data-slot="pagination-ellipsis" class="@Classes" @attributes="AdditionalAttributes">
    <Icon Name="ellipsis" Class="size-4" />
    <span class="sr-only">@SrLabel</span>
</span>

@code {
    /// <summary>Read aloud in place of the dots.</summary>
    [Parameter] public string SrLabel { get; set; } = "More pages";

    string Classes => Cn("flex size-control items-center justify-center", Class);
}

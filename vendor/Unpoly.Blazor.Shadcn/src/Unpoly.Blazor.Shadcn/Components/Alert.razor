@inherits UiComponentBase

<div data-slot="alert" role="alert" class="@Classes" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    /// <summary>default | destructive</summary>
    [Parameter] public string Variant { get; set; } = "default";

    const string Base =
        "relative grid w-full grid-cols-[0_1fr] items-start gap-y-0.5 rounded-lg border px-4 " +
        "py-3 text-control has-[>svg]:grid-cols-[calc(var(--spacing)*4)_1fr] " +
        "has-[>svg]:gap-x-3 [&>svg]:size-4 [&>svg]:translate-y-0.5 [&>svg]:text-current " +
        "has-data-[slot=alert-action]:pe-20";

    string VariantClass => Variant switch
    {
        "destructive" => "bg-card text-destructive *:data-[slot=alert-description]:text-destructive/90 [&>svg]:text-current",
        _ => "bg-card text-card-foreground",
    };

    string Classes => Cn(Base, VariantClass, Class);
}

# Generated by the CopyScopedCss build target from every .razor.css.
# Tracking it meant the committed copy silently drifted from its sources;
# dotnet publish regenerates it, and the Docker image builds from publish.
src/QuickShare/wwwroot/css/QuickShare.styles.css

bin/
obj/
*.session
appsettings.*.json
!appsettings.Development.json
.vs/
.gitnexus
slnmap.db*

# OpenCode session continuation state - transient, regenerable
.omo/

# Secrets — NEVER commit
.env

# Impeccable working artifacts — screenshots and reference boards are
# regenerable; DESIGN.md and critique snapshots are not.
.impeccable/shots*/
.impeccable/worlds/
.impeccable/questions/

# BMad scratch that should not be versioned alongside the committed
# planning artifacts in the same trees.
_bmad-output/party-mode/memories/installed/
_bmad-output/planning-artifacts/growth-features-implementation-plan.md

# Generated by the CopyScopedCss build target from every .razor.css.
# Tracking it meant the committed copy silently drifted from its sources;
# dotnet publish regenerates it, and the Docker image builds from publish.
src/QuickShare/wwwroot/css/QuickShare.styles.css

# TypeScript toolchain — deps and generated JS are built, not committed.
# The BuildTypeScript MSBuild target runs npm ci + tsc on every dotnet build
# (CI, Docker, local), so wwwroot/js regenerates from the ts/ sources.
node_modules/
src/QuickShare/wwwroot/js/**

# Test artifacts — blame-hang dumps, sequence XML, coverage
tests/**/TestResults/

<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- xUnit1051 (TestContext cancellation token) + CA1707 (underscores are the xunit naming convention): noise in tests -->
    <!-- CA1861 (inline arrays) + CA1822 (mark helpers static): style noise in tests -->
    <NoWarn>$(NoWarn);xUnit1051;CA1707;CA1861;CA1822</NoWarn>
  </PropertyGroup>
</Project>

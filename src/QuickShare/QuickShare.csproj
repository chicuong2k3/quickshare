<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>QuickShare</RootNamespace>
    <AssemblyName>QuickShare</AssemblyName>
    <UserSecretsId>f14da91e-ee6c-4a2e-8f55-0ac6329eed3c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickShare.Querying\QuickShare.Querying.csproj" />
    <ProjectReference Include="..\QuickShare.Querying.Generators\QuickShare.Querying.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.*" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="FastEndpoints" Version="8.2.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.2.0" />
    <PackageReference Include="LightResults" Version="10.0.4" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="3.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="payOS" Version="2.1.0" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Grafana.Loki" Version="9.0.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2" PrivateAssets="all" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.*" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <!-- Pin Relational to the same version as Microsoft.EntityFrameworkCore. The relational
         provider (Npgsql 10.0.0) floats Relational at an older patch (10.0.2), so without this
         the Browser.Tests resolve core 10.0.10 against Relational 10.0.2 and the app fails at
         startup with "Could not load ... Microsoft.EntityFrameworkCore.Relational, Version=10.0.10.0". -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />

    <!-- Web (Blazor SSR + htmx) dependencies -->
    <PackageReference Include="Htmxor" Version="1.0.0-beta.1.24" />
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- Observability: Prometheus metrics + health checks + log enrichment -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="AspNetCore.HealthChecks.Npgsql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" Version="9.0.0" />
    <PackageReference Include="Serilog.Enrichers.Span" Version="3.1.0" />
    <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.*" />
  </ItemGroup>

  <!-- TypeScript build: npm ci once (when toolchain missing), then tsc.
       Runs on every dotnet build/publish — CI and the Docker image both get
       fresh JS from the ts/ sources. Generated wwwroot/js is NOT committed. -->
  <Target Name="BuildTypeScript" BeforeTargets="Build" Condition="'$(BuildingProject)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(ProjectDir)" Condition="!Exists('$(ProjectDir)node_modules\.bin\tsc.cmd') And '$(OS)' == 'Windows_NT'" />
    <Exec Command="npm ci" WorkingDirectory="$(ProjectDir)" Condition="!Exists('$(ProjectDir)node_modules\.bin\tsc') And '$(OS)' != 'Windows_NT'" />
    <Exec Command="npm run tsc" WorkingDirectory="$(ProjectDir)" />
  </Target>

  <Target Name="CopyScopedCss" AfterTargets="Build">
    <Copy SourceFiles="$(IntermediateOutputPath)scopedcss\bundle\QuickShare.styles.css" DestinationFolder="$(ProjectDir)wwwroot\css" />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="QuickShare.Server.Tests" />
  </ItemGroup>

</Project>

<!DOCTYPE html>
@* lang follows the request culture; a hardcoded "en" mislabels every
   Vietnamese page for screen readers and translation tools. *@
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="grunge-dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="QuickShareCloud — secure temporary file sharing with auto-expiry." />
    <title>QuickShareCloud</title>

    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#EFE6D6" />
    <base href="/" />

    @* Outfit (display + UI, set light and wide-tracked) + Azeret Mono (spec labels, codes, measurements) *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200..700&family=Azeret+Mono:wght@300;400;500&display=swap" rel="stylesheet" />

    @* DAUB anti-FOUC: set theme before CSS loads *@
    <script>
        (function() {
            try {
                var family = window.localStorage.getItem('db-family') || 'grunge';
                var scheme = window.localStorage.getItem('db-scheme') || 'dark';
                // Map family+scheme to theme variant
                var familyMap = {
                    grunge: { dark: 'grunge-dark', light: 'grunge-light' },
                    default: { dark: 'dark', light: 'light' },
                    solarized: { dark: 'solarized-dark', light: 'solarized' },
                    ink: { dark: 'ink', light: 'ink-light' },
                    ember: { dark: 'ember', light: 'ember-light' },
                    bone: { dark: 'bone-dark', light: 'bone' }
                };
                var theme = (familyMap[family] && familyMap[family][scheme]) || 'grunge-dark';
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {}
        })();
    </script>

    <link rel="stylesheet" href="/css/QuickShare.styles.css" />
    <link rel="stylesheet" href="https://daub.dev/daub.css" />
    <link rel="stylesheet" href="/css/app.css" />

    @* HTMX head outlet for enhanced navigation *@
    <HtmxHeadOutlet />
    <HeadOutlet />
</head>
<body>
<!--
DIRECTION CONTRACT · seed 46c7765a
THESIS: Ciphertext is a folded sheet; the key in the link is the one pull that deploys it. The
server holds a packet it cannot open. Refuses the category's centered white card on a soft ground.
OWN-WORLD: Matte sheet stock, 60-degree crease lattice, hairline rules ending in mono spec labels,
parallelogram cells with cut corners, zero radius. Foil gold marks the single deployable action;
valley blue marks the active cell; mountain gray is everything at rest.
STORY: A stranger from a chat sees a packet with real measurements on it, watches their own browser
pull it open, and takes the file.
FIRST VIEWPORT: Crease lattice full-bleed; the delivery as a folded packet with its true specs
(bytes, parts, expiry, code) in mono along hairlines; the deploy action is a gold parallelogram tab.
FORM: Miura deployable sheet — user-pinned challenger; roll 46c7765a assigned index 5 (bearer ticket).
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->
    <Routes />

    <script src="https://daub.dev/daub.js"></script>
    <script>
        // Set grunge theme family (defaults to dark scheme)
        (function() {
            if (window.DAUB) {
                var family = window.localStorage.getItem('db-family') || 'grunge';
                var scheme = window.localStorage.getItem('db-scheme') || 'dark';
                window.DAUB.setFamily(family);
                window.DAUB.setScheme(scheme);
            }
        })();
    </script>
    <script src="/js/client-error-reporting.js" asp-append-version="true"></script>
    <script src="/js/ad-component.js" asp-append-version="true"></script>
    <script src="/lib/qrcode/qrcode.min.js"></script>
    <script defer src="/lib/alpinejs/cdn.min.js" asp-append-version="true"></script>
</body>
</html>

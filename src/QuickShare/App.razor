@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<!DOCTYPE html>
@* lang follows the request culture; a hardcoded "en" mislabels every
   Vietnamese page for screen readers and translation tools. *@
@{
    var isoLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var textDir = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}
<html lang="@isoLang" dir="@textDir" data-theme="dark" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="QuickShareCloud — secure temporary file sharing with auto-expiry." />
    <title>QuickShareCloud</title>

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#15181B" />
    <base href="/" />

    @* PWA (issue #14): installable shell + Android Web Share Target *@
    <link rel="manifest" href="/manifest.webmanifest" />

    @* Departure board ("Bảng chuyến"): Barlow Condensed (display/labels), Archivo (body), Martian Mono (data).
       All are SIL OFL — chosen for legibility, Vietnamese coverage, and license safety. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..800&family=Barlow+Condensed:wght@500;600;700&family=Martian+Mono:wght@400;600&display=swap" rel="stylesheet" />

    @* Anti-FOUC: apply saved theme (dark-first Departure Board) before CSS paints. *@
    <script>
        (function () {
            try {
                var saved = window.localStorage.getItem('db-scheme');
                var scheme = saved === 'light' || saved === 'dark'
                    ? saved
                    : 'dark';
                var isDark = scheme === 'dark';
                document.documentElement.classList.toggle('dark', isDark);
                document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
                var meta = document.querySelector('meta[name="theme-color"]');
                if (meta) meta.setAttribute('content', isDark ? '#15181B' : '#D8DBDE');
            } catch (e) { }
        })();
    </script>

    <link rel="stylesheet" href="@($"/{Assets["css/shadcn.generated.css"].TrimStart('/')}")" />
    <link rel="stylesheet" href="@($"/{Assets["_content/Unpoly.Blazor.Shadcn/ui.safari15.css"].TrimStart('/')}")" />
    <link rel="stylesheet" href="@($"/{Assets["css/app.css"].TrimStart('/')}")" />
    <link rel="stylesheet" href="@($"/{Assets[RoutePaths.ScopedStyles.TrimStart('/')].TrimStart('/')}")" />

    <script src="_content/Unpoly.Blazor.Shadcn/compat/safari15-shim.js"></script>
    <script src="_content/Unpoly.Blazor.Shadcn/compat/dialog-shim.js"></script>
    <script src="_content/Unpoly.Blazor.Shadcn/compat/popover.iife.min.js"></script>
    <script src="_content/Unpoly.Blazor.Shadcn/compat/css-has-pseudo.js"></script>
    <script src="_content/Unpoly.Blazor.Shadcn/compat/has-pseudo-boot.js"></script>
    <script src="_content/Unpoly.Blazor.Shadcn/toastify/toastify.js" defer></script>
    @* The library's AlertDialog and toast build their own buttons and their own live region in
       ui.js, so their labels cannot come from a Razor parameter: window.shadcnUi is the only hook
       it offers. Localized here, because an English "OK" next to a Vietnamese question is the
       kind of thing no page-level translation pass can fix afterwards. *@
    <script>
        window.shadcnUi = {
            confirmText: @((MarkupString)System.Text.Json.JsonSerializer.Serialize(Loc["dialog_confirm"].Value)),
            cancelText: @((MarkupString)System.Text.Json.JsonSerializer.Serialize(Loc["dialog_cancel"].Value)),
        };
    </script>
    <script src="_content/Unpoly.Blazor.Shadcn/ui.js" defer></script>
    <UnpolyHead />
    <HeadOutlet />
</head>
<body>
    <Routes />

    <script src="/js/page-actions.js" asp-append-version="true"></script>
    <script src="/js/voice.js" asp-append-version="true"></script>
    <script src="/js/client-error-reporting.js" asp-append-version="true"></script>
    <script src="/js/ad-component.js" asp-append-version="true"></script>
    <script src="/lib/qrcode/qrcode.min.js"></script>
    <script>
        // PWA (issue #14): progressive enhancement — a SW failure must never
        // break the page.
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' }).catch(function () { });
            });
        }
    </script>
</body>
</html>

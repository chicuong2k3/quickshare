@layout MainLayout
@page "/account"
@attribute [Authorize]
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Account — QuickShareCloud</PageTitle>

<PageWrapper id="account-app" Variant="PageVariant.Account">

    @* Profile Card — HTMX lazy loaded *@
    <HtmxFragment>
    <div id="profile-card" class="db-card account-card"
         hx-get="/account/profile"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="db-card__body">
            <div class="account-profile">
                <div class="account-skeleton-avatar"></div>
                <div class="account-skeleton-line account-skeleton-name" style="margin-top: 1.25rem"></div>
                <div class="account-skeleton-line account-skeleton-email" style="margin-top: 0.5rem"></div>
                <div class="account-skeleton-line account-skeleton-badge" style="margin-top: 0.75rem"></div>
            </div>
        </div>
    </div>
    </HtmxFragment>

    @* Branding Card — JS lazy loaded *@
    <div class="db-card" id="branding-card">
        <div class="db-card__body">
            <div class="account-section-head">
                <div class="account-section-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M12 1v2 M12 21v2 M4.22 4.22l1.42 1.42 M18.36 18.36l1.42 1.42 M1 12h2 M21 12h2 M4.22 19.78l1.42-1.42 M18.36 5.64l1.42-1.42" />
                    </svg>
                </div>
                <div>
                    <h3 class="db-h3">Share Branding</h3>
                    <p class="db-p db-text-muted">Customise how recipients see your shared files.</p>
                </div>
            </div>
            <div id="branding-loading" class="db-text-center" style="padding: 2.5rem 0">
                <div class="db-spinner db-spinner--lg"></div>
                <p class="db-p db-text-muted" style="margin-top: 0.75rem">Loading shared files…</p>
            </div>
            <div id="branding-empty" class="account-branding-empty" style="display:none">No shared files yet. Send a file first to brand it.</div>
            <div id="branding-list" style="display:none"></div>
        </div>
    </div>
</PageWrapper>

<script src="/js/account.js"></script>



@layout MainLayout
@page "/p2p/send"
@inject IConfiguration Config
@inject IHttpContextAccessor HttpContextAccessor

@{
    // API and pages are same-origin now; browser JS uses relative URLs.
    var apiBase = "";
}

<PageTitle>QuickShareCloud — P2P file transfer</PageTitle>

<PageWrapper Variant="PageVariant.Fill">
    <script>window.ZAPDROP_CONFIG = { apiBaseUrl: "@apiBase" };</script>
        <div class="container">
            <input type="file" name="file" id="p2ps-file-input" class="sr-only" aria-label="Choose a file" onchange="p2pSend.onFileSelect(event)" />

            @* IDLE / DRAGGING *@
            <section id="p2ps-idle" class="section">
                <h1 class="h1">
                    <span id="idle-h1">Send <span class="gradient">direct</span></span>
                    <span id="drag-h1" class="hidden">Drop your file</span>
                </h1>
                <p class="sub">
                    <span id="idle-sub">Peer-to-peer &middot; no server storage &middot; encrypted</span>
                    <span id="drag-sub" class="hidden">Release to start P2P transfer</span>
                </p>

                <div>
                    <div id=""
                         ondragover="p2pSend.onDragOver(event)"
                         ondragenter="p2pSend.onDragOver(event)"
                         ondragleave="p2pSend.onDragLeave(event)"
                         ondrop="p2pSend.onDrop(event)"
                         class="dropzone"
                         onclick="document.getElementById('p2ps-file-input').click()">
                        <div class="dropzone-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" />
                            </svg>
                        </div>
                        <div>
                            <p class="dropzone-title">
                                <span id="dropzone-idle">Drag &amp; drop a file to share directly</span>
                                <span id="dropzone-drag" class="hidden">Drop it here</span>
                            </p>
                            <p class="dropzone-sub">or click to browse &middot; no size limit</p>
                        </div>
                    </div>
                </div>

                <div class="pin-row">
                    <input type="checkbox" id="p2ps-enable-pin" class="pin-checkbox" onchange="p2pSend.togglePin()" />
                    <label for="p2ps-enable-pin" class="pin-label">Protect with PIN</label>
                    <input type="text" id="" class="pin-input hidden" placeholder="Enter a PIN" oninput="p2pSend.pin = this.value" />
                </div>
            </section>

            @* CREATING LINK *@
            <section id="p2ps-creating" class="section hidden">
                <div class="db-spinner db-spinner--lg" style="margin: 0 auto"></div>
                <h1 class="status-h1">Creating share link&hellip;</h1>
            </section>

            @* WAITING FOR PEER / SHARING *@
            <section id="p2ps-waiting" class="section hidden">
                <div class="db-spinner db-spinner--lg" style="margin: 0 auto"></div>
                <h1 class="status-h1">Waiting for receiver</h1>
                <p class="status-p">Share this link with the recipient:</p>
                <div class="share-box">
                    <div class="share-row">
                        <input id="p2ps-share-link" type="text" readonly class="share-input" aria-label="Share link" />
                        <button class="db-btn db-btn--primary" onclick="p2pSend.copyLink()" data-ai-action="p2p.share.copy-link" aria-label="Copy share link">
                            <span id="p2ps-copy-text">Copy link</span>
                            <span id="p2ps-copy-done" class="hidden">Copied!</span>
                        </button>
                    </div>
                </div>

                <div id="p2ps-qrcode" style="margin-top: 1.5rem; display: flex; justify-content: center"></div>

                <div id="p2ps-receiver-list" style="display: none; margin-top: 1.5rem; width: 100%">
                    <p style="font-size: 0.875rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--color-foreground)">Receivers</p>
                    <div id="p2ps-receiver-items"></div>
                </div>

                <p style="margin-top: 1rem; font-size: 0.75rem; color: var(--color-muted-foreground)">Link expires in 7 days. File transfers directly between peers.</p>
                <button class="db-btn db-btn--ghost" style="margin-top: 2rem" onclick="p2pSend.cancel()">Cancel</button>
            </section>

            @* FAILED *@
            <section id="p2ps-failed" class="section hidden">
                <div class="icon-error">
                    <svg class="icon-svg-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                </div>
                <h1 class="status-h1">Transfer failed</h1>
                <p class="status-p" id="p2ps-error-msg">The P2P connection could not be established.</p>
                <button class="db-btn db-btn--primary" style="margin-top: 2.5rem" onclick="p2pSend.reset()">Try again</button>
            </section>
        </div>
</PageWrapper>

<script src="/js/p2p/signaling.js"></script>
<script src="/js/p2p/peerConnection.js"></script>
<script src="/js/p2p/fileTransfer.js"></script>
<script src="/js/p2p/encryption.js"></script>
<script src="/js/p2p/send.js"></script>

@layout MainLayout
@page "/"

<PageTitle>QuickShareCloud â€” send files, not friction</PageTitle>

<PageWrapper Variant="PageVariant.Padded">
    <section class="home-hero">
        <span class="home-tag">Secure &middot; Fast &middot; Temporary</span>
        <h1 class="db-h1">
            Send <span class="home-accent">anything</span>,
            <br>zero friction
        </h1>
        <p class="db-p db-text-muted home-hero__sub">
            Encrypted file sharing with auto-expiry.
            No accounts needed for recipients. Files delete themselves.
        </p>
        <div class="home-hero__actions">
            <a href="/send" class="db-btn db-btn--primary db-btn--lg">Start sending</a>
            <a href="/pricing" class="db-btn db-btn--ghost db-btn--lg">View pricing</a>
        </div>
    </section>

    <section class="home-why" aria-labelledby="why-use-app">
        <div class="home-why__head">
            <h2 id="why-use-app" class="db-h2">Why use this app</h2>
            <p class="db-text-muted home-why__sub">
                Two clear modes: Cloud Send for share-anytime links, and P2P transfer for instant device-to-device delivery.
            </p>
        </div>
        <div class="home-why__badges" aria-label="Choose transfer mode">
            <span class="home-why__badge">
                <strong>Need long-term link?</strong>
                Use Cloud Send.
            </span>
            <span class="home-why__badge">
                <strong>Need instant live transfer?</strong>
                Use P2P.
            </span>
        </div>
        <div class="db-card home-why__card">
            <div class="db-card__body">
                <table class="home-why__table">
                    <caption class="home-why__caption">Cloud Send vs P2P transfer in real usage</caption>
                    <thead>
                        <tr>
                            <th scope="col">What matters</th>
                            <th scope="col">Cloud Send</th>
                            <th scope="col">P2P transfer</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">How delivery works</th>
                            <td>Create one link and share it anywhere.</td>
                            <td>Direct device-to-device stream between sender and receiver.</td>
                        </tr>
                        <tr>
                            <th scope="row">Can recipient open later?</th>
                            <td>Yes. Link stays available until expiry.</td>
                            <td>No. Both sides must be online during transfer.</td>
                        </tr>
                        <tr>
                            <th scope="row">Storage retention</th>
                            <td>Yes. File stays available until your expiry window.</td>
                            <td>No saved copy after the transfer session ends.</td>
                        </tr>
                        <tr>
                            <th scope="row">Best fit</th>
                            <td>Remote sharing, async handoff, longer availability.</td>
                            <td>Fast local handoff when both devices online now.</td>
                        </tr>
                        <tr>
                            <th scope="row">Scale when needed</th>
                            <td>Upgrade for larger limits and longer retention.</td>
                            <td>Great for quick transfers, not long-term hosting.</td>
                        </tr>
                    </tbody>
                </table>
                <div class="home-why__actions">
                    <a href="/send" class="db-btn db-btn--primary">Send a file now</a>
                    <a href="/pricing" class="db-btn db-btn--ghost">See Pro limits</a>
                </div>
            </div>
        </div>
    </section>
    <section class="home-features">
        <div class="db-grid db-grid--3 db-gap-4">
            <div class="db-card">
                <div class="db-card__body">
                    <div class="home-feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </div>
                    <h3 class="db-h3">End-to-end encrypted</h3>
                    <p class="db-text-muted">
                        Files are encrypted before they leave your device. Only intended recipients can decrypt.
                    </p>
                </div>
            </div>
            <div class="db-card">
                <div class="db-card__body">
                    <div class="home-feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </div>
                    <h3 class="db-h3">Auto-expiring links</h3>
                    <p class="db-text-muted">
                        Free transfers auto-expire after 2 hours. Pro and Studio keep files for 30–90 days.
                    </p>
                </div>
            </div>
            <div class="db-card">
                <div class="db-card__body">
                    <div class="home-feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                        </svg>
                    </div>
                    <h3 class="db-h3">No recipient signup</h3>
                    <p class="db-text-muted">
                        Share a link â€” that's it. Recipients download directly in their browser with zero friction.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="home-how">
        <h2 class="db-h2 home-how__title">How it works</h2>
        <div class="home-how__steps">
            <div class="home-step">
                <span class="home-step__num">1</span>
                <h3 class="db-h4">Upload your file</h3>
                <p class="db-text-muted">Drag and drop any file up to 5 GB. Encryption happens in your browser.</p>
            </div>
            <div class="home-step">
                <span class="home-step__num">2</span>
                <h3 class="db-h4">Share the link</h3>
                <p class="db-text-muted">Copy the secure link and send it via email, chat, or however you prefer.</p>
            </div>
            <div class="home-step">
                <span class="home-step__num">3</span>
                <h3 class="db-h4">It deletes itself</h3>
                <p class="db-text-muted">File auto-expires. No cleanup needed.</p>
            </div>
        </div>
    </section>

    <section class="home-cta">
        <div class="db-card home-cta__card">
            <div class="db-card__body">
                <h2 class="db-h2">Ready to send?</h2>
                <p class="db-text-muted home-cta__sub">It takes less than 10 seconds. No account needed to start &mdash; sign in for higher limits.</p>
                <a href="/send" class="db-btn db-btn--primary db-btn--lg">Send your first file</a>
            </div>
        </div>
    </section>
</PageWrapper>



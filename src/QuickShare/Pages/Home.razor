@page "/"

<PageTitle>QuickShareCloud â€” send files, not friction</PageTitle>

<PageWrapper Variant="PageVariant.Padded">
    <section class="home-hero">
        <span class="home-tag">Secure &middot; Fast &middot; Temporary</span>
        <h1 class="db-h1">
            Send <span class="home-accent">anything</span>,
            <br>zero friction
        </h1>
        <p class="db-p db-text-muted home-hero__sub">
            Encrypted file sharing with auto-expiry.
            No accounts needed for recipients. Files delete themselves.
        </p>
        <div class="home-hero__actions">
            <a href="/send" class="db-btn db-btn--primary db-btn--lg">Start sending</a>
            <a href="/pricing" class="db-btn db-btn--ghost db-btn--lg">View pricing</a>
        </div>
    </section>

    <section class="home-features">
        <div class="db-grid db-grid--3 db-gap-4">
            <div class="db-card">
                <div class="db-card__body">
                    <div class="home-feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </div>
                    <h3 class="db-h3">End-to-end encrypted</h3>
                    <p class="db-text-muted">
                        Files are encrypted before they leave your device. Only intended recipients can decrypt.
                    </p>
                </div>
            </div>
            <div class="db-card">
                <div class="db-card__body">
                    <div class="home-feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </div>
                    <h3 class="db-h3">Auto-expiring links</h3>
                    <p class="db-text-muted">
                        Set expiration from 1 hour to 30 days. Files are permanently deleted when time runs out.
                    </p>
                </div>
            </div>
            <div class="db-card">
                <div class="db-card__body">
                    <div class="home-feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                        </svg>
                    </div>
                    <h3 class="db-h3">No recipient signup</h3>
                    <p class="db-text-muted">
                        Share a link â€” that's it. Recipients download directly in their browser with zero friction.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="home-how">
        <h2 class="db-h2 home-how__title">How it works</h2>
        <div class="home-how__steps">
            <div class="home-step">
                <span class="home-step__num">1</span>
                <h3 class="db-h4">Upload your file</h3>
                <p class="db-text-muted">Drag and drop any file up to 200 MB. Encryption happens in your browser.</p>
            </div>
            <div class="home-step">
                <span class="home-step__num">2</span>
                <h3 class="db-h4">Share the link</h3>
                <p class="db-text-muted">Copy the secure link and send it via email, chat, or however you prefer.</p>
            </div>
            <div class="home-step">
                <span class="home-step__num">3</span>
                <h3 class="db-h4">It deletes itself</h3>
                <p class="db-text-muted">File auto-expires. No cleanup needed. No lingering copies on our servers.</p>
            </div>
        </div>
    </section>

    <section class="home-cta">
        <div class="db-card home-cta__card">
            <div class="db-card__body">
                <h2 class="db-h2">Ready to send?</h2>
                <p class="db-text-muted home-cta__sub">It takes less than 10 seconds. No account required.</p>
                <a href="/send" class="db-btn db-btn--primary db-btn--lg">Send your first file</a>
            </div>
        </div>
    </section>
</PageWrapper>


@layout MainLayout
@page "/pricing"
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Config

@{
    var isAuthenticated = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true;
    var currency = Config["Pricing:Currency"] ?? "$";
    var proMonthly = FormatPrice(Config.GetValue<int>("Pricing:ProMonthly", 9), currency);
    var proYearly = FormatPrice(Config.GetValue<int>("Pricing:ProYearly", 77), currency);
    var studioMonthly = FormatPrice(Config.GetValue<int>("Pricing:StudioMonthly", 29), currency);
    var studioYearly = FormatPrice(Config.GetValue<int>("Pricing:StudioYearly", 239), currency);
}

<PageTitle>Pricing â€” QuickShareCloud</PageTitle>

<PageWrapper Variant="PageVariant.Padded">

    @* â”€â”€ HERO â”€â”€ *@
    <section class="hero">
        <span class="tag">Simple pricing</span>
        <h1 class="db-h1">Simple, transparent pricing</h1>
        <p class="db-p db-text-muted">Choose the plan that fits your needs. No hidden fees. Cancel anytime.</p>
    </section>

    @* â”€â”€ BILLING TOGGLE + TIER CARDS (client-side toggle, no server round-trip) â”€â”€ *@
    <section id="pricing-body"
             x-data="{ billing: '@(IsYearly ? "yearly" : "monthly")' }"
             x-effect="const u = new URL(window.location); billing === 'yearly' ? u.searchParams.set('billing','yearly') : u.searchParams.delete('billing'); history.replaceState({}, '', u)">
        <div class="toggle-wrap">
            <div class="toggle-group">
                <button type="button"
                        x-on:click="billing = 'monthly'"
                        x-bind:class="billing === 'monthly' ? 'db-btn db-btn--primary' : 'db-btn db-btn--ghost'">
                    Monthly
                </button>
                <button type="button"
                        x-on:click="billing = 'yearly'"
                        x-bind:class="billing === 'yearly' ? 'db-btn db-btn--primary' : 'db-btn db-btn--ghost'">
                    Yearly
                    <span class="tag">Save 20%</span>
                </button>
            </div>
        </div>

        <div class="cards">

            @* Free Plan *@
            <div class="card">
                <div class="card__head">
                    <h3 class="db-h3">Free</h3>
                    <p class="db-text-muted" style="margin-top: 0.5rem">Great for getting started</p>
                </div>
                <div class="card__price">
                    <div class="price-amount">$0</div>
                    <div class="price-period db-text-muted">Forever free</div>
                </div>
                @if (!isAuthenticated)
                {
                    <a href="/login" class="db-btn db-btn--secondary">Get Started</a>
                }
                <div class="features">
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>100 MB</strong> per file</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>2 GB</strong> / month</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>5</strong> transfers/month</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>Files expire after <strong>7 days</strong></span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>End-to-end <strong>encryption</strong></span>
                    </div>
                </div>
            </div>

            @* Pro Plan *@
            <div class="card">
                <div class="card__head">
                    <h3 class="db-h3">Pro</h3>
                    <p class="db-text-muted" style="margin-top: 0.5rem">For creators &amp; professionals</p>
                </div>
                <div class="card__price">
                    <div x-show="billing === 'monthly'" class="pricing-monthly">
                        <div class="price-amount">@proMonthly</div>
                        <div class="price-period db-text-muted">Billed monthly</div>
                    </div>
                    <div x-show="billing === 'yearly'" class="pricing-yearly">
                        <div class="price-amount">@proYearly</div>
                        <div class="price-period db-text-muted">Billed yearly</div>
                    </div>
                </div>
                <a href="@(isAuthenticated ? "/upgrade?plan=pro" : "/login")"
                   x-bind:href="(billing === 'yearly' ? '/upgrade?plan=pro&billing=yearly' : '/upgrade?plan=pro')"
                   class="db-btn db-btn--primary">Start Free Trial</a>
                <div class="features">
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>1 GB</strong> per file</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>50 GB</strong> / month</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>100</strong> transfers/month</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>Password</strong> protection</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>Priority</strong> support</span>
                    </div>
                </div>
            </div>

            @* Studio Plan (Most Popular) *@
            <div class="card card--popular">
                <span class="card__badge">Most Popular</span>
                <div class="card__head">
                    <h3 class="db-h3">Studio</h3>
                    <p class="db-text-muted" style="margin-top: 0.5rem">For teams &amp; enterprises</p>
                </div>
                <div class="card__price">
                    <div x-show="billing === 'monthly'" class="pricing-monthly">
                        <div class="price-amount">@studioMonthly</div>
                        <div class="price-period db-text-muted">Billed monthly</div>
                    </div>
                    <div x-show="billing === 'yearly'" class="pricing-yearly">
                        <div class="price-amount">@studioYearly</div>
                        <div class="price-period db-text-muted">Billed yearly</div>
                    </div>
                </div>
                <a href="@(isAuthenticated ? "/upgrade?plan=studio" : "/login")"
                   x-bind:href="(billing === 'yearly' ? '/upgrade?plan=studio&billing=yearly' : '/upgrade?plan=studio')"
                   class="db-btn db-btn--primary">Start Free Trial</a>
                <div class="features">
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>20 GB</strong> per file</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>500 GB</strong> / month</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>Unlimited</strong> transfers</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>Custom</strong> branding</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>API</strong> access</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>Dedicated</strong> support</span>
                    </div>
                </div>
            </div>

        </div>
    </section>


    @* â”€â”€ FAQ â”€â”€ *@
    <section class="faq">
        <div class="faq__head">
            <h2 class="db-h2">Frequently Asked Questions</h2>
            <p class="db-text-muted" style="margin-top: 0.75rem">Get answers to common questions about our plans</p>
        </div>
        @foreach (var (q, a) in faqs)
        {
            <details>
                <summary>
                    <span>@q</span>
                    <svg class="faq-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                    </svg>
                </summary>
                <div class="faq-answer db-text-muted">@a</div>
            </details>
        }
    </section>

    @* â”€â”€ CTA â”€â”€ *@
    <section class="cta" x-data="{ billing: new URLSearchParams(window.location.search).get('billing') || 'monthly' }">
        <h3 class="cta__title">Ready to get started?</h3>
        <p class="db-text-muted">Start free, no credit card required. Pro and Studio include a 14-day trial.</p>
        <a href="@(isAuthenticated ? "/upgrade" : "/login")"
           x-bind:href="(billing === 'yearly' ? '/upgrade?billing=yearly' : '/upgrade')"
           class="db-btn db-btn--primary">Get Started</a>
    </section>

</PageWrapper>

@code {
    [SupplyParameterFromQuery]
    public string? Billing { get; set; }

    private bool IsYearly => string.Equals(Billing, "yearly", StringComparison.OrdinalIgnoreCase);

    private static string FormatPrice(int amount, string currency)
    {
        return $"{currency}{amount}";
    }

    private static readonly (string Question, string Answer)[] faqs = new[]
    {
        ("What's included in all plans?", "All plans include end-to-end encryption. Password protection, custom branding, and priority support are available on Pro and Studio plans."),
        ("Can I upgrade or downgrade anytime?", "Yes! Change your plan anytime. Upgrades take effect immediately, and downgrades apply at the end of your billing cycle."),
        ("Is there a free trial?", "Absolutely. All paid plans include a 14-day free trial with full access. No credit card required to start."),
        ("What happens to my files if I cancel?", "Your files remain accessible for 7 days after cancellation. Download them anytime during this period."),
        ("Do you offer refunds?", "We offer a full refund within 30 days of purchase if you're not satisfied. After that, you can cancel anytime with no penalties."),
        ("Can I get a custom plan?", "Yes! Contact us at support@quicksharecloud.com for enterprise pricing, team features, and dedicated support options."),
    };
}



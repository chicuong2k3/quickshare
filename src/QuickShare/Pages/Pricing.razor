@layout MainLayout
@page "/pricing"
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using QuickShare.Infrastructure.Caching
@inject AppDbContext Db
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Config

@{
    var isAuthenticated = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true;
    var currentUserPlan = PlanTierLimits.Free;
    if (isAuthenticated)
    {
        var userIdClaim = HttpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.NameIdentifier);
        if (Guid.TryParse(userIdClaim, out var userId))
        {
            currentUserPlan = StaticCache.Instance.GetOrSet(
                $"user:plan:{userId}",
                () => Db.Users
                    .AsNoTracking()
                    .Where(x => x.Id == userId)
                    .Select(x => x.Plan)
                    .FirstOrDefault() ?? PlanTierLimits.Free,
                TimeSpan.FromMinutes(10)
            );
        }
    }
    var currentPlanRank = GetPlanRank(currentUserPlan);

    var currency = Config[PricingKeys.Currency] ?? "$";
    var proMonthly = FormatPrice(Config.GetValue<int>(PricingKeys.ProMonthly, 9), currency);
    var proYearly = FormatPrice(Config.GetValue<int>(PricingKeys.ProYearly, 77), currency);
    var studioMonthly = FormatPrice(Config.GetValue<int>(PricingKeys.StudioMonthly, 29), currency);
    var studioYearly = FormatPrice(Config.GetValue<int>(PricingKeys.StudioYearly, 239), currency);
}

<PageTitle>Pricing â€” QuickShareCloud</PageTitle>

<PageWrapper Variant="PageVariant.Padded">

    @* â”€â”€ HERO â”€â”€ *@
    <section class="hero">
        <span class="tag">Simple pricing</span>
        <h1 class="db-h1">Simple, transparent pricing</h1>
        <p class="db-p db-text-muted">Choose the plan that fits your needs. No hidden fees. Cancel anytime.</p>
    </section>

    @* â”€â”€ BILLING TOGGLE + TIER CARDS (client-side toggle, no server round-trip) â”€â”€ *@
    <section id="pricing-body"
             x-data="{ billing: '@(IsYearly ? BillingPeriods.Yearly : BillingPeriods.Monthly)' }"
             x-effect="const u = new URL(window.location); billing === 'yearly' ? u.searchParams.set('billing','yearly') : u.searchParams.delete('billing'); history.replaceState({}, '', u)">
        <div class="toggle-wrap">
            <div class="toggle-group">
                <button type="button"
                        x-on:click="billing = 'monthly'"
                        x-bind:class="billing === 'monthly' ? 'db-btn db-btn--primary' : 'db-btn db-btn--ghost'">
                    Monthly
                </button>
                <button type="button"
                        x-on:click="billing = 'yearly'"
                        x-bind:class="billing === 'yearly' ? 'db-btn db-btn--primary' : 'db-btn db-btn--ghost'">
                    Yearly
                    <span class="tag">Save 20%</span>
                </button>
            </div>
        </div>

        <div class="cards">

            @* Free Plan *@
            <div class="card">
                <div class="card__head">
                    <h3 class="db-h3">Free</h3>
                    <p class="db-text-muted" style="margin-top: 0.5rem">Great for getting started</p>
                </div>
                <div class="card__price">
                    <div class="price-amount">$0</div>
                    <div class="price-period db-text-muted">Forever free</div>
                </div>
                @if (!isAuthenticated)
                {
                    <a href="/login" class="db-btn db-btn--secondary">Get Started</a>
                }
                <div class="features">
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>5 GB</strong> per file</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>15 GB</strong> / month</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>Files expire after <strong>2 hours</strong></span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>Lossless</strong> quality — no compression</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>End-to-end <strong>encryption</strong></span>
                    </div>
                </div>
            </div>

            @* Pro Plan *@
            <div class="card">
                <div class="card__head">
                    <h3 class="db-h3">Pro</h3>
                    <p class="db-text-muted" style="margin-top: 0.5rem">For creators &amp; professionals</p>
                </div>
                <div class="card__price">
                    <div x-show="billing === 'monthly'" class="pricing-monthly">
                        <div class="price-amount">@proMonthly</div>
                        <div class="price-period db-text-muted">Billed monthly</div>
                    </div>
                    <div x-show="billing === 'yearly'" class="pricing-yearly">
                        <div class="price-amount">@proYearly</div>
                        <div class="price-period db-text-muted">Billed yearly</div>
                    </div>
                </div>
                @if (currentPlanRank < ProPlanRank)
                {
                    <a href="@(isAuthenticated ? RoutePaths.UpgradePro : RoutePaths.Login)"
                       x-bind:href="(billing === 'yearly' ? '/upgrade?plan=pro&billing=yearly' : '/upgrade?plan=pro')"
                       class="db-btn db-btn--primary">Start Free Trial</a>
                }
                <div class="features">
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>20 GB</strong> per file</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>200 GB</strong> / month</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>30-day</strong> expiry</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>Password</strong> protection</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>No ads</strong></span>
                    </div>
                </div>
            </div>

            @* Studio Plan (Most Popular) *@
            <div class="card card--popular">
                <span class="card__badge">Most Popular</span>
                <div class="card__head">
                    <h3 class="db-h3">Studio</h3>
                    <p class="db-text-muted" style="margin-top: 0.5rem">For teams &amp; enterprises</p>
                </div>
                <div class="card__price">
                    <div x-show="billing === 'monthly'" class="pricing-monthly">
                        <div class="price-amount">@studioMonthly</div>
                        <div class="price-period db-text-muted">Billed monthly</div>
                    </div>
                    <div x-show="billing === 'yearly'" class="pricing-yearly">
                        <div class="price-amount">@studioYearly</div>
                        <div class="price-period db-text-muted">Billed yearly</div>
                    </div>
                </div>
                @if (currentPlanRank < StudioPlanRank)
                {
                    <a href="@(isAuthenticated ? RoutePaths.UpgradeStudio : RoutePaths.Login)"
                       x-bind:href="(billing === 'yearly' ? '/upgrade?plan=studio&billing=yearly' : '/upgrade?plan=studio')"
                       class="db-btn db-btn--primary">Start Free Trial</a>
                }
                <div class="features">
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>100 GB</strong> per file</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>2 TB</strong> / month</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>90-day</strong> expiry</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>Custom</strong> branding</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span><strong>API</strong> access</span>
                    </div>
                </div>
            </div>

        </div>
    </section>


    @* â”€â”€ FAQ â”€â”€ *@
    <section class="faq">
        <div class="faq__head">
            <h2 class="db-h2">Frequently Asked Questions</h2>
            <p class="db-text-muted" style="margin-top: 0.75rem">Get answers to common questions about our plans</p>
        </div>
        @foreach (var (q, a) in faqs)
        {
            <details>
                <summary>
                    <span>@q</span>
                    <svg class="faq-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                    </svg>
                </summary>
                <div class="faq-answer db-text-muted">@a</div>
            </details>
        }
    </section>

    @* â”€â”€ CTA â”€â”€ *@
    <section class="cta" x-data="{ billing: new URLSearchParams(window.location.search).get('billing') || 'monthly' }">
        <h3 class="cta__title">Ready to get started?</h3>
        <p class="db-text-muted">Start free, no credit card required. Pro and Studio include a 14-day trial.</p>
        <a href="@(isAuthenticated ? RoutePaths.Upgrade : RoutePaths.Login)"
           x-bind:href="(billing === 'yearly' ? '/upgrade?billing=yearly' : '/upgrade')"
           class="db-btn db-btn--primary">Get Started</a>
    </section>

</PageWrapper>

@code {
    [SupplyParameterFromQuery]
    public string? Billing { get; set; }

    private bool IsYearly => string.Equals(Billing, BillingPeriods.Yearly, StringComparison.OrdinalIgnoreCase);
    private const int FreePlanRank = 0;
    private const int ProPlanRank = 1;
    private const int StudioPlanRank = 2;

    private static int GetPlanRank(string plan)
    {
        return (plan ?? string.Empty).ToLowerInvariant() switch
        {
            PlanTierLimits.Studio => StudioPlanRank,
            PlanTierLimits.Pro => ProPlanRank,
            _ => FreePlanRank
        };
    }


    private static string FormatPrice(int amount, string currency)
    {
        return $"{currency}{amount}";
    }

    private static readonly (string Question, string Answer)[] faqs = new[]
    {
        ("What's the catch with Free tier?", "Free tier is instant delivery — your file stays available for 2 hours. That's enough time for the recipient to download, even large files. After that, it's permanently deleted. This lets us offer huge 5 GB transfers for free. Need longer? Upgrade to Pro."),
        ("Are my files compressed or reduced in quality?", "Never. What you upload is exactly what the recipient downloads — byte for byte. No compression, no re-encoding, no 'storage saver.' Photographers and video editors trust us for this reason."),
        ("How fast are downloads?", "Files transfer directly through Cloudflare's global edge network. No server bottleneck, no throttling. Your recipient's connection speed is the only limit."),
        ("Can I upgrade or downgrade anytime?", "Yes! Change your plan anytime. Upgrades take effect immediately, and downgrades apply at the end of your billing cycle."),
        ("Is there a free trial?", "Absolutely. All paid plans include a 14-day free trial with full access. No credit card required to start."),
        ("Do recipients need an account?", "No. Recipients download files directly in their browser — no account, no app, no signup required. Works on any device."),
        ("What happens to my files if I cancel?", "Your files remain accessible for 7 days after cancellation. Download them anytime during this period."),
        ("Do you offer refunds?", "We offer a full refund within 30 days of purchase if you're not satisfied. After that, you can cancel anytime with no penalties."),
    };
}



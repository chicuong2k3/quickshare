@layout MainLayout
@page "/send"
@inject IConfiguration Config
@inject IHttpContextAccessor HttpContextAccessor

@{
    // API and pages are same-origin now; browser JS uses relative URLs.
    var apiBase = "";
}

<PageTitle>QuickShareCloud â€” send a file in seconds</PageTitle>

<PageWrapper Variant="PageVariant.Fill">
    <script>window.ZAPDROP_CONFIG = { apiBaseUrl: "@apiBase" };</script>
        <div class="container">
            <input type="file" name="file" class="sr-only" aria-label="Choose a file to upload" onchange="uploadPage.onFileInput(event)" />

            @* IDLE / DRAGGING *@
            <section id="upload-idle" class="section">
                <h1 class="h1" id="upload-idle-h1">
                    <span id="upload-idle-text">Send <span class="gradient">anything</span></span>
                    <span id="upload-drag-text" class="hidden">Drop your file</span>
                </h1>
                <p class="sub" id="upload-idle-sub">
                    <span id="upload-idle-subtext">200 MB per file &middot; sign in to unlock higher limits</span>
                    <span id="upload-drag-subtext" class="hidden">Release to start the transfer</span>
                </p>

                <div>
                    <div id="dropzone"
                         ondragover="uploadPage.onDragOver(event)"
                         ondragenter="uploadPage.onDragOver(event)"
                         ondragleave="uploadPage.onDragLeave(event)"
                         ondrop="uploadPage.onDrop(event)"
                         class="dropzone"
                         onclick="uploadPage.triggerFileInput()">
                        <div class="dropzone-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <polyline points="17 8 12 3 7 8" />
                                <line x1="12" y1="3" x2="12" y2="15" />
                            </svg>
                        </div>
                        <div>
                            <p class="dropzone-title" id="dropzone-title">
                                <span id="dropzone-idle">Drag &amp; drop your files here</span>
                                <span id="dropzone-drag" class="hidden">Drop it here</span>
                            </p>
                            <p class="dropzone-sub">
                                <span id="dropzone-sub">or <kbd>Ctrl</kbd>+<kbd>V</kbd> to paste, or click to browse</span>
                            </p>
                        </div>
                    </div>
                </div>

                @* OTP — optional 6-digit security code for downloaders *@
                <div class="encrypt-toggle">
                    <div class="otp-wrap">
                        <span class="otp-label">Security code (optional)</span>
                        <div id="upload-otp" class="db-otp" style="gap: 0.5rem">
                            <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,0)" onkeydown="uploadPage.otpKeydown(event,0)" onchange="uploadPage.readOtp()" autocomplete="off" />
                            <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,1)" onkeydown="uploadPage.otpKeydown(event,1)" onchange="uploadPage.readOtp()" autocomplete="off" />
                            <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,2)" onkeydown="uploadPage.otpKeydown(event,2)" onchange="uploadPage.readOtp()" autocomplete="off" />
                            <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,3)" onkeydown="uploadPage.otpKeydown(event,3)" onchange="uploadPage.readOtp()" autocomplete="off" />
                            <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,4)" onkeydown="uploadPage.otpKeydown(event,4)" onchange="uploadPage.readOtp()" autocomplete="off" />
                            <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,5)" onkeydown="uploadPage.otpKeydown(event,5)" onchange="uploadPage.readOtp()" autocomplete="off" />
                        </div>
                        <span class="otp-hint">If set, recipients must enter this code to download</span>
                    </div>
                </div>

                @* Expiry selector *@
                <div class="expiry-row">
                    <span class="expiry-label">Expires in</span>
                    <div class="expiry-group" role="radiogroup" aria-label="Expiry duration">
                        <button type="button" role="radio" id="upload-expiry-24h"
                                class="expiry-btn expiry-btn--on"
                                onclick="uploadPage.selectExpiry('24h')">24 hours</button>
                        <button type="button" role="radio" id="upload-expiry-7d"
                                class="expiry-btn expiry-btn--off"
                                onclick="uploadPage.selectExpiry('7d')">7 days</button>
                    </div>
                </div>

                <div id="upload-paste-tip" class="hidden ">No image found in clipboard.</div>
            </section>

            @* UPLOADING *@
            <section id="upload-uploading" class="section hidden">
                <div class="db-spinner db-spinner--lg "></div>
                <h1 class="status-h1" id="upload-filename"></h1>
                <p class="status-p" id="upload-progress-label"></p>
                <div id="upload-encrypt-badge" class="badge-encrypt">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16" r="1" />
                    </svg>
                    Encrypted
                </div>
                <div class="progress-wrap">
                    <div class="progress-track">
                        <div id="upload-progress-bar" class="progress-fill" style="width: 0%" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
                <button id="upload-cancel-btn" class="db-btn db-btn--ghost" style="margin-top: 2.5rem" onclick="uploadPage.cancelUpload()">Cancel</button>
            </section>

            @* SUCCESS *@
            <section id="upload-success" class="section hidden">
                <div class="icon-success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                </div>
                <h1 class="status-h1" style="margin-top: 1.5rem">Your file is ready</h1>
                <p class="status-p" id="upload-success-name"></p>

                <div class="share-box">
                    <label for="share-link" class="share-label">Share link</label>
                    <div class="share-row">
                        <input id="share-link" type="text" readonly class="share-input" aria-label="Share link" />
                        <button type="button" aria-label="Copy share link" class="db-btn db-btn--primary" id="upload-copy-btn" onclick="uploadPage.copyLink()">
                            <span id="upload-copy-text">Copy link</span>
                            <span id="upload-copied-text" class="hidden">Copied!</span>
                        </button>
                    </div>
                    <p id="upload-expiry-label" style="margin-top: 0.75rem; font-size: 0.75rem; color: var(--db-color-text-muted)"></p>
                </div>

                <div id="qrcode" style="margin-top: 2rem; display: flex; justify-content: center"></div>

                <div id="upload-success-encrypt-badge" class="badge-encrypt" style="margin-top: 1rem">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16" r="1" />
                    </svg>
                    Encrypted &middot; the key is in the link, not on our servers
                </div>

                <button class="db-btn db-btn--ghost" style="margin-top: 2rem" onclick="uploadPage.reset()">Send another file</button>
            </section>

            @* ERROR *@
            <section id="upload-error" class="section hidden">
                <div class="icon-error">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                </div>
                <h1 class="status-h1">Upload failed</h1>
                <p class="status-p" id="upload-error-msg">An unknown error occurred.</p>
                <div style="margin-top: 2.5rem; display: flex; gap: 0.75rem; justify-content: center">
                    <button id="upload-resume-btn" class="db-btn db-btn--primary hidden" onclick="uploadPage.resumeUpload()">Resume upload</button>
                    <button class="db-btn" onclick="uploadPage.reset()">Start over</button>
                </div>
            </section>
        </div>
</PageWrapper>

<script src="/js/upload.js"></script>



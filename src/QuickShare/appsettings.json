{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": ""
        }
      }
    ],
    "Properties": {
      "Application": "QuickShare"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "QuickShare": {
    "CleanupIntervalMinutes": 60,
    "MaxP2PConnections": 1000
  },
  "R2": {
    "AccountId": "",
    "BucketName": "",
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "MultipartThreshold": 10485760,
    "PresignedUrlExpiry": {
      "UploadPartMinutes": 15,
      "DownloadSeconds": 60
    }
  },
  "PayOS": {
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "WebhookUrl": "",
    "ReturnUrl": "https://localhost:9001/upgrade",
    "CancelUrl": "https://localhost:9001/upgrade"
  },
  "Pricing": {
    "ProMonthly": 50000,
    "ProYearly": 500000,
    "StudioMonthly": 200000,
    "StudioYearly": 2000000,
    "Currency": "VND"
  }
}

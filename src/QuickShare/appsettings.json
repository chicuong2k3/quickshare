{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": ""
        }
      }
    ],
    "Properties": {
      "Application": "QuickShare"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "QuickShare": {
    "CleanupIntervalMinutes": 60,
    "MaxP2PConnections": 1000
  },
  "R2": {
    "AccountId": "",
    "BucketName": "",
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "MultipartThreshold": 10485760,
    "PresignedUrlExpiry": {
      "UploadPartMinutes": 15,
      "DownloadSeconds": 60
    }
  },
  "PayOS": {
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "WebhookUrl": "",
    "ReturnUrl": "https://localhost:9001/upgrade",
    "CancelUrl": "https://localhost:9001/upgrade"
  },
  "Pricing": {
    "ProMonthly": 49000,
    "ProYearly": 490000,
    "StudioMonthly": 199000,
    "StudioYearly": 1990000,
    "Currency": "VND",
    "Limits": {
      "Free": {
        "MaxFileSizeBytes": 5368709120,
        "MaxMonthlyBytes": 16106127360,
        "MaxExpiryHours": 2.0,
        "MaxDownloads": 10,
        "MaxConcurrency": 2
      },
      "Pro": {
        "MaxFileSizeBytes": 21474836480,
        "MaxMonthlyBytes": 214748364800,
        "MaxExpiryDays": 30,
        "MaxDownloads": 100,
        "MaxConcurrency": 5
      },
      "Studio": {
        "MaxFileSizeBytes": 107374182400,
        "MaxMonthlyBytes": 2199023255552,
        "MaxExpiryDays": 90,
        "MaxDownloads": null,
        "MaxConcurrency": 10
      }
    }
  }
}

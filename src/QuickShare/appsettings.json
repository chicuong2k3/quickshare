{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "service", "value": "quickshare" },
            { "key": "env", "value": "production" }
          ]
        }
      }
    ],
    "Properties": {
      "Application": "QuickShare"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "QuickShare": {
    "CleanupIntervalMinutes": 60,
    "MaxP2PConnections": 1000
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": "QuickShare",
    "BaseUrl": "https://localhost:9001",
    "DigestIntervalMinutes": 15
  },
  "R2": {
    "AccountId": "",
    "BucketName": "",
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "PublicBaseUrl": "",
    "MultipartThreshold": 10485760,
    "PresignedUrlExpiry": {
      "UploadPartMinutes": 15,
      "DownloadSeconds": 60
    }
  },
  "PayOS": {
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "WebhookUrl": "",
    "ReturnUrl": "https://localhost:9001/payments/payos/return",
    "CancelUrl": "https://localhost:9001/payments/payos/return"
  },
  "Pricing": {
    "ProMonthly": 49000,
    "ProYearly": 490000,
    "StudioMonthly": 199000,
    "StudioYearly": 1990000,
    "Currency": "VND",
    "Limits": {
      "Free": {
        "MaxFileSizeBytes": 5368709120,
        "MaxMonthlyBytes": 16106127360,
        "MaxExpiryHours": 24.0,
        "MaxDownloads": 10,
        "MaxConcurrency": 2
      },
      "Pro": {
        "MaxFileSizeBytes": 21474836480,
        "MaxMonthlyBytes": 214748364800,
        "MaxExpiryDays": 30,
        "MaxDownloads": 100,
        "MaxConcurrency": 5
      },
      "Studio": {
        "MaxFileSizeBytes": 107374182400,
        "MaxMonthlyBytes": 2199023255552,
        "MaxExpiryDays": 90,
        "MaxDownloads": null,
        "MaxConcurrency": 10
      }
    }
  }
  ,
  "FusionCache": {
    "Enabled": true,
    "DefaultDurationMinutes": 5,
    "FailSafeMaxDurationHours": 2,
    "FailSafeThrottleDurationSeconds": 30,
    "PlanTierLimitsDurationHours": 1
  },
  "FeatureFlags": {
    "Enabled": true,
    "Flags": {
      "previews": {
        "Enabled": false,
        "RolloutPercent": 100,
        "Description": "Feature previews (issue #21)"
      },
      "zero-knowledge": {
        "Enabled": false,
        "RolloutPercent": 100,
        "Description": "Zero-knowledge encryption (issue #26)"
      },
      "password-protection": {
        "Enabled": true,
        "RolloutPercent": 100,
        "Description": "Password-protected shares (issue #44)"
      },
      "virus-scan": {
        "Enabled": false,
        "RolloutPercent": 100,
        "Description": "Virus scanning (issue #48)"
      }
    }
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4318"
  },
  "Analytics": {
    "Enabled": true
  },
  "Admin": {
    "Emails": [ "nguyenchicuongk21@gmail.com" ]
  }
}

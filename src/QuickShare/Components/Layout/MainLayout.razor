@inherits LayoutComponentBase
@inject IHttpContextAccessor HttpContextAccessor
@using System.Security.Claims
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

@{
    var isAuthenticated = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true;
    var userName = HttpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.Name);
    var userEmail = HttpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.Email);
    var path = HttpContextAccessor.HttpContext?.Request.Path.Value ?? string.Empty;
}

<div class="layout-root">
    <nav class="db-navbar">
        <a class="db-navbar__brand" href="/">
            <span class="layout-logo" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="17 8 12 3 7 8" />
                    <line x1="12" y1="3" x2="12" y2="15" />
                </svg>
            </span>
            <span class="layout-brand-word">QuickShare<span class="layout-brand-cloud">Cloud</span></span>
        </a>
        <div class="db-navbar__nav">
            <div class="db-nav-menu">
                <a class="db-nav-menu__item @NavActive(path == RoutePaths.Send)" href="/send">@Loc["nav_send"]</a>
                <a class="db-nav-menu__item @NavActive(path.StartsWith(RoutePaths.P2p))" href="/p2p/send">P2P</a>
                <a class="db-nav-menu__item @NavActive(path == RoutePaths.Pricing)" href="/pricing">@Loc["nav_pricing"]</a>
            </div>
        </div>
        <div class="db-navbar__spacer"></div>
        <div class="db-navbar__actions">
            <LanguageSwitch />
            @if (isAuthenticated)
            {
                <div class="db-dropdown">
                    <button class="db-avatar db-avatar--sm db-dropdown__trigger layout-avatar-btn"
                            hx-get="/api/me/avatar"
                            hx-trigger="load once, profileUpdated from:body"
                            hx-swap="innerHTML"
                            data-avatar-menu-trigger="true"
                            type="button" aria-label="User menu">
                        <span class="layout-avatar-skeleton"></span>
                    </button>
                    <div class="db-dropdown__content layout-avatar-dropdown" data-avatar-menu-content="true">
                        <div class="layout-user-info">
                            <span class="layout-user-info__name">@userName</span>
                            <span class="layout-user-info__email">@userEmail</span>
                        </div>
                        <div class="db-dropdown__separator"></div>
                        <a href="/account" class="db-dropdown__item">@Loc["nav_account"]</a>
                        <a href="/logout" hx-boost="false" class="db-dropdown__item">@Loc["nav_logout"]</a>
                    </div>
                </div>
            }
            else
            {
                <a href="/login" class="db-btn db-btn--primary db-btn--sm">@Loc["nav_login"]</a>
            }
        </div>
        <button class="db-navbar__toggle" aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>
    </nav>

    @* Cookie consent banner *@
    <CookieConsent />

    @Body

    <footer class="layout-footer">
        <div class="layout-footer__inner">
            <span class="layout-footer__mark">QuickShareCloud</span>
            <span class="layout-footer__sep" aria-hidden="true">&middot;</span>
            <span class="layout-footer__note">send files, not friction</span>
        </div>
    </footer>
</div>

@code {
    private static string NavActive(bool isActive) =>
        isActive ? "db-nav-menu__item--active" : string.Empty;
}
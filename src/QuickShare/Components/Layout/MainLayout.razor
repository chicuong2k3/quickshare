@inherits LayoutComponentBase
@inject IHttpContextAccessor HttpContextAccessor
@using System.Globalization
@using System.Security.Claims
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@inject IStringLocalizer<QuickShare.SharedLoc> Loc
@inject IOptions<QuickShare.Infrastructure.QuickShareOptions> Options
@inject AppDbContext Db

@{
    var isAuthenticated = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true;
    var userName = HttpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.Name);
    var userEmail = HttpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.Email);
    var path = HttpContextAccessor.HttpContext?.Request.Path.Value ?? string.Empty;
}

<div class="layout-root">
    @{
        var announcement = Options.Value.Announcement;
        var announcementText = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" && !string.IsNullOrEmpty(announcement.TextVi)
            ? announcement.TextVi
            : announcement.TextEn;
    }
    @if (!string.IsNullOrEmpty(announcement.Id) && !string.IsNullOrEmpty(announcementText))
    {
        @* Site-wide announcement (issue #282) — server-rendered, dismiss persists in localStorage by Id. *@
        <div id="site-announcement" class="site-announcement site-announcement--@announcement.Level"
             role="status" data-announcement-id="@announcement.Id">
            <span>@announcementText</span>
            @if (!string.IsNullOrEmpty(announcement.Url))
            {
                <a href="@announcement.Url">@Loc["announcement_more"]</a>
            }
            <button type="button" class="site-announcement__dismiss" aria-label="@Loc["announcement_dismiss"]"
                    onclick="var b=document.getElementById('site-announcement');localStorage.setItem('qs-announce-'+b.dataset.announcementId,'1');b.remove()">×</button>
        </div>
        <script>
            (function () {
                var b = document.getElementById('site-announcement');
                if (b && localStorage.getItem('qs-announce-' + b.dataset.announcementId)) b.remove();
            })();
        </script>
    }
    @* Bypass blocks (WCAG 2.4.1, issue #95). Without it a keyboard or screen-reader user tabs
       the whole navbar again on every page — which is most of the reason people stop using
       keyboard navigation on a site at all. *@
    <a class="skip-link" href="#main-content">@Loc["a11y_skip_to_content"]</a>

    <nav class="db-navbar">
        <a class="db-navbar__brand" href="/">
            @* Mark: one crease cell folded — mountain solid, valley open. *@
            <span class="layout-logo" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round">
                    <path d="M2 8 L10 4 L22 9 L14 13 Z" />
                    <path d="M2 8 L10 12 L22 9" />
                    <path d="M10 4 L10 12" stroke-dasharray="2 2" />
                    <path d="M2 8 L6 18 L14 21 L14 13" />
                </svg>
            </span>
            <span class="layout-brand-stack">
                <span class="layout-brand-word">QuickShare<span class="layout-brand-cloud">Cloud</span></span>
                <span class="layout-brand-path miura-spec">@CurrentSpec(path)</span>
            </span>
        </a>
        <div class="db-navbar__nav">
            <div class="db-nav-menu">
                <a class="db-nav-menu__item @NavActive(path == RoutePaths.Home || string.IsNullOrEmpty(path))" href="/">@Loc["nav_home"]</a>
                <a class="db-nav-menu__item @NavActive(path == RoutePaths.Send)" href="/send">@Loc["nav_send"]</a>
                <a class="db-nav-menu__item @NavActive(path.StartsWith(RoutePaths.P2p))" href="/p2p/send">P2P</a>
                <a class="db-nav-menu__item @NavActive(path == RoutePaths.Pricing)" href="/pricing">@Loc["nav_pricing"]</a>
            </div>
        </div>
        <div class="db-navbar__spacer"></div>
        <div class="db-navbar__actions">
            <button type="button" class="db-btn db-btn--ghost db-btn--sm layout-command-trigger" onclick="openCommandPalette()" aria-label="@Loc["command_palette_trigger"]" title="@Loc["command_palette_trigger"]" data-ai-action="commandPalette.open">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <span class="layout-command-kbd" aria-hidden="true">⌘K</span>
            </button>
            @* Voice commands (#277) — drives the palette below; hidden by voice.js where the
               browser cannot listen, so it is never a dead button. *@
            <button type="button" id="voice-trigger" class="db-btn db-btn--ghost db-btn--sm layout-voice-trigger"
                    onclick="window.quickShareVoice.start()" aria-label="@Loc["voice_trigger"]"
                    title="@Loc["voice_trigger"]" data-ai-action="voice.start">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg>
            </button>
            <button type="button" class="db-btn db-btn--ghost db-btn--sm layout-theme-toggle" onclick="toggleTheme()" aria-label="@Loc["theme_toggle"]" title="@Loc["theme_toggle"]" data-ai-action="theme.toggle">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
            </button>
            <LanguageSwitch />
            @if (isAuthenticated)
            {
                <a href="@RoutePaths.AccountNotificationCenter" class="db-btn db-btn--ghost db-btn--sm layout-bell"
                   aria-label="@Loc["nav_notifications"]" title="@Loc["nav_notifications"]" data-ai-action="notifications.open">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    @if (unreadCount > 0)
                    {
                        <span class="layout-bell__badge" aria-label="@string.Format(Loc["notifications_badge_aria"], unreadCount)">@BadgeLabel(unreadCount)</span>
                    }
                </a>
                <div class="db-dropdown">
                    <button class="db-avatar db-avatar--sm db-dropdown__trigger layout-avatar-btn"
                            hx-get="/api/me/avatar"
                            hx-trigger="load once, profileUpdated from:body"
                            hx-swap="innerHTML"
                            type="button" aria-label="@Loc["a11y_user_menu"]">
                        <span class="layout-avatar-skeleton"></span>
                    </button>
                    <div class="db-dropdown__content layout-avatar-dropdown">
                        <div class="layout-user-info">
                            <span class="layout-user-info__name">@userName</span>
                            <span class="layout-user-info__email">@userEmail</span>
                        </div>
                        <div class="db-dropdown__separator"></div>
                        <a href="/account" class="db-dropdown__item">@Loc["nav_account"]</a>
                        <a href="@RoutePaths.AccountBilling" class="db-dropdown__item">@Loc["billing_h1"]</a>
                        <a href="/logout" hx-boost="false" class="db-dropdown__item">@Loc["nav_logout"]</a>
                    </div>
                </div>
            }
            else
            {
                <a href="/login" class="db-btn db-btn--primary db-btn--sm">@Loc["nav_login"]</a>
            }
        </div>
        <button class="db-navbar__toggle" aria-label="@Loc["a11y_menu"]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>
    </nav>

    @* What voice heard and what it is about to do (#277). A live region, because the whole
       point is that a hands-free user is told before anything happens. *@
    <p id="voice-status" class="voice-status" role="status" aria-live="polite" hidden></p>
    <script id="voice-i18n" type="application/json">@RawJson(VoiceStrings())</script>

    @* Command palette (issue #153) — Ctrl+K / Cmd+K opens; type to filter, arrows + Enter to pick. *@
    <div id="command-palette" class="command-palette" hidden role="dialog" aria-modal="true" aria-label="@Loc["command_palette_trigger"]">
        <div class="command-palette__backdrop" onclick="closeCommandPalette()"></div>
        <div class="command-palette__panel">
            <input id="command-palette-input" type="text" class="command-palette__input"
                   placeholder="@Loc["command_palette_placeholder"]" autocomplete="off"
                   aria-label="@Loc["command_palette_placeholder"]" />
            <ul id="command-palette-list" class="command-palette__list">
                <li><a href="@RoutePaths.Send" data-keywords="send upload file">@Loc["nav_send"]</a></li>
                <li><a href="@RoutePaths.P2pSend" data-keywords="p2p peer webrtc browser">@Loc["nav_p2p"]</a></li>
                <li><a href="@RoutePaths.AccountDeliveries" data-keywords="files deliveries list">@Loc["nav_files"]</a></li>
                <li><a href="@RoutePaths.Account" data-keywords="account settings profile">@Loc["nav_account"]</a></li>
                <li><a href="@RoutePaths.AccountBilling" data-keywords="billing plan payment">@Loc["billing_h1"]</a></li>
                <li><a href="@RoutePaths.Pricing" data-keywords="pricing plans upgrade">@Loc["nav_pricing"]</a></li>
                <li><a href="@RoutePaths.Help" data-keywords="help support docs faq">@Loc["nav_help"]</a></li>
                <li><a href="@RoutePaths.Status" data-keywords="status uptime">@Loc["footer_status"]</a></li>
            </ul>
            <p id="command-palette-empty" class="command-palette__empty" hidden>@Loc["command_palette_empty"]</p>
        </div>
    </div>
    @* Cookie consent banner *@
    <CookieConsent />

    @* A real landmark, so “jump to main” works in every screen reader and the skip link has
       somewhere to land. *@
    <main id="main-content" tabindex="-1">
        @Body
    </main>

    <footer class="layout-footer">
        <div class="layout-footer__inner">
            <div class="layout-footer__head">
                <span class="layout-footer__mark">QuickShareCloud</span>
                <span class="miura-rule layout-footer__rule"><span class="miura-spec">SEND FILES, NOT FRICTION</span></span>
            </div>
            @* Crawlable links — orphan landing pages do not get indexed. *@
            <nav class="layout-footer__links" aria-label="@Loc["nav_tools_footer_label"]">
                <a href="@RoutePaths.ToolsOnlineClipboard">@Loc["nav_tools_clipboard"]</a>
                <a href="@RoutePaths.ToolsShareText">@Loc["nav_tools_sharetext"]</a>
                <a href="@RoutePaths.ToolsSendImagesUncompressed">@Loc["nav_tools_images"]</a>
                <a href="@RoutePaths.SeoSendLargeFilesFree">@Loc["nav_seo_send_large"]</a>
                <a href="@RoutePaths.SeoWeTransferAlternatives">@Loc["nav_seo_wt_alt"]</a>
                <a href="@RoutePaths.SeoP2pFileTransfer">@Loc["nav_seo_p2p"]</a>
            </nav>
            <nav class="layout-footer__links" aria-label="@Loc["a11y_legal_links"]">
                <a href="@RoutePaths.Terms">@Loc["footer_terms"]</a>
                <a href="@RoutePaths.Privacy">@Loc["footer_privacy"]</a>
                <a href="@RoutePaths.Abuse">@Loc["footer_abuse"]</a>
                <a href="@RoutePaths.Status">@Loc["footer_status"]</a>
            </nav>
        </div>
    </footer>
</div>

<script>
    window.toggleTheme = function () {
        var scheme = localStorage.getItem('db-scheme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        localStorage.setItem('db-scheme', scheme === 'dark' ? 'light' : 'dark');
        window.location.reload();
    };

    // Command palette (#153): Ctrl+K / Cmd+K opens, Esc closes, arrows + Enter pick.
    window.openCommandPalette = function () {
        var pal = document.getElementById('command-palette');
        if (!pal) return;
        pal.hidden = false;
        var input = document.getElementById('command-palette-input');
        if (input) { input.value = ''; filterCommandPalette(''); setTimeout(function () { input.focus(); }, 0); }
        commandHighlight(0);
    };
    window.closeCommandPalette = function () {
        var pal = document.getElementById('command-palette');
        if (pal) pal.hidden = true;
    };
    window.filterCommandPalette = function (q) {
        var items = document.querySelectorAll('#command-palette-list li');
        var empty = document.getElementById('command-palette-empty');
        var visible = 0;
        q = (q || '').toLowerCase().trim();
        items.forEach(function (li) {
            var link = li.querySelector('a');
            var text = (link.textContent + ' ' + (link.getAttribute('data-keywords') || '')).toLowerCase();
            var show = !q || text.indexOf(q) !== -1;
            li.hidden = !show;
            if (show) visible++;
        });
        if (empty) empty.hidden = visible !== 0;
    };
    window.commandHighlight = function (idx) {
        var items = Array.prototype.filter.call(document.querySelectorAll('#command-palette-list li'), function (li) { return !li.hidden; });
        if (items.length === 0) return;
        if (idx < 0) idx = items.length - 1;
        if (idx >= items.length) idx = 0;
        items.forEach(function (li, i) { li.classList.toggle('command-palette__item--active', i === idx); });
        items[idx].scrollIntoView({ block: 'nearest' });
        document.querySelector('#command-palette-list').dataset.active = idx;
    };
    window.commandActiveIndex = function () {
        return parseInt(document.querySelector('#command-palette-list').dataset.active || '0', 10);
    };
    window.commandActivate = function () {
        var items = Array.prototype.filter.call(document.querySelectorAll('#command-palette-list li'), function (li) { return !li.hidden; });
        var idx = window.commandActiveIndex();
        var link = items[idx] && items[idx].querySelector('a');
        if (link) window.location.href = link.getAttribute('href');
    };
    document.addEventListener('keydown', function (e) {
        var pal = document.getElementById('command-palette');
        if (!pal) return;
        var open = !pal.hidden;
        if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
            e.preventDefault();
            open ? window.closeCommandPalette() : window.openCommandPalette();
            return;
        }
        if (!open) return;
        if (e.key === 'Escape') { e.preventDefault(); window.closeCommandPalette(); }
        else if (e.key === 'ArrowDown') { e.preventDefault(); window.commandHighlight(window.commandActiveIndex() + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); window.commandHighlight(window.commandActiveIndex() - 1); }
        else if (e.key === 'Enter') { e.preventDefault(); window.commandActivate(); }
    });
    document.addEventListener('input', function (e) {
        if (e.target && e.target.id === 'command-palette-input') {
            window.filterCommandPalette(e.target.value);
            window.commandHighlight(0);
        }
    });
</script>

@code {
    /// <summary>
    /// Strings the voice layer needs (#277). Passed as JSON rather than hardcoded in the script,
    /// because a spoken interface that answers in the wrong language is worse than none.
    /// </summary>
    private string VoiceStrings() => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["listening"] = Loc["voice_listening"],
        ["heard"] = Loc["voice_heard"],
        ["noMatch"] = Loc["voice_no_match"],
        ["running"] = Loc["voice_running"],
        ["cancelled"] = Loc["voice_cancelled"],
        ["unsupported"] = Loc["voice_unsupported"],
        ["denied"] = Loc["voice_denied"],
    });

    private static MarkupString RawJson(string json) => new(json);

    private const string RootSpec = "INDEX";

    private int unreadCount;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated != true)
            return;

        try
        {
            var user = await HttpContextAccessor.HttpContext.User.GetUserAsync(Db, CancellationToken.None);
            unreadCount = await Db.Notifications.CountAsync(n => n.UserId == user.Id && !n.IsRead);
        }
        catch
        {
            // A notification count must never break the shell render.
            unreadCount = 0;
        }
    }

    private static string BadgeLabel(int count) => count > 99 ? "99+" : count.ToString(CultureInfo.InvariantCulture);

    private static string NavActive(bool isActive) =>
        isActive ? "db-nav-menu__item--active" : string.Empty;

    // The nav's mono tag is wayfinding, not decoration: it names where the
    // visitor actually is, which the old chrome never showed.
    private static string CurrentSpec(string path) =>
        string.IsNullOrEmpty(path) || path == "/"
            ? RootSpec
            : path.Trim('/').ToUpperInvariant();
}
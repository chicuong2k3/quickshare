@layout MainLayout
@page "/account/workspace/domain"
@attribute [Authorize]
@using QuickShare.Components.Shared
@using QuickShare.Features.Workspaces.Audit
@using QuickShare.Features.Workspaces.Domains
@using QuickShare.Features.Workspaces.Shared
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject WorkspaceService Workspaces
@inject DomainVerifier Verifier
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["domain_title"]</PageTitle>

@* Workspace configuration — never index (issue #121). *@
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<PageWrapper Variant="PageVariant.Padded">

    <section class="hero">
        <h1 class="text-3xl font-bold tracking-tight">@Loc["domain_title"]</h1>
        <p class="text-muted-foreground">@Loc["domain_subtitle"]</p>
    </section>

    <WorkspaceTabs Current="@RoutePaths.AccountWorkspaceDomain" />

    @Chunk

</PageWrapper>

<script src="/js/domain.js" defer></script>

@code {
    private bool isAdmin;
    private WorkspaceDomain? domain;

    private RenderFragment Chunk => @<section id="workspace-domain-body" data-unpoly-reload>
        @if (!isAdmin)
        {
            <Card class="account-card workspace-card">
                <CardContent>
                    <p>@Loc["ws_admin_only"]</p>
                </CardContent>
            </Card>
        }
        else
        {
            <Card class="account-card workspace-card">
                <CardContent>
                    <h2 class="text-xl font-semibold">@Loc["domain_config_title"]</h2>
                    <p class="text-muted-foreground workspace-hint">@Loc["domain_config_hint"]</p>

                    <div class="workspace-form">
                        <label class="workspace-label" for="domain-host">@Loc["domain_host"]</label>
                        <Input id="domain-host"  type="text" autocomplete="off" spellcheck="false"
                               maxlength="@WorkspaceDomain.HostMaxLength"
                               value="@(domain?.Host ?? string.Empty)"
                               placeholder="files.example.com" />
                        <p class="text-muted-foreground workspace-hint">@Loc["domain_host_hint"]</p>

                        <dl class="workspace-stats">
                            <div class="workspace-stat">
                                <dt>@Loc["domain_cname_target"]</dt>
                                <dd>@Verifier.CanonicalHost</dd>
                            </div>
                        </dl>

                        <button type="button" data-slot="button" data-variant="default"
                                data-saved-label="@Loc["domain_saved"]"
                                onclick="window.quickShareDomain.save(this)"
                                data-ai-action="domain.save">@Loc["domain_save"]</button>

                        @if (domain is not null)
                        {
                            <button type="button" data-slot="button" data-variant="ghost"
                                    onclick="window.quickShareDomain.verify(this)"
                                    data-ai-action="domain.verify">@Loc["domain_verify"]</button>

                            <button type="button" data-slot="button" data-variant="ghost"
                                    data-confirm="@Loc["domain_remove_confirm"]"
                                    onclick="window.quickShareDomain.remove(this)"
                                    data-ai-action="domain.remove">@Loc["domain_remove"]</button>
                        }
                    </div>
                </CardContent>
            </Card>

            @if (domain is not null)
            {
                <Card class="account-card workspace-card">
                    <CardContent>
                        <h2 class="text-xl font-semibold">@Loc["domain_status_title"]</h2>

                        <p class="@(domain.IsVerified ? string.Empty : "workspace-notice")">
                            @(domain.IsVerified ? Loc["domain_verified"] : Loc["domain_unverified"])
                        </p>

                        <dl class="workspace-stats">
                            <div class="workspace-stat">
                                <dt>@Loc["domain_last_checked"]</dt>
                                <dd>@(domain.LastCheckedAt is { } at ? at.ToLocalTime().ToString("g") : "—")</dd>
                            </div>
                            <div class="workspace-stat">
                                <dt>@Loc["domain_token"]</dt>
                                <dd>@domain.VerificationToken</dd>
                            </div>
                        </dl>

                        <p class="text-muted-foreground workspace-hint">@Loc["domain_token_hint"]</p>

                        @if (!string.IsNullOrEmpty(domain.LastError))
                        {
                            <p class="text-muted-foreground workspace-hint">@Loc["domain_last_error", domain.LastError]</p>
                        }
                    </CardContent>
                </Card>
            }
        }
    </section>;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        var seat = await WorkspaceAuditReader.ResolveAdminSeatAsync(Workspaces, Db, ctx, CancellationToken.None);
        if (seat is null) return;

        isAdmin = true;
        domain = await Db.WorkspaceDomains
            .AsNoTracking()
            .FirstOrDefaultAsync(d => d.WorkspaceId == seat.WorkspaceId, CancellationToken.None);
    }
}

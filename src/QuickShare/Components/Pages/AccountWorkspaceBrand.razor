@layout MainLayout
@page "/account/workspace/brand"
@attribute [Authorize]
@using QuickShare.Components.Shared
@using QuickShare.Features.Workspaces.Audit
@using QuickShare.Features.Workspaces.Branding
@using QuickShare.Features.Workspaces.Shared
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject WorkspaceService Workspaces
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["brand_title"]</PageTitle>

@* Workspace settings — never index (issue #121). *@
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<PageWrapper Variant="PageVariant.Padded">

    <section class="hero">
        <h1 class="text-3xl font-bold tracking-tight">@Loc["brand_title"]</h1>
        <p class="text-muted-foreground">@Loc["brand_subtitle"]</p>
    </section>

    <WorkspaceTabs Current="@RoutePaths.AccountWorkspaceBrand" />

    @Chunk

</PageWrapper>

<script src="/js/brand.js" defer></script>

@code {
    private bool isAdmin;
    private WorkspaceBrand? brand;

    private RenderFragment Chunk => @<section id="workspace-brand-body" data-unpoly-reload>
        @if (!isAdmin)
        {
            <Card class="account-card workspace-card">
                <CardContent>
                    <p>@Loc["ws_admin_only"]</p>
                </CardContent>
            </Card>
        }
        else
        {
            <Card class="account-card workspace-card">
                <CardContent>
                    <h2 class="text-xl font-semibold">@Loc["brand_appearance_title"]</h2>
                    <p class="text-muted-foreground workspace-hint">@Loc["brand_scope_note"]</p>

                    <div class="workspace-form">
                        <label class="workspace-checkbox">
                            <input id="brand-enabled" type="checkbox" checked="@(brand?.Enabled ?? false)" />
                            <span>@Loc["brand_enabled"]</span>
                        </label>

                        <label class="workspace-label" for="brand-accent">@Loc["brand_accent"]</label>
                        <Input id="brand-accent"  type="text" placeholder="#c8a24a"
                               maxlength="@WorkspaceBrand.ColorMaxLength" value="@brand?.AccentColor" />

                        <label class="workspace-label" for="brand-accent-text">@Loc["brand_accent_text"]</label>
                        <Input id="brand-accent-text"  type="text" placeholder="#101010"
                               maxlength="@WorkspaceBrand.ColorMaxLength" value="@brand?.AccentTextColor" />
                        <p class="text-muted-foreground workspace-hint">@Loc["brand_contrast_note"]</p>

                        <label class="workspace-label" for="brand-header">@Loc["brand_header"]</label>
                        <Input id="brand-header"  type="text"
                               maxlength="@WorkspaceBrand.HeaderMaxLength" value="@brand?.HeaderText" />

                        <label class="workspace-label" for="brand-footer">@Loc["brand_footer"]</label>
                        <Input id="brand-footer"  type="text"
                               maxlength="@WorkspaceBrand.FooterMaxLength" value="@brand?.FooterText" />

                        <label class="workspace-checkbox">
                            <input id="brand-hide-qs" type="checkbox" checked="@(brand?.HideQuickShareBranding ?? false)" />
                            <span>@Loc["brand_hide_qs"]</span>
                        </label>

                        <button type="button" data-slot="button" data-variant="default"
                                data-saved-label="@Loc["brand_saved"]"
                                onclick="window.quickShareBrand.save(this)"
                                data-ai-action="brand.save">@Loc["brand_save"]</button>
                    </div>
                </CardContent>
            </Card>

            @* Logo (issue #285). *@
            <Card class="account-card workspace-card">
                <CardContent>
                    <h2 class="text-xl font-semibold">@Loc["brand_logo_title"]</h2>
                    <p class="text-muted-foreground workspace-hint">@Loc["brand_logo_hint"]</p>

                    @if (brand?.LogoKey is not null)
                    {
                        <img class="dl-brand__logo" alt=""
                             src="@BrandReader.AssetUrl(brand.WorkspaceId, BrandAssetKind.Logo)" />
                    }

                    <div class="workspace-form">
                        <Input id="brand-logo-file"  type="file"
                               accept="image/png,image/jpeg,image/webp" />
                        <button type="button" data-slot="button" data-variant="default"
                                data-kind="@BrandAssetKind.Logo"
                                data-input="brand-logo-file"
                                onclick="window.quickShareBrand.upload(this)"
                                data-ai-action="brand.logo.upload">@Loc["brand_upload"]</button>

                        @if (brand?.LogoKey is not null)
                        {
                            <button type="button" data-slot="button" data-variant="ghost"
                                    data-kind="@BrandAssetKind.Logo"
                                    onclick="window.quickShareBrand.removeAsset(this)"
                                    data-ai-action="brand.logo.remove">@Loc["brand_remove"]</button>
                        }
                    </div>
                </CardContent>
            </Card>

            @* Typography (issue #286). *@
            <Card class="account-card workspace-card">
                <CardContent>
                    <h2 class="text-xl font-semibold">@Loc["brand_fonts_title"]</h2>
                    <p class="text-muted-foreground workspace-hint">@Loc["brand_fonts_hint"]</p>

                    <div class="workspace-form">
                        <label class="workspace-label" for="brand-heading-name">@Loc["brand_heading_font"]</label>
                        <Input id="brand-heading-name"  type="text"
                               maxlength="@WorkspaceBrand.FontNameMaxLength" value="@brand?.HeadingFontName" />
                        <Input id="brand-heading-file"  type="file" accept="font/woff2,.woff2" />
                        <button type="button" data-slot="button" data-variant="ghost"
                                data-kind="@BrandAssetKind.HeadingFont"
                                data-input="brand-heading-file"
                                onclick="window.quickShareBrand.upload(this)"
                                data-ai-action="brand.font.heading">@Loc["brand_upload"]</button>

                        <label class="workspace-label" for="brand-body-name">@Loc["brand_body_font"]</label>
                        <Input id="brand-body-name"  type="text"
                               maxlength="@WorkspaceBrand.FontNameMaxLength" value="@brand?.BodyFontName" />
                        <Input id="brand-body-file"  type="file" accept="font/woff2,.woff2" />
                        <button type="button" data-slot="button" data-variant="ghost"
                                data-kind="@BrandAssetKind.BodyFont"
                                data-input="brand-body-file"
                                onclick="window.quickShareBrand.upload(this)"
                                data-ai-action="brand.font.body">@Loc["brand_upload"]</button>

                        <label class="workspace-label" for="brand-license">@Loc["brand_license"]</label>
                        <Input id="brand-license"  type="text"
                               maxlength="@WorkspaceBrand.LicenseNoteMaxLength" value="@brand?.FontLicenseNote" />
                        <p class="text-muted-foreground workspace-hint">@Loc["brand_license_note"]</p>
                    </div>
                </CardContent>
            </Card>

            @* Preview: the same CSS the recipient page emits, scoped to this card. *@
            @if (Preview is { } preview)
            {
                <Card class="account-card workspace-card">
                    <CardContent>
                        <h2 class="text-xl font-semibold">@Loc["brand_preview_title"]</h2>
                        <style>@PreviewCss(preview)</style>
                        <div class="brand-preview">
                            @if (preview.HasLogo)
                            {
                                <img class="dl-brand__logo" alt=""
                                     src="@BrandReader.AssetUrl(preview.WorkspaceId, BrandAssetKind.Logo)" />
                            }
                            @if (preview.HeaderText is { } header)
                            {
                                <p class="dl-brand__header">@header</p>
                            }
                            <p class="brand-preview__heading text-xl font-semibold">@Loc["brand_preview_heading"]</p>
                            <p class="brand-preview__body">@Loc["brand_preview_body"]</p>
                            <span class="brand-preview__chip">@Loc["brand_preview_chip"]</span>
                            @if (preview.FooterText is { } footer)
                            {
                                <p class="dl-brand__footer">@footer</p>
                            }
                        </div>
                    </CardContent>
                </Card>
            }
        }
    </section>;

    /// <summary>
    /// The stored brand as the recipient page would see it. Built from the saved row rather
    /// than the form, so the preview shows what a client would actually get — a preview of
    /// unsaved input would be a different, more flattering thing.
    /// </summary>
    private BrandView? Preview => brand is null || !brand.IsApplicable
        ? null
        : new BrandView(
            brand.WorkspaceId,
            brand.LogoKey is not null,
            brand.AccentColor,
            brand.AccentTextColor,
            brand.HeaderText,
            brand.FooterText,
            brand.HideQuickShareBranding,
            brand.HeadingFontName,
            brand.BodyFontName,
            brand.HeadingFontKey is not null,
            brand.BodyFontKey is not null);

    private static MarkupString PreviewCss(BrandView view) => new(BrandReader.ToCss(view));

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        var seat = await WorkspaceAuditReader.ResolveAdminSeatAsync(Workspaces, Db, ctx, CancellationToken.None);
        if (seat is null) return;

        isAdmin = true;
        brand = await Db.WorkspaceBrands
            .AsNoTracking()
            .FirstOrDefaultAsync(b => b.WorkspaceId == seat.WorkspaceId, CancellationToken.None);
    }
}

@layout MainLayout
@page "/account/deliveries"
@attribute [Authorize]
@using QuickShare.Components.Shared
@using QuickShare.Features.Deliveries.List
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject IMessageBus Bus
@inject AppDbContext Db
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["deliveries_title"]</PageTitle>

@if (isChunkRequest)
{
    @* Infinite-scroll append: only the chunk is selected out of this response. *@
    @Chunk
}
else
{
<PageWrapper Variant="PageVariant.Padded">

    <section class="hero">
        <h1 class="db-h1">@Loc["deliveries_h1"]</h1>
        <p class="db-p db-text-muted">@Loc["deliveries_lead"] <a class="db-link" href="/api/deliveries/export" data-ai-action="deliveries.export">@Loc["deliveries_export"]</a>
            @if (DeletedOnly)
            {
                <text>·</text> <a class="db-link" href="/account/deliveries">@Loc["deliveries_back"]</a>
            }
            else
            {
                <text>·</text> <a class="db-link" href="/account/deliveries?trash=1">@Loc["deliveries_trash"]</a>
            }
        </p>
    </section>

    <AccountTabs Current="@RoutePaths.AccountDeliveries" />

    @if (!isLoaded)
    {
        @* Shell skeleton — rendered instantly, no DB calls. *@
        <section id="deliveries-body"
                 hx-get="@RoutePaths.AccountDeliveries"
                 hx-trigger="load"
                 hx-target="#deliveries-body"
                 hx-select="#deliveries-body"
                 hx-swap="outerHTML"
                 aria-busy="true">
            <p class="db-text-muted">@Loc["deliveries_loading"]</p>
        </section>
    }
    else
    {
        <section id="deliveries-body">
            @* Link health at a glance (issue #202) — the DB is the source of truth, no probes needed. *@
            @if (health is not null && health.Active > 0)
            {
                <p class="account-deliveries-health db-text-muted">
                    <span>@string.Format(Loc["deliveries_health_active"], health.Active)</span>
                    @if (health.ExpiringSoon > 0)
                    {
                        <span class="account-deliveries-health__warn">@string.Format(Loc["deliveries_health_expiring"], health.ExpiringSoon)</span>
                    }
                    @if (health.Exhausted > 0)
                    {
                        <span class="account-deliveries-health__warn">@string.Format(Loc["deliveries_health_exhausted"], health.Exhausted)</span>
                    }
                </p>
            }

            @* Filter + search controls (issue #214). Every control swaps the whole body via HTMX. *@
            <div class="account-deliveries-controls">
                <nav class="account-deliveries-filters">
                    @FilterLink(null, Loc["deliveries_filter_all"])
                    @FilterLink(DeliveryStatus.Active, Loc["deliveries_filter_active"])
                    @FilterLink(DeliveryStatus.Scheduled, Loc["deliveries_filter_scheduled"])
                    @FilterLink(DeliveryStatus.Expired, Loc["deliveries_filter_expired"])
                    @FilterLink(DeliveryStatus.Revoked, Loc["deliveries_filter_revoked"])
                    @FavoritesLink
                    <a class="db-btn db-btn--ghost db-btn--sm" href="@RoutePaths.AccountDeliveryLabels">@Loc["deliveries_print_labels"]</a>
                </nav>
                <input type="search" name="@SearchQueryKey" value="@Search"
                       class="account-deliveries-search"
                       placeholder="@Loc["deliveries_search_placeholder"]"
                       aria-label="@Loc["deliveries_search_placeholder"]"
                       hx-get="@BodyUrl(Status, null)"
                       hx-trigger="keyup changed delay:400ms, search"
                       hx-target="#deliveries-body"
                       hx-select="#deliveries-body"
                       hx-swap="outerHTML" />
            </div>

            @* Bulk manage (issue #144) — select rows, then extend or trash together. *@
            <div class="account-deliveries-bulkbar" id="bulk-bar" data-count-template="@Loc["deliveries_bulk_selected"]">
                <label class="account-deliveries-selectall">
                    <input type="checkbox" onchange="bulkToggleAll(this)" aria-label="@Loc["deliveries_select_all"]" />
                    <span>@Loc["deliveries_select_all"]</span>
                </label>
                <span id="bulk-count" class="db-text-muted"></span>
                <button type="button" class="db-btn db-btn--primary db-btn--sm"
                        data-error="@Loc["deliveries_bulk_error"]"
                        onclick="bulkExtend(this)" data-ai-action="deliveries.bulkExtend" disabled>@Loc["deliveries_bulk_extend"]</button>
                <button type="button" class="db-btn db-btn--ghost db-btn--sm"
                        data-confirm="@Loc["deliveries_bulk_trash_confirm"]"
                        onclick="bulkTrash(this)" data-ai-action="deliveries.bulkTrash" disabled>@Loc["deliveries_bulk_trash"]</button>
            </div>

            @if (items.Count == 0)
            {
                @if (hasFilter)
                {
                    <div class="account-deliveries-empty">
                        <p class="db-p">@Loc["deliveries_no_results"]</p>
                    </div>
                }
                else
                {
                    <div class="account-deliveries-empty">
                        <p class="db-p">@Loc["deliveries_empty"]</p>
                        <p class="db-text-muted">@Loc["deliveries_empty_free"]</p>
                        <a href="@RoutePaths.Send" class="db-btn db-btn--primary">@Loc["deliveries_empty_cta"]</a>
                    </div>
                }
            }
            else
            {
                @Chunk
            }
        </section>
    }

</PageWrapper>
}

<script>
    window.cancelDelivery = function (btn) {
        var id = btn.closest('article').id.replace('delivery-', '');
        var msg = btn.getAttribute('data-confirm');
        if (msg && !window.confirm(msg)) return;
        fetch('/api/deliveries/' + id, { method: 'DELETE' }).then(function (r) {
            if (r.ok) btn.closest('article').remove();
        });
    };
    window.extendDelivery = function (btn) {
        var id = btn.closest('article').id.replace('delivery-', '');
        btn.disabled = true;
        fetch('/api/deliveries/' + id + '/extend', { method: 'POST' }).then(function (r) {
            if (r.ok) return r.json();
            return r.json().then(function (b) { throw b; });
        }).then(function (data) {
            var label = btn.closest('article').querySelector('.account-delivery__expiry');
            if (label && data.expiresAt) label.textContent = data.expiresAt;
        }).catch(function () { /* leave the stale label; user can retry */ })
          .finally(function () { btn.disabled = false; });
    };
    window.revokeDelivery = function (btn) {
        var id = btn.closest('article').id.replace('delivery-', '');
        var msg = btn.getAttribute('data-confirm');
        if (msg && !window.confirm(msg)) return;
        btn.disabled = true;
        fetch('/api/deliveries/' + id + '/revoke', { method: 'POST' }).then(function (r) {
            if (r.ok) {
                var article = btn.closest('article');
                article.classList.add('account-delivery--spent');
                article.querySelectorAll('button').forEach(function (b) { b.remove(); });
                var expiry = article.querySelector('.account-delivery__expiry');
                if (expiry) expiry.textContent = btn.getAttribute('data-revoked-label');
            } else {
                btn.disabled = false;
            }
        }).catch(function () { btn.disabled = false; });
    };
    window.renameDelivery = function (btn) {
        var article = btn.closest('article');
        var id = article.id.replace('delivery-', '');
        var nameEl = article.querySelector('.account-delivery__name');
        var current = nameEl ? nameEl.textContent : '';
        var next = window.prompt(btn.getAttribute('data-prompt'), current);
        if (!next || next.trim() === '' || next.trim() === current) return;
        fetch('/api/deliveries/' + id + '/filename', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fileName: next.trim() })
        }).then(function (r) {
            if (r.ok && nameEl) {
                nameEl.textContent = next.trim();
                nameEl.setAttribute('title', next.trim());
            }
        });
    };
    window.editTag = function (btn) {
        var article = btn.closest('article');
        var id = article.id.replace('delivery-', '');
        var tagEl = article.querySelector('.account-delivery__tag');
        var current = tagEl ? tagEl.textContent : '';
        var next = window.prompt(btn.getAttribute('data-prompt'), current);
        if (next === null) return;
        var value = next.trim();
        fetch('/api/deliveries/' + id + '/tag', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tag: value })
        }).then(function () {
            article.querySelectorAll('.account-delivery__tag').forEach(function (el) { el.remove(); });
            if (value) {
                var span = document.createElement('span');
                span.className = 'account-delivery__tag';
                span.textContent = value;
                btn.parentNode.insertBefore(span, btn);
            }
        }).catch(function () { /* leave as-is */ });
    };
    window.toggleFavorite = function (btn) {
        var id = btn.closest('article').id.replace('delivery-', '');
        fetch('/api/deliveries/' + id + '/favorite', { method: 'PATCH' }).then(function (r) {
            if (r.ok) return r.json();
            throw r;
        }).then(function (data) {
            btn.textContent = data.isFavorite ? '★' : '☆';
            btn.setAttribute('aria-pressed', data.isFavorite ? 'true' : 'false');
        }).catch(function () { /* leave the star as-is */ });
    };
    window.setDeliveryAlias = function (btn) {
        var article = btn.closest('article');
        var id = article.id.replace('delivery-', '');
        var next = window.prompt(btn.getAttribute('data-prompt'), btn.getAttribute('data-current') || '');
        if (next === null) return;
        fetch('/api/deliveries/' + id + '/alias', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ alias: next.trim() || null })
        }).then(function (r) {
            if (r.ok) window.location.reload();
            else window.alert(btn.getAttribute('data-error'));
        });
    };
    window.setDailyLimit = function (btn) {
        var id = btn.closest('article').id.replace('delivery-', '');
        var next = window.prompt(btn.getAttribute('data-prompt'), '');
        if (next === null) return;
        var value = next.trim() === '' ? null : parseInt(next, 10);
        if (value !== null && (isNaN(value) || value < 1)) { window.alert(btn.getAttribute('data-error')); return; }
        fetch('/api/deliveries/' + id + '/daily-limit', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ limit: value })
        }).then(function (r) {
            if (!r.ok) window.alert(btn.getAttribute('data-error'));
        });
    };
    window.cloneDelivery = function (btn) {
        var id = btn.closest('article').id.replace('delivery-', '');
        btn.disabled = true;
        fetch('/api/deliveries/' + id + '/clone', { method: 'POST' }).then(function (r) {
            if (r.ok) window.location.reload();
            else btn.disabled = false;
        }).catch(function () { btn.disabled = false; });
    };
    window.toggleDeliveryStats = function (btn) {
        var id = btn.closest('article').id.replace('delivery-', '');
        fetch('/api/deliveries/' + id + '/download-stats', { method: 'PATCH' }).then(function (r) {
            if (r.ok) return r.json();
            return r.json().then(function (b) { throw b; });
        }).then(function (data) {
            btn.textContent = data.hidden ? btn.getAttribute('data-show-label') : btn.getAttribute('data-hide-label');
        }).catch(function () { /* leave the label as-is */ });
    };
    window.deleteDelivery = function (btn) {
        var id = btn.closest('article').id.replace('delivery-', '');
        if (!window.confirm(btn.getAttribute('data-confirm'))) return;
        fetch('/api/deliveries/' + id + '/delete', { method: 'POST' }).then(function (r) {
            if (r.ok) btn.closest('article').remove();
        });
    };
    window.restoreDelivery = function (btn) {
        var id = btn.closest('article').id.replace('delivery-', '');
        fetch('/api/deliveries/' + id + '/restore', { method: 'POST' }).then(function (r) {
            if (r.ok) btn.closest('article').remove();
        });
    };
    window.bulkSelectedIds = function () {
        return Array.prototype.slice.call(document.querySelectorAll('.account-delivery__select:checked'))
            .map(function (el) { return el.value; });
    };
    window.bulkUpdateBar = function () {
        var bar = document.getElementById('bulk-bar');
        if (!bar) return;
        var ids = window.bulkSelectedIds();
        var count = document.getElementById('bulk-count');
        if (count) count.textContent = ids.length ? bar.getAttribute('data-count-template').replace('{0}', ids.length) : '';
        bar.querySelectorAll('button').forEach(function (b) { b.disabled = ids.length === 0; });
    };
    window.bulkToggleAll = function (master) {
        document.querySelectorAll('.account-delivery__select').forEach(function (cb) { cb.checked = master.checked; });
        window.bulkUpdateBar();
    };
    window.bulkExtend = function (btn) {
        var ids = window.bulkSelectedIds();
        if (ids.length === 0) return;
        btn.disabled = true;
        fetch('/api/deliveries/bulk', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: ids, action: 'extend', days: 7 })
        }).then(function (r) {
            if (r.ok) window.location.reload();
            else window.alert(btn.getAttribute('data-error'));
        }).catch(function () { window.alert(btn.getAttribute('data-error')); })
          .finally(function () { btn.disabled = false; });
    };
    window.bulkTrash = function (btn) {
        var ids = window.bulkSelectedIds();
        if (ids.length === 0) return;
        var msg = btn.getAttribute('data-confirm').replace('{0}', ids.length);
        if (!window.confirm(msg)) return;
        btn.disabled = true;
        fetch('/api/deliveries/bulk', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: ids, action: 'trash' })
        }).then(function (r) {
            if (r.ok) window.location.reload();
            else window.alert(btn.getAttribute('data-error'));
        }).catch(function () { window.alert(btn.getAttribute('data-error')); })
          .finally(function () { btn.disabled = false; });
    };
</script>

@code {
    private const string CursorQueryKey = "cursor";
    private const string StatusQueryKey = "status";
    private const string SearchQueryKey = "q";
    private const string FavoriteQueryKey = "favorite";
    private const string TrashQueryKey = "trash";
    private const string ChunkClass = "deliveries-chunk";
    private const int GaugeFullPercent = 100;
    private const int MinutesPerHour = 60;
    private const int HoursPerDay = 24;

    [Parameter]
    [SupplyParameterFromQuery(Name = CursorQueryKey)]
    public string? Cursor { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = StatusQueryKey)]
    public string? Status { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = SearchQueryKey)]
    public string? Search { get; set; }

    [Parameter]
    public bool Favorite { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = TrashQueryKey)]
    public bool DeletedOnly { get; set; }

    private bool hasFilter => !string.IsNullOrEmpty(Status) || !string.IsNullOrWhiteSpace(Search) || Favorite;

    /// <summary>URL for a full-body swap carrying the given filter plus the current search (or an explicit cursor).</summary>
    private string BodyUrl(string? status, string? cursor, bool? favorite = null)
    {
        var query = new List<string>();
        if (!string.IsNullOrEmpty(status)) query.Add($"{StatusQueryKey}={Uri.EscapeDataString(status)}");
        if (favorite ?? Favorite) query.Add($"{FavoriteQueryKey}=true");
        if (!string.IsNullOrWhiteSpace(Search)) query.Add($"{SearchQueryKey}={Uri.EscapeDataString(Search)}");
        if (!string.IsNullOrEmpty(cursor)) query.Add($"{CursorQueryKey}={cursor}");
        return query.Count == 0 ? RoutePaths.AccountDeliveries : $"{RoutePaths.AccountDeliveries}?{string.Join('&', query)}";
    }

    private RenderFragment FavoritesLink =>
        @<a class="db-btn db-btn--ghost db-btn--sm @(Favorite ? "account-deliveries-filter--current" : "")"
            href="@BodyUrl(null, null, favorite: true)"
            hx-get="@BodyUrl(null, null, favorite: true)"
            hx-target="#deliveries-body"
            hx-select="#deliveries-body"
            hx-swap="outerHTML"
            hx-push-url="true">@Loc["deliveries_filter_favorites"]</a>;

    private RenderFragment FilterLink(string? status, string label) =>
        @<a class="db-btn db-btn--ghost db-btn--sm @((Status == status || (status is null && string.IsNullOrEmpty(Status))) && !Favorite ? "account-deliveries-filter--current" : "")"
            href="@BodyUrl(status, null, favorite: false)"
            hx-get="@BodyUrl(status, null, favorite: false)"
            hx-target="#deliveries-body"
            hx-select="#deliveries-body"
            hx-swap="outerHTML"
            hx-push-url="true">@label</a>;

    private const int ExpiringSoonHours = 48;

    private sealed record HealthStats(int Active, int ExpiringSoon, int Exhausted);

    private HealthStats? health;
    private bool isLoaded;
    private bool isChunkRequest;
    private List<DeliveryItem> items = [];
    private string? nextCursor;

    /// <summary>Rows plus the sentinel that pulls the next page into view — appended to itself.</summary>
    private RenderFragment Chunk => @<div class="@ChunkClass account-deliveries">
        @foreach (var item in items)
        {
            var used = Math.Min(item.DownloadCount, item.MaxDownloads);
            var percent = item.MaxDownloads > 0 ? used * GaugeFullPercent / item.MaxDownloads : GaugeFullPercent;
            var exhausted = item.MaxDownloads > 0 && item.DownloadCount >= item.MaxDownloads;

            <article id="delivery-@item.Id" class="account-delivery @(exhausted ? "account-delivery--spent" : "")">
                <div class="account-delivery__head">
                    <input type="checkbox" class="account-delivery__select" value="@item.Id" onchange="bulkUpdateBar()" aria-label="@Loc["deliveries_select"]" />
                    <button type="button" class="account-delivery__star" onclick="toggleFavorite(this)"
                            aria-pressed="@(item.IsFavorite ? "true" : "false")"
                            aria-label="@Loc["deliveries_favorite"]" title="@Loc["deliveries_favorite"]"
                            data-ai-action="delivery.favorite">@(item.IsFavorite ? "★" : "☆")</button>
                    <FileTypeIcon ContentType="@item.ContentType" />
                    <span class="account-delivery__name" title="@item.FileName">@item.FileName</span>
                    @if (!string.IsNullOrEmpty(item.Alias))
                    {
                        <span class="account-delivery__alias db-text-muted">/d/@item.Alias</span>
                    }
                    @if (!string.IsNullOrEmpty(item.Tag))
                    {
                        <span class="account-delivery__tag" style="background: @TagColor(item.Tag)">@item.Tag</span>
                    }
                    <button type="button" class="account-delivery__tag-edit" onclick="editTag(this)" data-ai-action="delivery.tag" data-prompt="@Loc["deliveries_tag_prompt"]" aria-label="@Loc["deliveries_tag"]" title="@Loc["deliveries_tag"]">#</button>
                    <span class="account-delivery__expiry db-text-muted">
                        @if (item.Status == DeliveryStatus.Scheduled)
                        {
                            @Loc["deliveries_scheduled"] <text>·</text> @item.DeliverAt?.ToLocalTime().ToString("g")
                        }
                        else if (item.Status == DeliveryStatus.Revoked)
                        {
                            @Loc["deliveries_revoked"]
                        }
                        else
                        {
                            @ExpiryLabel(item.ExpiresAt)
                        }
                    </span>
                </div>
                <div class="account-delivery__gauge" role="img"
                     aria-label="@string.Format(Loc["deliveries_downloads"], item.DownloadCount, item.MaxDownloads)">
                    <span class="account-delivery__gauge-fill" style="width:@(percent)%"></span>
                </div>
                <p class="account-delivery__meta db-text-muted">
                    @if (exhausted)
                    {
                        <span class="account-delivery__spent-note">@Loc["deliveries_exhausted"]</span>
                    }
                    else
                    {
                        @string.Format(Loc["deliveries_downloads"], item.DownloadCount, item.MaxDownloads)
                    }
                    @if (DeletedOnly)
                    {
                        <button type="button" class="db-btn db-btn--ghost db-btn--sm"
                                onclick="restoreDelivery(this)" data-ai-action="delivery.restore">@Loc["deliveries_restore"]</button>
                    }
                    else if (item.Status == DeliveryStatus.Active)
                    {
                        <button type="button" class="db-btn db-btn--ghost db-btn--sm account-delivery__delete"
                                data-confirm="@Loc["deliveries_delete_confirm"]"
                                onclick="deleteDelivery(this)" data-ai-action="delivery.delete">@Loc["deliveries_delete"]</button>
                    }
                    @if (item.Status == DeliveryStatus.Scheduled)
                    {
                        <button type="button" class="db-btn db-btn--ghost db-btn--sm account-delivery__cancel"
                                data-confirm="@Loc["deliveries_cancel_confirm"]"
                                onclick="cancelDelivery(this)">@Loc["deliveries_cancel"]</button>
                    }
                    @if (item.Status is not (DeliveryStatus.Scheduled or DeliveryStatus.Revoked) && !exhausted)
                    {
                        <button type="button" class="db-btn db-btn--ghost db-btn--sm account-delivery__extend"
                                onclick="extendDelivery(this)" data-ai-action="delivery.extend">@Loc["deliveries_extend"]</button>
                    }
                    @if (item.Status == DeliveryStatus.Active)
                    {
                        <button type="button" class="db-btn db-btn--ghost db-btn--sm account-delivery__revoke"
                                data-confirm="@Loc["deliveries_revoke_confirm"]" data-revoked-label="@Loc["deliveries_revoked"]"
                                onclick="revokeDelivery(this)" data-ai-action="delivery.revoke">@Loc["deliveries_revoke"]</button>
                    }
                    @if (item.Status != DeliveryStatus.Revoked)
                    {
                        <button type="button" class="db-btn db-btn--ghost db-btn--sm account-delivery__rename"
                                data-prompt="@Loc["deliveries_rename_prompt"]"
                                onclick="renameDelivery(this)" data-ai-action="delivery.rename">@Loc["deliveries_rename"]</button>
                    }
                    @if (item.Status == DeliveryStatus.Active)
                    {
                        <button type="button" class="db-btn db-btn--ghost db-btn--sm account-delivery__clone"
                                onclick="cloneDelivery(this)" data-ai-action="delivery.clone">@Loc["deliveries_clone"]</button>
                        <button type="button" class="db-btn db-btn--ghost db-btn--sm account-delivery__set-alias"
                                data-prompt="@Loc["deliveries_alias_prompt"]" data-current="@item.Alias"
                                data-error="@Loc["deliveries_alias_error"]"
                                onclick="setDeliveryAlias(this)" data-ai-action="delivery.alias">@Loc["deliveries_alias"]</button>
                        <button type="button" class="db-btn db-btn--ghost db-btn--sm account-delivery__daily-limit"
                                data-prompt="@Loc["deliveries_daily_limit_prompt"]"
                                data-error="@Loc["deliveries_daily_limit_error"]"
                                onclick="setDailyLimit(this)" data-ai-action="delivery.dailyLimit">@Loc["deliveries_daily_limit"]</button>
                    }
                    @if (item.Status == DeliveryStatus.Active && item.ExpiresAt.HasValue)
                    {
                        <a class="db-btn db-btn--ghost db-btn--sm account-delivery__calendar"
                           href="@($"/api/downloads/{item.ShareCode}/calendar.ics")" download
                           data-ai-action="delivery.calendar">@Loc["deliveries_calendar"]</a>
                    }
                    <button type="button" class="db-btn db-btn--ghost db-btn--sm"
                            onclick="toggleDeliveryStats(this)" data-ai-action="delivery.toggleStats"
                            data-hide-label="@Loc["deliveries_hide_stats"]" data-show-label="@Loc["deliveries_show_stats"]">
                        @(item.HideDownloadStats ? Loc["deliveries_show_stats"] : Loc["deliveries_hide_stats"])
                    </button>
                </p>
            </article>
        }

        @if (nextCursor is not null)
        {
            <div class="account-deliveries-more"
                 hx-get="@BodyUrl(Status, nextCursor)"
                 hx-trigger="revealed"
                 hx-target="this"
                 hx-select=".@ChunkClass"
                 hx-swap="outerHTML"
                 aria-busy="true"></div>
        }
    </div>;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        var isHtmxRequest = string.Equals(
            ctx.Request.Headers[HtmxHeaders.Request].FirstOrDefault(),
            HtmxHeaders.RequestValue,
            StringComparison.OrdinalIgnoreCase);

        // Shell render: return immediately, no DB calls.
        if (!isHtmxRequest) return;

        isLoaded = true;
        isChunkRequest = !string.IsNullOrEmpty(Cursor);

        if (!isChunkRequest)
        {
            var user = await ctx.User.GetUserAsync(Db, CancellationToken.None);
            var now = DateTime.UtcNow;
            var soon = now.AddHours(ExpiringSoonHours);
            health = await Db.Deliveries
                .AsNoTracking()
                .Where(d => d.SenderId == user.Id)
                .GroupBy(_ => 1)
                .Select(g => new HealthStats(
                    g.Count(d => d.Status == DeliveryStatus.Active),
                    g.Count(d => d.Status == DeliveryStatus.Active && d.ExpiresAt != null && d.ExpiresAt > now && d.ExpiresAt < soon),
                    g.Count(d => d.Status == DeliveryStatus.Active && d.DownloadCount >= d.MaxDownloads)))
                .FirstOrDefaultAsync();
        }

        var result = await Bus.InvokeAsync<LightResults.Result<CursorPage<DeliveryItem>>>(
            new ListDeliveriesQuery(Cursor, Status: Status, Search: Search, FavoritesOnly: Favorite, DeletedOnly: DeletedOnly), CancellationToken.None);

        if (result.IsSuccess(out var page))
        {
            items = page.Items;
            nextCursor = page.NextCursor;
        }
    }

    private string ExpiryLabel(DateTime? expiresAt)
    {
        if (expiresAt is null) return Loc["deliveries_no_expiry"];

        var remaining = expiresAt.Value - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) return Loc["deliveries_expired"];
        if (remaining.TotalHours < 1) return string.Format(Loc["deliveries_expires_minutes"], (int)remaining.TotalMinutes + 1);
        if (remaining.TotalHours < HoursPerDay) return string.Format(Loc["deliveries_expires_hours"], (int)remaining.TotalHours);
        return string.Format(Loc["deliveries_expires_days"], (int)remaining.TotalDays);
    }

    private static string TagColor(string tag)
    {
        var hash = 0;
        foreach (var c in tag)
            hash = (hash * 31 + c) & 0x7fffffff;

        var hue = hash % 360;
        return $"hsla({hue}, 70%, 45%, 0.18)";
    }

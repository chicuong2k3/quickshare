@inject IStringLocalizer<QuickShare.SharedLoc> Loc
@layout MainLayout
@page "/login"
@inject IHttpContextAccessor HttpContextAccessor

@functions {
    private const string GoogleProvider = "google";
    private const string GithubProvider = "github";

    private string GetAuthUrl(string provider)
    {
        var requestedReturnUrl = HttpContextAccessor.HttpContext?.Request.Query["returnUrl"].FirstOrDefault();
        var returnUrl = IsLocalUrl(requestedReturnUrl) ? requestedReturnUrl : RoutePaths.Home;

        return $"{RoutePaths.Login}/{provider}?returnUrl={System.Net.WebUtility.UrlEncode(returnUrl)}";
    }

    private static bool IsLocalUrl(string? url)
    {
        if (string.IsNullOrEmpty(url))
            return false;

        if (url[0] != '/')
            return false;

        if (url.Length == 1)
            return true;

        return url[1] != '/' && url[1] != '\\' && !url.Contains('\\');
    }
}

<PageTitle>@Loc["login_page_title"]</PageTitle>

<PageWrapper Variant="PageVariant.Padded">
    <section class="login-shell" aria-labelledby="login-title">
        <Card class="login-card">
            <CardHeader class="login-header">
                <div class="login-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 17.5h10.2a3.8 3.8 0 0 0 .5-7.57A5.8 5.8 0 0 0 6.6 8.7 4.45 4.45 0 0 0 7 17.5Z" />
                        <path d="M12 10.5v6" />
                        <path d="m9.8 13 2.2-2.5 2.2 2.5" />
                    </svg>
                </div>
                <CardTitle><h1 id="login-title">@Loc["login_title"]</h1></CardTitle>
                <p class="login-subtitle text-muted-foreground">@Loc["login_subtitle"]</p>
            </CardHeader>

            <CardContent class="login-body">
                <ul class="login-provider-list">
                    <li>
                        <Button Href="@GetAuthUrl(GoogleProvider)"
                                class="login-provider login-provider--google"
                                data-provider="@GoogleProvider">
                            <span class="login-provider__icon">
                                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                            </span>
                            <span>@Loc["login_btn_google"]</span>
                        </Button>
                    </li>
                    <li>
                        <Button Href="@GetAuthUrl(GithubProvider)"
                                Variant="secondary"
                                class="login-provider login-provider--github"
                                data-provider="@GithubProvider">
                            <span class="login-provider__icon">
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7.678 1.855.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
                            </span>
                            <span>@Loc["login_btn_github"]</span>
                        </Button>
                    </li>
                </ul>

                @* Two more ways in (issues #68, #132). Both sit under the providers rather than
                   above them: OAuth is how accounts are created here, so it stays the front door. *@
                <div class="login-alt">
                    <button type="button" data-slot="button" data-variant="secondary" class="login-provider"
                            data-error-label="@Loc["passkeys_signin_failed"]"
                            data-unsupported-label="@Loc["passkeys_unsupported"]"
                            onclick="window.quickSharePasskeys.signIn(this)"
                            data-ai-action="login.passkey">@Loc["login_with_passkey"]</button>

                    <label class="workspace-label" for="login-email">@Loc["login_email_label"]</label>
                    <Input id="login-email" name="login-email" Type="email" autocomplete="email" />
                    <button type="button" data-slot="button" data-variant="ghost" data-size="sm"
                            data-sent-label="@Loc["login_link_sent"]"
                            onclick="window.quickSharePasskeys.sendLink(this)"
                            data-ai-action="login.magiclink">@Loc["login_send_link"]</button>
                </div>
            </CardContent>
        </Card>
    </section>
</PageWrapper>

<script src="/js/passkeys.js" defer></script>

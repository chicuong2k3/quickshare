@layout MainLayout
@page "/"
@using Microsoft.Extensions.Localization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

@{
    using var Db = DbFactory.CreateDbContext();
    var stats = QuickShare.Infrastructure.Caching.StaticCache.Instance.GetOrSet(
        "home:social-proof",
        () =>
        {
            var count = Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.AsNoTracking(Db.Deliveries).LongCount(d => d.DeletedAt == null);
            var bytes = Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.AsNoTracking(Db.Deliveries).Where(d => d.DeletedAt == null).Sum(d => (long?)d.FileSize) ?? 0L;
            return (Count: count, Gigabytes: Math.Max(0L, bytes / (1024L * 1024L * 1024L)));
        },
        TimeSpan.FromMinutes(5)
    );
}

<PageTitle>@Loc["home_title"]</PageTitle>

<PageWrapper Variant="PageVariant.Padded">

<div class="home-board">

    <section class="home-hero">
        <div class="home-hero__copy">
            <p class="home-eyebrow">@Loc["home_hero_tab"]</p>
            <h1 class="home-h1">
                @Loc["home_h1_send"] <span class="home-accent">@Loc["home_h1_anything"]</span>,
                <br>@Loc["home_h1_zero"]
            </h1>
            <p class="home-hero__sub">@Loc["home_sub"]</p>
            <div class="home-hero__actions">
                <Button Href="/send" Size="lg" class="home-btn home-btn--primary">@Loc["home_btn_start"]</Button>
                <Button Href="/pricing" Variant="ghost" Size="lg" class="home-btn">@Loc["home_btn_pricing"]</Button>
            </div>
            <p class="home-hero__paste">@Loc["home_paste_hint"]</p>
        </div>

        @* The thesis object is the board itself: a trip you could take right now. *@
        <div class="home-hero__board" aria-hidden="true">
            <div class="home-board__head">
                <span>8F2K · @Loc["home_hero_tab"]</span>
                <span>14:20</span>
            </div>
            <div class="home-trip">
                <span class="home-trip__code">01</span>
                <span class="home-trip__name">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" ? "anh-goc.zip" : "raw-photos.zip")</span>
                <span class="home-trip__size">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" ? "2,4 GB" : "2.4 GB")</span>
                <span class="home-trip__st home-trip__st--flight">@Loc["home_table_cloud"]</span>
            </div>
            <div class="home-trip">
                <span class="home-trip__code">02</span>
                <span class="home-trip__name">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" ? "ban-ve.pdf" : "blueprint.pdf")</span>
                <span class="home-trip__size">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" ? "48,2 MB" : "48.2 MB")</span>
                <span class="home-trip__st">P2P</span>
            </div>
            <div class="home-trip">
                <span class="home-trip__code">03</span>
                <span class="home-trip__name">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" ? "hop-dong.docx" : "contract.docx")</span>
                <span class="home-trip__size">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" ? "1,8 MB" : "1.8 MB")</span>
                <span class="home-trip__st home-trip__st--done">SHA-256</span>
            </div>
            <div class="home-board__foot">
                <span>@Loc["home_proof_e2e"]</span>
                <span>quickshare.vn/d/8F2KQ7</span>
            </div>
        </div>
    </section>

    @* Live social proof (issue #135) — real DB counts cached 5min via StaticCache *@
    <section id="home-social-proof" class="home-proof" aria-labelledby="home-proof-heading">
        <h2 id="home-proof-heading" class="home-proof__label">@Loc["home_proof_heading"]</h2>
        <div class="home-proof__facts">
            <span id="home-proof-deliveries">@string.Format(Loc["home_proof_deliveries"], stats.Count.ToString("N0"))</span>
            <span id="home-proof-volume">@string.Format(Loc["home_proof_volume"], stats.Gigabytes.ToString("N0"))</span>
            <span id="home-proof-e2e">@Loc["home_proof_e2e"]</span>
        </div>
    </section>

    <section class="home-why" aria-labelledby="why-use-app">
        <div class="home-why__head">
            <h2 id="why-use-app">@Loc["home_why_title"]</h2>
            <p class="home-why__sub">@Loc["home_why_sub"]</p>
        </div>

        <div class="home-why__modes" aria-label="Choose transfer mode">
            <span class="home-mode">@Loc["home_badge_cloud"]</span>
            <span class="home-mode">@Loc["home_badge_p2p"]</span>
        </div>

        <div class="home-table">
            <Table class="home-why__table">
                <caption class="sr-only">@Loc["home_table_caption"]</caption>
                <TableHeader>
                    <TableRow>
                        <TableHead scope="col">@Loc["home_table_what"]</TableHead>
                        <TableHead scope="col">@Loc["home_table_cloud"]</TableHead>
                        <TableHead scope="col">@Loc["home_table_p2p"]</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    <TableRow>
                        <TableHead scope="row">@Loc["home_row1_label"]</TableHead>
                        <TableCell>@Loc["home_row1_cloud"]</TableCell>
                        <TableCell>@Loc["home_row1_p2p"]</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["home_row2_label"]</TableHead>
                        <TableCell>@Loc["home_row2_cloud"]</TableCell>
                        <TableCell>@Loc["home_row2_p2p"]</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["home_row3_label"]</TableHead>
                        <TableCell>@Loc["home_row3_cloud"]</TableCell>
                        <TableCell>@Loc["home_row3_p2p"]</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["home_row4_label"]</TableHead>
                        <TableCell>@Loc["home_row4_cloud"]</TableCell>
                        <TableCell>@Loc["home_row4_p2p"]</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["home_row5_label"]</TableHead>
                        <TableCell>@Loc["home_row5_cloud"]</TableCell>
                        <TableCell>@Loc["home_row5_p2p"]</TableCell>
                    </TableRow>
                </TableBody>
            </Table>
        </div>

        <div class="home-why__actions">
            <Button Href="/send" Variant="outline" class="home-btn home-btn--accent">@Loc["home_btn_send_now"]</Button>
            <Button Href="/pricing" Variant="ghost" class="home-btn">@Loc["home_btn_pro_limits"]</Button>
        </div>
    </section>

    <section class="home-features">
        <article class="home-feature">
            <span class="home-feature__tab">@Loc["home_feat_tab1"]</span>
            <h3>@Loc["home_feat1_title"]</h3>
            <p>@Loc["home_feat1_desc"]</p>
        </article>
        <article class="home-feature">
            <span class="home-feature__tab">@Loc["home_feat_tab2"]</span>
            <h3>@Loc["home_feat2_title"]</h3>
            <p>@Loc["home_feat2_desc"]</p>
        </article>
        <article class="home-feature">
            <span class="home-feature__tab">@Loc["home_feat_tab3"]</span>
            <h3>@Loc["home_feat3_title"]</h3>
            <p>@Loc["home_feat3_desc"]</p>
        </article>
    </section>

    <section class="home-how">
        <h2>@Loc["home_how_title"]</h2>
        <div class="home-how__steps">
            <div class="home-step">
                <span class="home-step__num">1</span>
                <div><h3>@Loc["home_step1_title"]</h3><p>@Loc["home_step1_desc"]</p></div>
            </div>
            <div class="home-step">
                <span class="home-step__num">2</span>
                <div><h3>@Loc["home_step2_title"]</h3><p>@Loc["home_step2_desc"]</p></div>
            </div>
            <div class="home-step">
                <span class="home-step__num">3</span>
                <div><h3>@Loc["home_step3_title"]</h3><p>@Loc["home_step3_desc"]</p></div>
            </div>
        </div>
    </section>

    <section class="home-cta">
        <div>
            <h2>@Loc["home_cta_title"]</h2>
            <p>@Loc["home_cta_sub"]</p>
        </div>
        <Button Href="/send" Size="lg" Variant="outline" class="home-btn home-btn--accent">@Loc["home_cta_btn"]</Button>
    </section>

</div>

</PageWrapper>

<script src="/js/paste-anywhere.js"></script>

@* Anonymous visitor beacon (issue #24) — first funnel step. Fires per real page
   load even when the shell is served from the public HTTP cache. *@
<script>
    (function () {
        try {
            navigator.sendBeacon('@AnalyticsConstants.TrackRoute',
                new Blob([JSON.stringify({ event: '@AnalyticsEvents.Visitor' })], { type: 'application/json' }));
        } catch (e) { /* analytics must never break the page */ }
    })();
</script>




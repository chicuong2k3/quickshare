@layout MainLayout
@page "/"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["home_title"]</PageTitle>

<PageWrapper Variant="PageVariant.Padded">
    <section class="home-hero">
        @* The first viewport is the world's thesis: a white card on the dithered
           desktop, sitting on a stack of offset sheets — every delivery is a card. *@
        <div class="home-hero__stack">
            <div class="home-hero__ghost home-hero__ghost--2" aria-hidden="true"></div>
            <div class="home-hero__ghost home-hero__ghost--1" aria-hidden="true"></div>
            <div class="home-hero__card">
                <div class="qs-titlebar">
                    <span class="qs-titlebar__box" aria-hidden="true"></span>
                    <span class="qs-titlebar__label">@Loc["home_hero_tab"]</span>
                    <span class="qs-titlebar__box" aria-hidden="true"></span>
                </div>
                <div class="home-hero__body">
                    @* The stack's own object: a drawn pixel floppy with the rainbow label. *@
                    <svg class="home-hero__art" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="1" y="1" width="22" height="22" fill="var(--db-ink)"/>
                        <rect x="2" y="2" width="20" height="20" fill="var(--db-disk)"/>
                        <rect x="7" y="2" width="10" height="7" fill="var(--db-ink)"/>
                        <rect x="8" y="3" width="8" height="5" fill="var(--db-sand)"/>
                        <rect x="13" y="4" width="2" height="3" fill="var(--db-sheet-raised)"/>
                        <rect x="5" y="11" width="14" height="9" fill="var(--db-ink)"/>
                        <rect x="6" y="12" width="12" height="7" fill="var(--db-sheet-raised)"/>
                        <rect x="6" y="13" width="12" height="1" fill="#61BB46"/>
                        <rect x="6" y="14" width="12" height="1" fill="#FDB827"/>
                        <rect x="6" y="15" width="12" height="1" fill="#F5821F"/>
                        <rect x="6" y="16" width="12" height="1" fill="#E03A3E"/>
                        <rect x="6" y="17" width="12" height="1" fill="#963D97"/>
                        <rect x="6" y="18" width="12" height="1" fill="#009DDC"/>
                    </svg>
                    <h1 class="text-3xl font-bold tracking-tight home-h1">
                        @Loc["home_h1_send"] <span class="home-accent">@Loc["home_h1_anything"]</span>,
                        <br>@Loc["home_h1_zero"]
                    </h1>
                    <p class="text-muted-foreground home-hero__sub">
                        @Loc["home_sub"]
                    </p>
                    <div class="home-hero__actions">
                        <Button Href="/send" Size="lg">@Loc["home_btn_start"]</Button>
                        <Button Href="/pricing" Variant="ghost" Size="lg">@Loc["home_btn_pricing"]</Button>
                    </div>
                    <p class="text-muted-foreground home-hero__paste">@Loc["home_paste_hint"]</p>
                </div>
            </div>
        </div>
    </section>

    <section class="home-why" aria-labelledby="why-use-app">
        <div class="home-why__head">
            <h2 id="why-use-app" class="text-2xl font-bold">@Loc["home_why_title"]</h2>
                <p class="text-muted-foreground home-why__sub">
                @Loc["home_why_sub"]
            </p>
        </div>
        <div class="home-why__badges" aria-label="Choose transfer mode">
            <span class="home-why__badge">
                @Loc["home_badge_cloud"]
            </span>
            <span class="home-why__badge">
                @Loc["home_badge_p2p"]
            </span>
        </div>
        <Card class="home-why__card">
            <div class="qs-titlebar home-why__bar">
                <span class="qs-titlebar__box" aria-hidden="true"></span>
                <span class="qs-titlebar__label">@Loc["home_table_caption"]</span>
                <span class="qs-titlebar__box" aria-hidden="true"></span>
            </div>
            <CardContent>
                <table class="home-why__table">
                    <caption class="sr-only">@Loc["home_table_caption"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@Loc["home_table_what"]</th>
                            <th scope="col">@Loc["home_table_cloud"]</th>
                            <th scope="col">@Loc["home_table_p2p"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">@Loc["home_row1_label"]</th>
                            <td>@Loc["home_row1_cloud"]</td>
                            <td>@Loc["home_row1_p2p"]</td>
                        </tr>
                        <tr>
                            <th scope="row">@Loc["home_row2_label"]</th>
                            <td>@Loc["home_row2_cloud"]</td>
                            <td>@Loc["home_row2_p2p"]</td>
                        </tr>
                        <tr>
                            <th scope="row">@Loc["home_row3_label"]</th>
                            <td>@Loc["home_row3_cloud"]</td>
                            <td>@Loc["home_row3_p2p"]</td>
                        </tr>
                        <tr>
                            <th scope="row">@Loc["home_row4_label"]</th>
                            <td>@Loc["home_row4_cloud"]</td>
                            <td>@Loc["home_row4_p2p"]</td>
                        </tr>
                        <tr>
                            <th scope="row">@Loc["home_row5_label"]</th>
                            <td>@Loc["home_row5_cloud"]</td>
                            <td>@Loc["home_row5_p2p"]</td>
                        </tr>
                    </tbody>
                </table>
                <div class="home-why__actions">
                    <Button Href="/send">@Loc["home_btn_send_now"]</Button>
                    <Button Href="/pricing" Variant="ghost">@Loc["home_btn_pro_limits"]</Button>
                </div>
            </CardContent>
        </Card>
    </section>
    <section class="home-features">
        <div class="grid grid-cols-3 gap-4">
            <Card>
                <CardContent>
                    <span class="home-feature-tab home-feature-tab--green">@Loc["home_feat_tab1"]</span>
                    <div class="home-feature-icon home-feature-icon--green">
                        @* Pixel padlock *@
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <rect x="5" y="2" width="2" height="1" fill="currentColor"/>
                            <rect x="9" y="2" width="2" height="1" fill="currentColor"/>
                            <rect x="4" y="3" width="2" height="4" fill="currentColor"/>
                            <rect x="10" y="3" width="2" height="4" fill="currentColor"/>
                            <rect x="6" y="2" width="4" height="1" fill="currentColor"/>
                            <rect x="2" y="7" width="12" height="7" fill="currentColor"/>
                            <rect x="7" y="9" width="2" height="3" fill="var(--db-sheet-raised)"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold">@Loc["home_feat1_title"]</h3>
                    <p class="text-muted-foreground">
                        @Loc["home_feat1_desc"]
                    </p>
                </CardContent>
            </Card>
            <Card>
                <CardContent>
                    <span class="home-feature-tab home-feature-tab--blue">@Loc["home_feat_tab2"]</span>
                    <div class="home-feature-icon home-feature-icon--blue">
                        @* Pixel clock *@
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <rect x="2" y="2" width="12" height="12" fill="currentColor"/>
                            <rect x="3" y="3" width="10" height="10" fill="var(--db-sheet-raised)"/>
                            <rect x="7" y="4" width="2" height="5" fill="currentColor"/>
                            <rect x="9" y="8" width="3" height="2" fill="currentColor"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold">@Loc["home_feat2_title"]</h3>
                    <p class="text-muted-foreground">
                        @Loc["home_feat2_desc"]
                    </p>
                </CardContent>
            </Card>
            <Card>
                <CardContent>
                    <span class="home-feature-tab home-feature-tab--yellow">@Loc["home_feat_tab3"]</span>
                    <div class="home-feature-icon home-feature-icon--yellow">
                        @* Pixel arrow through an open door — no signup gate *@
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <rect x="9" y="2" width="5" height="12" fill="currentColor"/>
                            <rect x="10" y="3" width="3" height="10" fill="var(--db-sheet-raised)"/>
                            <rect x="1" y="7" width="9" height="2" fill="currentColor"/>
                            <rect x="7" y="5" width="2" height="2" fill="currentColor"/>
                            <rect x="7" y="9" width="2" height="2" fill="currentColor"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold">@Loc["home_feat3_title"]</h3>
                    <p class="text-muted-foreground">
                        @Loc["home_feat3_desc"]
                    </p>
                </CardContent>
            </Card>
        </div>
    </section>

    <section class="home-how">
        <h2 class="text-2xl font-bold home-how__title">@Loc["home_how_title"]</h2>
        <div class="home-how__steps">
            <div class="home-step">
                <span class="home-step__num">1</span>
                <h3 class="text-lg font-medium">@Loc["home_step1_title"]</h3>
                <p class="text-muted-foreground">@Loc["home_step1_desc"]</p>
            </div>
            <div class="home-step">
                <span class="home-step__num">2</span>
                <h3 class="text-lg font-medium">@Loc["home_step2_title"]</h3>
                <p class="text-muted-foreground">@Loc["home_step2_desc"]</p>
            </div>
            <div class="home-step">
                <span class="home-step__num">3</span>
                <h3 class="text-lg font-medium">@Loc["home_step3_title"]</h3>
                <p class="text-muted-foreground">@Loc["home_step3_desc"]</p>
            </div>
        </div>
    </section>

    <section class="home-cta">
        <Card class="home-cta__card">
            <CardContent>
                <h2 class="text-2xl font-bold">@Loc["home_cta_title"]</h2>
                <p class="text-muted-foreground home-cta__sub">@Loc["home_cta_sub"]</p>
                <Button Href="/send" Size="lg">@Loc["home_cta_btn"]</Button>
            </CardContent>
        </Card>
    </section>
</PageWrapper>

<script src="/js/paste-anywhere.js"></script>

@* Anonymous visitor beacon (issue #24) — first funnel step. Fires per real page
   load even when the shell is served from the public HTTP cache. *@
<script>
    (function () {
        try {
            navigator.sendBeacon('@AnalyticsConstants.TrackRoute',
                new Blob([JSON.stringify({ event: '@AnalyticsEvents.Visitor' })], { type: 'application/json' }));
        } catch (e) { /* analytics must never break the page */ }
    })();
</script>




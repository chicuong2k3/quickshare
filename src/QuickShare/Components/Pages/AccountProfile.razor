@inject IStringLocalizer<QuickShare.SharedLoc> Loc

@page "/account/profile"
@layout MainLayout
@attribute [Authorize]
@using QuickShare.Data
@using QuickShare.Features.Users.Shared
@using QuickShare.Infrastructure.Caching
@using QuickShare.Infrastructure.Storage
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IStorageProvider Storage
@inject IOptions<R2Options> R2Opt
@inject IAntiforgery Antiforgery

@{
    var apiBase = string.Empty;
}

<script>window.ZAPDROP_CONFIG = { apiBaseUrl: "@apiBase" };</script>

<Card id="profile-card" class="my-4 gap-3 px-6">
        <form id="profile-form" method="post" action="@RoutePaths.AccountProfile" enctype="multipart/form-data"
              data-saving-label="@Loc["account_profile_saving"]"
              data-saved-label="@Loc["account_profile_saved"]"
              data-error-name-required="@Loc["account_profile_error_name_required"]"
              data-error-image-size="@Loc["account_profile_error_image_size"]"
              data-error-update-failed="@Loc["account_profile_error_update_failed"]"
              @formname="account-profile" @onsubmit="HandleSubmit">
                <AntiforgeryToken />
                <div class="flex flex-col items-center text-center">
                    <label for="avatarFileInput" class="profile-avatar-picker" title="@Loc["account_profile_avatar_label"]" data-ai-action="profile.avatar.pick">
                        <img id="avatarPreview"
                             class="@(string.IsNullOrEmpty(avatar) ? "hidden " : string.Empty)h-20 w-20 rounded-none object-cover"
                             src="@(string.IsNullOrEmpty(avatar) ? null : avatar)"
                             alt="@name" />
                        <div id="avatarInitial"
                             class="@(string.IsNullOrEmpty(avatar) ? string.Empty : "hidden ")flex h-20 w-20 items-center justify-center rounded-none border bg-muted text-xl">@($"{(string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpper())}")</div>
                        <span class="profile-avatar-picker__overlay">@Loc["account_profile_change_avatar"]</span>
                        <input id="avatarFileInput" name="avatar" type="file" accept="image/*" class="sr-only profile-avatar-picker__input" aria-label="@Loc["account_profile_avatar_label"]" />
                    </label>
                    <h2 id="profile-display-name" class="mt-3 text-2xl font-semibold">@name</h2>
                    <p class="mt-1 text-muted-foreground">@email</p>
                    <span class="mt-2 rounded-none border px-2 py-1 text-sm">@provider · @plan</span>
                </div>

                <div id="profile-error" class="@(string.IsNullOrEmpty(formError) ? "hidden " : string.Empty)mt-4 text-destructive" role="alert">@formError</div>

                <div class="mt-4">
                    <label class="block space-y-2" for="name">
                        <span class="flex items-center justify-between gap-2 text-sm font-medium">
                            <span>@Loc["account_profile_name_label"]</span>
                            <span id="profile-save-status" class="profile-save-status" role="status" aria-live="polite"></span>
                        </span>
                        <Input id="name" name="name" Type="text" required Value="@name" class="w-full" />
                    </label>
                    <noscript>
                        <Button Type="submit" class="mt-3 w-full" data-ai-action="profile.save.submit">@Loc["account_profile_save_btn"]</Button>
                    </noscript>
                </div>
        </form>

        <div>
            <Button Href="/logout" Variant="ghost" class="w-full">@Loc["nav_logout"]</Button>
        </div>
</Card>

<script src="/js/account.js"></script>

@code {
    private const long MaxAvatarBytes = 5 * 1024 * 1024;

    private static readonly IReadOnlyDictionary<string, string> AvatarExtensions = new Dictionary<string, string>
    {
        ["image/jpeg"] = ".jpg",
        ["image/png"] = ".png",
        ["image/webp"] = ".webp",
        ["image/gif"] = ".gif",
        ["image/svg+xml"] = ".svg",
    };

    private string name = string.Empty;
    private string email = string.Empty;
    private string avatar = string.Empty;
    private string plan = "free";
    private string provider = "unknown";
    private string? formError;

    private string? FormName { get; set; }

    private IFormFile? FormAvatar { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var Db = DbFactory.CreateDbContext();
        try
        {
            var user = await HttpContextAccessor.HttpContext!.User.GetUserAsync(Db, CancellationToken.None);
            var profile = user.ToProfileResponse();
            name = profile.Name;
            email = profile.Email;
            avatar = profile.AvatarUrl;
            plan = profile.Plan;
        }
        catch { }

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            provider = httpContext.User?.FindFirstValue(AuthConstants.ProviderClaimType) ?? "unknown";
            formError = httpContext.Request.Query["error"].FirstOrDefault();
        }
    }

    private async Task HandleSubmit()
    {
        var context = HttpContextAccessor.HttpContext!;
        try
        {
            await Antiforgery.ValidateRequestAsync(context);
        }
        catch (AntiforgeryValidationException)
        {
            context.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        var form = await context.Request.ReadFormAsync();
        FormName = form["name"].FirstOrDefault();
        FormAvatar = form.Files.GetFile("avatar");
        await HandleUpdateProfile();
    }

    private async Task HandleUpdateProfile()
    {
        await using var Db = DbFactory.CreateDbContext();
        formError = null;
        var newName = FormName?.Trim();
        if (string.IsNullOrWhiteSpace(newName))
        {
            formError = Loc["account_profile_error_name_required"];
            return;
        }

        try
        {
            var ct = CancellationToken.None;
            var user = await HttpContextAccessor.HttpContext!.User.GetUserAsync(Db, ct);
            var userId = user.Id;

            string? avatarUrl = null;
            if (FormAvatar is { Length: > 0 })
            {
                if (FormAvatar.Length > MaxAvatarBytes)
                {
                    formError = Loc["account_profile_error_image_size"];
                    return;
                }

                var publicBaseUrl = R2Opt.Value.PublicBaseUrl;
                if (string.IsNullOrWhiteSpace(publicBaseUrl))
                {
                    formError = Loc["account_profile_error_update_failed"];
                    return;
                }

                var extension = AvatarExtensions.GetValueOrDefault(FormAvatar.ContentType, ".png");
                var objectKey = R2ObjectKey.ForAvatar(userId, extension);
                await using var stream = FormAvatar.OpenReadStream();
                await Storage.UploadObjectAsync(objectKey, stream, FormAvatar.ContentType, ct);
                avatarUrl = $"{publicBaseUrl.TrimEnd('/')}/{objectKey}";
            }

            if (avatarUrl is null)
            {
                await Db.Users
                    .Where(u => u.Id == userId)
                    .ExecuteUpdateAsync(setters => setters
                        .SetProperty(u => u.Name, newName), ct);
            }
            else
            {
                await Db.Users
                    .Where(u => u.Id == userId)
                    .ExecuteUpdateAsync(setters => setters
                        .SetProperty(u => u.Name, newName)
                        .SetProperty(u => u.AvatarUrl, avatarUrl), ct);
            }

            var updatedUser = await Db.Users.AsNoTracking().FirstAsync(u => u.Id == userId, ct);
            avatar = updatedUser.AvatarUrl;

            // ExecuteUpdateAsync bypasses the change tracker, so the cached User
            // entity still holds the old Name/AvatarUrl. Evict it now or the
            // avatar/name keep showing stale data until the 5-minute TTL expires.
            await UserCacheInvalidator.EvictAsync(Db, userId, ct);
        }
        catch
        {
            formError = Loc["account_profile_error_update_failed"];
            return;
        }
        name = newName;

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            var identity = httpContext.User.Identities.First();
            var claims = identity.Claims.Where(c => c.Type != ClaimTypes.Name).ToList();
            claims.Add(new Claim(ClaimTypes.Name, newName));
            var newPrincipal = new ClaimsPrincipal(new ClaimsIdentity(claims, identity.AuthenticationType));
            await httpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, newPrincipal);

        }
    }
}

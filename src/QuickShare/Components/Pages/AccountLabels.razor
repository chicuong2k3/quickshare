@layout MainLayout
@page "/account/deliveries/labels"
@attribute [Authorize]
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["labels_title"]</PageTitle>

<PageWrapper Variant="PageVariant.Padded">

    <section class="hero">
        <h1 class="db-h1">@Loc["labels_h1"]</h1>
        <p class="db-p db-text-muted">@Loc["labels_lead"]</p>
    </section>

    @if (!isLoaded)
    {
        @* Shell skeleton — rendered instantly, no DB calls. *@
        <section id="labels-body"
                 hx-get="@RoutePaths.AccountDeliveryLabels"
                 hx-trigger="load"
                 hx-target="#labels-body"
                 hx-select="#labels-body"
                 hx-swap="outerHTML"
                 aria-busy="true">
            <p class="db-text-muted">@Loc["labels_loading"]</p>
        </section>
    }
    else
    {
        <section id="labels-body">
            @if (labels.Count == 0)
            {
                <p class="db-text-muted">@Loc["labels_empty"]</p>
            }
            else
            {
                <div class="account-labels-toolbar">
                    <button type="button" class="db-btn db-btn--primary" onclick="window.print()">@Loc["labels_print"]</button>
                    <a href="@RoutePaths.AccountDeliveries" class="db-btn db-btn--ghost">@Loc["labels_back"]</a>
                </div>
                <div class="account-labels">
                    @foreach (var label in labels)
                    {
                        var url = $"{baseUrl}/d/{(string.IsNullOrEmpty(label.Alias) ? label.ShareCode : label.Alias)}";
                        <div class="account-label">
                            <div class="account-label__qr" data-url="@url"></div>
                            <div class="account-label__name" title="@label.FileName">@label.FileName</div>
                            <div class="account-label__meta db-text-muted">
                                @(label.ExpiresAt is { } exp ? string.Format(Loc["labels_expires"], exp.ToLocalTime().ToString("d")) : Loc["labels_no_expiry"])
                            </div>
                            <div class="account-label__url">@url</div>
                        </div>
                    }
                </div>
                <script>
                    (function () {
                        if (!window.qrcode) return;
                        document.querySelectorAll('.account-label__qr').forEach(function (el) {
                            try {
                                var qr = window.qrcode(0, 'M');
                                qr.addData(el.getAttribute('data-url'));
                                qr.make();
                                var n = qr.getModuleCount(), cell = 3, dim = n * cell;
                                var parts = ['<svg xmlns="http://www.w3.org/2000/svg" width="' + dim + '" height="' + dim + '" viewBox="0 0 ' + dim + ' ' + dim + '" style="image-rendering:pixelated"><rect width="' + dim + '" height="' + dim + '" fill="#fff"/>'];
                                for (var r = 0; r < n; r++) for (var c = 0; c < n; c++) if (qr.isDark(r, c)) parts.push('<rect x="' + (c * cell) + '" y="' + (r * cell) + '" width="' + cell + '" height="' + cell + '" fill="#000"/>');
                                parts.push('</svg>');
                                el.innerHTML = parts.join('');
                            } catch (e) { /* label prints without a QR */ }
                        });
                    })();
                </script>
            }
        </section>
    }

</PageWrapper>

@code {
    /// <summary>ponytail: hard cap per sheet run; paging labels is a non-goal until someone hits it.</summary>
    private const int MaxLabels = 100;

    private sealed record LabelRow(string FileName, string ShareCode, string? Alias, DateTime? ExpiresAt);

    private bool isLoaded;
    private List<LabelRow> labels = [];
    private string baseUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        var isHtmxRequest = string.Equals(
            ctx.Request.Headers[HtmxHeaders.Request].FirstOrDefault(),
            HtmxHeaders.RequestValue,
            StringComparison.OrdinalIgnoreCase);

        // Shell render: return immediately, no DB calls.
        if (!isHtmxRequest) return;

        isLoaded = true;
        baseUrl = $"{ctx.Request.Scheme}://{ctx.Request.Host}";

        var user = await ctx.User.GetUserAsync(Db, CancellationToken.None);
        labels = await Db.Deliveries
            .AsNoTracking()
            .Where(d => d.SenderId == user.Id && d.Status == DeliveryStatus.Active)
            .OrderByDescending(d => d.CreatedAt)
            .Take(MaxLabels)
            .Select(d => new LabelRow(d.FileName, d.ShareCode, d.Alias, d.ExpiresAt))
            .ToListAsync();
    }
}

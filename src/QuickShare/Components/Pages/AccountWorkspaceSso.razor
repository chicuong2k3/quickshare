@layout MainLayout
@page "/account/workspace/sso"
@attribute [Authorize]
@using QuickShare.Components.Shared
@using QuickShare.Features.Auth.Mfa
@using QuickShare.Features.Auth.Saml
@using QuickShare.Features.Auth.Sso
@using QuickShare.Features.Workspaces.Audit
@using QuickShare.Features.Workspaces.Shared
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject WorkspaceService Workspaces
@inject MfaPolicyService Policies
@inject SamlService Saml
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["sso_title"]</PageTitle>

@* Directory ids, provisioning tokens and enrolment posture — never index (issue #121). *@
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<PageWrapper Variant="PageVariant.Padded">

    <section class="hero">
        <h1 class="text-3xl font-bold tracking-tight">@Loc["sso_title"]</h1>
        <p class="text-muted-foreground">@Loc["sso_subtitle"]</p>
    </section>

    <WorkspaceTabs Current="@RoutePaths.AccountWorkspaceSso" />

    @Chunk

</PageWrapper>

<script src="/js/sso.js" defer></script>

@code {
    private bool isAdmin;
    private Workspace? workspace;
    private WorkspaceSsoConfig? config;
    private List<WorkspaceScimToken> tokens = [];
    private int members;
    private int covered;

    private RenderFragment Chunk => @<section id="workspace-sso-body">
        @if (!isAdmin || workspace is null)
        {
            <Card class="account-card workspace-card">
                <CardContent>
                    <p>@Loc["ws_admin_only"]</p>
                </CardContent>
            </Card>
        }
        else
        {
            @* ── #181 directory binding ── *@
            <Card class="account-card workspace-card">
                <CardContent>
                    <h2 class="text-xl font-semibold">@Loc["sso_directory_title"]</h2>
                    <p class="text-muted-foreground workspace-hint">@Loc["sso_directory_hint"]</p>

                    <div class="workspace-form">
                        <label class="workspace-label" for="sso-provider">@Loc["sso_provider"]</label>
                        <NativeSelect id="sso-provider">
                            <NativeSelectOption value="@SsoProvider.GoogleWorkspace" selected="@(Provider == SsoProvider.GoogleWorkspace)">@Loc["sso_provider_google"]</NativeSelectOption>
                            <NativeSelectOption value="@SsoProvider.Entra" selected="@(Provider == SsoProvider.Entra)">@Loc["sso_provider_entra"]</NativeSelectOption>
                            <NativeSelectOption value="@SsoProvider.Saml" selected="@(Provider == SsoProvider.Saml)">@Loc["sso_provider_saml"]</NativeSelectOption>
                        </NativeSelect>

                        <label class="workspace-label" for="sso-directory">@Loc["sso_directory"]</label>
                        <Input id="sso-directory"  type="text"
                               maxlength="@WorkspaceSsoConfig.DirectoryIdMaxLength"
                               value="@config?.DirectoryId" />
                        <p class="text-muted-foreground workspace-hint">@Loc["sso_directory_note"]</p>

                        @* SAML only. Shown always rather than toggled by script: a field that
                           appears on a dropdown change is a field somebody fills in and loses. *@
                        <label class="workspace-label" for="sso-saml-url">@Loc["saml_sso_url"]</label>
                        <Input id="sso-saml-url"  type="url"
                               maxlength="@WorkspaceSsoConfig.SamlUrlMaxLength"
                               value="@config?.SamlSsoUrl" />
                        <p class="text-muted-foreground workspace-hint">@Loc["saml_sso_url_hint"]</p>

                        <label class="workspace-label" for="sso-saml-cert">@Loc["saml_certificate"]</label>
                        <Textarea id="sso-saml-cert"  rows="4"
                                  maxlength="@WorkspaceSsoConfig.SamlCertificateMaxLength"
                                  placeholder="@(HasCertificate ? Loc["saml_certificate_set"].Value : "-----BEGIN CERTIFICATE-----")"></Textarea>
                        <p class="text-muted-foreground workspace-hint">@Loc["saml_certificate_hint"]</p>

                        @if (Provider == SsoProvider.Saml)
                        {
                            <dl class="workspace-stats">
                                <div class="workspace-stat">
                                    <dt>@Loc["saml_sp_entity"]</dt>
                                    <dd><code>@SpEntityId</code></dd>
                                </div>
                                <div class="workspace-stat">
                                    <dt>@Loc["saml_sp_acs"]</dt>
                                    <dd><code>@SpAcsUrl</code></dd>
                                </div>
                                <div class="workspace-stat">
                                    <dt>@Loc["saml_sp_metadata"]</dt>
                                    <dd><a href="@SamlRoutes.Metadata">@SamlRoutes.Metadata</a></dd>
                                </div>
                            </dl>
                        }

                        <label class="workspace-label" for="sso-domains">@Loc["sso_domains"]</label>
                        <Input id="sso-domains"  type="text"
                               maxlength="@WorkspaceSsoConfig.DomainsMaxLength"
                               value="@config?.AllowedEmailDomains" />
                        <p class="text-muted-foreground workspace-hint">@Loc["sso_domains_hint"]</p>

                        <label class="workspace-label" for="sso-jit-role">@Loc["sso_jit_role"]</label>
                        <NativeSelect id="sso-jit-role">
                            <NativeSelectOption value="">@Loc["sso_jit_off"]</NativeSelectOption>
                            <NativeSelectOption value="@nameof(WorkspaceRole.Member)" selected="@(config?.JitRole == WorkspaceRole.Member)">@Loc["sso_role_member"]</NativeSelectOption>
                            <NativeSelectOption value="@nameof(WorkspaceRole.Viewer)" selected="@(config?.JitRole == WorkspaceRole.Viewer)">@Loc["sso_role_viewer"]</NativeSelectOption>
                            <NativeSelectOption value="@nameof(WorkspaceRole.Admin)" selected="@(config?.JitRole == WorkspaceRole.Admin)">@Loc["sso_role_admin"]</NativeSelectOption>
                        </NativeSelect>

                        <label class="workspace-label" for="sso-admin-group">@Loc["sso_admin_group"]</label>
                        <Input id="sso-admin-group"  type="text"
                               maxlength="@WorkspaceSsoConfig.GroupIdMaxLength"
                               value="@config?.AdminGroupId" />
                        <p class="text-muted-foreground workspace-hint">@Loc["sso_admin_group_hint"]</p>

                        <label class="workspace-checkbox">
                            <input id="sso-enabled" type="checkbox" checked="@(config?.Enabled ?? true)" />
                            <span>@Loc["sso_enabled"]</span>
                        </label>

                        <label class="workspace-checkbox">
                            <input id="sso-require" type="checkbox" checked="@(config?.RequireSso ?? false)" />
                            <span>@Loc["sso_require"]</span>
                        </label>
                        <p class="text-muted-foreground workspace-hint">@Loc["sso_require_hint"]</p>

                        <button type="button" data-slot="button" data-variant="default"
                                data-saved-label="@Loc["sso_saved"]"
                                onclick="window.quickShareSso.save(this)"
                                data-ai-action="sso.save">@Loc["sso_save"]</button>

                        @if (config is not null)
                        {
                            <button type="button" data-slot="button" data-variant="ghost"
                                    data-confirm="@Loc["sso_remove_confirm"]"
                                    onclick="window.quickShareSso.remove(this)"
                                    data-ai-action="sso.remove">@Loc["sso_remove"]</button>
                        }
                    </div>
                </CardContent>
            </Card>

            @* ── #219 MFA policy and posture ── *@
            <Card class="account-card workspace-card">
                <CardContent>
                    <h2 class="text-xl font-semibold">@Loc["mfa_policy_title"]</h2>
                    <p class="text-muted-foreground workspace-hint">@Loc["mfa_policy_hint"]</p>

                    <dl class="workspace-stats">
                        <div class="workspace-stat">
                            <dt>@Loc["mfa_posture"]</dt>
                            <dd id="mfa-posture">@covered / @members</dd>
                        </div>
                        @if (workspace.MfaRequiredAt is { } since)
                        {
                            <div class="workspace-stat">
                                <dt>@Loc["mfa_since"]</dt>
                                <dd>@since.ToLocalTime().ToString("g")</dd>
                            </div>
                        }
                    </dl>

                    <div class="workspace-form">
                        <label class="workspace-checkbox">
                            <input id="mfa-required" type="checkbox" checked="@workspace.MfaRequired" />
                            <span>@Loc["mfa_require_label"]</span>
                        </label>

                        <label class="workspace-label" for="mfa-grace">@Loc["mfa_grace"]</label>
                        <input id="mfa-grace" type="number"
                               min="0" max="@Workspace.MaxMfaGraceDays" value="@workspace.MfaGraceDays" />
                        <p class="text-muted-foreground workspace-hint">@Loc["mfa_grace_hint"]</p>

                        <button type="button" data-slot="button" data-variant="default"
                                data-saved-label="@Loc["mfa_policy_saved"]"
                                onclick="window.quickShareSso.savePolicy(this)"
                                data-ai-action="mfa.policy.save">@Loc["mfa_policy_save"]</button>
                    </div>
                </CardContent>
            </Card>

            @* ── #146 SCIM provisioning ── *@
            <Card class="account-card workspace-card">
                <CardContent>
                    <h2 class="text-xl font-semibold">@Loc["scim_title"]</h2>
                    <p class="text-muted-foreground workspace-hint">@Loc["scim_hint", ScimBaseUrl]</p>

                    @if (tokens.Count == 0)
                    {
                        <p class="text-muted-foreground workspace-hint">@Loc["scim_none"]</p>
                    }
                    else
                    {
                        <ul class="workspace-member-list">
                            @foreach (var token in tokens)
                            {
                                <li class="workspace-member" id="scim-@token.Id">
                                    <div class="workspace-member__info">
                                        <span class="workspace-member__name">@token.Label</span>
                                        <span class="workspace-member__meta">
                                            @Loc["scim_created", token.CreatedAt.ToLocalTime().ToString("g")]
                                            · @(token.LastUsedAt is { } used
                                                ? Loc["scim_last_used", used.ToLocalTime().ToString("g")].Value
                                                : Loc["scim_never_used"].Value)
                                        </span>
                                    </div>
                                    <div class="workspace-member__actions">
                                        <button type="button" data-slot="button" data-variant="ghost"
                                                data-id="@token.Id"
                                                data-confirm="@Loc["scim_revoke_confirm"]"
                                                onclick="window.quickShareSso.revokeToken(this)"
                                                data-ai-action="scim.token.revoke">@Loc["scim_revoke"]</button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }

                    <div class="workspace-form">
                        <label class="workspace-label" for="scim-label">@Loc["scim_label"]</label>
                        <Input id="scim-label"  type="text"
                               maxlength="@WorkspaceScimToken.LabelMaxLength" />

                        <button type="button" data-slot="button" data-variant="default"
                                data-once-label="@Loc["scim_shown_once"]"
                                onclick="window.quickShareSso.createToken(this)"
                                data-ai-action="scim.token.create">@Loc["scim_create"]</button>

                        @* Filled in by script: the raw token exists in exactly one response. *@
                        <p class="security-secret" id="scim-new" hidden><code id="scim-new-value"></code></p>
                    </div>
                </CardContent>
            </Card>
        }
    </section>;

    private const string ScimBaseUrl = "/scim/v2";

    private string Provider => config?.Provider ?? SsoProvider.GoogleWorkspace;

    private bool HasCertificate => !string.IsNullOrEmpty(config?.SamlCertificate);

    /// <summary>What the identity provider admin has to paste on their side.</summary>
    private string SpEntityId => Saml.EntityId;
    private string SpAcsUrl => Saml.AssertionConsumerUrl;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;

        var seat = await WorkspaceAuditReader.ResolveAdminSeatAsync(Workspaces, Db, ctx, CancellationToken.None);
        if (seat is null) return;

        isAdmin = true;
        workspace = seat.Workspace;

        config = await Db.WorkspaceSsoConfigs
            .AsNoTracking()
            .FirstOrDefaultAsync(c => c.WorkspaceId == seat.WorkspaceId, CancellationToken.None);

        tokens = await Db.WorkspaceScimTokens
            .AsNoTracking()
            .Where(t => t.WorkspaceId == seat.WorkspaceId && t.RevokedAt == null)
            .OrderByDescending(t => t.CreatedAt)
            .ToListAsync(CancellationToken.None);

        (members, covered) = await Policies.PostureAsync(seat.WorkspaceId, CancellationToken.None);
    }
}

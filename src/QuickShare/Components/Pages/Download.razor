                        @* Anonymous feedback (issue #35) — one click, no account. *@
                        <FeedbackWidget Page="download" />

                    </div>

                    @* Report dialog — raised by JS; server still renders the trigger. *@
                    <div id="download-report-dialog" class="dl-report-dialog hidden">

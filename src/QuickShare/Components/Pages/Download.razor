@layout MainLayout
@page "/d/{ShareCode}"
@attribute [StreamRendering]
@inject IMessageBus Bus
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@using System.Text.Json
@using System.Text.Json.Serialization
@using QuickShare.Infrastructure
@using QuickShare.Features.Downloads.Info
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

@{
    // API and pages are same-origin now; browser JS uses relative URLs.
    var apiBase = string.Empty;
}

<PageTitle>@Loc["dl_title"]</PageTitle>

<script>window.ZAPDROP_CONFIG = { apiBaseUrl: "@apiBase" };</script>
<script id="download-i18n" type="application/json">@RawJson(Strings())</script>

<PageWrapper id="download-app" Variant="PageVariant.Centered">
    @if (Info is not null)
    {
        <script id="download-info-data" type="application/json">@RawJson(Info)</script>
    }
    <div class="card db-card">
        <div class="db-card__body">
            @switch (RenderState)
            {
                case DownloadRenderState.Loading:
                    <div class="db-text-center" style="padding: 2.5rem 0">
                        <div class="db-spinner"></div>
                        <p class="db-p" style="margin-top: 1.25rem; font-size: 0.875rem">@Loc["dl_checking"]</p>
                    </div>
                    break;

                case DownloadRenderState.Ready:
                    @* OTP Gate *@
                    <div id="download-phase-otp" class="db-text-center @PhaseClass(PhaseOtp)">
                        <div class="icon-box --lock">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16" r="1" />
                            </svg>
                        </div>
                        <h2 class="db-h2" style="font-size: 1.125rem">@Loc["dl_otp_h2"]</h2>
                        <p class="db-p" style="margin-top: 0.375rem; font-size: 0.875rem">@Loc["dl_otp_sub"]</p>
                        <div style="margin-top: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 1rem">
                            <div id="dl-otp" class="db-otp" style="gap: 0.5rem">
                                <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,0)" onkeydown="downloadApp.otpKeydown(event,0)" autocomplete="off" />
                                <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,1)" onkeydown="downloadApp.otpKeydown(event,1)" autocomplete="off" />
                                <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,2)" onkeydown="downloadApp.otpKeydown(event,2)" autocomplete="off" />
                                <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,3)" onkeydown="downloadApp.otpKeydown(event,3)" autocomplete="off" />
                                <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,4)" onkeydown="downloadApp.otpKeydown(event,4)" autocomplete="off" />
                                <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,5)" onkeydown="downloadApp.otpKeydown(event,5)" autocomplete="off" />
                            </div>
                            <p id="dl-otp-error" class="error hidden"></p>
                            <button id="dl-otp-btn" type="button" class="btn" onclick="downloadApp.verifyOtp()" data-ai-action="download.otp.unlock">
                                <span id="dl-otp-btn-text">@Loc["dl_otp_unlock"]</span>
                            </button>
                        </div>
                    </div>

                    @* Ad Interstitial *@
                    @* Never server-rendered: an ad nobody can dismiss without JS must not stand between a recipient and their file. JS raises it. *@
                    <div id="download-phase-ad" class="db-text-center hidden" style="padding: 1.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="4" width="20" height="16" rx="2" /><path d="M7 4v16 M17 4v16 M2 12h20 M2 8h20" />
                            </svg>
                        </div>
                        <h3 class="db-h3" style="font-size: 1rem">@Loc["dl_ad_title"]</h3>
                        <p class="db-p" style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_ad_sub"] <a href="/pricing" class="link">@Loc["dl_ad_upgrade"]</a></p>
                        <div style="margin-top: 1.5rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.75rem; color: var(--db-color-text-muted)">
                            <svg class="badge--sovereign" style="width: 0.875rem; height: 0.875rem" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                            <span id="dl-ad-countdown"></span>
                        </div>
                        <button type="button" class="report-toggle" style="margin-top: 1rem" onclick="downloadApp.skipAd()" data-ai-action="download.ad.skip">@Loc["dl_ad_skip"]</button>
                    </div>

                    @* File Card *@
                    <div id="download-phase-file" class="@PhaseClass(PhaseFile)">

                        <div class="file-row">
                            <div class="file-icon">@FileIcon(Info?.ContentType)</div>
                            <div class="file-meta">
                                @* Full name wraps: on touch there is no hover, so a title
                                   attribute is the only copy of a truncated name. *@
                                <h1 class="file-name" title="@Info?.FileName">@Info?.FileName</h1>
                                <dl class="file-specs">
                                    <div><dt class="miura-spec">@Loc["dl_spec_size"]</dt><dd>@FormatBytes(Info?.FileSize ?? 0)</dd></div>
                                    <div><dt class="miura-spec">@Loc["dl_spec_downloads_left"]</dt><dd>@Math.Max(0, (Info?.MaxDownloads ?? 0) - (Info?.DownloadCount ?? 0))</dd></div>
                                    <div><dt class="miura-spec">@Loc["dl_spec_expires"]</dt><dd>@ExpiryLabel</dd></div>
                                </dl>
                            </div>
                        </div>

                        <div class="badges">
                            <div id="dl-badge-encrypted" class="badge --encrypted hidden">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16" r="1" />
                                </svg>
                                @Loc["dl_badge_encrypted"]
                            </div>
                            <button type="button" id="dl-zk-btn" class="badge --sovereign" onclick="downloadApp.toggleZK()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" />
                                </svg>
                                @Loc["dl_badge_detail"]
                            </button>
                        </div>

                        <div id="dl-zk-panel" class="zk-panel hidden">
                            @* Only shown when the link actually carries a key. *@
                            <div class="zk-row hidden" id="dl-fact-key">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                <div><p style="font-weight: 500; color: var(--db-color-text)">@Loc["dl_fact_key_title"]</p><p style="color: var(--db-color-text-muted); margin-top: 0.125rem">@Loc["dl_fact_key_body"]</p></div>
                            </div>
                            <div class="zk-row">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                <div><p style="font-weight: 500; color: var(--db-color-text)">@Loc["dl_fact_expiry_title"]</p><p style="color: var(--db-color-text-muted); margin-top: 0.125rem">@Loc["dl_fact_expiry_body"]</p></div>
                            </div>
                            <div class="zk-row">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h10"/></svg>
                                <div><p style="font-weight: 500; color: var(--db-color-text)">@Loc["dl_fact_limit_title"]</p><p style="color: var(--db-color-text-muted); margin-top: 0.125rem">@Loc["dl_fact_limit_body"]</p></div>
                            </div>
                            <div class="zk-stats">
                                <span><span id="dl-download-count" style="font-weight: 500; color: var(--db-color-text)">0</span> @Loc["dl_stats_downloads"]</span>
                                <span>&middot;</span>
                                <span><span id="dl-max-downloads" style="font-weight: 500; color: var(--db-color-text)">0</span> @Loc["dl_stats_max"]</span>
                                <span>&middot;</span>
                                <span id="dl-expires-label"></span>
                            </div>
                        </div>

                        @* Text snippets render inline — pastebin-lite. Filled by download.js via
                           textContent only; never innerHTML. *@
                        <div id="dl-text-preview" class="text-preview hidden">
                            <div class="text-preview__bar">
                                <span id="dl-text-status" class="text-preview__status"></span>
                                <button type="button" id="dl-text-copy" class="db-btn db-btn--ghost db-btn--sm" onclick="downloadApp.copyText()">
                                    <span id="dl-text-copy-label">@Loc["dl_preview_copy"]</span>
                                </button>
                            </div>
                            <pre id="dl-text-body" class="text-preview__body"></pre>
                            <button type="button" id="dl-text-more" class="db-btn db-btn--ghost db-btn--sm hidden" onclick="downloadApp.showFullText()">@Loc["dl_preview_more"]</button>
                        </div>

                        <div style="margin-top: 2rem">
                            <a id="dl-download-btn" href="/api/downloads/@ShareCode" class="btn" onclick="return downloadApp.handleDownload(event)" data-ai-action="download.file.download" style="gap: 0.75rem; padding: 1rem 1.5rem">
                                <svg id="dl-download-icon" style="width: 1.25rem; height: 1.25rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
                                </svg>
                                <span id="dl-download-text">@Loc["dl_download"]</span>
                            </a>
                        </div>

                        @* AdComponent — rewarded ad for free-plan downloaders, self-contained *@
                        <QuickShare.Components.Shared.AdComponent />
                    </div>
                    break;

                case DownloadRenderState.Expired:
                    <div class="db-text-center" style="padding: 2.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
                            </svg>
                        </div>
                        <h1 class="db-h1" style="margin-top: 1.5rem; font-size: 1.25rem">@Loc["dl_expired_h1"]</h1>
                        <p class="db-p" style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_expired_sub"]</p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                    </div>
                    break;

                case DownloadRenderState.NotFound:
                    <div class="db-text-center" style="padding: 2.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                            </svg>
                        </div>
                        <h1 class="db-h1" style="margin-top: 1.5rem; font-size: 1.25rem">@Loc["dl_notfound_h1"]</h1>
                        <p class="db-p" style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_notfound_sub"]</p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                    </div>
                    break;

                case DownloadRenderState.LimitReached:
                    <div class="db-text-center" style="padding: 2.5rem 0">
                        <h1 class="db-h1" style="font-size: 1.25rem">@Loc["dl_limit_h1"]</h1>
                        <p class="db-p" style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_limit_sub"]</p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                    </div>
                    break;

                case DownloadRenderState.Error:
                    <div class="db-text-center" style="padding: 2.5rem 0">
                        <h1 class="db-h1" style="font-size: 1.25rem">@Loc["dl_error_h1"]</h1>
                        <p class="db-p" style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_error_sub"]</p>
                        <a href="" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_error_retry"]</a>
                    </div>
                    break;
            }
    </div>
    </div>

    <script src="/js/download.js"></script>

</PageWrapper>

@code {
    private const string PhaseOtp = "otp";
    private const string PhaseFile = "file";

    [Parameter] public string ShareCode { get; set; } = string.Empty;

    // The server renders the phase that works without JS. The ad phase never
    // qualifies, so JS raises that one after the page is already usable.
    private string InitialPhase => Info?.HasOtp == true ? PhaseOtp : PhaseFile;

    private string PhaseClass(string phase) => InitialPhase == phase ? string.Empty : "hidden";

    // download.js reads its copy from here rather than carrying English literals.
    private Dictionary<string, string> Strings() => new()
    {
        ["otpIncomplete"] = Loc["dl_otp_incomplete"],
        ["otpWrong"] = Loc["dl_otp_wrong"],
        ["otpVerifying"] = Loc["dl_otp_verifying"],
        ["otpUnlock"] = Loc["dl_otp_unlock"],
        ["adCountdown"] = Loc["dl_ad_countdown"],
        ["previewLoading"] = Loc["dl_preview_loading"],
        ["previewLines"] = Loc["dl_preview_lines"],
        ["copy"] = Loc["dl_preview_copy"],
        ["copied"] = Loc["dl_preview_copied"],
        ["download"] = Loc["dl_download"],
        ["decrypting"] = Loc["dl_decrypting"],
        ["downloadFailed"] = Loc["dl_download_failed"],
        ["expiryNone"] = Loc["dl_expiry_none"],
        ["expiryExpired"] = Loc["dl_expiry_expired"],
        ["expiryMin"] = Loc["dl_expiry_min"],
        ["expiryHour"] = Loc["dl_expiry_hour"],
        ["expiryDay"] = Loc["dl_expiry_day"],
        ["initialPhase"] = InitialPhase,
    };
    private DownloadRenderState RenderState { get; set; } = DownloadRenderState.Loading;
    private DownloadInfoDto? Info { get; set; }
    private string ExpiryLabel { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {


        try
        {
            var result = await Bus.InvokeAsync<LightResults.Result<DownloadInfoResponse>>(
                new DownloadInfoQuery(ShareCode), CancellationToken.None);

            if (!result.IsSuccess(out var value))
            {
                result.IsFailure(out var error);
                var msg = error.Message ?? string.Empty;
                if (msg.Contains("expired", StringComparison.OrdinalIgnoreCase))
                    RenderState = DownloadRenderState.Expired;
                else if (msg.Contains("limit", StringComparison.OrdinalIgnoreCase))
                    RenderState = DownloadRenderState.LimitReached;
                else
                    RenderState = DownloadRenderState.NotFound;
                return;
            }

            Info = new DownloadInfoDto
            {
                FileName = value.FileName,
                ContentType = value.ContentType,
                FileSize = value.FileSize,
                ExpiresAt = value.ExpiresAt,
                DownloadCount = value.DownloadCount,
                MaxDownloads = value.MaxDownloads,
                HasOtp = value.HasOtp,
                SenderPlan = value.SenderPlan
            };
            ExpiryLabel = Info.ExpiresAt.HasValue ? $"expires {ExpiryCountdown(Info.ExpiresAt.Value)}" : "no expiry";
            RenderState = DownloadRenderState.Ready;
        }
        catch { RenderState = DownloadRenderState.Error; }
    }

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase, PropertyNameCaseInsensitive = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        var magnitude = (int)Math.Floor(Math.Log(bytes, 1024));
        if (magnitude >= units.Length) magnitude = units.Length - 1;
        var size = bytes / Math.Pow(1024, magnitude);
        return magnitude == 0 ? $"{bytes} B" : $"{size:F1} {units[magnitude]}";
    }
    private static string ExpiryCountdown(DateTime expiresAt)
    {
        var remaining = expiresAt - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) return "expired";
        if (remaining.TotalHours < 1) return $"in {(int)remaining.TotalMinutes} min";
        if (remaining.TotalHours < 24) return $"in {(int)remaining.TotalHours} h";
        return $"in {(int)remaining.TotalDays} day{((int)remaining.TotalDays == 1 ? string.Empty : "s")}";
    }
    private static MarkupString FileIcon(string? contentType)
    {
        var key = (contentType ?? string.Empty).ToLowerInvariant();
        var d = key switch
        {
            var s when s.StartsWith("image/") => "M21 15V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9 M3 16l5-5 4 4 3-3 4 4 M16 19h6 M19 16v6",
            var s when s.StartsWith("video/") => "m22 8-6 4 6 4V8Z M14 6H4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2Z",
            var s when s.StartsWith("audio/") => "M9 18V5l12-2v13 M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
            "application/pdf" => "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M9 13h6 M9 17h6",
            var s when s.Contains("zip") || s.Contains("compressed") || s.Contains("tar") => "M21 8v13H3V8 M1 3h22v5H1z M10 12h4",
            _ => "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6",
        };
        return new MarkupString($"<svg class=\"\" style=\"width:1.75rem;height:1.75rem\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{d}\"/></svg>");
    }
    // MarkupString: a plain string gets HTML-encoded by Razor even inside <script>,
    // which breaks JSON.parse in download.js (quotes become &quot;). The default
    // System.Text.Json encoder escapes <, > and & so raw emission stays safe.
    private static MarkupString RawJson(DownloadInfoDto? info) => new(info is null ? "{}" : JsonSerializer.Serialize(info, JsonOptions));

    private static MarkupString RawJson(Dictionary<string, string> strings) => new(JsonSerializer.Serialize(strings, JsonOptions));

    private enum DownloadRenderState { Loading, Ready, Expired, NotFound, LimitReached, Error }
    private sealed class DownloadInfoDto
    {
        public string FileName { get; set; } = string.Empty; public string ContentType { get; set; } = string.Empty; public long FileSize { get; set; }
        public DateTime? ExpiresAt { get; set; } public int DownloadCount { get; set; } public int MaxDownloads { get; set; }
        public bool HasOtp { get; set; } public string SenderPlan { get; set; } = string.Empty;
    }
}



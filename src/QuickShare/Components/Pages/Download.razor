                                <label class="block" style="margin-top: 1rem">
                                    <span class="text-sm font-medium">@Loc["dl_report_category"]</span>
                                    <select id="dl-report-category" class="rounded-md border bg-transparent px-3 py-1 text-sm" required>
                                        <option value="abuse">@Loc["dl_report_cat_abuse"]</option>
                                        <option value="copyright">@Loc["dl_report_cat_copyright"]</option>
                                        <option value="malware">@Loc["dl_report_cat_malware"]</option>
                                        <option value="other">@Loc["dl_report_cat_other"]</option>
                                    </select>
                                </label>
                                <label class="block" style="margin-top: 0.75rem">
                                    <span class="text-sm font-medium">@Loc["dl_report_note"]</span>
                                    <textarea id="dl-report-note" class="rounded-md border bg-transparent px-3 py-1 text-sm" rows="3" maxlength="2000"></textarea>
                                </label>
                                <p id="dl-report-error" class="error hidden" style="margin-top: 0.5rem"></p>
                                <div style="margin-top: 1rem; display: flex; gap: 0.5rem">
                                    <button type="submit" class="btn" data-ai-action="download.report.submit">@Loc["dl_report_submit"]</button>
                                    <button type="button" class="inline-flex items-center gap-1 rounded text-sm font-medium text-muted-foreground hover:text-foreground" onclick="downloadApp.closeReport()">@Loc["dl_report_cancel"]</button>
                                </div>
                            </form>
                            <p id="dl-report-done" class="text-muted-foreground hidden" style="margin-top: 1rem; font-size: 0.875rem">@Loc["dl_report_done"]</p>
                        </div>
                    </div>

                    @* Expired phase — hidden by default; download.js swaps to it when the
                       countdown reaches zero. Server always renders a usable phase. *@
                    <div id="download-phase-expired" class="hidden">
                        <div class="text-center" style="padding: 2.5rem 0">
                            <div class="icon-box --muted">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
                                </svg>
                            </div>
                            <div class="text-3xl font-bold tracking-tight" role="heading" aria-level="1" style="margin-top: 1.5rem; font-size: 1.25rem">@Loc["dl_expired_h1"]</div>
                            <p style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_expired_sub"]</p>
                            <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                            @if (Info?.AllowExtensionRequests == true)
                            {
                                <div id="dl-ext-request" style="margin-top: 1.5rem">
                                    <button type="button" class="btn" id="dl-ext-request-btn" onclick="requestExtension()" data-ai-action="delivery.requestExtension">@Loc["dl_ext_request_btn"]</button>
                                    <p id="dl-ext-request-done" class="hidden" style="margin-top: 0.5rem">@Loc["dl_ext_request_sent"]</p>
                                </div>
                            }
                        </div>
                    </div>
                    break;

                case DownloadRenderState.Scheduled:
                    <div class="text-center" style="padding: 2.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
                            </svg>
                        </div>
                        <h1 class="text-3xl font-bold tracking-tight" style="margin-top: 1.5rem; font-size: 1.25rem">@Loc["dl_scheduled_h1"]</h1>
                        <p style="margin-top: 0.5rem; font-size: 0.875rem">
                            @Loc["dl_scheduled_sub", ScheduledLabel]
                            <span id="dl-scheduled-countdown" style="display:block;margin-top:0.25rem;font-weight:500"></span>
                        </p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                    </div>
                    break;

                case DownloadRenderState.Expired:
                    <div class="text-center" style="padding: 2.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
                            </svg>
                        </div>
                        <h1 class="text-3xl font-bold tracking-tight" style="margin-top: 1.5rem; font-size: 1.25rem">@Loc["dl_expired_h1"]</h1>
                        <p style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_expired_sub"]</p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                        @if (allowExtensionRequests)
                        {
                            <div id="dl-ext-request" style="margin-top: 1.5rem">
                                <button type="button" class="btn" id="dl-ext-request-btn" onclick="requestExtension()" data-ai-action="delivery.requestExtension">@Loc["dl_ext_request_btn"]</button>
                                <p id="dl-ext-request-done" class="hidden" style="margin-top: 0.5rem">@Loc["dl_ext_request_sent"]</p>
                            </div>
                        }
                    </div>
                    break;

                case DownloadRenderState.Suspended:
                    <div id="download-phase-suspended" class="text-center" style="padding: 2.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                            </svg>
                        </div>
                        <h1 class="text-3xl font-bold tracking-tight" style="margin-top: 1.5rem; font-size: 1.25rem">@Loc["dl_suspended_h1"]</h1>
                        <p style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_suspended_sub"]</p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                    </div>
                    break;

                case DownloadRenderState.Revoked:
                    <div id="download-phase-revoked" class="text-center" style="padding: 2.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                            </svg>
                        </div>
                        <h1 class="text-3xl font-bold tracking-tight" style="margin-top: 1.5rem; font-size: 1.25rem">@Loc["dl_revoked_h1"]</h1>
                        <p style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_revoked_sub"]</p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                    </div>
                    break;

                case DownloadRenderState.Restricted:
                    @* Access rules refused this caller (issues #142/#166). Deliberately says
                       nothing about which rule, the sender's values, the file, or the counts —
                       a refused visitor learns only that a restriction exists. *@
                    <div id="download-phase-restricted" class="text-center" style="padding: 2.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                            </svg>
                        </div>
                        <h1 class="text-3xl font-bold tracking-tight" style="margin-top: 1.5rem; font-size: 1.25rem">@Loc["dl_restricted_h1"]</h1>
                        <p style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_restricted_sub"]</p>
                        <p class="dl-restricted__notice">@Loc["dl_restricted_notice"]</p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                    </div>
                    break;

                case DownloadRenderState.NotFound:
                    <div class="text-center" style="padding: 2.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                            </svg>
                        </div>
                        <h1 class="text-3xl font-bold tracking-tight" style="margin-top: 1.5rem; font-size: 1.25rem">@Loc["dl_notfound_h1"]</h1>
                        <p style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_notfound_sub"]</p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                    </div>
                    break;

                case DownloadRenderState.LimitReached:
                    <div class="text-center" style="padding: 2.5rem 0">
                        <h1 class="text-3xl font-bold tracking-tight" style="font-size: 1.25rem">@Loc["dl_limit_h1"]</h1>
                        <p style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_limit_sub"]</p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                    </div>
                    break;

                case DownloadRenderState.DailyLimit:
                    <div id="download-phase-daily-limit" class="text-center" style="padding: 2.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
                            </svg>
                        </div>
                        <h1 class="text-3xl font-bold tracking-tight" style="margin-top: 1.5rem; font-size: 1.25rem">@Loc["dl_daily_limit_h1"]</h1>
                        <p style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_daily_limit_sub"]</p>
                        <a href="/" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_send_a_file"]</a>
                    </div>
                    break;

                case DownloadRenderState.Error:
                    <div class="text-center" style="padding: 2.5rem 0">
                        <h1 class="text-3xl font-bold tracking-tight" style="font-size: 1.25rem">@Loc["dl_error_h1"]</h1>
                        <p style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_error_sub"]</p>
                        <a href="" class="btn" style="display: inline-flex; margin-top: 2rem; width: auto; padding: 0.875rem 2rem">@Loc["dl_error_retry"]</a>
                    </div>
                    break;
            }
    </div>
    </div>

    <script src="/js/download.js"></script>

<script>
    window.recipientGate = {
        download: function () {
            var email = document.getElementById('dl-recipient-email').value.trim();
            if (!email) return;
            var consent = document.getElementById('dl-recipient-consent').checked;
            window.location.href = '/api/downloads/' + '@ShareCode' + '?recipientEmail=' + encodeURIComponent(email) + '&marketingConsent=' + (consent ? 'true' : 'false');
        }
    };
</script>

<script>
    window.emailOtp = {
        send: function () {
            var email = document.getElementById('dl-email-otp-email');
            if (!email || !email.value.trim()) return;
            var btn = document.getElementById('dl-email-otp-send');
            btn.disabled = true;
            fetch('/api/deliveries/' + '@ShareCode' + '/request-email-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email.value.trim() }),
            }).then(function (r) {
                if (r.ok) {
                    document.getElementById('dl-email-otp-sent').classList.remove('hidden');
                }
                btn.disabled = false;
            }).catch(function () { btn.disabled = false; });
        },
        download: function () {
            var email = document.getElementById('dl-email-otp-email').value.trim();
            var code = document.getElementById('dl-email-otp-code').value.trim();
            if (!email || !code) return;
            window.location.href = '/api/downloads/' + '@ShareCode' + '?emailOtp=' + encodeURIComponent(code) + '&email=' + encodeURIComponent(email);
        }
    };
</script>

<script>
    window.requestExtension = function () {
        var btn = document.getElementById('dl-ext-request-btn');
        if (!btn) return;
        btn.disabled = true;
        fetch('/api/deliveries/' + '@ShareCode' + '/extension-request', { method: 'POST' }).then(function (r) {
            if (r.ok) {
                btn.classList.add('hidden');
                var done = document.getElementById('dl-ext-request-done');
                if (done) done.classList.remove('hidden');
            } else {
                btn.disabled = false;
            }
        }).catch(function () { btn.disabled = false; });
    };
</script>

    @if (Files.Count > 1)
    {
        @* Server-rendered, like the comment thread and for the same reason: the recipient page
           has to work with scripting off (DownloadNoScriptTests), and a bundle whose contents
           only appear after a fetch is an empty page to that reader. *@
        <section id="dl-files" class="dl-files" data-share-code="@ShareCode">
            <h2 class="dl-files__title text-xl font-semibold">@Loc["dl_files_title", Files.Count]</h2>

            <ul class="dl-files__list">
                @foreach (var file in Files)
                {
                    <li class="dl-file">
                        <a class="dl-file__name" href="/api/downloads/@ShareCode/files/@file.Id">@file.FileName</a>
                        <span class="dl-file__size">@FormatBytes(file.FileSize)</span>
                    </li>
                }
            </ul>

            <a class="dl-files__all inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" href="/api/downloads/@ShareCode/zip"
               data-ai-action="download.zip">@Loc["dl_files_download_all", FormatBytes(TotalFileBytes)]</a>
        </section>
    }

    @if (CommentsOpen)
    {
        @* Posting needs JS; the thread does not. Hide only the controls, natively. *@
        <noscript><style>.dl-comments__js { display: none; }</style></noscript>

        <section id="dl-comments" class="dl-comments" data-share-code="@ShareCode">
            <h2 class="dl-comments__title text-xl font-semibold">@Loc["dl_comments_title"]</h2>

            @if (Comments.Count == 0)
            {
                <p class="text-muted-foreground" id="dl-comments-empty">@Loc["dl_comments_empty"]</p>
            }

            <ul class="dl-comments__list" id="dl-comments-list">
                @foreach (var comment in Comments.Where(c => c.ParentId is null))
                {
                    <li class="dl-comment" id="dl-comment-@comment.Id">
                        <p class="dl-comment__meta">
                            <strong>@comment.AuthorName</strong>
                            @if (comment.IsTeamMember)
                            {
                                @* Marked because an anonymous display name is a claim, not an identity. *@
                                <span class="dl-comment__badge">@Loc["dl_comments_team"]</span>
                            }
                            <time datetime="@comment.CreatedAt.ToString("o")">@comment.CreatedAt.ToLocalTime().ToString("g")</time>
                        </p>
                        <p class="dl-comment__body">@(comment.IsDeleted ? Loc["dl_comments_removed"].Value : comment.Body)</p>

                        @foreach (var reply in Comments.Where(c => c.ParentId == comment.Id))
                        {
                            <div class="dl-comment dl-comment--reply" id="dl-comment-@reply.Id">
                                <p class="dl-comment__meta">
                                    <strong>@reply.AuthorName</strong>
                                    @if (reply.IsTeamMember)
                                    {
                                        <span class="dl-comment__badge">@Loc["dl_comments_team"]</span>
                                    }
                                    <time datetime="@reply.CreatedAt.ToString("o")">@reply.CreatedAt.ToLocalTime().ToString("g")</time>
                                </p>
                                <p class="dl-comment__body">@(reply.IsDeleted ? Loc["dl_comments_removed"].Value : reply.Body)</p>
                            </div>
                        }

                        @if (CanPost)
                        {
                            <button type="button" class="dl-comments__js inline-flex items-center gap-1 rounded text-sm font-medium text-muted-foreground hover:text-foreground"
                                    data-parent-id="@comment.Id"
                                    onclick="window.quickShareComments.reply(this)"
                                    data-ai-action="comment.reply">@Loc["dl_comments_reply"]</button>
                        }
                    </li>
                }
            </ul>

            @if (CanPost)
            {
                @* Posting needs JS. The thread above does not — a reader with scripts off still
                   sees the conversation, which is the part that carries the information. *@
                <div class="dl-comments__form dl-comments__js">
                    @if (!IsSignedIn)
                    {
                        <label class="workspace-label" for="dl-comment-name">@Loc["dl_comments_name"]</label>
                        <input id="dl-comment-name" class="rounded-md border bg-transparent px-3 py-1 text-sm" type="text" maxlength="@DeliveryComment.AuthorNameMaxLength" />
                    }

                    <label class="workspace-label" for="dl-comment-body">@Loc["dl_comments_body"]</label>
                    <textarea id="dl-comment-body" class="rounded-md border bg-transparent px-3 py-1 text-sm" rows="3" maxlength="@DeliveryComment.BodyMaxLength"></textarea>

                    <p class="dl-comments__hint text-muted-foreground" id="dl-comment-replying" hidden>
                        @Loc["dl_comments_replying"]
                        <button type="button" class="dl-comments__cancel"
                                onclick="window.quickShareComments.cancelReply()"
                                data-ai-action="comment.reply.cancel">@Loc["dl_comments_cancel_reply"]</button>
                    </p>

                    <button type="button" class="inline-flex items-center rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground"
                            data-error-label="@Loc["dl_comments_failed"]"
                            onclick="window.quickShareComments.post(this)"
                            data-ai-action="comment.post">@Loc["dl_comments_post"]</button>
                </div>
            }
        </section>
    }

    @if (Brand?.FooterText is { } brandFooter)
    {
        <p class="dl-brand__footer">@brandFooter</p>
    }
</PageWrapper>

<script src="/js/comments.js" defer></script>

@code {
    private const string PhasePassword = "password";
    private const string PhaseOtp = "otp";
    private const string PhaseFile = "file";
    [Parameter] public string ShareCode { get; set; } = string.Empty;

    // The server renders the phase that works without JS. The ad phase never
    // qualifies, so JS raises that one after the page is already usable.
    private string InitialPhase => Info?.HasPassword == true ? PhasePassword : Info?.HasOtp == true ? PhaseOtp : PhaseFile;
    private string PhaseClass(string phase) => InitialPhase == phase ? string.Empty : "hidden";
    private Dictionary<string, string> Strings() => new()
    {
        ["otpIncomplete"] = Loc["dl_otp_incomplete"],
        ["otpWrong"] = Loc["dl_otp_wrong"],
        ["otpVerifying"] = Loc["dl_otp_verifying"],
        ["otpUnlock"] = Loc["dl_otp_unlock"],
        ["passwordIncomplete"] = Loc["dl_password_incomplete"],
        ["passwordWrong"] = Loc["dl_password_wrong"],
        ["passwordVerifying"] = Loc["dl_password_verifying"],
        ["passwordUnlock"] = Loc["dl_password_unlock"],
        ["adCountdown"] = Loc["dl_ad_countdown"],
        ["previewLoading"] = Loc["dl_preview_loading"],
        ["previewLines"] = Loc["dl_preview_lines"],
        ["diffUnified"] = Loc["dl_diff_unified"],
        ["diffSplit"] = Loc["dl_diff_split"],
        ["diffRaw"] = Loc["dl_diff_raw"],
        ["diffView"] = Loc["dl_diff_view"],
        ["copy"] = Loc["dl_preview_copy"],
        ["copied"] = Loc["dl_preview_copied"],
        ["copySha"] = Loc["dl_sha_copy"],
        ["shareLabel"] = Loc["dl_share"],
        ["shareCopied"] = Loc["dl_share_copied"],
        ["download"] = Loc["dl_download"],
        ["decrypting"] = Loc["dl_decrypting"],
        ["downloadFailed"] = Loc["dl_download_failed"],
        ["expiryNone"] = Loc["dl_expiry_none"],
        ["expiryExpired"] = Loc["dl_expiry_expired"],
        ["expiryMin"] = Loc["dl_expiry_min"],
        ["expiryHour"] = Loc["dl_expiry_hour"],
        ["expiryDay"] = Loc["dl_expiry_day"],
        ["expiryCountdown"] = Loc["dl_expiry_countdown"],
        ["expiryDownloadNow"] = Loc["dl_expiry_download_now"],
        ["scheduledCountdown"] = Loc["dl_scheduled_countdown"],
        ["initialPhase"] = InitialPhase,
        ["reportError"] = Loc["dl_report_error"],
        ["previewImageAlt"] = Loc["dl_preview_alt"],
        ["previewPdfTitle"] = Loc["dl_preview_pdf"],
        ["zipBytes"] = Loc["dl_zip_bytes"],
    };
    private DownloadRenderState RenderState { get; set; } = DownloadRenderState.Loading;
    private DownloadInfoDto? Info { get; set; }
    private string ExpiryLabel { get; set; } = string.Empty;
    private bool allowExtensionRequests;
    private bool IsScheduled => Info?.Status == DeliveryStatus.Scheduled && Info.DeliverAt > DateTime.UtcNow;
    private string ScheduledLabel => Info?.DeliverAt is { } d ? d.ToLocalTime().ToString("f") : string.Empty;
    private string RequestBase => $"{HttpContextAccessor.HttpContext!.Request.Scheme}://{HttpContextAccessor.HttpContext.Request.Host}";
    private string OgTitle => !string.IsNullOrEmpty(Info?.FileName) ? Info!.FileName : Loc["dl_title"];
    private string OgDescription => Info is null
        ? string.Empty
        : $"{FormatBytes(Info.FileSize)} · {(Info.ExpiresAt.HasValue ? ExpiryCountdown(Info.ExpiresAt.Value) : Loc["dl_expiry_none"])}";
    private string OgUrl => $"{RequestBase}{HttpContextAccessor.HttpContext!.Request.Path}{HttpContextAccessor.HttpContext.Request.QueryString}";
    private string OgImageUrl => $"{RequestBase}/og-cover.svg";
    private bool ShowViralCta => Info is not null && Info.SenderPlan is not (PlanTierLimits.Pro or PlanTierLimits.Studio);

    /// <summary>
    /// The sending workspace's brand, or null for a personal share. Resolved from the delivery
    /// rather than from the viewer: the recipient has no account, and the brand they should see
    /// is the sender's.
    /// </summary>
    private BrandView? Brand { get; set; }

    /// <summary>
    /// The preview overlay as a CSS <c>url()</c> tile (issue #155), or null when this share
    /// carries no watermark. Only the preview is marked — the download is untouched.
    /// </summary>
    private string? Watermark { get; set; }

    /// <summary>
    /// The addressed recipient's token from their own mail (issue #37), or null for anybody who
    /// arrived by a forwarded or copied link.
    /// </summary>
    private string? RecipientToken { get; set; }

    /// <summary>Human label of the region this delivery is stored in (issue #119), or null.</summary>
    private string? RegionLabel { get; set; }

    /// <summary>The files in this delivery (issue #79). Always at least one.</summary>
    private List<DeliveryFile> Files { get; set; } = [];

    private long TotalFileBytes => Files.Sum(f => f.FileSize);

    /// <summary>Thread state (issue #289), resolved through the same gate the API uses.</summary>
    private bool CommentsOpen { get; set; }
    private bool CanPost { get; set; }
    private bool IsSignedIn { get; set; }
    private List<CommentDto> Comments { get; set; } = [];

    /// <summary>
    /// Emits the brand stylesheet unescaped. Safe because every interpolated value is validated
    /// on save — hex colours and a restricted font-name character set — so nothing here can
    /// close a declaration and open something else.
    /// </summary>
    private static MarkupString RawCss(string css) => new(css);

    /// <summary>
    /// Loads the file list (issue #79).
    ///
    /// Only for a share that is already showing its contents: a password- or OTP-gated delivery
    /// keeps its file names to itself until the gate is passed, because names and sizes are part
    /// of what the gate exists to withhold.
    /// </summary>
    private async Task LoadFilesAsync(Guid? deliveryId, bool gated, CancellationToken ct)
    {
        if (deliveryId is null || gated)
            return;

        Files = await Db.DeliveryFiles
            .AsNoTracking()
            .Where(f => f.DeliveryId == deliveryId.Value)
            .OrderBy(f => f.SortOrder)
            .ToListAsync(ct);
    }

    /// <summary>
    /// Loads the thread through <see cref="CommentGate"/> — the same resolver the API uses, so
    /// the page cannot show a conversation the endpoint would refuse. Server-rendered rather
    /// than fetched, so a reader with scripts disabled still sees it.
    /// </summary>
    private async Task LoadCommentsAsync(CancellationToken ct)
    {
        var delivery = await Db.Deliveries
            .AsNoTracking()
            .FirstOrDefaultAsync(d => d.ShareCode == ShareCode && d.DeletedAt == null, ct);

        if (delivery is null)
            return;

        IsSignedIn = HttpContextAccessor.HttpContext?.User.Identity?.IsAuthenticated ?? false;

        var member = await CommentAuthor.IsWorkspaceMemberAsync(
            Db, HttpContextAccessor.HttpContext!, delivery.WorkspaceId, ct);

        var verdict = await Gate.EvaluateAsync(delivery, member, ct);
        CommentsOpen = verdict.CanRead;
        CanPost = verdict.CanPost;

        if (!CommentsOpen)
            return;

        Comments = await Db.DeliveryComments
            .AsNoTracking()
            .Where(c => c.DeliveryId == delivery.Id)
            .OrderBy(c => c.CreatedAt)
            .Select(c => new CommentDto(
                c.Id,
                c.ParentId,
                c.AuthorName,
                c.AuthorUserId != null,
                c.DeletedAt == null ? c.Body : string.Empty,
                c.DeletedAt != null,
                c.CreatedAt,
                c.EditedAt))
            .ToListAsync(ct);
    }

    protected override async Task OnInitializedAsync()
    {
        // Referral attribution (issue #15): visiting a link tagged ?r= records
        // the referrer in a 30-day cookie; signup later consumes it.
        var httpContext = HttpContextAccessor.HttpContext!;
        var refCode = httpContext.Request.Query[ReferralPolicy.QueryParam].FirstOrDefault();
        if (!string.IsNullOrEmpty(refCode))
        {
            httpContext.Response.Cookies.Append(ReferralPolicy.CookieName, refCode, new CookieOptions
            {
                MaxAge = TimeSpan.FromDays(ReferralPolicy.CookieDays),
                HttpOnly = true,
                SameSite = SameSiteMode.Lax
            });
        }

        // Brand of the sending workspace (issues #285, #286). Read straight from the delivery
        // rather than widened into DownloadInfoResponse: that payload is serialized to the
        // recipient, and the workspace id has no business being in it.
        var stored = await Db.Deliveries
            .AsNoTracking()
            .Where(d => d.ShareCode == ShareCode)
            // Id and the two gate hashes join the projection for the file list (issue #79):
            // it needs to know which delivery, and whether the share is still behind a gate.
            // Still deliberately narrow — none of this reaches the recipient payload.
            .Select(d => new
            {
                d.Id,
                d.WorkspaceId,
                d.StorageRegion,
                d.PasswordHash,
                d.OtpHash,
                d.WatermarkEnabled,
                SenderName = d.Sender != null ? d.Sender.Name : null,
            })
            .FirstOrDefaultAsync(CancellationToken.None);

        // White-label host check (issue #81). A verified custom domain belongs to one workspace,
        // and a share from a different one must not be reachable through it: an agency's client
        // seeing somebody else's file under the agency's own hostname is the worst failure this
        // feature can have, and it is worth a 404 rather than a redirect that confirms the code.
        if (await Domains.IsForeignHostAsync(
                httpContext.Request.Host.Host, stored?.WorkspaceId, CancellationToken.None))
        {
            RenderState = DownloadRenderState.NotFound;
            return;
        }

        // Per-recipient tracking (issue #37). Before anything can fail: a page that renders is
        // an open, whatever the delivery's own state turns out to be.
        RecipientToken = httpContext.Request.Query[DeliveryRecipient.TokenQueryKey].FirstOrDefault();
        if (stored is not null && RecipientToken is not null)
            await Recipients.MarkOpenedAsync(stored.Id, RecipientToken, CancellationToken.None);

        Brand = await Brands.ForWorkspaceAsync(stored?.WorkspaceId, CancellationToken.None);

        // The overlay marks the screenshot, never the file: nothing below touches the stored
        // object or the download route (issue #155).
        if (stored?.WatermarkEnabled == true
            && PreviewWatermark.TextFor(Brand?.HeaderText, stored.SenderName) is { } watermarkText)
        {
            Watermark = PreviewWatermark.ToCssUrl(watermarkText);
        }
        var gated = !string.IsNullOrEmpty(stored?.PasswordHash) || !string.IsNullOrEmpty(stored?.OtpHash);
        await LoadFilesAsync(stored?.Id, gated, CancellationToken.None);
        await LoadCommentsAsync(CancellationToken.None);
        // Null when the delivery has no region, or when the region it was written to is no
        // longer configured — a label we cannot resolve is worse than no badge at all.
        RegionLabel = Regions.LabelFor(stored?.StorageRegion);

        try
        {
            var result = await Bus.Send<LightResults.Result<DownloadInfoResponse>>(
                new DownloadInfoQuery(ShareCode), CancellationToken.None);

            if (!result.IsSuccess(out var value))
            {
                result.IsFailure(out var error);
                var msg = error?.Message ?? string.Empty;
                // Access rules refused this caller (issues #142/#166). Matched on the exact
                // code and placed ahead of the substring sniffs below — "delivery_restricted"
                // contains none of their needles today, but the ordering is the guarantee.
                if (string.Equals(msg, ErrorCodes.DeliveryRestricted, StringComparison.Ordinal))
                    RenderState = DownloadRenderState.Restricted;
                else if (msg.Contains("expired", StringComparison.OrdinalIgnoreCase))
                {
                    RenderState = DownloadRenderState.Expired;
                    var extStatus = await Bus.Send<LightResults.Result<ExtensionStatusResponse>>(
                        new GetExtensionStatusQuery(ShareCode), CancellationToken.None);
                    if (extStatus.IsSuccess(out var extValue))
                        allowExtensionRequests = extValue.Allowed;
                }
                else if (msg.Contains("daily", StringComparison.OrdinalIgnoreCase))
                    RenderState = DownloadRenderState.DailyLimit;
                else if (msg.Contains("limit", StringComparison.OrdinalIgnoreCase))
                    RenderState = DownloadRenderState.LimitReached;
                else if (msg.Contains("suspended", StringComparison.OrdinalIgnoreCase))
                    RenderState = DownloadRenderState.Suspended;
                else if (msg.Contains("revoked", StringComparison.OrdinalIgnoreCase))
                    RenderState = DownloadRenderState.Revoked;
                else
                    RenderState = DownloadRenderState.NotFound;
                return;
            }

            Info = new DownloadInfoDto
            {
                FileName = value.FileName,
                ContentType = value.ContentType,
                FileSize = value.FileSize,
                ExpiresAt = value.ExpiresAt,
                DeliverAt = value.DeliverAt,
                Status = value.Status,
                DownloadCount = value.DownloadCount,
                MaxDownloads = value.MaxDownloads,
                HasOtp = value.HasOtp,
                HasPassword = value.HasPassword,
                SenderPlan = value.SenderPlan,
                Message = value.Message,
                Sha256 = value.Sha256,
                FirstDownloadedAt = value.FirstDownloadedAt,
                HideDownloadStats = value.HideDownloadStats,
                BurnAfterDownload = value.BurnAfterDownload,
                AllowExtensionRequests = value.AllowExtensionRequests,
                PrivacyMode = value.PrivacyMode,
                EmailOtpEnabled = value.EmailOtpEnabled,
                RequireRecipientEmail = value.RequireRecipientEmail
            };
            ExpiryLabel = Info.ExpiresAt.HasValue ? Loc["dl_expiry_countdown", ExpiryCountdown(Info.ExpiresAt.Value)] : Loc["dl_expiry_none"];
            RenderState = IsScheduled ? DownloadRenderState.Scheduled : DownloadRenderState.Ready;
        }
        catch { RenderState = DownloadRenderState.Error; }
    }

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase, PropertyNameCaseInsensitive = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        var magnitude = (int)Math.Floor(Math.Log(bytes, 1024));
        if (magnitude >= units.Length) magnitude = units.Length - 1;
        var size = bytes / Math.Pow(1024, magnitude);
        return magnitude == 0 ? $"{bytes} B" : $"{size:F1} {units[magnitude]}";
    }
    private string ExpiryCountdown(DateTime expiresAt)
    {
        var remaining = expiresAt - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) return Loc["dl_expiry_expired"];
        if (remaining.TotalHours < 1) return Loc["dl_expiry_min", (int)remaining.TotalMinutes];
        if (remaining.TotalHours < 24) return Loc["dl_expiry_hour", (int)remaining.TotalHours];
        return Loc["dl_expiry_day", (int)remaining.TotalDays];
    }
    private string FirstDownloadLabel(DateTime firstDownloadedAt)
    {
        var elapsed = DateTime.UtcNow - firstDownloadedAt;
        if (elapsed <= TimeSpan.Zero) return Loc["dl_stats_just_now"];
        if (elapsed.TotalMinutes < 1) return Loc["dl_stats_seconds_ago", (int)elapsed.TotalSeconds];
        if (elapsed.TotalHours < 1) return Loc["dl_stats_minutes_ago", (int)elapsed.TotalMinutes];
        if (elapsed.TotalDays < 1) return Loc["dl_stats_hours_ago", (int)elapsed.TotalHours];
        return Loc["dl_stats_days_ago", (int)elapsed.TotalDays];
    }
    private static MarkupString FileIcon(string? contentType)
    {
        var key = (contentType ?? string.Empty).ToLowerInvariant();
        var d = key switch
        {
            var s when s.StartsWith("image/") => "M21 15V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9 M3 16l5-5 4 4 3-3 4 4 M16 19h6 M19 16v6",
            var s when s.StartsWith("video/") => "m22 8-6 4 6 4V8Z M14 6H4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2Z",
            var s when s.StartsWith("audio/") => "M9 18V5l12-2v13 M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
            "application/pdf" => "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M9 13h6 M9 17h6",
            var s when s.Contains("zip") || s.Contains("compressed") || s.Contains("tar") => "M21 8v13H3V8 M1 3h22v5H1z M10 12h4",
            _ => "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6",
        };
        return new MarkupString($"<svg class=\"\" style=\"width:1.75rem;height:1.75rem\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{d}\"/></svg>");
    }
    // MarkupString: a plain string gets HTML-encoded by Razor even inside <script>,
    // which breaks JSON.parse in download.js (quotes become &quot;). The default
    // System.Text.Json encoder escapes <, > and & so raw emission stays safe.
    private static MarkupString RawJson(DownloadInfoDto? info) => new(info is null ? "{}" : JsonSerializer.Serialize(info, JsonOptions));

    private static MarkupString RawJson(Dictionary<string, string> strings) => new(JsonSerializer.Serialize(strings, JsonOptions));

    private enum DownloadRenderState { Loading, Ready, Scheduled, Expired, Suspended, Revoked, Restricted, NotFound, LimitReached, DailyLimit, Error }
    private sealed class DownloadInfoDto
    {
        public string FileName { get; set; } = string.Empty; public string ContentType { get; set; } = string.Empty; public long FileSize { get; set; }
        public DateTime? ExpiresAt { get; set; } public DateTime? DeliverAt { get; set; } public string Status { get; set; } = string.Empty;
        public int DownloadCount { get; set; } public int MaxDownloads { get; set; }
        public bool HasOtp { get; set; } public bool HasPassword { get; set; } public string SenderPlan { get; set; } = string.Empty;
        public string? Message { get; set; }
        public string? Sha256 { get; set; }
        public DateTime? FirstDownloadedAt { get; set; }
        public bool HideDownloadStats { get; set; }
        public bool BurnAfterDownload { get; set; }
        public bool AllowExtensionRequests { get; set; }
        public bool PrivacyMode { get; set; }
        public bool EmailOtpEnabled { get; set; }
        public bool RequireRecipientEmail { get; set; }
    }
}

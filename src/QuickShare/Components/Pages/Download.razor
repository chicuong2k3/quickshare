@layout MainLayout
@page "/d/{ShareCode}"
@inject IMediator Bus
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@using System.Text.Json
@using System.Text.Json.Serialization
@using QuickShare.Infrastructure
@using QuickShare.Features.Downloads.Info
@using QuickShare.Features.Deliveries.ExtensionRequests
@using QuickShare.Features.Workspaces.Branding
@using QuickShare.Features.Workspaces.Domains
@using QuickShare.Features.Downloads.Shared
@using QuickShare.Features.Deliveries.Recipients
@using QuickShare.Features.Uploads.Shared
@using QuickShare.Features.Deliveries.Comments
@inject IStringLocalizer<QuickShare.SharedLoc> Loc
@inject BrandReader Brands
@inject WorkspaceDomainReader Domains
@inject RecipientTracker Recipients
@inject StorageRegionResolver Regions
@inject CommentGate Gate

@{
    // API and pages are same-origin now; browser JS uses relative URLs.
    var apiBase = string.Empty;
}

<PageTitle>@Loc["dl_title"]</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
    @* OpenGraph rich card (issue #75) — server-rendered so Zalo/FB/Telegram
       crawlers get filename + size + brand without any client JS. *@
    <meta property="og:title" content="@OgTitle" />
    <meta property="og:description" content="@OgDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@OgUrl" />
    <meta property="og:image" content="@OgImageUrl" />
    @* Workspace brand (issues #285, #286) — token values only, never token names or type
       sizes, and every value was validated on save. Rendered here so the client's first paint
       is already the agency's, not a flash of ours. *@
    @if (Brand is not null)
    {
        <style>@RawCss(BrandReader.ToCss(Brand))</style>
    }
</HeadContent>

<script>window.ZAPDROP_CONFIG = { apiBaseUrl: "@apiBase" };</script>
<script id="download-i18n" type="application/json">@RawJson(Strings())</script>

<PageWrapper id="download-app" Variant="PageVariant.Centered">
    @if (Info is not null)
    {
        <script id="download-info-data" type="application/json">@RawJson(Info)</script>
    }
    @if (Brand is not null && (Brand.HasLogo || Brand.HeaderText is not null))
    {
        <div class="dl-brand">
            @if (Brand.HasLogo)
            {
                <img class="dl-brand__logo"
                     src="@BrandReader.AssetUrl(Brand.WorkspaceId, BrandAssetKind.Logo)"
                     alt="@(Brand.HeaderText ?? string.Empty)" />
            }
            @if (Brand.HeaderText is { } header)
            {
                <p class="dl-brand__header">@header</p>
            }
        </div>
    }
    @if (RegionLabel is { } regionLabel)
    {
        @* Residency badge (issue #119) — a trust signal the recipient can see without asking. *@
        <p class="dl-region">@Loc["dl_stored_in", regionLabel]</p>
    }
    <div class="card" data-slot="card">
        @* The delivery's own card chrome; the label is the real share code. *@
        <div class="qs-titlebar">
            <span class="qs-titlebar__box" aria-hidden="true"></span>
            <span class="qs-titlebar__label">@ShareCode</span>
            <span class="qs-titlebar__box" aria-hidden="true"></span>
        </div>
        <div class="px-(--card-spacing)">
            @switch (RenderState)
            {
                case DownloadRenderState.Loading:
                    <div class="text-center" style="padding: 2.5rem 0">
                        <div class="size-6 animate-spin rounded-full border-2 border-current border-t-transparent"></div>
                        <p style="margin-top: 1.25rem; font-size: 0.875rem">@Loc["dl_checking"]</p>
                    </div>
                    break;

                case DownloadRenderState.Ready:

                    @* Password Gate (issue #44) — unlocked before the OTP gate *@
                    <div id="download-phase-password" class="text-center @PhaseClass(PhasePassword)">
                        <div class="icon-box --lock">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16" r="1" />
                            </svg>
                        </div>
                        <h2 class="text-xl font-semibold">@Loc["dl_password_h2"]</h2>
                        <p style="margin-top: 0.375rem; font-size: 0.875rem">@Loc["dl_password_sub"]</p>
                        <div style="margin-top: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 1rem">
                            <input type="password" id="dl-password" class="rounded-md border bg-transparent px-3 py-1 text-sm" style="max-width: 20rem; width: 100%" autocomplete="off" onkeydown="downloadApp.passwordKeydown(event)" aria-label="@Loc["dl_password_h2"]" />
                            @* role="alert" (issue #95): a wrong password that is only *shown* is a dead end for
                               anybody not looking at that spot on the screen. *@
                            <p id="dl-password-error" class="error hidden" role="alert"></p>
                            <button id="dl-password-btn" type="button" class="btn" onclick="downloadApp.verifyPassword()" data-ai-action="download.password.unlock">
                                <span id="dl-password-btn-text">@Loc["dl_password_unlock"]</span>
                            </button>
                        </div>
                    </div>

                    @* OTP Gate *@
                    <div id="download-phase-otp" class="text-center @PhaseClass(PhaseOtp)">
                        <div class="icon-box --lock">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16" r="1" />
                            </svg>
                        </div>
                        <h2 class="text-xl font-semibold">@Loc["dl_otp_h2"]</h2>
                        <p style="margin-top: 0.375rem; font-size: 0.875rem">@Loc["dl_otp_sub"]</p>
                        <div style="margin-top: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 1rem">
                            @* Six boxes, each with its own name (issue #95). Unlabelled, a screen
                               reader announces six identical "edit text" fields and the code is
                               unenterable without sight. *@
                            <div id="dl-otp" class="flex gap-2" style="gap: 0.5rem" role="group" aria-label="@Loc["dl_otp_h2"]">
                                <input type="text" class="h-12 w-10 rounded-md border text-center text-lg" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,0)" onkeydown="downloadApp.otpKeydown(event,0)" autocomplete="off" aria-label="@Loc["a11y_code_digit", 1, 6]" />
                                <input type="text" class="h-12 w-10 rounded-md border text-center text-lg" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,1)" onkeydown="downloadApp.otpKeydown(event,1)" autocomplete="off" aria-label="@Loc["a11y_code_digit", 2, 6]" />
                                <input type="text" class="h-12 w-10 rounded-md border text-center text-lg" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,2)" onkeydown="downloadApp.otpKeydown(event,2)" autocomplete="off" aria-label="@Loc["a11y_code_digit", 3, 6]" />
                                <input type="text" class="h-12 w-10 rounded-md border text-center text-lg" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,3)" onkeydown="downloadApp.otpKeydown(event,3)" autocomplete="off" aria-label="@Loc["a11y_code_digit", 4, 6]" />
                                <input type="text" class="h-12 w-10 rounded-md border text-center text-lg" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,4)" onkeydown="downloadApp.otpKeydown(event,4)" autocomplete="off" aria-label="@Loc["a11y_code_digit", 5, 6]" />
                                <input type="text" class="h-12 w-10 rounded-md border text-center text-lg" inputmode="numeric" maxlength="1" oninput="downloadApp.otpInput(event,5)" onkeydown="downloadApp.otpKeydown(event,5)" autocomplete="off" aria-label="@Loc["a11y_code_digit", 6, 6]" />
                            </div>
                            <p id="dl-otp-error" class="error hidden" role="alert"></p>
                            <div id="dl-captcha" class="dl-captcha hidden"></div>
                            <button id="dl-otp-btn" type="button" class="btn" onclick="downloadApp.verifyOtp()" data-ai-action="download.otp.unlock">
                                <span id="dl-otp-btn-text">@Loc["dl_otp_unlock"]</span>
                            </button>
                        </div>
                    </div>

                    @* Ad Interstitial *@
                    @* Never server-rendered: an ad nobody can dismiss without JS must not stand between a recipient and their file. JS raises it. *@
                    <div id="download-phase-ad" class="text-center hidden" style="padding: 1.5rem 0">
                        <div class="icon-box --muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="4" width="20" height="16" rx="2" /><path d="M7 4v16 M17 4v16 M2 12h20 M2 8h20" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold" style="font-size: 1rem">@Loc["dl_ad_title"]</h3>
                        <p style="margin-top: 0.5rem; font-size: 0.875rem">@Loc["dl_ad_sub"] <a href="/pricing" class="link">@Loc["dl_ad_upgrade"]</a></p>
                        <div style="margin-top: 1.5rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.75rem; color: var(--db-color-text-muted)">
                            <svg class="badge--sovereign" style="width: 0.875rem; height: 0.875rem" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                            <span id="dl-ad-countdown"></span>
                        </div>
                        <button type="button" class="report-toggle" style="margin-top: 1rem" onclick="downloadApp.skipAd()" data-ai-action="download.ad.skip">@Loc["dl_ad_skip"]</button>
                    </div>

                    @* File Card *@
                    <div id="download-phase-file" class="@PhaseClass(PhaseFile)">

                        <div class="file-row">
                            <div class="file-icon">@FileIcon(Info?.ContentType)</div>
                            <div class="file-meta">
                                @* Full name wraps: on touch there is no hover, so a title
                                   attribute is the only copy of a truncated name. *@
                                <h1 class="file-name" title="@Info?.FileName">@Info?.FileName</h1>
                                <dl class="file-specs">
                                    <div><dt class="miura-spec">@Loc["dl_spec_size"]</dt><dd>@FormatBytes(Info?.FileSize ?? 0)</dd></div>
                                    <div><dt class="miura-spec">@Loc["dl_spec_downloads_left"]</dt><dd>@Math.Max(0, (Info?.MaxDownloads ?? 0) - (Info?.DownloadCount ?? 0))</dd></div>
                                    <div><dt class="miura-spec">@Loc["dl_spec_expires"]</dt><dd id="dl-spec-expires">@ExpiryLabel</dd></div>
                                </dl>
                                @* Urgent-expiry nudge — hidden by default, shown by download.js
                                   when the link is under one hour. *@
                                <a id="dl-expiry-nudge" href="/api/downloads/@ShareCode" class="dl-expiry-nudge hidden" data-ai-action="download.file.download">@Loc["dl_expiry_download_now"]</a>
                            </div>
                        </div>

                        <div class="badges">
                            <div id="dl-badge-encrypted" class="badge --encrypted hidden">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16" r="1" />
                                </svg>
                                @Loc["dl_badge_encrypted"]
                            </div>
                            @if (Info?.BurnAfterDownload == true)
                            {
                                <div class="badge --burn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2s5 4 5 9a5 5 0 0 1-10 0c0-3 2-5 3-6 1 1 3 2 4 3 0-2-1-4-2-6z"/></svg>
                                    @Loc["dl_badge_burn"]
                                </div>
                            }
                            <button type="button" id="dl-zk-btn" class="badge --sovereign" onclick="downloadApp.toggleZK()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" />
                                </svg>
                                @Loc["dl_badge_detail"]
                            </button>
                        </div>

                        <div id="dl-zk-panel" class="zk-panel hidden">
                            @* Only shown when the link actually carries a key. *@
                            <div class="zk-row hidden" id="dl-fact-key">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                <div><p style="font-weight: 500; color: var(--db-color-text)">@Loc["dl_fact_key_title"]</p><p style="color: var(--db-color-text-muted); margin-top: 0.125rem">@Loc["dl_fact_key_body"]</p></div>
                            </div>
                            <div class="zk-row">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                <div><p style="font-weight: 500; color: var(--db-color-text)">@Loc["dl_fact_expiry_title"]</p><p style="color: var(--db-color-text-muted); margin-top: 0.125rem">@Loc["dl_fact_expiry_body"]</p></div>
                            </div>
                            <div class="zk-row">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h10"/></svg>
                                <div><p style="font-weight: 500; color: var(--db-color-text)">@Loc["dl_fact_limit_title"]</p><p style="color: var(--db-color-text-muted); margin-top: 0.125rem">@Loc["dl_fact_limit_body"]</p></div>
                            </div>
                            <div class="zk-stats">
                                <span><span id="dl-download-count" style="font-weight: 500; color: var(--db-color-text)">0</span> @Loc["dl_stats_downloads"]</span>
                                <span>&middot;</span>
                                <span><span id="dl-max-downloads" style="font-weight: 500; color: var(--db-color-text)">0</span> @Loc["dl_stats_max"]</span>
                                <span>&middot;</span>
                                <span id="dl-expires-label"></span>
                            </div>
                        </div>

                        @* Text snippets render inline — pastebin-lite. Filled by download.js;
                           markdown/code (issue #240) render structured HTML, everything else
                           is set via textContent only. All input is HTML-escaped first. *@
                        <div id="dl-text-preview" class="text-preview hidden">
                            <div class="text-preview__bar">
                                <span id="dl-text-status" class="text-preview__status"></span>
                                <button type="button" id="dl-text-copy" class="inline-flex items-center gap-1 rounded text-sm font-medium text-muted-foreground hover:text-foreground" onclick="downloadApp.copyText()">
                                    <span id="dl-text-copy-label">@Loc["dl_preview_copy"]</span>
                                </button>
                            </div>
                            @* Diff toolbar (issue #248) — shown by download.js only when a
                               .patch/.diff file renders. Hidden by default for non-diff. *@
                            <div id="dl-diff-toolbar" class="dl-diff-toolbar hidden">
                                <button type="button" id="dl-diff-mode-btn" class="hidden" onclick="downloadApp.toggleDiffMode()" aria-pressed="false">
                                    <span id="dl-diff-mode-label">@Loc["dl_diff_split"]</span>
                                </button>
                                <button type="button" id="dl-diff-raw-btn" class="inline-flex items-center gap-1 rounded text-sm font-medium text-muted-foreground hover:text-foreground" onclick="downloadApp.toggleDiffRaw()" aria-pressed="false">
                                    <span id="dl-diff-raw-label">@Loc["dl_diff_raw"]</span>
                                </button>
                            </div>
                            <div id="dl-text-body" class="text-preview__body"></div>
                            <button type="button" id="dl-text-more" class="hidden" onclick="downloadApp.showFullText()">@Loc["dl_preview_more"]</button>
                        </div>

                        @* Sender note (issue #137) — server-rendered escaped text. *@
                        @if (!string.IsNullOrEmpty(Info?.Message))
                        {
                            <div class="dl-message" style="margin-top: 1.25rem; padding: 1rem 1.25rem; background: var(--db-color-surface, rgba(255,255,255,0.04))">
                                <p class="text-sm font-medium" style="margin: 0 0 0.375rem">@Loc["dl_message_label"]</p>
                                <p style="margin: 0; font-size: 0.875rem; white-space: pre-wrap; overflow-wrap: anywhere">@Info.Message</p>
                            </div>
                        }

                        @* Inline media preview (issue #21) — filled by download.js. Only
                           ungated, unencrypted media reaches this element. *@
                        <div id="dl-media-preview"
                             class="dl-media hidden @(Watermark is null ? string.Empty : "dl-media--watermark")"
                             style="margin-top: 1.5rem@(Watermark is null ? string.Empty : $"; --dl-watermark: {Watermark}")"></div>

                        @* ZIP archive contents (issue #215) — filled by download.js; a
                           read-only entry listing so recipients see what's inside before
                           committing to a large download. Only ungated, unencrypted
                           .zip deliveries reach this element. *@
                        <div id="dl-zip-preview" class="dl-zip hidden" style="margin-top: 1.5rem">
                            <p class="text-sm font-medium" style="margin: 0 0 0.5rem">@Loc["dl_zip_title"]</p>
                            <div id="dl-zip-list" class="dl-zip__list"></div>
                        </div>

                        @* Aggregate download stats (issue #64) — count only, no sender identity. *@
                        @if (Info?.HideDownloadStats != true && (Info?.DownloadCount ?? 0) > 0)
                        {
                            <p class="text-muted-foreground" style="margin-top: 1rem; font-size: 0.8125rem">
                                @Loc["dl_stats_downloaded", Info!.DownloadCount]
                                @if (Info.FirstDownloadedAt is { } first)
                                {
                                    <text>·</text> @Loc["dl_stats_first", FirstDownloadLabel(first)]
                                }
                            </p>
                        }

                        @* Privacy mode (issue #187) — the sender left no trace; say so, don't count. *@
                        @if (Info?.PrivacyMode == true)
                        {
                            <p class="text-muted-foreground" style="margin-top: 0.75rem; font-size: 0.8125rem" role="note">@Loc["dl_privacy_badge"]</p>
                        }

                        @* Burn-after-download warning (issue #12) — shown before the download button. *@
                        @if (Info?.BurnAfterDownload == true)
                        {
                            <p class="dl-burn-warning" style="margin-top: 1rem; font-size: 0.875rem; color: var(--db-color-accent-text)">@Loc["dl_burn_warning"]</p>
                        }

                        @* SHA-256 checksum (issue #66) — copy button, no client JS required to render. *@
                        @if (!string.IsNullOrEmpty(Info?.Sha256))
                        {
                            <div class="dl-sha" style="margin-top: 1rem; font-size: 0.8125rem">
                                <span class="text-sm font-medium" style="display:block; margin-bottom: 0.25rem">SHA-256</span>
                                <div style="display:flex; gap: 0.5rem; align-items: flex-start">
                                    <code class="dl-sha__value" style="word-break: break-all; flex: 1">@Info.Sha256</code>
                                    <button type="button" class="inline-flex items-center gap-1 rounded text-sm font-medium text-muted-foreground hover:text-foreground" onclick="downloadApp.copySha256()" data-ai-action="download.sha.copy">
                                        <span id="dl-sha-copy-label">@Loc["dl_sha_copy"]</span>
                                    </button>
                                </div>
                            </div>
                        }


                        @* Recipient email gate (issue #324) — anonymous downloaders surrender an email first *@
                        @if (Info?.RequireRecipientEmail == true)
                        {
                            <div id="dl-recipient-gate" style="margin-top: 2rem">
                                <p>@Loc["dl_recipient_email_title"]</p>
                                <input type="email" id="dl-recipient-email" class="rounded-md border bg-transparent px-3 py-1 text-sm" placeholder="@Loc["dl_recipient_email_placeholder"]" autocomplete="email" style="max-width: 20rem; width: 100%; margin-bottom: 0.5rem" aria-label="@Loc["dl_recipient_email_placeholder"]" />
                                <label class="burn-toggle" style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem">
                                    <input type="checkbox" id="dl-recipient-consent" />
                                    <span>@Loc["dl_recipient_consent"]</span>
                                </label>
                                <button type="button" id="dl-recipient-download" class="btn" onclick="recipientGate.download()" data-ai-action="download.recipientGate.download">@Loc["dl_download"]</button>
                            </div>
                        }

                        @* Email OTP gate (issue #291) — recipient requests a single-use emailed code *@
                        @if (Info?.EmailOtpEnabled == true)
                        {
                            <div id="dl-email-otp" class="dl-email-otp" style="margin-top: 2rem">
                                <p>@Loc["dl_email_otp_title"]</p>
                                <input type="email" id="dl-email-otp-email" class="rounded-md border bg-transparent px-3 py-1 text-sm" placeholder="@Loc["dl_email_otp_email_placeholder"]" autocomplete="email" style="max-width: 20rem; width: 100%; margin-bottom: 0.5rem" aria-label="@Loc["dl_email_otp_email_placeholder"]" />
                                <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap">
                                    <button type="button" id="dl-email-otp-send" class="btn" onclick="emailOtp.send()" data-ai-action="download.emailOtp.send">@Loc["dl_email_otp_send"]</button>
                                    <p id="dl-email-otp-sent" class="hidden" style="margin: 0">@Loc["dl_email_otp_sent"]</p>
                                </div>
                                <input type="text" id="dl-email-otp-code" class="rounded-md border bg-transparent px-3 py-1 text-sm" placeholder="@Loc["dl_email_otp_placeholder"]" inputmode="numeric" maxlength="6" autocomplete="one-time-code" style="max-width: 20rem; width: 100%; margin-top: 0.5rem" aria-label="@Loc["dl_email_otp_placeholder"]" />
                                <button type="button" id="dl-email-otp-download" class="btn" onclick="emailOtp.download()" data-ai-action="download.emailOtp.download" style="margin-top: 0.75rem">@Loc["dl_email_otp_download"]</button>
                            </div>
                        }

                        <div style="margin-top: 2rem">
                            @if (Info?.EmailOtpEnabled != true && Info?.RequireRecipientEmail != true)
                            {
                                <a id="dl-download-btn" href="/api/downloads/@ShareCode" class="btn" onclick="return downloadApp.handleDownload(event)" data-ai-action="download.file.download" style="gap: 0.75rem; padding: 1rem 1.5rem">
                                    <svg id="dl-download-icon" style="width: 1.25rem; height: 1.25rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
                                    </svg>
                                    <span id="dl-download-text">@Loc["dl_download"]</span>
                                </a>
                            }
                            @* Native share sheet (issue #283) — shares the link only, never the password/OTP. *@
                            <button type="button" class="inline-flex items-center gap-1 rounded text-sm font-medium text-muted-foreground hover:text-foreground" style="margin-top: 0.75rem"
                                    onclick="downloadApp.sharePage()" data-ai-action="download.share">
                                <svg style="width: 1rem; height: 1rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                                </svg>
                                <span id="dl-share-label">@Loc["dl_share"]</span>
                            </button>
                        </div>

                        @* AdComponent — rewarded ad for free-plan downloaders, self-contained *@
                        <QuickShare.Components.Shared.AdComponent />

                        @* Report abuse / DMCA — anonymous, no account needed (issue #53) *@
                        <div class="dl-report">
                            <button type="button" class="dl-report__link" onclick="downloadApp.openReport()" data-ai-action="download.report.open">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width: 0.875rem; height: 0.875rem"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                @Loc["dl_report_link"]

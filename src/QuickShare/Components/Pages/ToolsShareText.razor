@layout MainLayout
@page "/tools/share-text"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<ToolsLanding Heading="@Loc["tools_sharetext_heading"]"
              Description="@Loc["tools_sharetext_desc"]"
              Lede="@Loc["tools_sharetext_lede"]"
              PasteHint="@Loc["tools_sharetext_pastehint"]">
    <Body>
        <h2 class="mt-8 text-xl font-semibold">@Loc["tools_sharetext_how_title"]</h2>
        <p>@Loc["tools_sharetext_how_body"]</p>

        <h2 class="mt-8 text-xl font-semibold">@Loc["tools_sharetext_why_title"]</h2>
        <ul class="list-disc space-y-2 pl-6">
            <li>@Loc["tools_sharetext_why_1"]</li>
            <li>@Loc["tools_sharetext_why_2"]</li>
            <li>@Loc["tools_sharetext_why_3"]</li>
        </ul>

        <h2 class="mt-8 text-xl font-semibold">@Loc["tools_sharetext_uses_title"]</h2>
        <p>@Loc["tools_sharetext_uses_body"]</p>
    </Body>
</ToolsLanding>
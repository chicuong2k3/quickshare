@layout MainLayout
@page "/not-found"
@using Microsoft.AspNetCore.Diagnostics
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["notfound_title"]</PageTitle>

<PageWrapper Variant="PageVariant.Centered">
    <div class="notfound-board">
        <div class="qs-titlebar">
            <span class="qs-titlebar__box" aria-hidden="true"></span>
            <span class="qs-titlebar__label">404</span>
            <span class="qs-titlebar__box" aria-hidden="true"></span>
        </div>

        <div class="notfound-board__body">
            <div class="notfound-board__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                </svg>
            </div>

            <h1 class="notfound-board__title">@Loc["notfound_h1"]</h1>
            <p class="notfound-board__sub">@Loc["notfound_sub"]</p>

            <div class="notfound-board__actions">
                <a class="notfound-board__action notfound-board__action--amber" href="@RoutePaths.Home" data-ai-action="notfound.home">@Loc["notfound_cta_home"]</a>
                <a class="notfound-board__action" href="@RoutePaths.AccountDeliveries" data-ai-action="notfound.deliveries">@Loc["notfound_cta_deliveries"]</a>
            </div>
        </div>
    </div>
</PageWrapper>

@code {
    protected override void OnInitialized()
    {
        // Re-executed routes already carry HTTP 404 from UseStatusCodePagesWithReExecute.
        // Direct hits on /not-found signal 404 through Navigation.NotFound() without mutating
        // response headers manually mid-SSR (issue #206).
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx is not null && ctx.Features.Get<IStatusCodeReExecuteFeature>() is null)
        {
            Navigation.NotFound();
        }
    }
}

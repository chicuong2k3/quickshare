@layout MainLayout
@page "/not-found"
@* Catch-all (lowest route precedence): any URL no other page or endpoint claims
   renders this branded 404 instead of an empty response (issue #206). *@
@page "/{*UnmatchedPath:nonfile}"
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["notfound_title"]</PageTitle>

<PageWrapper Variant="PageVariant.Centered">
    <div class="nf-card db-card">
        <div class="qs-titlebar">
            <span class="qs-titlebar__box" aria-hidden="true"></span>
            <span class="qs-titlebar__label">404</span>
            <span class="qs-titlebar__box" aria-hidden="true"></span>
        </div>
        <div class="db-card__body nf-body">
            <h1 class="db-h2 nf-title">@Loc["notfound_h1"]</h1>
            <p class="db-p db-text-muted">@Loc["notfound_sub"]</p>
            <div class="nf-actions">
                <a href="@RoutePaths.Home" class="db-btn db-btn--primary">@Loc["notfound_cta_home"]</a>
                <a href="@RoutePaths.AccountDeliveries" class="db-btn db-btn--ghost">@Loc["notfound_cta_deliveries"]</a>
            </div>
        </div>
    </div>
</PageWrapper>

@code {
    [Parameter] public string? UnmatchedPath { get; set; }

    protected override void OnInitialized()
    {
        // Direct hits on /not-found should also be a 404, not a 200 (issue #206).
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx is not null && !ctx.Response.HasStarted)
        {
            ctx.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}

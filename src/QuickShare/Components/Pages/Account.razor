@inject IStringLocalizer<QuickShare.SharedLoc> Loc
@using Unpoly.Blazor.Shadcn

@layout MainLayout
@page "/account"
@attribute [Authorize]
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Loc["account_page_title"]</PageTitle>

<PageWrapper id="account-app" Variant="PageVariant.Account">

    <AccountTabs Current="@RoutePaths.Account" />

    @* Onboarding checklist (issue #129), dismissible. *@
    <AccountOnboarding />
    @* Profile card renders in the initial response. *@
    <AccountProfile />

    @* Monthly usage bar. *@
    <AccountUsage />

    @* Known devices (issue #149). *@
    <AccountDevices />

    @* Referral (issue #31). *@
    <AccountReferral />

    @* Notification preferences (issue #117). *@
    <AccountNotifications />

    @* Download history (issue #220). *@
    <AccountDownloads />

    @* Security activity (issue #126). *@
    <AccountSecurityActivity />

    @* Data & privacy (issue #59) — static, no DB calls. *@
    <Card class="my-4 p-6">
        <h3 class="text-lg font-semibold">@Loc["account_data_title"]</h3>
        <div class="mt-4 flex flex-wrap gap-2">
            <Button Href="/api/me/export" Variant="ghost" Size="sm" data-ai-action="account.exportData">@Loc["account_data_export"]</Button>
            <button type="button" data-slot="button" data-variant="ghost" data-size="sm" class="text-destructive"
                    data-prompt="@Loc["account_data_delete_prompt"]"
                    data-error="@Loc["account_data_delete_error"]"
                    onclick="deleteAccount(this)" data-ai-action="account.delete">@Loc["account_data_delete"]</button>
        </div>
    </Card>

</PageWrapper>

<script>
    window.deleteAccount = function (btn) {
        var email = window.prompt(btn.getAttribute('data-prompt'));
        if (!email || email.trim() === '') return;
        btn.disabled = true;
        fetch('/api/me/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ confirmEmail: email.trim() })
        }).then(function (r) {
            if (r.ok) window.location.href = '/logout';
            else window.alert(btn.getAttribute('data-error'));
        }).catch(function () { window.alert(btn.getAttribute('data-error')); })
          .finally(function () { btn.disabled = false; });
    };
    (function () {
        if (localStorage.getItem('qs-onboarding-dismissed')) {
            var card = document.getElementById('onboarding-card');
            if (card) card.remove();
        }
    })();
</script>

<script src="/js/account.js"></script>



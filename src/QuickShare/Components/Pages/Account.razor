@inject IStringLocalizer<QuickShare.SharedLoc> Loc

@layout MainLayout
@page "/account"
@attribute [Authorize]
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Loc["account_page_title"]</PageTitle>

<PageWrapper id="account-app" Variant="PageVariant.Account">

    <AccountTabs Current="@RoutePaths.Account" />

    @* Onboarding checklist (issue #129) — HTMX lazy loaded, dismissible. *@
    <HtmxFragment>
    <div id="onboarding-card" class="db-card account-card"
         hx-get="@RoutePaths.AccountOnboarding"
         hx-trigger="load"
         hx-select="#onboarding-card"
         hx-swap="outerHTML">
        <div class="db-card__body">
            <div class="account-skeleton-line account-skeleton-name" style="margin-top: 0"></div>
        </div>
    </div>
    </HtmxFragment>
    @* Profile Card — HTMX lazy loaded *@
    <HtmxFragment>
    <div id="profile-card" class="db-card account-card"
         hx-get="/account/profile"
         hx-trigger="load"
         hx-select="#profile-card"
         hx-swap="outerHTML">
        <div class="db-card__body">
            <div class="account-profile">
                <div class="account-skeleton-avatar"></div>
                <div class="account-skeleton-line account-skeleton-name" style="margin-top: 1.25rem"></div>
                <div class="account-skeleton-line account-skeleton-email" style="margin-top: 0.5rem"></div>
                <div class="account-skeleton-line account-skeleton-badge" style="margin-top: 0.75rem"></div>
            </div>
        </div>
    </div>
    </HtmxFragment>

    @* Monthly usage bar — HTMX lazy loaded *@
    <HtmxFragment>
    <div id="usage-card" class="db-card account-card account-usage"
         hx-get="@RoutePaths.AccountUsage"
         hx-trigger="load"
         hx-select="#usage-card"
         hx-swap="outerHTML">
        <div class="db-card__body">
            <div class="account-skeleton-line account-skeleton-name" style="margin-top: 0"></div>
        </div>
    </div>
    </HtmxFragment>

    @* Known devices (issue #149) — HTMX lazy loaded *@
    <HtmxFragment>
    <div id="devices-card" class="db-card account-card"
         hx-get="/account/devices"
         hx-trigger="load, devicesUpdated from:body"
         hx-select="#devices-card"
         hx-swap="outerHTML">
        <div class="db-card__body">
            <div class="account-skeleton-line account-skeleton-name" style="margin-top: 0"></div>
        </div>
    </div>
    </HtmxFragment>

    @* Referral (issue #31) — HTMX lazy loaded *@
    <HtmxFragment>
    <div id="referral-card" class="db-card account-card"
         hx-get="@RoutePaths.AccountReferral"
         hx-trigger="load"
         hx-select="#referral-card"
         hx-swap="outerHTML">
        <div class="db-card__body">
            <div class="account-skeleton-line account-skeleton-name" style="margin-top: 0"></div>
        </div>
    </div>
    </HtmxFragment>

    @* Notification preferences (issue #117) — HTMX lazy loaded *@
    <HtmxFragment>
    <div id="notifications-card" class="db-card account-card"
         hx-get="@RoutePaths.AccountNotifications"
         hx-trigger="load"
         hx-select="#notifications-card"
         hx-swap="outerHTML">
        <div class="db-card__body">
            <div class="account-skeleton-line account-skeleton-name" style="margin-top: 0"></div>
        </div>
    </div>
    </HtmxFragment>

    @* Download history (issue #220) — HTMX lazy loaded *@
    <HtmxFragment>
    <div id="downloads-card" class="db-card account-card"
         hx-get="@RoutePaths.AccountDownloads"
         hx-trigger="load"
         hx-select="#downloads-card"
         hx-swap="outerHTML">
        <div class="db-card__body">
            <div class="account-skeleton-line account-skeleton-name" style="margin-top: 0"></div>
        </div>
    </div>
    </HtmxFragment>

    @* Data & privacy (issue #59) — static, no DB calls. *@
    <div class="db-card account-card">
        <div class="db-card__body">
            <h3 class="db-h4">@Loc["account_data_title"]</h3>
            <div class="account-data-actions">
                <a href="/api/me/export" class="db-btn db-btn--ghost db-btn--sm" data-ai-action="account.exportData">@Loc["account_data_export"]</a>
                <button type="button" class="db-btn db-btn--ghost db-btn--sm account-data-delete"
                        data-prompt="@Loc["account_data_delete_prompt"]"
                        data-error="@Loc["account_data_delete_error"]"
                        onclick="deleteAccount(this)" data-ai-action="account.delete">@Loc["account_data_delete"]</button>
            </div>
        </div>
    </div>

</PageWrapper>

<script>
    window.deleteAccount = function (btn) {
        var email = window.prompt(btn.getAttribute('data-prompt'));
        if (!email || email.trim() === '') return;
        btn.disabled = true;
        fetch('/api/me/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ confirmEmail: email.trim() })
        }).then(function (r) {
            if (r.ok) window.location.href = '/logout';
            else window.alert(btn.getAttribute('data-error'));
        }).catch(function () { window.alert(btn.getAttribute('data-error')); })
          .finally(function () { btn.disabled = false; });
    };
    window.dismissOnboarding = function (btn) {
        localStorage.setItem('qs-onboarding-dismissed', '1');
        var card = btn.closest('#onboarding-card');
        if (card) card.remove();
    };
    (function () {
        if (localStorage.getItem('qs-onboarding-dismissed')) {
            var card = document.getElementById('onboarding-card');
            if (card) card.remove();
        }
    })();
</script>

<script src="/js/account.js"></script>



@layout MainLayout
@page "/account/workspace/streaming"
@attribute [Authorize]
@using QuickShare.Components.Shared
@using QuickShare.Features.Workspaces.Audit
@using QuickShare.Features.Workspaces.Shared
@using QuickShare.Features.Workspaces.Streaming
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject WorkspaceService Workspaces
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["siem_title"]</PageTitle>

@* Contains an endpoint and sink health — never index (issue #121). *@
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

@if (isChunkRequest)
{
    @Chunk
}
else
{
<PageWrapper Variant="PageVariant.Padded">

    <section class="hero">
        <h1 class="db-h1">@Loc["siem_title"]</h1>
        <p class="db-p db-text-muted">@Loc["siem_subtitle"]</p>
    </section>

    <WorkspaceTabs Current="@RoutePaths.AccountWorkspaceStreaming" />

    <section id="workspace-streaming-body"
             hx-get="@RoutePaths.AccountWorkspaceStreaming"
             hx-trigger="load"
             hx-target="#workspace-streaming-body"
             hx-select="#workspace-streaming-body"
             hx-swap="outerHTML"
             aria-busy="true">
        <div class="db-card account-card">
            <div class="db-card__body">
                <div class="account-skeleton-line account-skeleton-name" style="margin-top: 0"></div>
            </div>
        </div>
    </section>

</PageWrapper>
}

<script src="/js/siem.js" defer></script>

@code {
    private bool isChunkRequest;
    private bool isAdmin;
    private SiemSink? sink;

    private RenderFragment Chunk => @<section id="workspace-streaming-body">
        @if (!isAdmin)
        {
            <div class="db-card account-card workspace-card">
                <div class="db-card__body">
                    <p class="db-p">@Loc["ws_admin_only"]</p>
                </div>
            </div>
        }
        else
        {
            <div class="db-card account-card workspace-card">
                <div class="db-card__body">
                    <h2 class="db-h3">@Loc["siem_config_title"]</h2>
                    <p class="db-p db-text-muted workspace-hint">@Loc["siem_config_hint"]</p>

                    <div class="workspace-form">
                        <label class="workspace-label" for="siem-endpoint">@Loc["siem_endpoint"]</label>
                        <input id="siem-endpoint" class="db-input" type="url" placeholder="https://"
                               maxlength="@SiemSink.EndpointMaxLength" value="@sink?.Endpoint" />

                        <label class="workspace-label" for="siem-format">@Loc["siem_format"]</label>
                        <select id="siem-format" class="db-input">
                            <option value="@SiemFormat.Json" selected="@(Format == SiemFormat.Json)">@Loc["siem_format_json"]</option>
                            <option value="@SiemFormat.Cef" selected="@(Format == SiemFormat.Cef)">@Loc["siem_format_cef"]</option>
                            <option value="@SiemFormat.SplunkHec" selected="@(Format == SiemFormat.SplunkHec)">@Loc["siem_format_splunk"]</option>
                        </select>

                        <label class="workspace-label" for="siem-secret">@Loc["siem_secret"]</label>
                        <input id="siem-secret" class="db-input" type="password" autocomplete="off"
                               maxlength="@SiemSink.SecretMaxLength"
                               placeholder="@(sink is not null && !string.IsNullOrEmpty(sink.Secret) ? Loc["siem_secret_set"] : string.Empty)" />

                        <label class="workspace-label" for="siem-filter">@Loc["siem_filter"]</label>
                        <input id="siem-filter" class="db-input" type="text"
                               maxlength="@SiemSink.EventFilterMaxLength" value="@sink?.EventFilter"
                               placeholder="@Loc["siem_filter_placeholder"]" />

                        <label class="workspace-checkbox">
                            <input id="siem-enabled" type="checkbox" checked="@(sink?.Enabled ?? true)" />
                            <span>@Loc["siem_enabled"]</span>
                        </label>

                        <button type="button" class="db-btn db-btn--primary"
                                data-saved-label="@Loc["siem_saved"]"
                                onclick="window.quickShareSiem.save(this)"
                                data-ai-action="siem.save">@Loc["siem_save"]</button>

                        @if (sink is not null)
                        {
                            <button type="button" class="db-btn db-btn--ghost db-btn--sm"
                                    data-confirm="@Loc["siem_remove_confirm"]"
                                    onclick="window.quickShareSiem.remove(this)"
                                    data-ai-action="siem.remove">@Loc["siem_remove"]</button>
                        }
                    </div>
                </div>
            </div>

            @if (sink is not null)
            {
                <div class="db-card account-card workspace-card">
                    <div class="db-card__body">
                        <h2 class="db-h3">@Loc["siem_health_title"]</h2>

                        @if (sink.IsParked)
                        {
                            <p class="db-p workspace-notice">@Loc["siem_parked", SiemSink.MaxConsecutiveFailures]</p>
                        }

                        <dl class="workspace-stats">
                            <div class="workspace-stat">
                                <dt>@Loc["siem_last_shipped"]</dt>
                                <dd>@(sink.LastShippedAt is { } shipped ? shipped.ToLocalTime().ToString("g") : "—")</dd>
                            </div>
                            <div class="workspace-stat">
                                <dt>@Loc["siem_last_attempt"]</dt>
                                <dd>@(sink.LastAttemptAt is { } tried ? tried.ToLocalTime().ToString("g") : "—")</dd>
                            </div>
                            <div class="workspace-stat">
                                <dt>@Loc["siem_failures"]</dt>
                                <dd>@sink.ConsecutiveFailures</dd>
                            </div>
                        </dl>

                        @if (!string.IsNullOrEmpty(sink.LastError))
                        {
                            <p class="db-p db-text-muted workspace-hint">@Loc["siem_last_error", sink.LastError]</p>
                        }
                    </div>
                </div>
            }
        }
    </section>;

    private string Format => sink?.Format ?? SiemFormat.Json;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        var isHtmxRequest = string.Equals(
            ctx.Request.Headers[HtmxHeaders.Request].FirstOrDefault(),
            HtmxHeaders.RequestValue,
            StringComparison.OrdinalIgnoreCase);

        if (!isHtmxRequest) return;

        isChunkRequest = true;

        var seat = await WorkspaceAuditReader.ResolveAdminSeatAsync(Workspaces, Db, ctx, CancellationToken.None);
        if (seat is null) return;

        isAdmin = true;
        sink = await Db.SiemSinks
            .AsNoTracking()
            .FirstOrDefaultAsync(s => s.WorkspaceId == seat.WorkspaceId, CancellationToken.None);
    }
}

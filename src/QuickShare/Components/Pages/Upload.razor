@layout MainLayout
@page "/send"
@using System.Text.Json
@using System.Text.Json.Serialization
@using QuickShare.Infrastructure.Caching
@inject IConfiguration Config
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<QuickShare.SharedLoc> Loc
@inject AppDbContext Db

@{
    // API and pages are same-origin now; browser JS uses relative URLs.
    var apiBase = string.Empty;

    // The idle subtext is auth-aware: anonymous visitors see the sign-up nudge,
    // signed-in users see their plan's per-file limit (mirrors the Pricing page).
    var isAuthenticated = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true;
    var plan = PlanTierLimits.Free;
    string idleSubtext;
    if (isAuthenticated)
    {
        var userIdClaim = HttpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.NameIdentifier);
        if (Guid.TryParse(userIdClaim, out var userId))
        {
            plan = StaticCache.Instance.GetOrSet(
                $"user:plan:{userId}",
                () => Db.Users
                    .AsNoTracking()
                    .Where(x => x.Id == userId)
                    .Select(x => x.Plan)
                    .FirstOrDefault() ?? PlanTierLimits.Free,
                TimeSpan.FromMinutes(10)
            );
        }

        idleSubtext = plan switch
        {
            PlanTierLimits.Pro => Loc["pricing_pro_feat_size"],
            PlanTierLimits.Studio => Loc["pricing_studio_feat_size"],
            _ => Loc["pricing_free_feat_size"],
        };
    }
    else
    {
        idleSubtext = Loc["upload_idle_sub_limit"];
    }

    var canSchedule = plan is PlanTierLimits.Pro or PlanTierLimits.Studio;
    maxExpiryDays = (int)Math.Max(1, Math.Round(PlanTierLimits.GetMaxExpiry(plan ?? PlanTierLimits.Free).TotalDays));
}

<PageTitle>@Loc["upload_title"]</PageTitle>

<PageWrapper Variant="PageVariant.Fill">
    <script>window.ZAPDROP_CONFIG = { apiBaseUrl: "@apiBase" };</script>
    <script id="upload-i18n" type="application/json">@RawJson(Strings())</script>
        <div class="container">
            <input type="file" name="file" class="sr-only" aria-label="@Loc["upload_file_input_label"]" onchange="uploadPage.onFileInput(event)" />

            @* IDLE / DRAGGING *@
            <section id="upload-idle" class="section">
                <h1 class="h1" id="upload-idle-h1">
                    <span id="upload-idle-text">@Loc["upload_idle_send_prefix"]<span class="gradient">@Loc["upload_idle_anything"]</span></span>
                    <span id="upload-drag-text" class="hidden">@Loc["upload_drag_drop_file"]</span>
                </h1>
                <p class="sub" id="upload-idle-sub">
                    <span id="upload-idle-subtext">@idleSubtext</span>
                    <span id="upload-drag-subtext" class="hidden">@Loc["upload_drag_release"]</span>
                </p>

                <div>
                    <div id="dropzone"
                         ondragover="uploadPage.onDragOver(event)"
                         ondragenter="uploadPage.onDragOver(event)"
                         ondragleave="uploadPage.onDragLeave(event)"
                         ondrop="uploadPage.onDrop(event)"
                         class="dropzone"
                         onclick="uploadPage.triggerFileInput()">
                        <div class="dropzone-icon">
                            @* Pixel arrow rising into the disk slot *@
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <rect x="2" y="2" width="12" height="3" fill="currentColor"/>
                                <rect x="6" y="3" width="4" height="1" fill="var(--db-sheet-raised)"/>
                                <rect x="7" y="7" width="2" height="7" fill="currentColor"/>
                                <rect x="5" y="9" width="2" height="2" fill="currentColor"/>
                                <rect x="9" y="9" width="2" height="2" fill="currentColor"/>
                            </svg>
                        </div>
                        <div>
                            <p class="dropzone-title" id="dropzone-title">
                                <span id="dropzone-idle">@Loc["upload_dropzone_idle"]</span>
                                <span id="dropzone-drag" class="hidden">@Loc["upload_dropzone_drag"]</span>
                            </p>
                            <p class="dropzone-sub">
                                <span id="dropzone-sub">@Loc["upload_dropzone_sub"]</span>
                            </p>
                        </div>
                    </div>
                </div>

                @* Text snippet sharing (issue #178) — paste text, share without a file *@
                <button type="button" class="db-btn db-btn--ghost db-btn--sm upload-text-toggle"
                        onclick="uploadPage.toggleTextMode()" data-ai-action="upload.shareText.toggle">@Loc["upload_share_text_toggle"]</button>
                <div id="upload-text-mode" class="hidden upload-text-mode">
                    <textarea id="upload-text-input" class="sender-email-input upload-text-input" rows="6"
                              placeholder="@Loc["upload_share_text_placeholder"]" maxlength="100000"></textarea>
                    <button type="button" class="db-btn db-btn--primary"
                            onclick="uploadPage.shareText()" data-ai-action="upload.shareText.submit">@Loc["upload_share_text_btn"]</button>
                </div>

                @* Upload from URL (issue #57) — Pro/Studio server-side remote fetch *@
                @if (canSchedule)
                {
                    <button type="button" class="db-btn db-btn--ghost db-btn--sm upload-text-toggle"
                            onclick="uploadUrl.toggle()" data-ai-action="upload.fromUrl.toggle">@Loc["upload_url_toggle"]</button>
                    <div id="upload-url-mode" class="hidden upload-text-mode">
                        <div class="upload-url-row">
                            <input type="url" id="upload-url-input" class="sender-email-input" placeholder="@Loc["upload_url_placeholder"]" autocomplete="off" aria-label="@Loc["upload_url_toggle"]" />
                            <button type="button" class="db-btn db-btn--primary" id="upload-url-btn"
                                    onclick="uploadUrl.fetch()" data-ai-action="upload.fromUrl.submit">@Loc["upload_url_fetch"]</button>
                        </div>
                        <div id="upload-url-status" class="upload-url-status hidden" role="status"
                             data-fetching="@Loc["upload_url_fetching"]" data-failed="@Loc["upload_url_failed"]"></div>
                        <div id="upload-url-success" class="upload-url-success hidden">
                            <input id="upload-url-link" type="text" readonly class="share-input" aria-label="@Loc["upload_share_link_label"]" />
                            <button type="button" class="db-btn db-btn--ghost db-btn--sm" onclick="uploadUrl.copy()">@Loc["upload_copy_link"]</button>
                        </div>
                    </div>
                }

                @* Protect your link (issues #44 + OTP gate) — optional password and/or 6-digit code *@
                <div class="sender-email-wrap">
                    <span class="otp-label">@Loc["upload_protect_label"]</span>

                    <label for="upload-password" class="protect-sub">@Loc["upload_password_label"]</label>
                    <input type="password" id="upload-password" class="sender-email-input" maxlength="@Delivery.PasswordMaxLength" autocomplete="new-password" placeholder="@Loc["upload_password_placeholder"]" oninput="uploadPage.passwordInput(event)" />
                    @* Live strength meter (issue #287) — client-side only, hidden until typing starts *@
                    <div id="upload-password-meter" class="pw-meter hidden" aria-live="polite"
                         data-weak="@Loc["upload_pw_weak"]" data-fair="@Loc["upload_pw_fair"]" data-strong="@Loc["upload_pw_strong"]">
                        <span class="pw-meter__bar"><span class="pw-meter__fill"></span></span>
                        <span class="pw-meter__label"></span>
                    </div>
                    <span class="otp-hint">@Loc["upload_password_hint"]</span>

                    <span class="protect-sub">@Loc["upload_otp_label"]</span>
                    <div id="upload-otp" class="db-otp" style="gap: 0.5rem; margin-top: 0.5rem">
                        <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,0)" onkeydown="uploadPage.otpKeydown(event,0)" onchange="uploadPage.readOtp()" autocomplete="off" />
                        <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,1)" onkeydown="uploadPage.otpKeydown(event,1)" onchange="uploadPage.readOtp()" autocomplete="off" />
                        <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,2)" onkeydown="uploadPage.otpKeydown(event,2)" onchange="uploadPage.readOtp()" autocomplete="off" />
                        <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,3)" onkeydown="uploadPage.otpKeydown(event,3)" onchange="uploadPage.readOtp()" autocomplete="off" />
                        <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,4)" onkeydown="uploadPage.otpKeydown(event,4)" onchange="uploadPage.readOtp()" autocomplete="off" />
                        <input type="text" class="db-otp__input" inputmode="numeric" maxlength="1" oninput="uploadPage.otpInput(event,5)" onkeydown="uploadPage.otpKeydown(event,5)" onchange="uploadPage.readOtp()" autocomplete="off" />
                    </div>
                    <span class="otp-hint">@Loc["upload_otp_hint"]</span>
                </div>

                @* Burn-after-download (issue #12) — single-use link *@
                <div class="sender-email-wrap">
                    <label class="otp-label burn-toggle">
                        <input type="checkbox" id="upload-burn" />
                        <span>@Loc["upload_burn_label"]</span>
                    </label>
                    <span class="otp-hint">@Loc["upload_burn_hint"]</span>
                </div>

                @* Extension requests (issue #233) — recipients may ask for more time *@
                <div class="sender-email-wrap">
                    <label class="otp-label burn-toggle">
                        <input type="checkbox" id="upload-allow-requests" />
                        <span>@Loc["upload_allow_requests_label"]</span>
                    </label>
                    <span class="otp-hint">@Loc["upload_allow_requests_hint"]</span>
                </div>

                @* Privacy mode (issue #187) — no tracking, no analytics, no visible counts *@
                <div class="sender-email-wrap">
                    <label class="otp-label burn-toggle">
                        <input type="checkbox" id="upload-privacy" />
                        <span>@Loc["upload_privacy_label"]</span>
                    </label>
                    <span class="otp-hint">@Loc["upload_privacy_hint"]</span>
                </div>

                @* Metadata strip (issue #170) — privacy-first, on by default *@
                <div class="sender-email-wrap">
                    <label class="otp-label burn-toggle">
                        <input type="checkbox" id="upload-strip-metadata" checked />
                        <span>@Loc["upload_strip_metadata_label"]</span>
                    </label>
                    <span class="otp-hint">@Loc["upload_strip_metadata_hint"]</span>
                </div>

                @* Auto-compress images (issue #63) — saves bandwidth, on by default *@
                <div class="sender-email-wrap">
                    <label class="otp-label burn-toggle">
                        <input type="checkbox" id="upload-compress" checked />
                        <span>@Loc["upload_compress_label"]</span>
                    </label>
                    <span class="otp-hint">@Loc["upload_compress_hint"]</span>
                </div>




                @* Sender note (issue #137) — optional, plain text, rendered escaped on /d *@
                <div class="sender-email-wrap">
                    <label for="upload-message" class="otp-label">@Loc["upload_message_label"]</label>
                    <textarea id="upload-message" class="sender-email-input" rows="2" maxlength="@Delivery.MessageMaxLength" placeholder="@Loc["upload_message_placeholder"]"></textarea>
                    <span class="otp-hint">@Loc["upload_message_hint"]</span>
                </div>

                @* Expiry options (issue #22) — options rendered per plan; server clamps to plan max *@
                <div class="sender-email-wrap">
                    <label for="upload-expiry" class="otp-label">@Loc["upload_expiry_label"]</label>
                    @if (canSchedule)
                    {
                        <input type="number" id="upload-expiry-days" class="sender-email-input" min="1" max="@maxExpiryDays" value="@maxExpiryDays" inputmode="numeric" aria-label="@Loc["upload_expiry_label"]" />
                        <span class="otp-hint">@Loc["upload_expiry_days_hint", maxExpiryDays]</span>
                    }
                    else
                    {
                        <select id="upload-expiry" class="sender-email-input">
                            <option value="2">@Loc["upload_expiry_2h"]</option>
                            <option value="24" selected>@Loc["upload_expiry_24h"]</option>
                            <option value="168">@Loc["upload_expiry_7d"]</option>
                        </select>
                        <span class="otp-hint">@Loc["upload_expiry_hint"]</span>
                    }
                </div>

                @* Optional sender email — anonymous only: signed-in users already have email on their account. *@
                @if (!isAuthenticated)
                {
                    <div class="sender-email-wrap">
                        <label for="upload-sender-email" class="otp-label">@Loc["upload_sender_email_label"]</label>
                        <input type="email" id="upload-sender-email" class="sender-email-input" inputmode="email" autocomplete="email" placeholder="@Loc["upload_sender_email_placeholder"]" />
                        <span class="otp-hint">@Loc["upload_sender_email_hint"]</span>
                    </div>
                }

                @* Multi-recipient share (issue #37) — email the link to N people at upload *@
                <div class="sender-email-wrap">
                    <label for="upload-recipients" class="otp-label">@Loc["upload_recipients_label"]</label>
                    <input type="text" id="upload-recipients" class="sender-email-input" autocomplete="off" placeholder="@Loc["upload_recipients_placeholder"]" />
                    <span class="otp-hint">@Loc["upload_recipients_hint"]</span>
                </div>

                @if (canSchedule)
                {
                    <div class="sender-email-wrap">
                        <label for="upload-deliver-at" class="otp-label">@Loc["upload_deliver_at_label"]</label>
                        <input type="datetime-local" id="upload-deliver-at" class="sender-email-input" />
                        <span class="otp-hint">@Loc["upload_deliver_at_hint"]</span>
                    </div>
                }

                <div id="upload-paste-tip" class="hidden ">@Loc["upload_paste_no_image"]</div>
            </section>

            @* UPLOADING *@
            <section id="upload-uploading" class="section hidden">
                <div class="db-spinner db-spinner--lg "></div>
                <h1 class="status-h1" id="upload-filename"></h1>
                <p class="status-p" id="upload-progress-label"></p>
                <div id="upload-encrypt-badge" class="badge-encrypt">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16" r="1" />
                    </svg>
                    @Loc["upload_encrypted"]
                </div>
                <div class="progress-wrap">
                    <div class="progress-track">
                        <div id="upload-progress-bar" class="progress-fill" style="width: 0%" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
                <button id="upload-cancel-btn" class="db-btn db-btn--ghost" style="margin-top: 2.5rem" onclick="uploadPage.cancelUpload()">@Loc["upload_cancel"]</button>
            </section>

            @* SUCCESS *@
            <section id="upload-success" class="section hidden">
                <div class="icon-success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                </div>
                <h1 class="status-h1" style="margin-top: 1.5rem">@Loc["upload_success_title"]</h1>
                <p class="status-p" id="upload-success-name"></p>

                <div class="share-box">
                    @* The new delivery's card: striped chrome, then its address. *@
                    <div class="qs-titlebar">
                        <span class="qs-titlebar__box" aria-hidden="true"></span>
                        <label for="share-link" class="qs-titlebar__label">@Loc["upload_share_link_label"]</label>
                        <span class="qs-titlebar__box" aria-hidden="true"></span>
                    </div>
                    <div class="share-row">
                        <input id="share-link" type="text" readonly class="share-input" aria-label="@Loc["upload_share_link_label"]" />
                        <button type="button" id="upload-share-btn" aria-label="@Loc["upload_share_aria"]" class="db-btn" onclick="uploadPage.shareLink()" data-ai-action="upload.share.sheet">@Loc["upload_share_btn"]</button>
                        <button type="button" aria-label="@Loc["upload_copy_link_aria"]" class="db-btn db-btn--primary" id="upload-copy-btn" onclick="uploadPage.copyLink()">
                            <span id="upload-copy-text">@Loc["upload_copy_link"]</span>
                            <span id="upload-copied-text" class="hidden">@Loc["upload_copied"]</span>
                        </button>
                    </div>
                    <p id="upload-expiry-label" style="margin-top: 0.75rem; font-size: 0.75rem; color: var(--db-color-text-muted)"></p>
                </div>

                <div id="qrcode" style="margin-top: 2rem; display: flex; justify-content: center"></div>

                <div id="upload-success-encrypt-badge" class="badge-encrypt" style="margin-top: 1rem">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16" r="1" />
                    </svg>
                    @Loc["upload_encrypted_key_in_link"]
                </div>
                <FeedbackWidget Page="send" />

                <button class="db-btn db-btn--ghost" style="margin-top: 2rem" onclick="uploadPage.reset()">@Loc["upload_send_another"]</button>
            </section>

            @* ERROR *@
            <section id="upload-error" class="section hidden">
                <div class="icon-error">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                </div>
                <h1 class="status-h1">@Loc["upload_error_title"]</h1>
                <p class="status-p" id="upload-error-msg">@Loc["upload_error_unknown"]</p>
                <div style="margin-top: 2.5rem; display: flex; gap: 0.75rem; justify-content: center">
                    <button id="upload-resume-btn" class="db-btn db-btn--primary hidden" onclick="uploadPage.resumeUpload()">@Loc["upload_resume"]</button>
                    <button class="db-btn" onclick="uploadPage.reset()">@Loc["upload_try_again"]</button>
                </div>
            </section>

    @* Rewarded ad for free-plan users *@
    <div class="upload-ad-section">
        <AdComponent />
    </div>
        </div>
</PageWrapper>

<script src="/js/paste-anywhere.js"></script>
<script src="/js/upload.js"></script>

<script>
    window.uploadUrl = {
        toggle: function () {
            document.getElementById('upload-url-mode').classList.toggle('hidden');
        },
        fetch: function () {
            var input = document.getElementById('upload-url-input');
            var url = input.value.trim();
            if (!url) return;
            var btn = document.getElementById('upload-url-btn');
            var status = document.getElementById('upload-url-status');
            var success = document.getElementById('upload-url-success');
            success.classList.add('hidden');
            btn.disabled = true;
            status.textContent = status.dataset.fetching;
            status.classList.remove('hidden');
            fetch('/api/upload-from-url', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url: url })
            }).then(function (r) {
                return r.json().then(function (data) { return { ok: r.ok, data: data }; });
            }).then(function (res) {
                btn.disabled = false;
                if (res.ok) {
                    status.classList.add('hidden');
                    document.getElementById('upload-url-link').value = res.data.shareLink;
                    success.classList.remove('hidden');
                } else {
                    status.textContent = status.dataset.failed;
                }
            }).catch(function () {
                btn.disabled = false;
                status.textContent = status.dataset.failed;
            });
        },
        copy: function () {
            var link = document.getElementById('upload-url-link');
            link.focus();
            link.select();
            try { document.execCommand('copy'); } catch (_) { }
        }
    };
</script>

@code {
    private int maxExpiryDays = 30;

    // upload.js reads its copy from here rather than carrying English literals.
    private Dictionary<string, string> Strings() => new()
    {
        ["errorUnknown"] = Loc["upload_error_unknown"],
        ["expiryLabel"] = Loc["upload_expiry_at"],
        ["starting"] = Loc["upload_starting"],
        ["failed"] = Loc["upload_failed"],
        ["sizeExceeded"] = Loc["upload_size_exceeded"],
        ["startFailed"] = Loc["upload_start_failed"],
        ["urlRefreshFailed"] = Loc["upload_url_refresh_failed"],
        ["partFailed"] = Loc["upload_part_failed"],
        ["finalizeFailed"] = Loc["upload_finalize_failed"],
        ["qrNotLoaded"] = Loc["upload_qr_not_loaded"],
        ["qrAria"] = Loc["upload_qr_aria"],
        ["qrUnavailable"] = Loc["upload_qr_unavailable"],
        ["shareTitle"] = Loc["upload_share_title"],
        ["shareText"] = Loc["upload_share_text"],
    };

    // MarkupString: a plain string gets HTML-encoded by Razor even inside <script>,
    // which breaks JSON.parse in upload.js (quotes become &quot;). The default
    // System.Text.Json encoder escapes <, > and & so raw emission stays safe.
    private static MarkupString RawJson(Dictionary<string, string> strings) => new(JsonSerializer.Serialize(strings, JsonOptions));

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase, PropertyNameCaseInsensitive = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
}


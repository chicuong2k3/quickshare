@layout MainLayout
@page "/account/billing"
@attribute [Authorize]
@using QuickShare.Data
@using QuickShare.Features.Payments
@using QuickShare.Features.Payments.Subscriptions
@using QuickShare.Infrastructure.Caching
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.Extensions.Localization
@inject AppDbContext Db
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Config
@inject IStringLocalizer<QuickShare.SharedLoc> Loc
@inject IAntiforgery Antiforgery

<PageTitle>@Loc["billing_title"]</PageTitle>

<PageWrapper Variant="PageVariant.Padded">

    <section class="hero">
        <h1 class="text-3xl font-semibold">@Loc["billing_h1"]</h1>
    </section>

    <AccountTabs Current="@RoutePaths.AccountBilling" />

    <section class="billing-body" id="billing-body">
        @if (billing is null)
        {
            <p class="text-muted-foreground">@Loc["billing_loading"]</p>
        }
        else
        {
            @if (trialDaysLeft is { } daysLeft)
            {
                <div class="mb-5 flex flex-wrap items-center gap-3 rounded-md border bg-card px-5 py-4" role="status">
                    <strong>@Loc["trial_banner_title"]</strong>
                    <span class="text-sm text-muted-foreground">@Loc["trial_banner_sub", daysLeft]</span>
                    <Button Href="/pricing" Size="sm" class="ml-auto" data-ai-action="billing.trial.convert">@Loc["billing_btn_upgrade"]</Button>
                </div>
            }
            <div class="summary-card">
                <div class="summary-card__head">
                    <h2 class="text-2xl font-semibold">@billing.PlanDisplay @Loc["billing_plan_suffix"]</h2>
                    <p class="text-muted-foreground">@planDescription</p>
                </div>
                <div class="summary-card__price">
                    <span class="price-amount">@planPrice</span>
                    <span class="price-period text-muted-foreground">@billingPeriodLabel</span>
                </div>
                <div class="summary-card__features">
                    @foreach (var feature in planFeatures)
                    {
                        <div class="feature">
                            <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                            <span>@feature</span>
                        </div>
                    }
                </div>

                @if (billing.Plan == PlanTierLimits.Free && subscription?.IsPaused != true)
                {
                    <Button Href="/pricing" class="mt-6 w-full">@Loc["billing_btn_upgrade"]</Button>
                }
                else
                {
                    @if (subscription?.Status == SubscriptionStatus.Cancelled)
                    {
                        <p class="mt-4 text-muted-foreground">
                            @string.Format(Loc["billing_cancelled"], subscription.CurrentPeriodEnd.ToString("MMM dd, yyyy"))
                        </p>
                        <Button Href="/pricing" class="mt-4 w-full">@Loc["billing_btn_renew"]</Button>
                    }
                    else if (subscription?.IsPaused == true)
                    {
                        <p class="mt-4 text-muted-foreground">
                            @Loc["billing_paused", subscription.PausedDaysBanked]
                        </p>
                        <div class="summary-card__actions">
                            <form method="post" style="display:inline" @formname="billing-resume" @onsubmit="HandleSubmit">
                                <AntiforgeryToken />
                                <input type="hidden" name="Action" value="@SubscriptionActionResume" />
                                <Button Type="submit">@Loc["billing_btn_resume"]</Button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="summary-card__actions">
                            <Button Href="/pricing" Variant="secondary">@Loc["billing_btn_change"]</Button>

                            @* A hold is offered before the exit, not hidden behind it: somebody
                               taking a break should not have to cancel to stop paying. *@
                            <form method="post" style="display:inline" @formname="billing-pause" @onsubmit="HandleSubmit">
                                <AntiforgeryToken />
                                <input type="hidden" name="Action" value="@SubscriptionActionPause" />
                                <Button Type="submit" Variant="secondary">@Loc["billing_btn_pause"]</Button>
                            </form>

                            <form method="post" style="display:inline" @formname="billing-cancel" @onsubmit="HandleSubmit">
                                <AntiforgeryToken />
                                <input type="hidden" name="Action" value="@SubscriptionActionCancel" />
                                <label class="block text-sm font-medium" for="cancel-reason">@Loc["billing_cancel_reason"]</label>
                                <select id="cancel-reason" name="Reason" class="rounded-md border bg-background px-3 py-2">
                                    @foreach (var reason in CancellationReasons.All)
                                    {
                                        <option value="@reason">@Loc[$"billing_reason_{reason}"]</option>
                                    }
                                </select>
                                <label class="block text-sm font-medium" for="cancel-feedback">@Loc["billing_cancel_feedback"]</label>
                                <textarea id="cancel-feedback" name="Feedback" class="rounded-md border bg-background px-3 py-2" rows="2"
                                          maxlength="@Subscription.CancellationFeedbackMaxLength"></textarea>
                                <Button Type="submit" Variant="destructive">
                                    @Loc["billing_btn_cancel"]
                                </Button>
                            </form>
                        </div>
                    }
                }
            </div>

            <div class="history">
                <h2 class="text-2xl font-semibold">@Loc["billing_history_title"]</h2>

                @if (billing.Events.Count == 0)
                {
                    <p class="text-muted-foreground">@Loc["billing_history_empty"]</p>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var evt in billing.Events)
                        {
                            <div class="timeline-item">
                                <div class="timeline-item__dot @eventDotClass(evt.EventType)"></div>
                                <div class="timeline-item__content">
                                    <div class="timeline-item__label">@evt.EventLabel</div>
                                    <div class="timeline-item__meta text-muted-foreground">
                                        @evt.CreatedAt.ToString("MMM dd, yyyy")
                                        @if (evt.Amount > 0)
                                        {
                                            <span>· @evt.Amount.ToString("F2") @evt.Currency</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(evt.InvoiceUrl))
                                    {
                                        <a href="@evt.InvoiceUrl" target="_blank" rel="noopener noreferrer" class="text-primary underline">@Loc["billing_view_receipt"]</a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>

</PageWrapper>

@code {
    private const string SubscriptionActionCancel = "cancel";
    private const string SubscriptionActionPause = "pause";
    private const string SubscriptionActionResume = "resume";

private BillingHistoryResponse? billing;
private Subscription? subscription;
private int? trialDaysLeft;

    private string planPrice => (billing?.Plan, billingPeriod) switch
    {
        (PlanTierLimits.Pro, BillingPeriods.Monthly) => FormatPrice(Config.GetValue<int>(PricingKeys.ProMonthly, 9)),
        (PlanTierLimits.Pro, BillingPeriods.Yearly) => FormatPrice(Config.GetValue<int>(PricingKeys.ProYearly, 77)),
        (PlanTierLimits.Studio, BillingPeriods.Monthly) => FormatPrice(Config.GetValue<int>(PricingKeys.StudioMonthly, 29)),
        (PlanTierLimits.Studio, BillingPeriods.Yearly) => FormatPrice(Config.GetValue<int>(PricingKeys.StudioYearly, 239)),
        _ => "$0"
    };

    private string FormatPrice(int amount)
    {
        var currency = Config[PricingKeys.Currency] ?? "$";
        return $"{currency}{amount}";
    }

    private string planDescription => billing?.Plan switch
    {
        PlanTierLimits.Pro => Loc["billing_pro_desc"],
        PlanTierLimits.Studio => Loc["billing_studio_desc"],
        _ => Loc["billing_free_desc"]
    };

    private string[] planFeatures => billing?.Plan switch
    {
        PlanTierLimits.Pro => Loc["billing_feat_pro"].Value.Split(" | "),
        PlanTierLimits.Studio => Loc["billing_feat_studio"].Value.Split(" | "),
        _ => Loc["billing_feat_free"].Value.Split(" | ")
    };

    private string billingPeriod => (subscription?.BillingPeriod ?? BillingPeriod.Monthly).ToString().ToLowerInvariant();

    private string billingPeriodLabel => billing?.Plan == PlanTierLimits.Free ? Loc["billing_period_label"] : $"/ {billingPeriod}";

    private string eventDotClass(string eventType) => eventType switch
    {
        PaymentEventTypes.SubscriptionCreated => "dot--created",
        PaymentEventTypes.SubscriptionRenewed => "dot--renewed",
        PaymentEventTypes.SubscriptionCancelled => "dot--cancelled",
        PaymentEventTypes.SubscriptionExpired => "dot--expired",
        _ => "dot--default"
    };

    protected override Task OnInitializedAsync() => LoadBillingAsync();

    private async Task LoadBillingAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        var ct = CancellationToken.None;
        var user = await ctx.User.GetUserAsync(Db, ct);
        billing = await BillingHistoryService.GetForUserAsync(user, Db, Loc, ct);
        subscription = await SubscriptionService.GetCurrentAsync(user, Db, ct);
        trialDaysLeft = await SubscriptionService.GetTrialDaysLeftAsync(user, Db, ct);
    }

    private async Task HandleSubmit()
    {
        var ctx = HttpContextAccessor.HttpContext!;

        var ct = CancellationToken.None;
        var user = await ctx.User.GetUserAsync(Db, ct);

        try
        {
            await Antiforgery.ValidateRequestAsync(ctx);
        }
        catch (AntiforgeryValidationException)
        {
            ctx.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        var form = await ctx.Request.ReadFormAsync(ct);
        var action = form["Action"].ToString();

        if (action == SubscriptionActionPause || action == SubscriptionActionResume)
        {
            await HandleHoldAsync(user, action == SubscriptionActionPause, ct);
            await UserCacheInvalidator.EvictAsync(Db, user.Id, ct);
        }
        else if (action == SubscriptionActionCancel)
        {
            var cancelled = await SubscriptionService.CancelAsync(user, Db, ct);

            // Recorded with the exit (issue #174). A churn number without a reason tells you
            // that people left, which you already knew.
            if (cancelled is not null)
            {
                cancelled.CancellationReason = CancellationReasons.Normalize(form["Reason"].ToString());
                var feedback = form["Feedback"].ToString().Trim();
                cancelled.CancellationFeedback = feedback.Length == 0
                    ? null
                    : feedback[..Math.Min(feedback.Length, Subscription.CancellationFeedbackMaxLength)];
            }

            await Db.SaveChangesAsync(ct);

            // Evict cached user and payment history after the subscription changes.
            await UserCacheInvalidator.EvictAsync(Db, user.Id, ct);
        }

        await LoadBillingAsync();
    }

    /// <summary>
    /// Puts the subscription on hold or lifts it (issue #229).
    ///
    /// The plan follows the hold: paused means Free, because nothing is being charged for.
    /// </summary>
    private async Task HandleHoldAsync(User user, bool pause, CancellationToken ct)
    {
        var current = await Db.Subscriptions
            .Where(s => s.UserId == user.Id)
            .OrderByDescending(s => s.CurrentPeriodEnd)
            .FirstOrDefaultAsync(ct);

        if (current is null)
            return;

        var now = DateTime.UtcNow;
        var changed = pause
            ? SubscriptionLifecycle.Pause(current, now)
            : SubscriptionLifecycle.Resume(current, now);

        if (!changed)
            return;

        var plan = pause ? PlanTierLimits.Free : current.Plan;
        await Db.Users
            .Where(u => u.Id == user.Id)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(u => u.Plan, plan)
                .SetProperty(u => u.UpdatedAt, now), ct);

        user.Plan = plan;
        await Db.SaveChangesAsync(ct);
        await SubscriptionService.PushPlanToWorkspaceAsync(user.Id, Db, ct);
    }

}

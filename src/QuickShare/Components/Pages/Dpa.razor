@layout MainLayout
@page "/dpa"
@using QuickShare.Components.Shared
@using QuickShare.Features.Users.Dpa
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["dpa_title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@Loc["dpa_subtitle"]" />
</HeadContent>

@*
    The terms are public — procurement reads them before anyone signs in, and a DPA behind a
    login is a DPA their legal team cannot review. Only the signing panel needs an account.
*@
<PageWrapper Variant="PageVariant.Padded">
    <article class="legal">
        <h1 class="text-3xl font-bold tracking-tight">@Loc["dpa_title"]</h1>
        <p class="text-muted-foreground legal__version">
            @Loc["dpa_version", DpaTerms.CurrentVersion, DpaTerms.CurrentVersionDate.ToString("yyyy-MM-dd")]
        </p>
        <p>@Loc["dpa_subtitle"]</p>

        <h2 class="text-2xl font-bold">@Loc["dpa_s1_title"]</h2>
        <p>@Loc["dpa_s1_body"]</p>

        <h2 class="text-2xl font-bold">@Loc["dpa_s2_title"]</h2>
        <p>@Loc["dpa_s2_body"]</p>

        <h2 class="text-2xl font-bold">@Loc["dpa_s3_title"]</h2>
        <p>@Loc["dpa_s3_body"]</p>

        <h2 class="text-2xl font-bold">@Loc["dpa_s4_title"]</h2>
        <p>@Loc["dpa_s4_body"]</p>

        <h2 class="text-2xl font-bold">@Loc["dpa_s5_title"]</h2>
        <p>@Loc["dpa_s5_body"]</p>

        <h2 class="text-2xl font-bold">@Loc["dpa_s6_title"]</h2>
        <p>@Loc["dpa_s6_body"]</p>

        <h2 class="text-2xl font-bold">@Loc["dpa_sign_title"]</h2>

        @if (!isAuthenticated)
        {
            <p class="text-muted-foreground">@Loc["dpa_sign_login"]</p>
        }
        else if (signature is not null && signature.Version == DpaTerms.CurrentVersion)
        {
            <p>
                @Loc["dpa_signed_by", signature.SignerName, signature.CompanyName, signature.SignedAt.ToLocalTime().ToString("f")]
            </p>
            <button type="button" data-slot="button" data-variant="ghost" data-size="sm" class="dpa-print-hide"
                    onclick="window.print()" data-ai-action="dpa.print">@Loc["dpa_print"]</button>
        }
        else
        {
            @if (signature is not null)
            {
                <p class="text-muted-foreground">@Loc["dpa_resign", signature.Version, DpaTerms.CurrentVersion]</p>
            }

            <div class="workspace-form dpa-print-hide">
                <label class="workspace-label" for="dpa-company">@Loc["dpa_company"]</label>
                <Input id="dpa-company" type="text"
                       maxlength="@DpaSignature.CompanyNameMaxLength" />

                <label class="workspace-label" for="dpa-signer">@Loc["dpa_signer"]</label>
                <Input id="dpa-signer" type="text"
                       maxlength="@DpaSignature.SignerMaxLength" />

                <label class="workspace-label" for="dpa-email">@Loc["dpa_email"]</label>
                <Input id="dpa-email" type="email" value="@userEmail" />

                <button type="button" data-slot="button" data-variant="default"
                        data-signed-label="@Loc["dpa_signed_ok"]"
                        onclick="window.quickShareDpa.sign(this)"
                        data-ai-action="dpa.sign">@Loc["dpa_sign_button"]</button>
            </div>
        }

        <p class="text-muted-foreground">@Loc["dpa_not_legal_advice"]</p>
    </article>
</PageWrapper>

<script src="/js/dpa.js" defer></script>

@code {
    private bool isAuthenticated;
    private string userEmail = string.Empty;
    private DpaSignature? signature;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        isAuthenticated = ctx.User.Identity?.IsAuthenticated ?? false;
        if (!isAuthenticated) return;

        var user = await ctx.User.GetUserAsync(Db, CancellationToken.None);
        userEmail = user.Email;

        signature = await Db.DpaSignatures
            .AsNoTracking()
            .Where(d => d.UserId == user.Id)
            .OrderByDescending(d => d.SignedAt)
            .FirstOrDefaultAsync(CancellationToken.None);
    }
}

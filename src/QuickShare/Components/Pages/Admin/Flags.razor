@page "/admin/flags"
@layout MainLayout
@attribute [Authorize]
@using QuickShare.Infrastructure.FeatureFlags
@using Microsoft.Extensions.Options
@inject IStringLocalizer<QuickShare.SharedLoc> Loc
@inject IHttpContextAccessor HttpContextAccessor
@inject IFeatureFlagService FlagService
@inject IOptions<AdminOptions> AdminOpt

<PageTitle>@Loc["admin_flags_page_title"]</PageTitle>

@if (isHxRequest)
{
    <HtmxFragment>
    <div id="admin-flags-table" class="db-card admin-flags-card">
        <div class="db-card__body">
            @if (!isAdmin)
            {
                <div class="db-alert db-alert--error" role="alert">@Loc["admin_flags_forbidden"]</div>
            }
            else if (flags.Count == 0)
            {
                <p class="db-p db-text-muted">@Loc["admin_flags_empty"]</p>
            }
            else
            {
                <table class="admin-flags-table">
                    <thead>
                        <tr>
                            <th scope="col">@Loc["admin_flags_col_key"]</th>
                            <th scope="col">@Loc["admin_flags_col_enabled"]</th>
                            <th scope="col">@Loc["admin_flags_col_rollout"]</th>
                            <th scope="col"><span class="sr-only">@Loc["admin_flags_col_actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var flag in flags)
                        {
                            <tr class="admin-flag-row">
                                <td>
                                    <span class="admin-flag-key">@flag.Key</span>
                                    @if (!string.IsNullOrEmpty(flag.Description))
                                    {
                                        <span class="admin-flag-desc">@flag.Description</span>
                                    }
                                </td>
                                <td>
                                    <label class="admin-flag-toggle">
                                        <input type="checkbox"
                                               name="Enabled"
                                               value="true"
                                               checked="@flag.EffectiveEnabled"
                                               data-ai-action="admin.flags.enabled.@flag.Key" />
                                        <span>@Loc[flag.EffectiveEnabled ? "admin_flags_on" : "admin_flags_off"]</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="admin-flag-percent">
                                        <span class="sr-only">@Loc["admin_flags_rollout_label"]</span>
                                        <input type="number"
                                               name="RolloutPercent"
                                               min="0"
                                               max="100"
                                               step="1"
                                               value="@flag.EffectiveRolloutPercent"
                                               data-ai-action="admin.flags.rollout.@flag.Key" />
                                        <span aria-hidden="true">%</span>
                                    </label>
                                </td>
                                <td>
                                    <form class="admin-flag-form"
                                          hx-put="/api/admin/flags/@flag.Key"
                                          hx-swap="none"
                                          hx-on::after-request="if (event.detail.successful) htmx.ajax('GET', '/admin/flags', {target: '#admin-flags-table', select: '#admin-flags-table', swap: 'outerHTML'})"
                                          data-ai-action="admin.flags.save.@flag.Key">
                                        <button type="submit" class="db-btn db-btn--primary admin-flag-save-btn">@Loc["admin_flags_save_btn"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
    </HtmxFragment>
}
else
{
    <PageWrapper id="admin-flags-app" Variant="PageVariant.Padded">
        <div class="admin-flags-heading">
            <h1 class="db-h1">@Loc["admin_flags_title"]</h1>
            <p class="db-p db-text-muted">@Loc["admin_flags_subtitle"]</p>
        </div>

        @if (!isAdmin)
        {
            <div class="db-alert db-alert--error" role="alert">@Loc["admin_flags_forbidden"]</div>
        }
        else
        {
            <HtmxFragment>
            <div id="admin-flags-table" class="db-card admin-flags-card"
                 hx-get="@RoutePaths.AdminFlags"
                 hx-trigger="load"
                 hx-target="#admin-flags-table"
                 hx-select="#admin-flags-table"
                 hx-swap="outerHTML">
                <div class="db-card__body">
                    <div class="admin-skeleton-line admin-skeleton-row"></div>
                    <div class="admin-skeleton-line admin-skeleton-row"></div>
                    <div class="admin-skeleton-line admin-skeleton-row"></div>
                    <div class="admin-skeleton-line admin-skeleton-row"></div>
                </div>
            </div>
            </HtmxFragment>
        }
    </PageWrapper>
}

@code {
    private bool isHxRequest;
    private bool isAdmin;
    private IReadOnlyList<FeatureFlagStatus> flags = [];

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        var request = httpContext?.Request;
        isHxRequest = request is not null
            && request.Headers[HtmxHeaders.Request].FirstOrDefault() == HtmxHeaders.RequestValue;

        isAdmin = httpContext?.User.IsAdmin(AdminOpt.Value) ?? false;

        if (!isHxRequest || !isAdmin)
        {
            return;
        }

        flags = await FlagService.ListAsync(CancellationToken.None);
    }
}
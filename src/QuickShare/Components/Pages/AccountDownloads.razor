@inject IStringLocalizer<QuickShare.SharedLoc> Loc

@page "/account/downloads"
@layout MainLayout
@attribute [Authorize]
@using QuickShare.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject IHttpContextAccessor HttpContextAccessor

<Card id="downloads-card" class="my-4 w-full max-w-md p-6">
        <h3 class="text-lg font-semibold">@Loc["account_downloads_title"]</h3>

        @if (items.Count == 0)
        {
            <p class="mt-3 text-muted-foreground">@Loc["account_downloads_empty"]</p>
        }
        else
        {
            <ul class="mt-3">
                @foreach (var item in items)
                {
                    <li class="flex justify-between gap-3 border-b py-2 last:border-b-0">
                        <span class="min-w-0 truncate" title="@item.FileName">@item.FileName</span>
                        <span class="whitespace-nowrap font-mono text-sm text-muted-foreground">@item.DownloadedAt.ToLocalTime().ToString("g")</span>
                    </li>
                }
            </ul>
        }
</Card>

@code {

    private sealed record DownloadItem(string FileName, DateTime DownloadedAt);

    private List<DownloadItem> items = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await HttpContextAccessor.HttpContext!.User.GetUserAsync(Db, CancellationToken.None);
            items = await Db.DownloadTrackings
                .AsNoTracking()
                .Where(t => t.UserId == user.Id)
                .OrderByDescending(t => t.DownloadedAt)
                .Take(50)
                .Select(t => new DownloadItem(
                    Db.Deliveries.Where(d => d.Id == t.DeliveryId).Select(d => d.FileName).FirstOrDefault() ?? string.Empty,
                    t.DownloadedAt))
                .ToListAsync();
        }
        catch { }
    }
}

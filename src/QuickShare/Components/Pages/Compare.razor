@layout MainLayout
@page "/compare"
@using System.Globalization

@* Competitor comparison (issue #168) — factual, honest, SEO-targeted. *@

<PageTitle>@(IsVi ? "So sánh: QuickShare vs WeTransfer, SwissTransfer, Smash" : "QuickShare vs WeTransfer, SwissTransfer, Smash")</PageTitle>
<HeadContent>
    <meta name="description" content="@(IsVi ? "So sánh trung thực QuickShare với WeTransfer, SwissTransfer và Smash: dung lượng, thời hạn, mã hoá, tính năng." : "An honest comparison of QuickShare vs WeTransfer, SwissTransfer and Smash: limits, expiry, encryption, features.")" />
</HeadContent>

<PageWrapper Variant="PageVariant.Padded">
    <article class="legal">
        <h1 class="text-3xl font-bold tracking-tight">@(IsVi ? "So sánh QuickShare với các đối thủ" : "QuickShare vs the alternatives")</h1>
        <p class="text-muted-foreground">@(IsVi ? "Dữ liệu đối thủ là ảnh chụp năm 2026, kiểm chứng định kỳ mỗi quý. Chúng tôi chỉ nói điều chúng tôi làm được." : "Competitor data is a 2026 snapshot, re-verified quarterly. We only claim what we actually do.")</p>

        <h2 class="text-2xl font-bold">@(IsVi ? "Bảng so sánh" : "Comparison")</h2>
        <div style="overflow-x: auto">
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead scope="col"></TableHead>
                        <TableHead scope="col">QuickShare</TableHead>
                        <TableHead scope="col">WeTransfer</TableHead>
                        <TableHead scope="col">SwissTransfer</TableHead>
                        <TableHead scope="col">Smash</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    <TableRow><TableHead scope="row">@(IsVi ? "Gói miễn phí" : "Free size")</TableHead><TableCell>@(IsVi ? "Lên tới 5 GB" : "Up to 5 GB")</TableCell><TableCell>2 GB</TableCell><TableCell>50 GB</TableCell><TableCell>2 GB</TableCell></TableRow>
                    <TableRow><TableHead scope="row">@(IsVi ? "Thời hạn liên kết" : "Link lifetime")</TableHead><TableCell>@(IsVi ? "2h–7 ngày" : "2h–7 days")</TableCell><TableCell>3 days</TableCell><TableCell>30 days</TableCell><TableCell>14 days</TableCell></TableRow>
                    <TableRow><TableHead scope="row">@(IsVi ? "Mã hoá đầu-cuối" : "End-to-end encryption")</TableHead><TableCell>@(IsVi ? "Có (AES-256-GCM)" : "Yes (AES-256-GCM)")</TableCell><TableCell>No</TableCell><TableCell>No</TableCell><TableCell>No</TableCell></TableRow>
                    <TableRow><TableHead scope="row">@(IsVi ? "Mật khẩu (miễn phí)" : "Password (free)")</TableHead><TableCell>@(IsVi ? "Có" : "Yes")</TableCell><TableCell>@(IsVi ? "Trả phí" : "Paid")</TableCell><TableCell>@(IsVi ? "Có" : "Yes")</TableCell><TableCell>@(IsVi ? "Có" : "Yes")</TableCell></TableRow>
                    <TableRow><TableHead scope="row">@(IsVi ? "Truyền P2P" : "P2P transfer")</TableHead><TableCell>@(IsVi ? "Có" : "Yes")</TableCell><TableCell>No</TableCell><TableCell>No</TableCell><TableCell>No</TableCell></TableRow>
                    <TableRow><TableHead scope="row">@(IsVi ? "Xem trước file" : "File preview")</TableHead><TableCell>@(IsVi ? "Có" : "Yes")</TableCell><TableCell>@(IsVi ? "Trả phí" : "Paid")</TableCell><TableCell>@(IsVi ? "Có" : "Yes")</TableCell><TableCell>@(IsVi ? "Có" : "Yes")</TableCell></TableRow>
                    <TableRow><TableHead scope="row">@(IsVi ? "Cam kết không huấn luyện AI" : "No-AI-training pledge")</TableHead><TableCell>@(IsVi ? "Có" : "Yes")</TableCell><TableCell>No</TableCell><TableCell>—</TableCell><TableCell>@(IsVi ? "Có" : "Yes")</TableCell></TableRow>
                </TableBody>
            </Table>
        </div>

        <h2 class="text-2xl font-bold">@(IsVi ? "Điểm khác biệt của chúng tôi" : "Where we differ")</h2>
        <ul class="legal__list">
            @if (IsVi)
            {
                <li>Mã hoá đầu-cuối: máy chủ không đọc được nội dung file.</li>
                <li>Truyền P2P trình duyệt-tới-trình duyệt, không lưu trên máy chủ.</li>
                <li>Mật khẩu bảo vệ miễn phí, tự huỷ sau 1 lần tải, mã SHA-256.</li>
                <li>Cam kết không dùng file để huấn luyện AI.</li>
            }
            else
            {
                <li>End-to-end encryption: the server cannot read file contents.</li>
                <li>P2P browser-to-browser transfer, never stored on our servers.</li>
                <li>Free password protection, burn-after-download, SHA-256 checksums.</li>
                <li>A pledge never to use files for AI training.</li>
            }
        </ul>

        <h2 class="text-2xl font-bold">@(IsVi ? "Khi nào họ tốt hơn" : "When they're better")</h2>
        <p>@(IsVi ? "Thành thật: SwissTransfer cho gửi miễn phí tới 50 GB với liên kết 30 ngày — nếu bạn cần gửi file cực lớn, miễn phí, không cần mã hoá, họ hợp hơn. WeTransfer có thương hiệu quen thuộc hơn với người dùng quốc tế. QuickShare hợp nhất khi bạn quan tâm quyền riêng tư, mã hoá và thị trường Việt Nam (Zalo, dữ liệu di động)." : "Honestly: SwissTransfer offers up to 50 GB free with 30-day links — for a very large, free, unencrypted send, they win. WeTransfer has more brand recognition internationally. QuickShare wins when you care about privacy, encryption, and the Vietnamese market (Zalo, mobile data).")</p>

        <p><a class="text-primary underline-offset-4 hover:underline" href="@RoutePaths.Send">@(IsVi ? "Gửi file miễn phí →" : "Send a file free →")</a></p>
    </article>
</PageWrapper>

@code {
    private static bool IsVi => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi";
}

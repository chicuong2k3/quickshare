@layout MainLayout
@page "/tools/gui-anh-khong-nen"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<ToolsLanding Heading="@Loc["tools_images_heading"]"
              Description="@Loc["tools_images_desc"]"
              Lede="@Loc["tools_images_lede"]"
              PasteHint="@Loc["tools_images_pastehint"]">
    <Body>
        <h2 class="db-h2">@Loc["tools_images_why_title"]</h2>
        <p>@Loc["tools_images_why_body"]</p>

        <h2 class="db-h2">@Loc["tools_images_how_title"]</h2>
        <p>@Loc["tools_images_how_body"]</p>

        <h2 class="db-h2">@Loc["tools_images_diff_title"]</h2>
        <ul>
            <li>@Loc["tools_images_diff_1"]</li>
            <li>@Loc["tools_images_diff_2"]</li>
            <li>@Loc["tools_images_diff_3"]</li>
            <li>@Loc["tools_images_diff_4"]</li>
        </ul>
    </Body>
</ToolsLanding>
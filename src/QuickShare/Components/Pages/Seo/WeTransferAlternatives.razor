@layout MainLayout
@page "/wetransfer-alternatives"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<SeoLanding Heading="@Loc["seo_wt_h1"]"
            Description="@Loc["seo_wt_desc"]"
            Lede="@Loc["seo_wt_lede"]"
            CtaLabel="@Loc["seo_wt_cta"]">
    <Body>
        <h2 class="db-h2">@Loc["seo_wt_compare_title"]</h2>
        <ul>
            <li>@Loc["seo_wt_compare_1"]</li>
            <li>@Loc["seo_wt_compare_2"]</li>
            <li>@Loc["seo_wt_compare_3"]</li>
            <li>@Loc["seo_wt_compare_4"]</li>
        </ul>

        <h2 class="db-h2">@Loc["seo_wt_note_title"]</h2>
        <p>@Loc["seo_wt_note_body"]</p>
    </Body>
</SeoLanding>

@layout MainLayout
@page "/p2p-file-transfer"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<SeoLanding Heading="@Loc["seo_p2p_h1"]"
            Description="@Loc["seo_p2p_desc"]"
            Lede="@Loc["seo_p2p_lede"]"
            CtaLabel="@Loc["seo_p2p_cta"]">
    <Body>
        <h2 class="db-h2">@Loc["seo_p2p_how_title"]</h2>
        <p>@Loc["seo_p2p_how_body"]</p>

        <h2 class="db-h2">@Loc["seo_p2p_when_title"]</h2>
        <p>@Loc["seo_p2p_when_body"]</p>
    </Body>
</SeoLanding>

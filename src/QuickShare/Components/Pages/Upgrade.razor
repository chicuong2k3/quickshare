@layout MainLayout
@page "/upgrade"
@attribute [Authorize]
@using Microsoft.AspNetCore.Antiforgery
@using QuickShare.Features.Payments
@using QuickShare.Features.Payments.PayOS
@using QuickShare.Features.Payments.Promos
@using QuickShare.Features.Payments.Subscriptions
@using QuickShare.Features.Users.Shared
@using QuickShare.Infrastructure.Caching
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject IConfiguration Config
@inject CheckoutService Checkout
@inject CacheService Cache
@inject IStringLocalizer<QuickShare.SharedLoc> Loc
@inject IAntiforgery Antiforgery
@inject AnalyticsService Analytics

<PageTitle>@string.Format(Loc["upgrade_page_title"], planDisplay)</PageTitle>

@if (isPollRequest)
{
    @PaymentStatus
}
else
{
    <PageWrapper Variant="PageVariant.Padded">
        <section class="mx-auto max-w-2xl space-y-6">
            <header class="text-center">
                <h1 class="text-3xl font-semibold">@string.Format(Loc["upgrade_h1"], planDisplay)</h1>
                <p class="mt-2 text-muted-foreground">
                    @Loc["upgrade_current_plan"]<strong>@currentPlan</strong>@Loc["upgrade_current_plan_suffix"]
                    @string.Format(Loc["upgrade_plan_brings"], planDisplay, planSummary)
                </p>
            </header>

            @if (activeCampaign is not null)
            {
                <div id="upgrade-campaign-banner" class="rounded-md border border-primary/40 bg-primary/5 p-4 text-sm" role="status">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <span class="rounded bg-primary px-2 py-0.5 text-xs font-semibold text-primary-foreground">@activeCampaign.CampaignName</span>
                            <strong class="ml-2">@(activeCampaign.Description ?? activeCampaign.CampaignName)</strong>
                        </div>
                        <span class="font-mono text-xs">@Loc["campaign_auto_applied"]: <strong>@activeCampaign.Code</strong> (-@activeCampaign.Value%)</span>
                    </div>
                </div>
            }

            <Card class="px-6">
                <div class="text-center">
                    <h2 class="text-2xl font-semibold">@planDisplay</h2>
                    <p class="text-muted-foreground">@Loc[$"upgrade_plan_desc_{planKey}"]</p>
                    <p class="mt-4 text-3xl font-semibold">
                        @(IsYearly ? planYearlyPrice : planMonthlyPrice)
                        <span class="text-sm font-normal text-muted-foreground">@(IsYearly ? Loc["upgrade_period_yearly"] : Loc["upgrade_period_monthly"])</span>
                    </p>
                </div>
                <ul class="space-y-2 text-sm">
                    @foreach (var featureKey in planFeatureKeys)
                    {
                        <li>@Loc[featureKey]</li>
                    }
                </ul>
            </Card>

            <Card id="upgrade-body" class="px-6">
                <h2 class="text-2xl font-semibold">@Loc["upgrade_complete_title"]</h2>
                <p class="text-muted-foreground">
                    @((MarkupString)string.Format(Loc["upgrade_complete_desc"], $"<strong>{planDisplay}</strong>", IsYearly ? Loc["upgrade_billing_yearly_label"] : Loc["upgrade_billing_monthly_label"], $"<strong>{(IsYearly ? planYearlyPrice : planMonthlyPrice)}</strong>"))
                </p>

                @if (currentPlan == PlanTierLimits.Free && paymentIntent is null)
                {
                    <section class="space-y-3 rounded-md border p-4">
                        <h3 class="font-semibold">@Loc["trial_option_title"]</h3>
                        <p class="text-sm text-muted-foreground">@Loc["trial_option_desc"]</p>
                        @if (trialError)
                        {
                            <p class="text-destructive" role="alert">@Loc["trial_option_error"]</p>
                        }
                        <form method="post" @formname="upgrade-trial" @onsubmit="HandleSubmit">
                            <AntiforgeryToken />
                            <input type="hidden" name="@ActionField" value="@TrialAction" />
                            <Button Type="submit" class="w-full" data-ai-action="upgrade.trial.start">@Loc["trial_option_btn"]</Button>
                        </form>
                    </section>
                }

                @if (cryptoResult is { Success: true })
                {
                    <section class="space-y-3">
                        <h3 class="font-semibold">@Loc["upgrade_payment_info_title"]<strong>@PlanCatalog.FormatPrice(paymentAmount, Config[PricingKeys.Currency])</strong></h3>
                        <p class="text-muted-foreground">@Loc["upgrade_crypto_hint"]</p>
                        <Button Href="@cryptoResult.HostedUrl" target="_blank" rel="noopener noreferrer" data-ai-action="upgrade.crypto.open">@Loc["upgrade_crypto_open"]</Button>
                        @PaymentStatus
                    </section>
                }
                else if (payOSResult is { Success: true })
                {
                    <section class="space-y-3">
                        <h3 class="font-semibold">@Loc["upgrade_payment_info_title"]<strong>@PlanCatalog.FormatPrice(paymentAmount, Config[PricingKeys.Currency])</strong></h3>
                        <p class="text-muted-foreground">@Loc["upgrade_payos_support"]</p>
                        <Button Href="@payOSResult.CheckoutUrl" target="_blank" rel="noopener noreferrer">@Loc["upgrade_payos_open"]</Button>
                        <iframe src="@payOSResult.CheckoutUrl" title="@Loc["upgrade_payos_iframe_title"]"
                                sandbox="allow-scripts allow-same-origin allow-forms allow-popups" loading="lazy"
                                class="min-h-96 w-full rounded-md border"></iframe>
                        @PaymentStatus
                    </section>
                }
                else
                {
                    @if (cryptoResult is not null || payOSResult is not null)
                    {
                        <p class="text-destructive" role="alert">@string.Format(Loc["upgrade_payment_error"], cryptoResult?.ErrorMessage ?? payOSResult?.ErrorMessage)</p>
                    }
                    <section class="space-y-3">
                        <h3 class="font-semibold">@Loc["upgrade_payment_method_title"]</h3>
                        <p class="text-muted-foreground">@Loc["upgrade_payment_method_desc"]</p>
                        <form method="post" class="space-y-3" @formname="upgrade-checkout" @onsubmit="HandleSubmit">
                            <AntiforgeryToken />
                            <input type="hidden" name="Plan" value="@selectedPlan" />
                            <input type="hidden" name="Billing" value="@(IsYearly ? BillingPeriods.Yearly : BillingPeriods.Monthly)" />
                            <label class="block space-y-2" for="upgrade-payment-method">
                                <span class="block text-sm font-medium">@Loc["upgrade_payment_channel_label"]</span>
                                <NativeSelect id="upgrade-payment-method" name="PaymentMethod">
                                    <NativeSelectOption value="@PaymentMethods.BankQr">@Loc["upgrade_method_bank_qr"]</NativeSelectOption>
                                    <NativeSelectOption value="@PaymentMethods.MoMo">@Loc["upgrade_method_momo"]</NativeSelectOption>
                                    <NativeSelectOption value="@PaymentMethods.ZaloPay">@Loc["upgrade_method_zalopay"]</NativeSelectOption>
                                    <NativeSelectOption value="@PaymentMethods.VisaCard">@Loc["upgrade_method_visa"]</NativeSelectOption>
                                    <NativeSelectOption value="@PaymentMethods.StripeCard">@Loc["upgrade_method_stripe"]</NativeSelectOption>
                                    <NativeSelectOption value="@PaymentMethods.PayPalWallet">@Loc["upgrade_method_paypal"]</NativeSelectOption>
                                </NativeSelect>
                            </label>
                            <label class="block space-y-2" for="upgrade-promo">
                                <span class="block text-sm font-medium">@Loc["upgrade_promo_label"]</span>
                                <Input id="upgrade-promo" name="PromoCode" class="w-full" Type="text" Value="@prefilledPromo" maxlength="@PromoCode.CodeMaxLength" autocomplete="off" />
                            </label>
                            <Button Type="submit" class="w-full">@Loc["upgrade_pay_now_btn"]</Button>
                            @if (Checkout.CryptoAvailable)
                            {
                                <Button Type="submit" Variant="outline" class="w-full" name="Provider" value="@PaymentProviders.Crypto" data-ai-action="upgrade.pay.crypto">@Loc["upgrade_pay_crypto_btn"]</Button>
                            }
                        </form>
                    </section>
                }
                <p class="text-center text-sm text-muted-foreground">
                    @Loc["upgrade_auto_upgrade_note"]
                    @Loc["upgrade_need_help"] <a href="mailto:support@quicksharecloud.com" class="text-primary underline">@Loc["upgrade_contact_support"]</a>.
                </p>
            </Card>

            @* Buy as a Gift Subscription (issue #102) *@
            <Card id="upgrade-gift-card" class="px-6 py-5">
                <div class="space-y-3">
                    <h2 class="text-lg font-semibold">@Loc["gift_card_title"]</h2>
                    <p class="text-sm text-muted-foreground">@Loc["gift_card_sub"]</p>

                    @if (!string.IsNullOrEmpty(giftError))
                    {
                        <p class="text-sm text-destructive" role="alert">@giftError</p>
                    }
                    @if (createdGift is not null)
                    {
                        <div id="upgrade-gift-created" class="rounded-md border border-primary/40 bg-primary/5 p-3 text-sm" role="status">
                            <p class="font-medium">@string.Format(Loc["gift_created_msg"], createdGift.RecipientEmail)</p>
                            <p class="mt-1 font-mono text-xs">/gift/claim?token=@createdGift.Token</p>
                        </div>
                    }
                    else
                    {
                        <form method="post" class="space-y-3" @formname="upgrade-gift-buy" @onsubmit="HandleSubmit">
                            <AntiforgeryToken />
                            <input type="hidden" name="@ActionField" value="@GiftBuyAction" />
                            <input type="hidden" name="Plan" value="@selectedPlan" />
                            <input type="hidden" name="Billing" value="@(IsYearly ? BillingPeriods.Yearly : BillingPeriods.Monthly)" />
                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                <label class="block space-y-1 text-sm" for="gift-recipient-email">
                                    <span class="font-medium">@Loc["gift_recipient_email_label"]</span>
                                    <Input id="gift-recipient-email" name="RecipientEmail" Type="email" maxlength="@SubscriptionGift.EmailMaxLength" required />
                                </label>
                                <label class="block space-y-1 text-sm" for="gift-message">
                                    <span class="font-medium">@Loc["gift_message_label"]</span>
                                    <Input id="gift-message" name="GiftMessage" Type="text" maxlength="@SubscriptionGift.MessageMaxLength" />
                                </label>
                            </div>
                            <Button Type="submit" Variant="outline" Size="sm" data-ai-action="upgrade.gift.submit">@Loc["gift_buy_btn"]</Button>
                        </form>
                    }
                </div>
            </Card>

            @* Student + Nonprofit Verification (issue #203) *@
            <Card id="upgrade-discount-card" class="px-6 py-5">
                <div class="space-y-3">
                    <h2 class="text-lg font-semibold">@Loc["discount_edu_title"]</h2>
                    <p class="text-sm text-muted-foreground">@Loc["discount_edu_sub"]</p>

                    @if (discountApp is { Status: DiscountApplication.StatusApproved, IssuedPromoCode: not null })
                    {
                        <div id="upgrade-discount-approved" class="rounded-md border border-primary/40 bg-primary/5 p-3 text-sm" role="status">
                            <p class="font-medium">@Loc["discount_edu_approved_msg"]: <code class="rounded border bg-background px-2 py-0.5 font-mono font-bold">@discountApp.IssuedPromoCode</code></p>
                        </div>
                    }
                    else if (discountApp is { Status: DiscountApplication.StatusPending })
                    {
                        <div id="upgrade-discount-pending" class="rounded-md border p-3 text-sm text-muted-foreground" role="status">
                            @Loc["discount_edu_pending_msg"] (@discountApp.OrganizationName)
                        </div>
                    }
                    else
                    {
                        <form method="post" class="space-y-3" @formname="upgrade-discount-apply" @onsubmit="HandleSubmit">
                            <AntiforgeryToken />
                            <input type="hidden" name="@ActionField" value="@DiscountApplyAction" />
                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                <label class="block space-y-1 text-sm" for="discount-kind">
                                    <span class="font-medium">@Loc["discount_edu_kind_label"]</span>
                                    <NativeSelect id="discount-kind" name="Kind">
                                        <NativeSelectOption value="@DiscountApplication.KindStudent">@Loc["discount_edu_kind_student"]</NativeSelectOption>
                                        <NativeSelectOption value="@DiscountApplication.KindNonprofit">@Loc["discount_edu_kind_nonprofit"]</NativeSelectOption>
                                    </NativeSelect>
                                </label>
                                <label class="block space-y-1 text-sm" for="discount-org">
                                    <span class="font-medium">@Loc["discount_edu_org_label"]</span>
                                    <Input id="discount-org" name="OrganizationName" Type="text" maxlength="@DiscountApplication.OrganizationMaxLength" required />
                                </label>
                            </div>
                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                <label class="block space-y-1 text-sm" for="discount-email">
                                    <span class="font-medium">@Loc["discount_edu_email_label"]</span>
                                    <Input id="discount-email" name="VerificationEmail" Type="email" placeholder="student@hust.edu.vn" maxlength="@DiscountApplication.VerificationEmailMaxLength" required />
                                </label>
                                <label class="block space-y-1 text-sm" for="discount-proof">
                                    <span class="font-medium">@Loc["discount_edu_proof_label"]</span>
                                    <Input id="discount-proof" name="ProofReference" Type="text" maxlength="@DiscountApplication.ProofReferenceMaxLength" />
                                </label>
                            </div>
                            <Button Type="submit" Variant="outline" Size="sm" data-ai-action="upgrade.discount.submit">@Loc["discount_edu_submit_btn"]</Button>
                        </form>
                    }
                </div>
            </Card>
        </section>
    </PageWrapper>
}

@code {
    [Parameter, SupplyParameterFromQuery] public string? Plan { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Billing { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "promo")] public string? PromoQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = PayOSOrderCodeQueryKey)] public long? PayOSOrderCode { get; set; }

    private const string PayOSOrderCodeQueryKey = "orderCode";
    private const string PollQueryKey = "poll";
    private const string PollQueryValue = "1";
    private const string PollInterval = "3000";
    private const string PaymentStatusId = "payment-status";
    private const string ActionField = "Action";
    private const string TrialAction = "trial";
    private const string DiscountApplyAction = "discount-apply";
    private const string GiftBuyAction = "gift-buy";

    private string selectedPlan = PlanTierLimits.Pro;
    private string currentPlan = PlanTierLimits.Free;
    private PaymentIntent? paymentIntent;
    private PayOSPaymentResult? payOSResult;
    private QuickShare.Features.Payments.Crypto.CryptoChargeResult? cryptoResult;
    private ActiveCampaignDto? activeCampaign;
    private DiscountApplication? discountApp;
    private SubscriptionGift? createdGift;
    private string? giftError;
    private string prefilledPromo = string.Empty;
    private bool isPollRequest;
    private bool paymentCompleted;
    private bool trialError;
    private long pollOrderCode;

    private string PollUrl => $"{RoutePaths.Upgrade}?plan={selectedPlan}&{PayOSOrderCodeQueryKey}={pollOrderCode}&{PollQueryKey}={PollQueryValue}";
    private RenderFragment PaymentStatus => @<div id="@PaymentStatusId" up-poll="@(paymentCompleted ? "false" : "true")" up-interval="@PollInterval" up-href="@PollUrl">
        @if (paymentCompleted)
        {
            <p class="font-semibold" role="status">@string.Format(Loc["upgrade_payment_success"], planDisplay)</p>
            <Button Href="@RoutePaths.AccountBilling" class="mt-3">@Loc["billing_view_receipt"]</Button>
        }
        else
        {
            <p class="text-sm text-muted-foreground" role="status">@Loc["upgrade_waiting_confirmation"]</p>
            <a href="@PollUrl" class="text-sm text-primary underline">@Loc["upgrade_refresh_status"]</a>
        }
    </div>;

    private PlanInfo PlanData => PlanCatalog.Get(selectedPlan);
    private string planKey => selectedPlan == PlanTierLimits.Studio ? "studio" : "pro";
    private string planDisplay => PlanData.Display;
    private string planSummary => Loc[$"upgrade_plan_summary_{planKey}"].Value;
    private string[] planFeatureKeys => selectedPlan == PlanTierLimits.Studio
        ? ["upgrade_feat_studio_1", "upgrade_feat_studio_2", "upgrade_feat_studio_3", "upgrade_feat_studio_5", "upgrade_feat_studio_6"]
        : ["upgrade_feat_pro_1", "upgrade_feat_pro_2", "upgrade_feat_pro_3", "upgrade_feat_pro_4", "upgrade_feat_pro_5"];
    private string planMonthlyPrice => PlanCatalog.FormatPrice(Config.GetValue(PlanData.MonthlyPricingKey, PlanData.MonthlyDefaultAmount), Config[PricingKeys.Currency]);
    private string planYearlyPrice => PlanCatalog.FormatPrice(Config.GetValue(PlanData.YearlyPricingKey, PlanData.YearlyDefaultAmount), Config[PricingKeys.Currency]);
    private bool IsYearly => string.Equals(Billing, BillingPeriods.Yearly, StringComparison.OrdinalIgnoreCase);
    private int paymentAmount => (int)(paymentIntent?.Amount ?? 0);

    protected override async Task OnInitializedAsync()
    {
        selectedPlan = PlanCatalog.Normalize(Plan);
        var ctx = HttpContextAccessor.HttpContext!;
        var isPost = Microsoft.AspNetCore.Http.HttpMethods.IsPost(ctx.Request.Method);
        isPollRequest = !isPost && ctx.Request.Query[PollQueryKey] == PollQueryValue
            && long.TryParse(ctx.Request.Query[PayOSOrderCodeQueryKey].FirstOrDefault(), out pollOrderCode);
        var ct = CancellationToken.None;
        var user = await ctx.User.GetUserAsync(Db, ct);
        currentPlan = user.ToProfileResponse().Plan;

        if (isPollRequest)
        {
            paymentCompleted = await Checkout.IsCompletedAsync(user, pollOrderCode, ct);
            return;
        }

        activeCampaign = await GetActiveCampaignEndpoint.ResolveActiveAsync(Db, Cache, ctx, ct);
        discountApp = await Db.DiscountApplications.AsNoTracking().FirstOrDefaultAsync(a => a.UserId == user.Id, ct);

        if (!string.IsNullOrWhiteSpace(PromoQuery))
        {
            prefilledPromo = PromoCode.NormalizeCode(PromoQuery);
        }
        else if (discountApp is { Status: DiscountApplication.StatusApproved, IssuedPromoCode: not null })
        {
            prefilledPromo = discountApp.IssuedPromoCode;
        }
        else if (activeCampaign is not null)
        {
            prefilledPromo = activeCampaign.Code;
        }
    }

    private async Task HandleSubmit()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        var ct = CancellationToken.None;
        try
        {
            await Antiforgery.ValidateRequestAsync(ctx);
        }
        catch (AntiforgeryValidationException)
        {
            ctx.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        var user = await ctx.User.GetUserAsync(Db, ct);
        var form = await ctx.Request.ReadFormAsync(ct);
        if (form[ActionField] == TrialAction)
        {
            var trial = await SubscriptionService.StartTrialAsync(user, Db, ct);
            if (trial.IsSuccess())
            {
                await UserCacheInvalidator.EvictAsync(Db, user.Id, ct);
                try
                {
                    await Analytics.RecordAsync(AnalyticsEvents.TrialStarted, new AnalyticsEventData(null, 0, null, PlanTierLimits.Pro), ct);
                }
                catch { }
                ctx.Response.Redirect(RoutePaths.AccountBilling);
            }
            else
            {
                trialError = true;
            }
            return;
        }

        if (form[ActionField] == DiscountApplyAction)
        {
            var kind = form["Kind"].FirstOrDefault() ?? DiscountApplication.KindStudent;
            var org = form["OrganizationName"].FirstOrDefault()?.Trim() ?? string.Empty;
            var email = form["VerificationEmail"].FirstOrDefault()?.Trim().ToLowerInvariant() ?? string.Empty;
            var proof = form["ProofReference"].FirstOrDefault()?.Trim();
            if (!string.IsNullOrEmpty(org) && email.Contains('@', StringComparison.Ordinal))
            {
                var app = await Db.DiscountApplications.FirstOrDefaultAsync(a => a.UserId == user.Id, ct);
                if (app is null)
                {
                    app = new DiscountApplication { Id = Guid.CreateVersion7(), UserId = user.Id };
                    Db.DiscountApplications.Add(app);
                }
                app.Kind = string.Equals(kind, DiscountApplication.KindNonprofit, StringComparison.OrdinalIgnoreCase)
                    ? DiscountApplication.KindNonprofit
                    : DiscountApplication.KindStudent;
                app.OrganizationName = org;
                app.VerificationEmail = email;
                app.ProofReference = string.IsNullOrWhiteSpace(proof) ? null : proof;
                if (app.Kind == DiscountApplication.KindStudent && DiscountApplication.IsAutoVerifiedAcademicEmail(email))
                {
                    await SubmitDiscountApplicationEndpoint.IssueDiscountCodeAsync(Db, app, DateTime.UtcNow, ct);
                    prefilledPromo = app.IssuedPromoCode ?? prefilledPromo;
                }
                else
                {
                    app.Status = DiscountApplication.StatusPending;
                }
                await Db.SaveChangesAsync(ct);
                discountApp = app;
            }
            return;
        }

        if (form[ActionField] == GiftBuyAction)
        {
            var recipient = form["RecipientEmail"].FirstOrDefault()?.Trim().ToLowerInvariant() ?? string.Empty;
            var msg = form["GiftMessage"].FirstOrDefault();
            if (string.Equals(recipient, user.Email, StringComparison.OrdinalIgnoreCase))
            {
                giftError = Loc["gift_claim_self_error"];
                return;
            }
            if (!string.IsNullOrEmpty(recipient) && recipient.Contains('@', StringComparison.Ordinal))
            {
                (createdGift, paymentIntent, payOSResult) = await Checkout.CreateGiftCheckoutAsync(
                    user, recipient, selectedPlan, IsYearly, msg, null, null, ct);
                pollOrderCode = paymentIntent?.PayOSOrderCode ?? 0;
            }
            return;
        }

        selectedPlan = PlanCatalog.Normalize(form["Plan"].FirstOrDefault());
        Billing = form["Billing"].FirstOrDefault();
        var promo = form["PromoCode"].FirstOrDefault();
        var provider = form["Provider"].FirstOrDefault();
        var paymentMethod = form["PaymentMethod"].FirstOrDefault();
        if (string.Equals(provider, PaymentProviders.Crypto, StringComparison.Ordinal))
        {
            (paymentIntent, cryptoResult) = await Checkout.CreateCryptoCheckoutAsync(user, selectedPlan, IsYearly, ct, promo);
        }
        else
        {
            (paymentIntent, payOSResult) = await Checkout.CreatePaymentLinkAsync(user, selectedPlan, IsYearly, ct, promo, paymentMethod: paymentMethod);
        }
        pollOrderCode = paymentIntent?.PayOSOrderCode ?? 0;
    }
}

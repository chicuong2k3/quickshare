@layout MainLayout
@page "/upgrade"
@attribute [Authorize]
@using QuickShare.Features.Payments
@using QuickShare.Features.Payments.PayOS
@using QuickShare.Features.Payments.Subscriptions
@using QuickShare.Features.Users.Shared
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject IConfiguration Config
@inject CheckoutService Checkout

<PageTitle>Nâng cấp lên @planDisplay — QuickShareCloud</PageTitle>

@if (isPollRequest)
{
    @* HTMX poll response — only #payment-status is selected out of this page. *@
    @PaymentStatus
}
else
{
<PageWrapper Variant="PageVariant.Padded">

    <section class="hero">
        <span class="tag">Nâng cấp</span>
        <h1 class="db-h1">Nâng cấp lên @planDisplay</h1>
        <p class="db-p db-text-muted">
            @if (isFullyLoaded)
            {
                <text>Bạn đang ở gói <strong>@currentPlan</strong>. </text>
            }
            @planDisplay mang đến cho bạn @planSummary.
        </p>
    </section>

    @if (!isFullyLoaded)
    {
        @* Shell skeleton: rendered in < 500ms, no DB calls *@
        <section id="upgrade-body"
                 hx-get="/upgrade?plan=@selectedPlan&billing=@(Billing ?? "")"
                 hx-trigger="load"
                 hx-target="#upgrade-body"
                 hx-select="#upgrade-body"
                 hx-swap="outerHTML"
                 aria-busy="true">
            @SummaryCard

            <div class="payment">
                <h2 class="db-h2">Hoàn tất nâng cấp</h2>
                <p class="db-text-muted" style="margin-top: 0.5rem">
                    Nâng cấp lên <strong>@planDisplay</strong>
                    @(IsYearly ? " (hàng năm)" : " (hàng tháng)")
                    &mdash; <strong>@(IsYearly ? planYearlyPrice : planMonthlyPrice)</strong>
                </p>

                <div class="payment-option">
                    <h3 class="db-h3">Chuyển khoản / Thẻ</h3>
                    <p class="db-text-muted">Thanh toán qua PayOS (chuyển khoản, thẻ nội địa, Visa/Mastercard)</p>
                    <form method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="Plan" value="@selectedPlan" />
                        <input type="hidden" name="Billing" value="@(IsYearly ? BillingPeriods.Yearly : BillingPeriods.Monthly)" />
                        <button type="submit" class="db-btn db-btn--primary" style="width:100%;margin-top:1rem">
                            Thanh toán với PayOS
                        </button>
                    </form>
                </div>
            </div>
        </section>
    }
    else
    {
        @* Full render: HTMX GET re-render or POST with data *@
        <section id="upgrade-body">
            @SummaryCard

            <div class="payment" id="payment-section">
                <h2 class="db-h2">Hoàn tất nâng cấp</h2>
                <p class="db-text-muted" style="margin-top: 0.5rem">
                    Nâng cấp lên <strong>@planDisplay</strong>
                    @(IsYearly ? " (hàng năm)" : " (hàng tháng)")
                    &mdash; <strong id="price-label">@(IsYearly ? planYearlyPrice : planMonthlyPrice)</strong>
                </p>

                @if (paymentCompleted)
                {
                    @PaymentStatus
                }
                else if (payOSResult is not null && payOSResult.Success)
                {
                    <div class="payment-info">
                        <h3 class="db-h3">Thanh toán <strong>@PlanCatalog.FormatPrice(paymentAmount, Config[PricingKeys.Currency])</strong></h3>
                        <p class="db-text-muted" style="margin-top:0.5rem">PayOS hỗ trợ chuyển khoản ngân hàng, thẻ nội địa, Visa/Mastercard.</p>

                        @* Mã QR + thông tin chuyển khoản đã có sẵn trong khung PayOS bên dưới. *@
                        <div class="payos-checkout">
                            <div class="payos-iframe-wrap">
                                <iframe src="@payOSResult.CheckoutUrl"
                                        title="Thanh toán PayOS"
                                        sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
                                        loading="lazy"
                                        class="payos-iframe"></iframe>
                            </div>
                        </div>

                        @PaymentStatus
                    </div>
                }
                else if (payOSResult is not null)
                {
                    <div class="db-alert db-alert--error" style="margin-top:1rem;padding:1rem;border-radius:0.5rem;color:var(--db-color-danger)">
                        <p>Không thể tạo link thanh toán: @payOSResult.ErrorMessage</p>
                        <form method="post" style="margin-top:1rem">
                            <AntiforgeryToken />
                            <input type="hidden" name="Plan" value="@selectedPlan" />
                            <input type="hidden" name="Billing" value="@(IsYearly ? BillingPeriods.Yearly : BillingPeriods.Monthly)" />
                            <button type="submit" class="db-btn db-btn--primary">
                                Thử lại
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    @* PaymentIntent created, PayOS call in progress (loading state) *@
                    <div class="payment-info payment-info--loading">
                        <p class="db-text-muted">Đang tạo link thanh toán...</p>
                        <div class="db-spinner" style="margin:1rem auto"></div>
                    </div>
                }

                <p class="db-text-muted" style="margin-top:2rem;font-size:0.8rem;text-align:center">
                    Gói sẽ được nâng cấp ngay sau khi xác nhận thanh toán.
                    Cần hỗ trợ? <a href="mailto:support@quicksharecloud.com" class="db-link">Liên hệ support</a>.
                </p>
            </div>
        </section>
    }

</PageWrapper>
}



@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Plan { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Billing { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = PayOSOrderCodeQueryKey)]
    public long? PayOSOrderCode { get; set; }

    private const string PayOSOrderCodeQueryKey = "orderCode";
    private const string PollQueryKey = "poll";
    private const string PollQueryValue = "1";
    private const string PollInterval = "every 3s";
    private const string PaymentStatusId = "payment-status";

    private string selectedPlan = PlanTierLimits.Pro;
    private string currentPlan = PlanTierLimits.Free;
    private bool isFullyLoaded;
    private PaymentIntent? paymentIntent;
    private PayOSPaymentResult? payOSResult;
    private bool isPollRequest;
    private bool paymentCompleted;
    private long pollOrderCode;

    /// <summary>
    /// Swapped in place by HTMX every few seconds while the payment is pending, so the
    /// webhook result lands as a partial — no full page reload.
    /// </summary>
    private RenderFragment PaymentStatus => @<div id="@PaymentStatusId">
        @if (paymentCompleted)
        {
            <div class="db-alert db-alert--success" style="margin-top:1rem;padding:1rem;border-radius:0.5rem">
                <p><strong>Thanh toán thành công!</strong> Gói @planDisplay đã được kích hoạt.</p>
                <a href="/account/billing" class="db-btn db-btn--primary" style="margin-top:1rem">Xem hoá đơn</a>
            </div>
        }
        else
        {
            <p class="db-text-muted"
               style="margin-top:1rem;font-size:0.85rem"
               hx-get="/upgrade?plan=@selectedPlan&@(PayOSOrderCodeQueryKey)=@pollOrderCode&@(PollQueryKey)=@PollQueryValue"
               hx-trigger="@PollInterval"
               hx-target="#@PaymentStatusId"
               hx-select="#@PaymentStatusId"
               hx-swap="outerHTML">
                Đang chờ xác nhận thanh toán — gói sẽ được kích hoạt tự động.
            </p>
        }
    </div>;

    private PlanInfo PlanData => PlanCatalog.Get(selectedPlan);
    private string planDisplay => PlanData.Display;
    private string planSummary => PlanData.Summary;
    private string planMonthlyPrice => PlanCatalog.FormatPrice(
        Config.GetValue(PlanData.MonthlyPricingKey, PlanData.MonthlyDefaultAmount),
        Config[PricingKeys.Currency]);
    private string planYearlyPrice => PlanCatalog.FormatPrice(
        Config.GetValue(PlanData.YearlyPricingKey, PlanData.YearlyDefaultAmount),
        Config[PricingKeys.Currency]);

    private bool IsYearly => string.Equals(Billing, BillingPeriods.Yearly, StringComparison.OrdinalIgnoreCase);
    private int paymentAmount => (int)(paymentIntent?.Amount ?? 0);

    private RenderFragment SummaryCard => @<div class="summary-card">
        <div class="summary-card__head">
            <h2 class="db-h2">@PlanData.Display</h2>
            <p class="db-text-muted">@PlanData.Description</p>
        </div>
        <div class="summary-card__price">
            @if (IsYearly)
            {
                <span class="price-amount">@planYearlyPrice</span>
                <span class="price-period db-text-muted">/ năm</span>
            }
            else
            {
                <span class="price-amount">@planMonthlyPrice</span>
                <span class="price-period db-text-muted">/ tháng</span>
            }
        </div>
        <div class="summary-card__features">
            @foreach (var feature in PlanData.Features)
            {
                <div class="feature">
                    <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    <span>@feature</span>
                </div>
            }
        </div>
    </div>;

    protected override async Task OnInitializedAsync()
    {
        selectedPlan = PlanCatalog.Normalize(Plan);

        var ctx = HttpContextAccessor.HttpContext!;
        var isHtmxRequest = string.Equals(
            ctx.Request.Headers[HtmxHeaders.Request].FirstOrDefault(),
            HtmxHeaders.RequestValue,
            StringComparison.OrdinalIgnoreCase);
        var isPost = Microsoft.AspNetCore.Http.HttpMethods.IsPost(ctx.Request.Method);
        isPollRequest = ctx.Request.Query[PollQueryKey] == PollQueryValue
            && TryGetPayOSOrderCode(ctx, out pollOrderCode);

        // Shell render for GET: return immediately, no DB calls.
        if (!isHtmxRequest && !isPost) return;

        isFullyLoaded = true;

        var ct = CancellationToken.None;
        var user = await ctx.User.GetUserAsync(Db, ct);
        currentPlan = user.ToProfileResponse().Plan;

        // Poll: webhook status only — never creates another payment link.
        if (isPollRequest)
        {
            paymentCompleted = await Checkout.IsCompletedAsync(user, pollOrderCode, ct);
            if (paymentCompleted)
            {
                // Gói đã kích hoạt — nhảy thẳng sang trang hoá đơn (HTMX điều hướng trang cha).
                ctx.Response.Headers[HtmxHeaders.Redirect] = RoutePaths.AccountBilling;
            }
            return;
        }

        // Auto-create payment on first load (HTMX GET) or on form submit / retry (POST).
        if (isPost)
        {
            var form = await ctx.Request.ReadFormAsync();
            var formPlan = form["Plan"].FirstOrDefault() ?? PlanTierLimits.Pro;
            var formBilling = form["Billing"].FirstOrDefault() ?? BillingPeriods.Monthly;
            var formIsYearly = string.Equals(formBilling, BillingPeriods.Yearly, StringComparison.OrdinalIgnoreCase);
            (paymentIntent, payOSResult) = await Checkout.CreatePaymentLinkAsync(user, formPlan, formIsYearly, ct);
        }
        else if (isHtmxRequest)
        {
            (paymentIntent, payOSResult) = await Checkout.CreatePaymentLinkAsync(user, selectedPlan, IsYearly, ct);
        }

        pollOrderCode = paymentIntent?.PayOSOrderCode ?? pollOrderCode;
    }

    private bool TryGetPayOSOrderCode(HttpContext ctx, out long orderCode)
    {
        if (PayOSOrderCode.HasValue)
        {
            orderCode = PayOSOrderCode.Value;
            return true;
        }

        var orderCodeRaw = ctx.Request.Query[PayOSOrderCodeQueryKey].FirstOrDefault();
        return long.TryParse(orderCodeRaw, out orderCode);
    }
}

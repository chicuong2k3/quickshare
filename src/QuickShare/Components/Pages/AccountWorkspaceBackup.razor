@layout MainLayout
@page "/account/workspace/backup"
@attribute [Authorize]
@using QuickShare.Components.Shared
@using QuickShare.Features.Workspaces.Audit
@using QuickShare.Features.Workspaces.Shared
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject WorkspaceService Workspaces
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<PageTitle>@Loc["backup_title"]</PageTitle>

@* Destination credentials and run history — never index (issue #121). *@
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<PageWrapper Variant="PageVariant.Padded">

    <section class="hero">
        <h1 class="text-3xl font-bold tracking-tight">@Loc["backup_title"]</h1>
        <p class="text-muted-foreground">@Loc["backup_subtitle"]</p>
    </section>

    <WorkspaceTabs Current="@RoutePaths.AccountWorkspaceBackup" />

    @Chunk

</PageWrapper>

<script src="/js/backup.js" defer></script>

@code {
    private bool isAdmin;
    private WorkspaceBackupPolicy? policy;

    private RenderFragment Chunk => @<section id="workspace-backup-body" data-unpoly-reload>
        @if (!isAdmin)
        {
            <Card class="account-card workspace-card">
                <CardContent>
                    <p>@Loc["ws_admin_only"]</p>
                </CardContent>
            </Card>
        }
        else
        {
            <Card class="account-card workspace-card">
                <CardContent>
                    <h2 class="text-xl font-semibold">@Loc["backup_destination_title"]</h2>
                    @* Said here rather than discovered during an actual disaster. *@
                    <p class="workspace-notice">@Loc["backup_metadata_only"]</p>

                    <div class="workspace-form">
                        <label class="workspace-label" for="backup-endpoint">@Loc["backup_endpoint"]</label>
                        <Input id="backup-endpoint"  type="url" placeholder="https://"
                               maxlength="@WorkspaceBackupPolicy.EndpointMaxLength" value="@policy?.Endpoint" />

                        <label class="workspace-label" for="backup-bucket">@Loc["backup_bucket"]</label>
                        <Input id="backup-bucket"  type="text"
                               maxlength="@WorkspaceBackupPolicy.BucketMaxLength" value="@policy?.BucketName" />

                        <label class="workspace-label" for="backup-region">@Loc["backup_region"]</label>
                        <Input id="backup-region"  type="text"
                               value="@(policy?.Region ?? ObjectStoreDefaults.Region)" />

                        <label class="workspace-label" for="backup-prefix">@Loc["backup_prefix"]</label>
                        <Input id="backup-prefix"  type="text"
                               maxlength="@WorkspaceBackupPolicy.PrefixMaxLength" value="@policy?.KeyPrefix" />

                        <label class="workspace-label" for="backup-key">@Loc["backup_access_key"]</label>
                        <Input id="backup-key"  type="text" autocomplete="off"
                               maxlength="@WorkspaceBackupPolicy.SecretMaxLength" value="@policy?.AccessKeyId" />

                        <label class="workspace-label" for="backup-secret">@Loc["backup_secret"]</label>
                        <Input id="backup-secret"  type="password" autocomplete="off"
                               maxlength="@WorkspaceBackupPolicy.SecretMaxLength"
                               placeholder="@(policy is not null && !string.IsNullOrEmpty(policy.AccessKeySecret) ? Loc["backup_secret_set"] : string.Empty)" />

                        <label class="workspace-label" for="backup-frequency">@Loc["backup_frequency"]</label>
                        <NativeSelect id="backup-frequency">
                            <NativeSelectOption value="@BackupFrequency.Daily" selected="@(Frequency == BackupFrequency.Daily)">@Loc["backup_daily"]</NativeSelectOption>
                            <NativeSelectOption value="@BackupFrequency.Weekly" selected="@(Frequency == BackupFrequency.Weekly)">@Loc["backup_weekly"]</NativeSelectOption>
                        </NativeSelect>

                        <label class="workspace-label" for="backup-retained">@Loc["backup_retained"]</label>
                        <input id="backup-retained" type="number"
                               min="@WorkspaceBackupPolicy.MinRetainedCopies"
                               max="@WorkspaceBackupPolicy.MaxRetainedCopies"
                               value="@(policy?.RetainedCopies ?? 4)" />

                        <label class="workspace-checkbox">
                            <input id="backup-enabled" type="checkbox" checked="@(policy?.Enabled ?? true)" />
                            <span>@Loc["backup_enabled"]</span>
                        </label>

                        <button type="button" data-slot="button" data-variant="default"
                                data-saved-label="@Loc["backup_saved"]"
                                onclick="window.quickShareBackup.save(this)"
                                data-ai-action="backup.save">@Loc["backup_save"]</button>

                        @if (policy is not null)
                        {
                            <button type="button" data-slot="button" data-variant="ghost"
                                    onclick="window.quickShareBackup.runNow(this)"
                                    data-ai-action="backup.run">@Loc["backup_run_now"]</button>

                            <button type="button" data-slot="button" data-variant="ghost"
                                    data-confirm="@Loc["backup_remove_confirm"]"
                                    onclick="window.quickShareBackup.remove(this)"
                                    data-ai-action="backup.remove">@Loc["backup_remove"]</button>
                        }
                    </div>
                </CardContent>
            </Card>

            @if (policy is not null)
            {
                <Card class="account-card workspace-card">
                    <CardContent>
                        <h2 class="text-xl font-semibold">@Loc["backup_last_run_title"]</h2>

                        <dl class="workspace-stats">
                            <div class="workspace-stat">
                                <dt>@Loc["backup_last_run"]</dt>
                                <dd>@(policy.LastRunAt is { } ran ? ran.ToLocalTime().ToString("g") : "—")</dd>
                            </div>
                            <div class="workspace-stat">
                                <dt>@Loc["backup_status"]</dt>
                                <dd>@StatusLabel(policy.LastStatus)</dd>
                            </div>
                            <div class="workspace-stat">
                                <dt>@Loc["backup_deliveries"]</dt>
                                <dd>@policy.LastDeliveryCount</dd>
                            </div>
                        </dl>

                        @if (!string.IsNullOrEmpty(policy.LastManifestKey))
                        {
                            <p class="text-muted-foreground workspace-hint">@Loc["backup_manifest_key", policy.LastManifestKey]</p>
                        }

                        @if (!string.IsNullOrEmpty(policy.LastError))
                        {
                            <p class="text-muted-foreground workspace-hint">@Loc["backup_last_error", policy.LastError]</p>
                        }
                    </CardContent>
                </Card>
            }
        }
    </section>;

    private string Frequency => policy?.Frequency ?? BackupFrequency.Weekly;

    private string StatusLabel(string status) => status switch
    {
        BackupRunStatus.Succeeded => Loc["backup_status_ok"],
        BackupRunStatus.Failed => Loc["backup_status_failed"],
        _ => Loc["backup_status_never"],
    };

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        var seat = await WorkspaceAuditReader.ResolveAdminSeatAsync(Workspaces, Db, ctx, CancellationToken.None);
        if (seat is null) return;

        isAdmin = true;
        policy = await Db.WorkspaceBackupPolicies
            .AsNoTracking()
            .FirstOrDefaultAsync(p => p.WorkspaceId == seat.WorkspaceId, CancellationToken.None);
    }
}

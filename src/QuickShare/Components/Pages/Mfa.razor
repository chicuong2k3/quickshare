@layout MainLayout
@page "/mfa"
@attribute [Authorize]
@using Microsoft.AspNetCore.Antiforgery
@using QuickShare.Components.Shared
@using QuickShare.Features.Auth.Mfa
@using QuickShare.Features.Auth.Totp
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject MfaPolicyService Policies
@inject IStringLocalizer<QuickShare.SharedLoc> Loc
@inject IAntiforgery Antiforgery

<PageTitle>@Loc["mfa_title"]</PageTitle>

@* A challenge screen is never something to index (issue #121). *@
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

@*
    This is the wall. Its whole job is to be the first thing a held session sees, and a skeleton
    that fills in a moment later would mean the gate briefly renders as an empty page — which
    reads as "the site is broken", which is how somebody ends up filing a ticket instead of
    typing six digits. The queries behind it are two indexed lookups on the current account.
*@
<PageWrapper Variant="PageVariant.Padded">

    <section class="mb-6">
        <h1 class="text-3xl font-semibold">@Loc["mfa_title"]</h1>
        <p class="mt-2 text-muted-foreground">@Subtitle</p>
    </section>

    <Card class="w-full max-w-md p-6">
            @if (NeedsEnrolment)
            {
                @* Out of grace and not enrolled: the way out is enrolment, not a code. *@
                <p>@Loc["mfa_enrol_required"]</p>
                <Button Href="@RoutePaths.AccountSecurity" class="mt-4">@Loc["mfa_go_enrol"]</Button>
            }
            else
            {
                <form method="post" @formname="mfa-challenge" @onsubmit="HandleSubmit" class="space-y-3">
                    <AntiforgeryToken />
                    <label class="block text-sm font-medium" for="mfa-code">@Loc["mfa_code_label"]</label>
                    <input id="mfa-code" name="@CodeField" class="w-full rounded-md border bg-background px-3 py-2" type="text"
                           autocomplete="one-time-code" maxlength="@RecoveryCodeMaxLength" required autofocus />
                    <p class="text-sm text-muted-foreground">@Loc["mfa_code_hint"]</p>
                    @if (retryAfterSeconds > 0)
                    {
                        <p class="text-sm text-destructive" role="alert">@Loc["mfa_rate_limited", retryAfterSeconds]</p>
                    }
                    else if (challengeFailed)
                    {
                        <p class="text-sm text-destructive" role="alert">@Loc["mfa_code_failed"]</p>
                    }
                    <Button Type="submit" data-ai-action="mfa.verify">@Loc["mfa_verify"]</Button>
                </form>
            }

            <p class="mt-4 text-sm text-muted-foreground">
                <a class="underline" href="@RoutePaths.Logout">@Loc["mfa_sign_out"]</a>
            </p>
    </Card>

</PageWrapper>

@code {
    /// <summary>A recovery code is longer than a TOTP code; the field has to admit both.</summary>
    private const int RecoveryCodeMaxLength = 32;
    private const int DefaultRetrySeconds = 60;
    private const string CodeField = "code";

    private bool NeedsEnrolment { get; set; }
    private bool challengeFailed;
    private int retryAfterSeconds;

    private string Subtitle => NeedsEnrolment ? Loc["mfa_subtitle_enrol"] : Loc["mfa_subtitle_code"];

    private async Task HandleSubmit()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        try
        {
            await Antiforgery.ValidateRequestAsync(ctx);
        }
        catch (AntiforgeryValidationException)
        {
            ctx.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        if (NeedsEnrolment)
        {
            ctx.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        var user = await ctx.User.GetUserAsync(Db, ctx.RequestAborted);
        var form = await ctx.Request.ReadFormAsync(ctx.RequestAborted);
        var result = await TotpChallenge.VerifyAsync(Db, user, form[CodeField].ToString(), ctx, ctx.RequestAborted);
        if (result == TotpChallengeResult.RateLimited)
        {
            ctx.Response.StatusCode = StatusCodes.Status429TooManyRequests;
            retryAfterSeconds = int.TryParse(ctx.Response.Headers.RetryAfter.ToString(), out var retryAfter)
                ? retryAfter
                : DefaultRetrySeconds;
            return;
        }

        if (result == TotpChallengeResult.Success)
        {
            ctx.Response.Redirect(RoutePaths.Home);
            return;
        }

        challengeFailed = true;
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx is null)
            return;

        var user = await ctx.User.GetUserOrDefaultAsync(Db, CancellationToken.None);
        if (user is null)
            return;

        var enrolled = await Db.UserTotps
            .AsNoTracking()
            .AnyAsync(t => t.UserId == user.Id && t.ConfirmedAt != null, CancellationToken.None);

        if (enrolled)
            return;

        // Not enrolled: the only reason to be here is a workspace policy past its grace window.
        var verdict = await Policies.EvaluateAsync(user.Id, CancellationToken.None);
        NeedsEnrolment = verdict.Blocked;
    }
}

@inject IStringLocalizer<QuickShare.SharedLoc> Loc

@page "/account/usage"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject IHttpContextAccessor HttpContextAccessor

<Card id="usage-card" class="my-4 w-full max-w-md p-6">
        <h3 class="mb-4 text-lg font-semibold">@Loc["account_usage_title"]</h3>
        @if (unlimited)
        {
            <p class="text-muted-foreground">@Loc["account_usage_unlimited"]</p>
        }
        else
        {
            <div class="h-2.5 w-full overflow-hidden rounded-full bg-muted" role="meter" aria-valuenow="@barWidth" aria-valuemin="0" aria-valuemax="100" aria-label="@Loc["account_usage_title"]">
                <div class="h-full transition-[width] motion-reduce:transition-none @barClass" style="width: @barWidth%"></div>
            </div>
            <div class="mt-2 flex items-baseline justify-between gap-3 text-sm">
                <span class="text-muted-foreground">@Loc["account_usage_summary", usedText, quotaText]</span>
                <span class="font-mono">@pct%</span>
            </div>
            @if (pct >= 70)
            {
                <Button Href="@RoutePaths.Upgrade" Size="sm" class="mt-3" data-ai-action="usage.upgrade">@Loc["account_usage_upgrade"]</Button>
            }
        }

        <p class="mt-3 text-xs text-muted-foreground">@Loc["account_usage_rate_limit", RateLimitPerMinute]</p>

        @if (coldArchivedBytes > 0)
        {
            <p id="usage-cold-bytes" class="mt-2 text-xs text-muted-foreground">@Loc["account_usage_cold_saved", FormatBytes(coldArchivedBytes)]</p>
        }
        @if (deduplicatedSavedBytes > 0)
        {
            <p id="usage-dedup-bytes" class="mt-1 text-xs text-muted-foreground">@Loc["account_usage_dedup_saved", FormatBytes(deduplicatedSavedBytes)]</p>
        }


        @* Largest files (issue #315) — the cleanup shortlist, biggest first. *@
        @if (largest.Count > 0)
        {
            <h4 class="mb-2 mt-5 font-semibold">@Loc["account_usage_largest_title"]</h4>
            <ul class="mb-3">
                @foreach (var file in largest)
                {
                    <li class="flex justify-between gap-3 py-1 text-sm">
                        <span class="min-w-0 truncate" title="@file.FileName">@file.FileName</span>
                        <span class="whitespace-nowrap font-mono tabular-nums text-muted-foreground">@FormatBytes(file.FileSize)</span>
                    </li>
                }
            </ul>
            <Button Href="@RoutePaths.AccountDeliveries" Variant="ghost" Size="sm">@Loc["account_usage_largest_manage"]</Button>
        }

        @* Recent download activity (issue #33) *@
        @if (recentDownloads.Count > 0)
        {
            <h4 class="mb-2 mt-5 font-semibold">@Loc["account_usage_recent_title"]</h4>
            <ul class="mb-3">
                @foreach (var dl in recentDownloads)
                {
                    <li class="flex justify-between gap-3 py-1 text-sm">
                        <span class="min-w-0 truncate" title="@dl.FileName">
                            @dl.FileName
                            @if (!string.IsNullOrEmpty(dl.CountryCode))
                            {
                                <span class="ml-1 font-mono text-xs text-muted-foreground">[@dl.CountryCode]</span>
                            }
                        </span>
                        <span class="whitespace-nowrap font-mono tabular-nums text-muted-foreground">@dl.DownloadedAt.ToLocalTime().ToString("g")</span>
                    </li>
                }
            </ul>
        }

        @* Download geolocation breakdown (issue #267) *@
        @if (countryBreakdown.Count > 0)
        {
            <h4 class="mb-2 mt-5 font-semibold">@Loc["account_usage_countries_title"]</h4>
            <ul id="usage-country-list" class="mb-3">
                @foreach (var c in countryBreakdown)
                {
                    <li class="flex justify-between gap-3 py-1 text-sm">
                        <span class="font-mono">@c.CountryCode</span>
                        <span class="font-mono tabular-nums text-muted-foreground">@c.Count</span>
                    </li>
                }
            </ul>
        }
</Card>

@code {
    private const int LargestFilesCount = 10;
    private const int RateLimitPerMinute = 1500;

    private sealed record LargestFile(string FileName, long FileSize);
    private sealed record RecentDownload(string FileName, DateTime DownloadedAt, string? CountryCode);
    private sealed record CountryBreakdown(string CountryCode, int Count);

    private List<LargestFile> largest = [];
    private List<RecentDownload> recentDownloads = [];
    private List<CountryBreakdown> countryBreakdown = [];
    private bool unlimited;
    private int pct;
    private int barWidth;
    private string barClass = "account-usage-bar__fill--ok";
    private string usedText = string.Empty;
    private string quotaText = string.Empty;
    private long coldArchivedBytes;
    private long deduplicatedSavedBytes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await HttpContextAccessor.HttpContext!.User.GetUserAsync(Db, CancellationToken.None);

            // Largest live files (issue #315) — cleanup targets, biggest first.
            largest = await Db.Deliveries
                .AsNoTracking()
                .Where(d => d.SenderId == user.Id && d.Status == DeliveryStatus.Active)
                .OrderByDescending(d => d.FileSize)
                .Take(LargestFilesCount)
                .Select(d => new LargestFile(d.FileName, d.FileSize))
                .ToListAsync();

            // Recent download activity (issue #33) — who downloaded, when.
            recentDownloads = await (
                from t in Db.DownloadTrackings
                join d in Db.Deliveries on t.DeliveryId equals d.Id
                where d.SenderId == user.Id
                orderby t.DownloadedAt descending
                select new RecentDownload(d.FileName, t.DownloadedAt, t.CountryCode)
            ).AsNoTracking().Take(5).ToListAsync();

            // Geolocation breakdown (issue #267) — top recipient countries.
            var rawCountries = await (
                from t in Db.DownloadTrackings
                join d in Db.Deliveries on t.DeliveryId equals d.Id
                where d.SenderId == user.Id && t.CountryCode != null && t.CountryCode != string.Empty
                select t.CountryCode
            ).AsNoTracking().ToListAsync();

            countryBreakdown = rawCountries
                .GroupBy(c => c!)
                .Select(g => new CountryBreakdown(g.Key, g.Count()))
                .OrderByDescending(c => c.Count)
                .ThenBy(c => c.CountryCode)
                .Take(10)
                .ToList();

            var quota = PlanTierLimits.GetMonthlyQuota(user.Plan);
            coldArchivedBytes = await Db.Deliveries
                .AsNoTracking()
                .Where(d => d.SenderId == user.Id && d.DeletedAt == null && d.StorageTier == DeliveryStorageTier.Cold)
                .SumAsync(d => (long?)d.FileSize) ?? 0L;
            deduplicatedSavedBytes = await Db.Deliveries
                .AsNoTracking()
                .Where(d => d.SenderId == user.Id && d.DeletedAt == null && d.IsDeduplicated)
                .SumAsync(d => (long?)d.FileSize) ?? 0L;
            if (quota is null)
            {
                unlimited = true;
                return;
            }

            var periodStart = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, DateTimeKind.Utc);
            var usage = await Db.UserUsages
                .AsNoTracking()
                .FirstOrDefaultAsync(u => u.UserId == user.Id && u.PeriodStart == periodStart);

            var used = Math.Max(0L, (usage?.TotalBytesUploaded ?? 0L) - (usage?.ColdArchivedBytes ?? 0L));
            pct = quota.Value == 0 ? 100 : (int)(used * 100 / quota.Value);
            barWidth = Math.Min(100, pct);
            barClass = pct switch
            {
                < 70 => "account-usage-bar__fill--ok",
                < 90 => "account-usage-bar__fill--warn",
                _ => "account-usage-bar__fill--over",
            };
            usedText = FormatBytes(used);
            quotaText = FormatBytes(quota.Value);
        }
        catch
        {
            unlimited = true;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        var magnitude = (int)Math.Floor(Math.Log(bytes, 1024));
        if (magnitude >= units.Length) magnitude = units.Length - 1;
        var size = bytes / Math.Pow(1024, magnitude);
        return magnitude == 0 ? $"{bytes} B" : $"{size:F1} {units[magnitude]}";
    }
}

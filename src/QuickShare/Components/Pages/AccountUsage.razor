@inject IStringLocalizer<QuickShare.SharedLoc> Loc

@page "/account/usage"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav

<HtmxFragment>
<div id="usage-card" class="db-card account-card account-usage">
    <div class="db-card__body">
        <h3 class="db-h4 account-usage__title">@Loc["account_usage_title"]</h3>
        @if (unlimited)
        {
            <p class="db-p db-text-muted account-usage__unlimited">@Loc["account_usage_unlimited"]</p>
        }
        else
        {
            <div class="account-usage-bar" role="meter" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="@Loc["account_usage_title"]">
                <div class="account-usage-bar__fill @barClass" style="width: @barWidth%"></div>
            </div>
            <div class="account-usage-meta">
                <span class="db-text-muted">@Loc["account_usage_summary", usedText, quotaText]</span>
                <span class="account-usage-pct">@pct%</span>
            </div>
            @if (pct >= 70)
            {
                <a href="@RoutePaths.Upgrade" class="db-btn db-btn--primary db-btn--sm" style="margin-top: 0.75rem" data-ai-action="usage.upgrade">@Loc["account_usage_upgrade"]</a>
            }
        }

        @* Largest files (issue #315) — the cleanup shortlist, biggest first. *@
        @if (largest.Count > 0)
        {
            <h4 class="db-h5 account-usage__largest-title">@Loc["account_usage_largest_title"]</h4>
            <ul class="account-usage-largest">
                @foreach (var file in largest)
                {
                    <li class="account-usage-largest__row">
                        <span class="account-usage-largest__name" title="@file.FileName">@file.FileName</span>
                        <span class="account-usage-largest__size db-text-muted">@FormatBytes(file.FileSize)</span>
                    </li>
                }
            </ul>
            <a href="@RoutePaths.AccountDeliveries" class="db-btn db-btn--ghost db-btn--sm">@Loc["account_usage_largest_manage"]</a>
        }

        @* Recent download activity (issue #33) *@
        @if (recentDownloads.Count > 0)
        {
            <h4 class="db-h5 account-usage__largest-title">@Loc["account_usage_recent_title"]</h4>
            <ul class="account-usage-largest">
                @foreach (var dl in recentDownloads)
                {
                    <li class="account-usage-largest__row">
                        <span class="account-usage-largest__name" title="@dl.FileName">@dl.FileName</span>
                        <span class="account-usage-largest__size db-text-muted">@dl.DownloadedAt.ToLocalTime().ToString("g")</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>
</HtmxFragment>

@code {
    private const int LargestFilesCount = 10;

    private sealed record LargestFile(string FileName, long FileSize);
    private sealed record RecentDownload(string FileName, DateTime DownloadedAt);

    private List<LargestFile> largest = [];
    private List<RecentDownload> recentDownloads = [];
    private bool unlimited;
    private int pct;
    private int barWidth;
    private string barClass = "account-usage-bar__fill--ok";
    private string usedText = string.Empty;
    private string quotaText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var request = HttpContextAccessor.HttpContext?.Request;
        if (request is not null
            && Microsoft.AspNetCore.Http.HttpMethods.IsGet(request.Method)
            && request.Headers[HtmxHeaders.Request].FirstOrDefault() != HtmxHeaders.RequestValue)
        {
            Nav.NavigateTo(RoutePaths.Account);
            return;
        }

        try
        {
            var user = await HttpContextAccessor.HttpContext!.User.GetUserAsync(Db, CancellationToken.None);

            // Largest live files (issue #315) — cleanup targets, biggest first.
            largest = await Db.Deliveries
                .AsNoTracking()
                .Where(d => d.SenderId == user.Id && d.Status == DeliveryStatus.Active)
                .OrderByDescending(d => d.FileSize)
                .Take(LargestFilesCount)
                .Select(d => new LargestFile(d.FileName, d.FileSize))
                .ToListAsync();

            // Recent download activity (issue #33) — who downloaded, when.
            recentDownloads = await (
                from t in Db.DownloadTrackings
                join d in Db.Deliveries on t.DeliveryId equals d.Id
                where d.SenderId == user.Id
                orderby t.DownloadedAt descending
                select new RecentDownload(d.FileName, t.DownloadedAt)
            ).AsNoTracking().Take(5).ToListAsync();

            var quota = PlanTierLimits.GetMonthlyQuota(user.Plan);
            if (quota is null)
            {
                unlimited = true;
                return;
            }

            var periodStart = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, DateTimeKind.Utc);
            var usage = await Db.UserUsages
                .AsNoTracking()
                .FirstOrDefaultAsync(u => u.UserId == user.Id && u.PeriodStart == periodStart);

            var used = usage?.TotalBytesUploaded ?? 0;
            pct = quota.Value == 0 ? 100 : (int)(used * 100 / quota.Value);
            barWidth = Math.Min(100, pct);
            barClass = pct switch
            {
                < 70 => "account-usage-bar__fill--ok",
                < 90 => "account-usage-bar__fill--warn",
                _ => "account-usage-bar__fill--over",
            };
            usedText = FormatBytes(used);
            quotaText = FormatBytes(quota.Value);
        }
        catch
        {
            unlimited = true;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        var magnitude = (int)Math.Floor(Math.Log(bytes, 1024));
        if (magnitude >= units.Length) magnitude = units.Length - 1;
        var size = bytes / Math.Pow(1024, magnitude);
        return magnitude == 0 ? $"{bytes} B" : $"{size:F1} {units[magnitude]}";
    }
}

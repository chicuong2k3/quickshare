@layout MainLayout
@page "/tools/online-clipboard"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

<ToolsLanding Heading="@Loc["tools_clipboard_heading"]"
              Description="@Loc["tools_clipboard_desc"]"
              Lede="@Loc["tools_clipboard_lede"]"
              PasteHint="@Loc["tools_clipboard_pastehint"]">
    <Body>
        <h2 class="mt-8 text-xl font-semibold">@Loc["tools_clipboard_what_title"]</h2>
        <p>@Loc["tools_clipboard_what_body"]</p>

        <h2 class="mt-8 text-xl font-semibold">@Loc["tools_clipboard_why_title"]</h2>
        <ul class="list-disc space-y-2 pl-6">
            <li>@Loc["tools_clipboard_why_1"]</li>
            <li>@Loc["tools_clipboard_why_2"]</li>
            <li>@Loc["tools_clipboard_why_3"]</li>
            <li>@Loc["tools_clipboard_why_4"]</li>
        </ul>

        <h2 class="mt-8 text-xl font-semibold">@Loc["tools_clipboard_good_title"]</h2>
        <p>@Loc["tools_clipboard_good_body"]</p>
    </Body>
</ToolsLanding>
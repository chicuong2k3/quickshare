@layout MainLayout
@page "/pricing"
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using QuickShare.Infrastructure.Caching
@using Microsoft.Extensions.Localization
@inject AppDbContext Db
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Config
@inject IStringLocalizer<QuickShare.SharedLoc> Loc

@{
    var isAuthenticated = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true;
    var currentUserPlan = PlanTierLimits.Free;
    if (isAuthenticated)
    {
        var userIdClaim = HttpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.NameIdentifier);
        if (Guid.TryParse(userIdClaim, out var userId))
        {
            currentUserPlan = StaticCache.Instance.GetOrSet(
                $"user:plan:{userId}",
                () => Db.Users
                    .AsNoTracking()
                    .Where(x => x.Id == userId)
                    .Select(x => x.Plan)
                    .FirstOrDefault() ?? PlanTierLimits.Free,
                TimeSpan.FromMinutes(10)
            );
        }
    }
    var currentPlanRank = GetPlanRank(currentUserPlan ?? PlanTierLimits.Free);

    var currency = Config[PricingKeys.Currency] ?? "$";
    var proMonthly = FormatPrice(Config.GetValue<int>(PricingKeys.ProMonthly, 9), currency);
    var proYearly = FormatPrice(Config.GetValue<int>(PricingKeys.ProYearly, 77), currency);
    var studioMonthly = FormatPrice(Config.GetValue<int>(PricingKeys.StudioMonthly, 29), currency);
    var studioYearly = FormatPrice(Config.GetValue<int>(PricingKeys.StudioYearly, 239), currency);
    var nowUtc = DateTime.UtcNow;
    var activeCampaign = Db.PromoCodes.AsNoTracking().Where(p => p.RevokedAt == null && p.CampaignName != null && p.AutoApplyOnCheckout && (p.StartsAt == null || p.StartsAt <= nowUtc) && (p.ExpiresAt == null || p.ExpiresAt > nowUtc)).OrderByDescending(p => p.Value).FirstOrDefault();
}

<PageTitle>@Loc["pricing_title"]</PageTitle>

<PageWrapper Variant="PageVariant.Padded">

    @* HERO *@
    <section class="hero">
        @* No eyebrow above the heading. *@
        <h1 class="text-3xl font-bold tracking-tight">@Loc["pricing_h1"]</h1>
        <p class="text-muted-foreground">@Loc["pricing_sub"]</p>
    </section>

    @if (activeCampaign is not null)
    {
        var claimHref = $"{RoutePaths.UpgradePro}&promo={activeCampaign.Code}";
        <section id="pricing-campaign-banner" class="my-6">
            <Card class="border-primary/40 bg-primary/5">
                <CardContent class="flex flex-wrap items-center justify-between gap-3 py-4">
                    <div>
                        <span class="rounded bg-primary px-2 py-0.5 text-xs font-semibold text-primary-foreground">@activeCampaign.CampaignName</span>
                        <strong class="ml-2 text-sm">@(activeCampaign.Description ?? activeCampaign.CampaignName)</strong>
                    </div>
                    <div class="flex items-center gap-3 text-xs">
                        <span>@Loc["campaign_code_label"]: <code id="pricing-campaign-code" class="rounded border bg-background px-2 py-0.5 font-mono font-bold">@activeCampaign.Code</code> (-@activeCampaign.Value%)</span>
                        <Button Href="@claimHref" Size="sm" data-ai-action="pricing.campaign.claim">@Loc["campaign_claim_btn"]</Button>
                    </div>
                </CardContent>
            </Card>
        </section>
    }

    @* BILLING TOGGLE + TIER CARDS (client-side toggle, no server round-trip) *@
    <section id="pricing-body"
             x-data="{ billing: '@(IsYearly ? BillingPeriods.Yearly : BillingPeriods.Monthly)' }"
             x-effect="const u = new URL(window.location); billing === 'yearly' ? u.searchParams.set('billing','yearly') : u.searchParams.delete('billing'); history.replaceState({}, '', u)">
        <div class="toggle-wrap">
            <div class="toggle-group">
                @* Static classes are the no-JS fallback; Alpine swaps them on init. *@
                <button type="button"
                        data-slot="button"
                        x-on:click="billing = 'monthly'"
                        :data-variant="billing === 'monthly' ? 'default' : 'ghost'"
                        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 cursor-pointer h-control px-4 py-2">
                    @Loc["pricing_monthly"]
                </button>
                <button type="button"
                        data-slot="button"
                        x-on:click="billing = 'yearly'"
                        :data-variant="billing === 'yearly' ? 'default' : 'ghost'"
                        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 cursor-pointer h-control px-4 py-2">
                    @Loc["pricing_yearly"]
                    <span class="tag">@Loc["pricing_save"]</span>
                </button>
            </div>
        </div>

        <div class="cards">

            @* Free Plan *@
            <div class="card">
                <div class="card__head">
                    <h3 class="text-xl font-semibold">@Loc["pricing_free_name"]</h3>
                    <p class="text-muted-foreground" style="margin-top: 0.5rem">@Loc["pricing_free_desc"]</p>
                </div>
                <div class="card__price">
                    <div class="price-amount">$0</div>
                    <div class="price-period text-muted-foreground">@Loc["pricing_free_price_period"]</div>
                </div>
                @if (!isAuthenticated)
                {
                    <Button Href="/login" Variant="secondary">@Loc["btn_get_started"]</Button>
                }
                <div class="features">
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_free_feat_size"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_free_feat_monthly"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_free_feat_expiry"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_free_feat_lossless"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_free_feat_e2e"]</span>
                    </div>
                </div>
            </div>

            @* Pro Plan *@
            <div class="card">
                <div class="card__head">
                    <h3 class="text-xl font-semibold">@Loc["pricing_pro_name"]</h3>
                    <p class="text-muted-foreground" style="margin-top: 0.5rem">@Loc["pricing_pro_desc"]</p>
                </div>
                <div class="card__price">
                    <div x-show="billing === 'monthly'" class="pricing-monthly">
                        <div class="price-amount">@proMonthly</div>
                        <div class="price-period text-muted-foreground">@Loc["pricing_pro_billed_monthly"]</div>
                    </div>
                    <div x-show="billing === 'yearly'" x-cloak class="pricing-yearly">
                        <div class="price-amount">@proYearly</div>
                        <div class="price-period text-muted-foreground">@Loc["pricing_pro_billed_yearly"]</div>
                    </div>
                </div>
                @if (currentPlanRank < ProPlanRank)
                {
                    <Button Href="@(isAuthenticated ? RoutePaths.UpgradePro : RoutePaths.Login)"
                       x-bind:href="(billing === 'yearly' ? '/upgrade?plan=pro&billing=yearly' : '/upgrade?plan=pro')">@Loc["btn_start_free_trial"]</Button>
                }
                <div class="features">
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_pro_feat_size"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_pro_feat_monthly"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_pro_feat_expiry"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_pro_feat_password"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_pro_feat_noads"]</span>
                    </div>
                </div>
            </div>

            @* Studio Plan (Most Popular) *@
            <div class="card card--popular">
                <span class="card__badge">@Loc["pricing_card_badge"]</span>
                <div class="card__head">
                    <h3 class="text-xl font-semibold">@Loc["pricing_studio_name"]</h3>
                    <p class="text-muted-foreground" style="margin-top: 0.5rem">@Loc["pricing_studio_desc"]</p>
                </div>
                <div class="card__price">
                    <div x-show="billing === 'monthly'" class="pricing-monthly">
                        <div class="price-amount">@studioMonthly</div>
                        <div class="price-period text-muted-foreground">@Loc["pricing_studio_billed_monthly"]</div>
                    </div>
                    <div x-show="billing === 'yearly'" x-cloak class="pricing-yearly">
                        <div class="price-amount">@studioYearly</div>
                        <div class="price-period text-muted-foreground">@Loc["pricing_studio_billed_yearly"]</div>
                    </div>
                </div>
                @if (currentPlanRank < StudioPlanRank)
                {
                    <Button Href="@(isAuthenticated ? RoutePaths.UpgradeStudio : RoutePaths.Login)"
                       x-bind:href="(billing === 'yearly' ? '/upgrade?plan=studio&billing=yearly' : '/upgrade?plan=studio')">@Loc["btn_start_free_trial"]</Button>
                }
                <div class="features">
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_studio_feat_size"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_studio_feat_monthly"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_studio_feat_expiry"]</span>
                    </div>
                    <div class="feature">
                        <svg class="feature__icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        <span>@Loc["pricing_studio_feat_api"]</span>
                    </div>
                </div>
            </div>

        </div>
    </section>


    @* Pricing calculator (issue #169) — client-side estimation from real PlanTierLimits *@
    <section id="pricing-calculator" class="my-8" aria-labelledby="pricing-calc-title">
        <Card>
            <CardContent class="space-y-4 py-6">
                <div>
                    <h2 id="pricing-calc-title" class="text-2xl font-bold">@Loc["pricing_calc_title"]</h2>
                    <p class="text-muted-foreground" style="margin-top: 0.25rem">@Loc["pricing_calc_sub"]</p>
                </div>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                    <div>
                        <label for="calc-files" class="block text-sm font-medium">@Loc["pricing_calc_files_label"]</label>
                        <Input id="calc-files" Type="number" min="1" max="10000" Value="20" oninput="window.quickSharePricingCalc && window.quickSharePricingCalc.update()" data-ai-action="pricing.calc.files" />
                    </div>
                    <div>
                        <label for="calc-size-mb" class="block text-sm font-medium">@Loc["pricing_calc_size_label"]</label>
                        <Input id="calc-size-mb" Type="number" min="1" max="102400" Value="250" oninput="window.quickSharePricingCalc && window.quickSharePricingCalc.update()" data-ai-action="pricing.calc.size" />
                    </div>
                    <div>
                        <label for="calc-retention-days" class="block text-sm font-medium">@Loc["pricing_calc_retention_label"]</label>
                        <Input id="calc-retention-days" Type="number" min="1" max="365" Value="7" oninput="window.quickSharePricingCalc && window.quickSharePricingCalc.update()" data-ai-action="pricing.calc.retention" />
                    </div>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-4 border-t pt-4">
                    <div>
                        <span class="text-sm text-muted-foreground">@Loc["pricing_calc_volume_label"]: </span>
                        <strong id="calc-volume-out">5.0 GB</strong>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-sm text-muted-foreground">@Loc["pricing_calc_recommend_label"]:</span>
                        <strong id="calc-plan-out" data-free="@Loc["pricing_free_name"]" data-pro="@Loc["pricing_pro_name"]" data-studio="@Loc["pricing_studio_name"]">@Loc["pricing_free_name"]</strong>
                        <Button id="calc-cta-btn" Href="@(isAuthenticated ? RoutePaths.UpgradePro : RoutePaths.Login)" Size="sm">@Loc["btn_start_free_trial"]</Button>
                    </div>
                </div>
            </CardContent>
        </Card>
    </section>
    <script>
        window.quickSharePricingCalc = {
            update: function () {
                var filesEl = document.getElementById('calc-files');
                var sizeEl = document.getElementById('calc-size-mb');
                var daysEl = document.getElementById('calc-retention-days');
                var volOut = document.getElementById('calc-volume-out');
                var planOut = document.getElementById('calc-plan-out');
                var ctaBtn = document.getElementById('calc-cta-btn');
                if (!filesEl || !sizeEl || !daysEl || !volOut || !planOut) return;
                var files = Math.max(1, parseInt(filesEl.value || '1', 10));
                var sizeMb = Math.max(1, parseFloat(sizeEl.value || '1'));
                var days = Math.max(1, parseInt(daysEl.value || '1', 10));
                var totalGb = (files * sizeMb) / 1024;
                volOut.textContent = totalGb.toFixed(1) + ' GB';
                var planKey = 'free';
                if (totalGb > 200 || sizeMb > 10240 || days > 30) {
                    planKey = 'studio';
                } else if (totalGb > 15 || sizeMb > 2048 || days > 7) {
                    planKey = 'pro';
                }
                planOut.textContent = planOut.getAttribute('data-' + planKey) || planKey;
                if (ctaBtn) {
                    ctaBtn.setAttribute('href', planKey === 'studio' ? '/upgrade?plan=studio' : '/upgrade?plan=pro');
                }
            }
        };
    </script>

    @* Side-by-side comparison (issue #299) — real limits from PlanTierLimits, no fabricated features. *@
    <section class="compare">
        <h2 class="text-2xl font-bold compare__title">@Loc["pricing_compare_title"]</h2>
        <div class="compare__scroll">
            <Table class="compare__table">
                <caption class="visually-hidden">@Loc["pricing_compare_title"]</caption>
                <TableHeader>
                    <TableRow>
                        <TableHead scope="col">@Loc["pricing_compare_feature"]</TableHead>
                        <TableHead scope="col">@Loc["pricing_free_name"]</TableHead>
                        <TableHead scope="col">@Loc["pricing_pro_name"]</TableHead>
                        <TableHead scope="col">@Loc["pricing_studio_name"]</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    <TableRow>
                        <TableHead scope="row">@Loc["pricing_compare_max_file"]</TableHead>
                        <TableCell>@SizeLabel(PlanTierLimits.GetMaxFileSize(PlanTierLimits.Free))</TableCell>
                        <TableCell>@SizeLabel(PlanTierLimits.GetMaxFileSize(PlanTierLimits.Pro))</TableCell>
                        <TableCell>@SizeLabel(PlanTierLimits.GetMaxFileSize(PlanTierLimits.Studio))</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["pricing_compare_monthly"]</TableHead>
                        <TableCell>@SizeLabel(PlanTierLimits.GetMonthlyQuota(PlanTierLimits.Free))</TableCell>
                        <TableCell>@SizeLabel(PlanTierLimits.GetMonthlyQuota(PlanTierLimits.Pro))</TableCell>
                        <TableCell>@SizeLabel(PlanTierLimits.GetMonthlyQuota(PlanTierLimits.Studio))</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["pricing_compare_expiry"]</TableHead>
                        <TableCell>@DaysLabel(PlanTierLimits.GetMaxExpiry(PlanTierLimits.Free))</TableCell>
                        <TableCell>@DaysLabel(PlanTierLimits.GetMaxExpiry(PlanTierLimits.Pro))</TableCell>
                        <TableCell>@DaysLabel(PlanTierLimits.GetMaxExpiry(PlanTierLimits.Studio))</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["pricing_compare_downloads"]</TableHead>
                        <TableCell>@PlanTierLimits.GetMaxDownloads(PlanTierLimits.Free)</TableCell>
                        <TableCell>@PlanTierLimits.GetMaxDownloads(PlanTierLimits.Pro)</TableCell>
                        <TableCell>@PlanTierLimits.GetMaxDownloads(PlanTierLimits.Studio)</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["pricing_compare_password"]</TableHead>
                        <TableCell>✓</TableCell><TableCell>✓</TableCell><TableCell>✓</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["pricing_compare_scheduled"]</TableHead>
                        <TableCell>—</TableCell><TableCell>✓</TableCell><TableCell>✓</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["pricing_compare_alias"]</TableHead>
                        <TableCell>—</TableCell><TableCell>✓</TableCell><TableCell>✓</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["pricing_compare_daily_cap"]</TableHead>
                        <TableCell>—</TableCell><TableCell>✓</TableCell><TableCell>✓</TableCell>
                    </TableRow>
                    <TableRow>
                        <TableHead scope="row">@Loc["pricing_compare_noads"]</TableHead>
                        <TableCell>—</TableCell><TableCell>✓</TableCell><TableCell>✓</TableCell>
                    </TableRow>
                </TableBody>
            </Table>
        </div>
    </section>

    @* FAQ *@
    <section class="faq">
        <div class="faq__head">
            <h2 class="text-2xl font-bold">@Loc["pricing_faq_title"]</h2>
            <p class="text-muted-foreground" style="margin-top: 0.75rem">@Loc["pricing_faq_sub"]</p>
        </div>
        @foreach (var (q, a) in faqs)
        {
            <details>
                <summary>
                    <span>@q</span>
                    <svg class="faq-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                    </svg>
                </summary>
                <div class="faq-answer text-muted-foreground">@a</div>
            </details>
        }
    </section>

    <section id="pricing-education-discount" class="my-8" aria-labelledby="pricing-edu-title">
        <Card>
            <CardContent class="flex flex-wrap items-center justify-between gap-4 py-6">
                <div class="space-y-1">
                    <h2 id="pricing-edu-title" class="text-xl font-bold">@Loc["discount_edu_title"]</h2>
                    <p class="text-sm text-muted-foreground">@Loc["discount_edu_sub"]</p>
                </div>
                <Button Href="@(isAuthenticated ? RoutePaths.UpgradePro : RoutePaths.Login)" Variant="outline" data-ai-action="pricing.edu.apply">@Loc["discount_edu_cta"]</Button>
            </CardContent>
        </Card>
    </section>

    @* CTA *@
    <section class="cta" x-data="{ billing: new URLSearchParams(window.location.search).get('billing') || 'monthly' }">
        <h3 class="cta__title">@Loc["pricing_cta_title"]</h3>
        <p class="text-muted-foreground">@Loc["pricing_cta_sub"]</p>
        <Button Href="@(isAuthenticated ? RoutePaths.Upgrade : RoutePaths.Login)"
           x-bind:href="(billing === 'yearly' ? '/upgrade?billing=yearly' : '/upgrade')">@Loc["btn_get_started"]</Button>
    </section>

</PageWrapper>

@code {

@inject IStringLocalizer<QuickShare.SharedLoc> Loc

@* Global (non-scoped) styles: this markup also ships inside server-rendered partials. *@
<nav class="account-tabs" aria-label="Account sections">
    <a href="@RoutePaths.Account" class="account-tabs__item @Active(RoutePaths.Account)">@Loc["account_tab_profile"]</a>
    <a href="@RoutePaths.AccountDeliveries" class="account-tabs__item @Active(RoutePaths.AccountDeliveries)">@Loc["account_tab_deliveries"]</a>
    <a href="@RoutePaths.AccountDeveloper" class="account-tabs__item @Active(RoutePaths.AccountDeveloper)">@Loc["account_tab_developer"]</a>
    <a href="@RoutePaths.AccountSecurity" class="account-tabs__item @Active(RoutePaths.AccountSecurity)">@Loc["account_tab_security"]</a>
    <a href="@RoutePaths.AccountRecurring" class="account-tabs__item @Active(RoutePaths.AccountRecurring)">@Loc["account_tab_recurring"]</a>
    <a href="@RoutePaths.AccountFileRequests" class="account-tabs__item @Active(RoutePaths.AccountFileRequests)">@Loc["account_tab_requests"]</a>
    <a href="@RoutePaths.AccountWorkspace" class="account-tabs__item @Active(RoutePaths.AccountWorkspace)">@Loc["ws_tab_workspace"]</a>
    <a href="@RoutePaths.AccountBilling" class="account-tabs__item @Active(RoutePaths.AccountBilling)">@Loc["account_tab_billing"]</a>
</nav>

@code {
    private const string ActiveClass = "account-tabs__item--active";

    [Parameter]
    public string Current { get; set; } = RoutePaths.Account;

    private string Active(string route) =>
        string.Equals(Current, route, StringComparison.OrdinalIgnoreCase) ? ActiveClass : string.Empty;
}

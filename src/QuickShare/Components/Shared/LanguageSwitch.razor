@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IStringLocalizer<QuickShare.SharedLoc> Loc
@inject IHttpContextAccessor HttpContextAccessor

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}


<div class="lang-switch" data-ai-action="switch-language">
    <NativeSelect onchange="
        var culture = this.value;
        document.cookie = '.AspNetCore.Culture=c=' + culture + '|uic=' + culture + ';path=/;max-age=2592000';
        location.reload();
    " aria-label="@Loc["lang_switch_label"]">
        <NativeSelectOption value="en" Selected="@(currentCulture == "en")">@Loc["lang_en"]</NativeSelectOption>
        <NativeSelectOption value="vi" Selected="@(currentCulture == "vi")">@Loc["lang_vi"]</NativeSelectOption>
    </NativeSelect>
</div>
@page "/account"
@using RizzyUI
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor

@{
    var user = HttpContextAccessor.HttpContext?.User;
    var name = user?.FindFirstValue(ClaimTypes.Name) ?? "Unknown";
    var email = user?.FindFirstValue(ClaimTypes.Email) ?? "No email";
    var provider = user?.FindFirstValue("provider") ?? "unknown";
    var avatar = user?.FindFirstValue("avatar_url") ?? "";
}

<PageTitle>Account — QuickShareCloud</PageTitle>

<div class="min-h-screen flex flex-col bg-gradient-to-b from-[#fcfbf8] to-[#f6f4ed] text-foreground">
    <header class="absolute inset-x-0 top-0 z-50">
        <div class="flex items-center justify-between px-8 py-6">
            <RzLink Href="/" Underline="false" class="flex items-center gap-3 text-foreground/80 hover:text-foreground transition-colors">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-foreground/10 text-foreground/70 text-xs font-bold">Q</span>
                <span class="text-sm font-semibold tracking-tight">QuickShareCloud</span>
            </RzLink>
            <nav class="flex items-center gap-2">
                <RzLink Href="/" Underline="false" class="rounded-full px-5 py-2 text-sm font-medium text-foreground/70 hover:text-foreground hover:bg-foreground/5 transition-all">Send</RzLink>
                <RzLink Href="/pricing" Underline="false" class="rounded-full px-5 py-2 text-sm font-medium text-foreground/70 hover:text-foreground hover:bg-foreground/5 transition-all">Pricing</RzLink>
                <RzLink Href="/logout" Underline="false" class="rounded-full px-5 py-2 text-sm font-medium text-foreground/70 hover:text-foreground hover:bg-foreground/5 transition-all">Sign out</RzLink>
            </nav>
        </div>
    </header>

    <main class="flex flex-1 items-center justify-center px-6 pb-20 pt-32">
        <RzCard class="w-full max-w-md shadow-sm">
            <CardContent class="p-10">
                <div class="flex flex-col items-center text-center">
                    @if (!string.IsNullOrEmpty(avatar))
                    {
                        <RzAvatar Size="Size.Large" class="ring-2 ring-border">
                            <img src="@avatar" alt="@name" class="h-16 w-16 rounded-full object-cover" />
                        </RzAvatar>
                    }
                    else
                    {
                        <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-primary/8 text-primary text-2xl font-bold">
                            @name[..1].ToUpper()
                        </div>
                    }
                    <RzHeading Level="HeadingLevel.H2" class="mt-5 text-2xl font-semibold">@name</RzHeading>
                    <RzParagraph class="mt-1.5 text-base text-muted-foreground">@email</RzParagraph>
                    <RzBadge Variant="ThemeVariant.Default" Soft="true" class="mt-3">@provider</RzBadge>
                </div>

                <div class="mt-10 space-y-3">
                    <RzItem Variant="ItemVariant.Outline">
                        <ItemContent>
                            <ItemTitle>Account created</ItemTitle>
                        </ItemContent>
                        <ItemActions>
                            <span class="text-sm font-medium">Just now</span>
                        </ItemActions>
                    </RzItem>
                    <RzItem Variant="ItemVariant.Outline">
                        <ItemContent>
                            <ItemTitle>Plan</ItemTitle>
                        </ItemContent>
                        <ItemActions>
                            <RzBadge Variant="ThemeVariant.Default" Soft="true">Free</RzBadge>
                        </ItemActions>
                    </RzItem>
                </div>

                <div class="mt-10">
                    <RzLink Href="/logout" Underline="false"
                            class="flex w-full items-center justify-center rounded-2xl border border-destructive/20 bg-destructive/5 px-6 py-3.5 text-sm font-medium text-destructive hover:bg-destructive/10 transition-colors">
                        Sign out
                    </RzLink>
                </div>
            </CardContent>
        </RzCard>
    </main>

    <footer class="px-8 py-6 text-center text-xs text-muted-foreground/80">
        QuickShareCloud &mdash; secure file sharing.
    </footer>
</div>

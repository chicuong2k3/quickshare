@page "/t/{ShareId:guid}"
@inject HttpClient Http
@inject IConfiguration Config
@using System.Net
@using System.Text.Json
@using System.Text.Json.Serialization
@* Static SSR download page. The server calls the API at render time (no client interactivity required).
   Constraint: no InteractiveServer / WebAssembly. *@
@{
    var apiBase = Config["QuickShare:ApiBaseUrl"] ?? "http://localhost:59155";
    var downloadUrl = $"{apiBase.TrimEnd('/')}/api/temp/{ShareId}/download";
}

<PageTitle>Download — QuickShareCloud</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-lg rounded-2xl border border-border bg-card shadow-sm">
        @switch (RenderState)
        {
            case DownloadRenderState.Loading:
                <div class="p-8 text-center">
                    <div class="mx-auto h-8 w-8 animate-spin rounded-full border-2 border-primary border-t-transparent"></div>
                    <p class="mt-3 text-sm text-muted-foreground">Checking link…</p>
                </div>
                break;

            case DownloadRenderState.Ready:
                <div class="p-8">
                    <div class="flex items-start gap-4">
                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                            @FileIcon(Info?.ContentType)
                        </div>
                        <div class="min-w-0 flex-1">
                            <h1 class="truncate text-lg font-semibold tracking-tight" title="@Info?.Filename">@Info?.Filename</h1>
                            <p class="mt-1 text-sm text-muted-foreground">@FormatBytes(Info?.Size ?? 0) · @ExpiryCountdown(Info?.ExpiresAt ?? DateTime.UtcNow)</p>
                        </div>
                    </div>

                    <div class="mt-6">
                        <a href="@downloadUrl"
                           class="flex w-full items-center justify-center gap-2 rounded-md bg-primary px-4 py-3 text-sm font-medium text-primary-foreground transition hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <polyline points="7 10 12 15 17 10" />
                                <line x1="12" y1="15" x2="12" y2="3" />
                            </svg>
                            Download
                        </a>
                        <p class="mt-3 text-center text-xs text-muted-foreground">
                            Your download starts in a new request. No login required.
                        </p>
                    </div>
                </div>
                break;

            case DownloadRenderState.Expired:
                <div class="p-8 text-center">
                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-muted">
                        <svg class="h-6 w-6 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <polyline points="12 6 12 12 16 14" />
                        </svg>
                    </div>
                    <h1 class="mt-4 text-lg font-semibold tracking-tight">This file has expired</h1>
                    @if (!string.IsNullOrEmpty(Info?.Filename))
                    {
                        <p class="mt-2 text-sm text-muted-foreground">
                            <span class="font-medium text-foreground">@Info.Filename</span>
                            @if (Info.ExpiresAt != default)
                            {
                                <text> · expired @Info.ExpiresAt.ToString("d MMM yyyy, HH:mm") UTC</text>
                            }
                        </p>
                    }
                    <p class="mt-1 text-xs text-muted-foreground">Temp shares are removed automatically after expiry.</p>
                </div>
                break;

            case DownloadRenderState.NotFound:
                <div class="p-8 text-center">
                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-muted">
                        <svg class="h-6 w-6 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                        </svg>
                    </div>
                    <h1 class="mt-4 text-lg font-semibold tracking-tight">File not found</h1>
                    <p class="mt-2 text-sm text-muted-foreground">This link doesn't match any share.</p>
                    <a href="/" class="mt-6 inline-flex items-center justify-center rounded-md border border-border bg-background px-4 py-2 text-sm font-medium hover:bg-muted">
                        Share a new file
                    </a>
                </div>
                break;

            case DownloadRenderState.Error:
                <div class="p-8 text-center">
                    <h1 class="text-lg font-semibold tracking-tight">Something went wrong</h1>
                    <p class="mt-2 text-sm text-muted-foreground">We couldn't reach the share service. Please try again in a moment.</p>
                    <a href="/" class="mt-6 inline-flex items-center justify-center rounded-md border border-border bg-background px-4 py-2 text-sm font-medium hover:bg-muted">
                        Back to upload
                    </a>
                </div>
                break;
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid ShareId { get; set; }

    private DownloadRenderState RenderState { get; set; } = DownloadRenderState.Loading;
    private TempShareInfoDto? Info { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Default permissive back-end call. The endpoint returns 200 with an `expired` flag
            // when the row exists but past expiry (per Design Notes), 404 when the row truly doesn't exist.
            var response = await Http.GetAsync($"api/temp/{ShareId}");
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                RenderState = DownloadRenderState.NotFound;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                RenderState = DownloadRenderState.Error;
                return;
            }

            await using var stream = await response.Content.ReadAsStreamAsync();
            Info = await JsonSerializer.DeserializeAsync<TempShareInfoDto>(stream, JsonOptions);
            if (Info is null)
            {
                RenderState = DownloadRenderState.Error;
                return;
            }

            RenderState = Info.Expired ? DownloadRenderState.Expired : DownloadRenderState.Ready;
        }
        catch (Exception)
        {
            // Network failure reaching the API — render a generic error state (SSR, no client retry round-trip).
            RenderState = DownloadRenderState.Error;
        }
    }

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        var magnitude = (int)Math.Floor(Math.Log(bytes, 1024));
        if (magnitude >= units.Length) magnitude = units.Length - 1;
        var size = bytes / Math.Pow(1024, magnitude);
        return magnitude == 0 ? $"{bytes} B" : $"{size:F1} {units[magnitude]}";
    }

    private static string ExpiryCountdown(DateTime expiresAt)
    {
        var remaining = expiresAt - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) return "expired";
        if (remaining.TotalHours < 1) return $"expires in {(int)remaining.TotalMinutes} min";
        if (remaining.TotalHours < 24) return $"expires in {(int)remaining.TotalHours} h";
        return $"expires in {(int)remaining.TotalDays} day{((int)remaining.TotalDays == 1 ? "" : "s")}";
    }

    private static MarkupString FileIcon(string? contentType)
    {
        var key = (contentType ?? "").ToLowerInvariant();
        var svg = key switch
        {
            var s when s.StartsWith("image/") => IconPath("M21 15V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9 M3 16l5-5 4 4 3-3 4 4 M16 19h6 M19 16v6"),
            var s when s.StartsWith("video/") => IconPath("m22 8-6 4 6 4V8Z M14 6H4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2Z"),
            var s when s.StartsWith("audio/") => IconPath("M9 18V5l12-2v13 M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"),
            "application/pdf" => IconPath("M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M9 13h6 M9 17h6"),
            var s when s.Contains("zip") || s.Contains("compressed") || s.Contains("tar") =>
                IconPath("M21 8v13H3V8 M1 3h22v5H1z M10 12h4"),
            var s when s.Contains("json") || s.Contains("xml") || s.StartsWith("text/") =>
                IconPath("M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"),
            _ => IconPath("M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6"),
        };
        return new MarkupString(svg);
    }

    private static string IconPath(string d) =>
        $"<svg class=\"h-6 w-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{d}\"/></svg>";

    private enum DownloadRenderState { Loading, Ready, Expired, NotFound, Error }

    private sealed class TempShareInfoDto
    {
        public Guid Id { get; set; }
        public string Filename { get; set; } = string.Empty;
        public long Size { get; set; }
        public string ContentType { get; set; } = string.Empty;
        public DateTime ExpiresAt { get; set; }
        public bool Expired { get; set; }
    }
}

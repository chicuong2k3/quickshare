@page "/pricing"
@using RizzyUI

<PageTitle>Pricing — QuickShareCloud</PageTitle>

<div class="min-h-screen flex flex-col" x-data="{ billing: 'monthly', openFaq: null }" x-cloak>
    <header class="flex items-center justify-between px-6 py-5">
        <RzLink Href="/" Underline="false" class="flex items-center gap-2 text-foreground">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-primary-foreground text-xs font-bold">Q</span>
            <span class="text-sm font-semibold tracking-tight">QuickShareCloud</span>
        </RzLink>
        <nav class="flex items-center gap-4 text-sm">
            <RzLink Href="/">Upload</RzLink>
            <RzLink Href="/pricing">Pricing</RzLink>
        </nav>
    </header>

    <main class="flex-1 px-4 pb-16">
        <section class="max-w-4xl mx-auto pt-12 pb-12 text-center">
            <RzHeading Level="HeadingLevel.H1" class="text-3xl font-bold tracking-tight sm:text-4xl">
                You've got the ideas,<br class="sm:hidden" /> we've got the plans
            </RzHeading>
            <RzParagraph ProseWidth="ProseWidth.Comfortable" class="mt-4 text-base text-muted-foreground mx-auto sm:text-lg">
                Whether you're sending big files for fun or delivering work for clients — keep creative projects moving forward with QuickShareCloud.
            </RzParagraph>

            <div class="mt-10 inline-flex items-center rounded-full border border-border bg-muted/40 p-1"
                 role="radiogroup" aria-label="Billing period">
                <RzButton Variant="ThemeVariant.Default" role="radio"
                        x-bind:aria-checked="(billing === 'monthly').toString()"
                        x-bind:class="billing === 'monthly' ? 'bg-primary text-primary-foreground shadow-sm' : 'text-muted-foreground hover:text-foreground'"
                        class="rounded-full px-5 py-2 text-sm font-medium transition-colors"
                        x-on:click="billing = 'monthly'">Monthly</RzButton>
                <RzButton Variant="ThemeVariant.Default" role="radio"
                        x-bind:aria-checked="(billing === 'yearly').toString()"
                        x-bind:class="billing === 'yearly' ? 'bg-primary text-primary-foreground shadow-sm' : 'text-muted-foreground hover:text-foreground'"
                        class="rounded-full px-5 py-2 text-sm font-medium transition-colors"
                        x-on:click="billing = 'yearly'">Yearly</RzButton>
            </div>
        </section>

        @* TIER CARDS *@
        <section class="max-w-5xl mx-auto grid gap-6 lg:grid-cols-3 lg:items-start">
            @* Free *@
            <RzCard class="flex flex-col">
                <CardContent class="p-6 sm:p-8 flex flex-col flex-1">
                    <h2 class="text-lg font-semibold">Free</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Perfect for occasional users or anyone exploring QuickShareCloud for the first time.</p>
                    <p class="mt-1 text-xs text-muted-foreground">For individual, non-commercial use only</p>
                    <div class="mt-5"><span class="text-4xl font-bold">$0</span></div>
                    <p class="mt-1 text-sm text-muted-foreground">Enjoy QuickShareCloud for free</p>
                    <ul class="mt-6 space-y-3 text-sm flex-1">
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Share and receive up to <strong>3 GB</strong> / month</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><strong>10</strong> transfers per month</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Transfer expiry up to <strong>3 days</strong></span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Data encryption</span></li>
                    </ul>
                    <div class="mt-8">
                        <a href="/" class="flex w-full items-center justify-center rounded-md border border-border bg-background px-4 py-2.5 text-sm font-medium hover:bg-muted transition-colors focus:outline-none focus:ring-2 focus:ring-ring">Get Started</a>
                    </div>
                </CardContent>
            </RzCard>

            @* Starter *@
            <RzCard class="flex flex-col">
                <CardContent class="p-6 sm:p-8 flex flex-col flex-1">
                    <h2 class="text-lg font-semibold">Starter</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Share and receive up to 300 GB / month.</p>
                    <p class="mt-1 text-xs text-muted-foreground">For individual use only</p>
                    <div class="mt-5">
                        <span x-show="billing === 'monthly'" class="text-4xl font-bold">$8</span>
                        <span x-show="billing === 'yearly'" class="text-4xl font-bold">$77</span>
                        <span x-show="billing === 'monthly'" class="text-sm text-muted-foreground">/month</span>
                        <span x-show="billing === 'yearly'" class="text-sm text-muted-foreground">/year</span>
                    </div>
                    <p x-show="billing === 'monthly'" class="mt-1 text-sm text-muted-foreground">Billed monthly</p>
                    <p x-show="billing === 'yearly'" class="mt-1 text-sm text-muted-foreground">$6.42/mo billed annually</p>
                    <ul class="mt-6 space-y-3 text-sm flex-1">
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Share and receive up to <strong>300 GB</strong> / month</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><strong>10</strong> transfers per month</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Transfer expiry up to <strong>3 days</strong></span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Password-protected transfers</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Custom wallpaper backgrounds</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Data encryption</span></li>
                    </ul>
                    <div class="mt-8">
                        <a href="/checkout?tier=starter" class="flex w-full items-center justify-center rounded-md bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors focus:outline-none focus:ring-2 focus:ring-ring">Subscribe</a>
                    </div>
                </CardContent>
            </RzCard>

            @* Ultimate (Most Popular) *@
            <RzCard class="flex flex-col relative border-primary border-2 lg:scale-105">
                <RzBadge Variant="ThemeVariant.Primary" class="absolute -top-3 left-1/2 -translate-x-1/2">Most Popular</RzBadge>
                <CardContent class="p-6 sm:p-8 flex flex-col flex-1">
                    <h2 class="text-lg font-semibold">Ultimate</h2>
                    <p class="mt-1 text-sm text-muted-foreground">The ultimate choice for power users who send big files all day, every day.</p>
                    <p class="mt-1 text-xs text-muted-foreground">For individual use only</p>
                    <div class="mt-5">
                        <span x-show="billing === 'monthly'" class="text-4xl font-bold">$23</span>
                        <span x-show="billing === 'yearly'" class="text-4xl font-bold">$221</span>
                        <span x-show="billing === 'monthly'" class="text-sm text-muted-foreground">/month</span>
                        <span x-show="billing === 'yearly'" class="text-sm text-muted-foreground">/year</span>
                    </div>
                    <p x-show="billing === 'monthly'" class="mt-1 text-sm text-muted-foreground">Billed monthly</p>
                    <p x-show="billing === 'yearly'" class="mt-1 text-sm text-muted-foreground">$18.42/mo billed annually</p>
                    <ul class="mt-6 space-y-3 text-sm flex-1">
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><strong>Unlimited</strong> transfer volume</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><strong>Unlimited</strong> transfers per month</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><strong>Unlimited</strong> transfer expiration</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Custom branding per transfer</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Recover expired transfers</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Automatic malware scanning</span></li>
                        <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Sell files and receive payment</span></li>
                    </ul>
                    <div class="mt-8">
                        <a href="/checkout?tier=ultimate" class="flex w-full items-center justify-center rounded-md bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors focus:outline-none focus:ring-2 focus:ring-ring">Subscribe</a>
                    </div>
                </CardContent>
            </RzCard>
        </section>

        @* FEATURE COMPARISON TABLE *@
        <section class="max-w-5xl mx-auto mt-20">
            <RzHeading Level="HeadingLevel.H2" class="text-2xl font-bold tracking-tight text-center">Compare plans</RzHeading>

            <div class="mt-10 overflow-x-auto">
                <RzTable class="w-full text-sm">
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell class="text-left font-medium">Feature</TableHeaderCell>
                            <TableHeaderCell class="text-center w-28">Free</TableHeaderCell>
                            <TableHeaderCell class="text-center w-28">Starter</TableHeaderCell>
                            <TableHeaderCell class="text-center w-28">Ultimate</TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @* Send and Receive *@
                        <TableRow><td colspan="4" class="pt-6 pb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Send and Receive</td></TableRow>
                        <TableRow><td class="py-3 pr-4">GB / Month</td><td class="py-3 px-4 text-center text-muted-foreground">3</td><td class="py-3 px-4 text-center text-muted-foreground">300</td><td class="py-3 px-4 text-center font-medium">Unlimited</td></TableRow>
                        <TableRow><td class="py-3 pr-4">Transfers / Month</td><td class="py-3 px-4 text-center text-muted-foreground">10</td><td class="py-3 px-4 text-center text-muted-foreground">10</td><td class="py-3 px-4 text-center font-medium">Unlimited</td></TableRow>
                        <TableRow><td class="py-3 pr-4">File size limit</td><td class="py-3 px-4 text-center text-muted-foreground">2 GB</td><td class="py-3 px-4 text-center text-muted-foreground">2 GB</td><td class="py-3 px-4 text-center text-muted-foreground">2 GB</td></TableRow>

                        @* Security *@
                        <TableRow><td colspan="4" class="pt-6 pb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Security</td></TableRow>
                        <TableRow><td class="py-3 pr-4">Transfer expiry</td><td class="py-3 px-4 text-center text-muted-foreground">Up to 3 days</td><td class="py-3 px-4 text-center text-muted-foreground">Up to 3 days</td><td class="py-3 px-4 text-center font-medium">Unlimited</td></TableRow>
                        <TableRow><td class="py-3 pr-4">Recover expired transfers</td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Password-protected transfers</td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Data encryption</td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Automatic malware scanning</td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td></TableRow>

                        @* Branding *@
                        <TableRow><td colspan="4" class="pt-6 pb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Branding</td></TableRow>
                        <TableRow><td class="py-3 pr-4">Custom transfer page</td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Personalized transfer emails</td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Custom transfer wallpapers</td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Social links on download page</td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Custom branding per transfer</td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td></TableRow>

                        @* Monetization *@
                        <TableRow><td colspan="4" class="pt-6 pb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Monetization</td></TableRow>
                        <TableRow><td class="py-3 pr-4">Sell files and receive payment</td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><span class="text-muted-foreground">—</span></td><td class="py-3 px-4 text-center"><svg class="mx-auto h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Platform fees</td><td class="py-3 px-4 text-center text-muted-foreground">N/A</td><td class="py-3 px-4 text-center text-muted-foreground">N/A</td><td class="py-3 px-4 text-center font-medium">None</td></TableRow>

                        @* Team Features (Coming Soon) *@
                        <TableRow><td colspan="4" class="pt-6 pb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Team Features</td></TableRow>
                        <TableRow><td class="py-3 pr-4">Shared branding</td><td colspan="3" class="py-3 px-4 text-center"><RzBadge Variant="ThemeVariant.Default" Soft="true">Coming Soon</RzBadge></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Invite team members</td><td colspan="3" class="py-3 px-4 text-center"><RzBadge Variant="ThemeVariant.Default" Soft="true">Coming Soon</RzBadge></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Shared storage</td><td colspan="3" class="py-3 px-4 text-center"><RzBadge Variant="ThemeVariant.Default" Soft="true">Coming Soon</RzBadge></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Centralized billing</td><td colspan="3" class="py-3 px-4 text-center"><RzBadge Variant="ThemeVariant.Default" Soft="true">Coming Soon</RzBadge></td></TableRow>
                    </TableBody>
                </RzTable>
            </div>
        </section>

        @* FAQ *@
        <section class="max-w-3xl mx-auto mt-20">
            <RzHeading Level="HeadingLevel.H2" class="text-2xl font-bold tracking-tight text-center">Frequently asked questions</RzHeading>
            <dl class="mt-10 divide-y divide-border">
                <div class="py-5">
                    <dt><RzButton Variant="ThemeVariant.Ghost" class="flex w-full items-center justify-between text-left text-sm font-medium hover:text-primary transition-colors" x-on:click="openFaq = openFaq === 0 ? null : 0" x-bind:aria-expanded="(openFaq === 0).toString()">What happens after I sign up and pay?<svg class="ml-4 h-4 w-4 shrink-0 text-muted-foreground transition-transform" x-bind:class="openFaq === 0 ? 'rotate-180' : ''" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></RzButton></dt>
                    <dd class="mt-3 pr-12 text-sm text-muted-foreground" x-show="openFaq === 0" x-cloak>Access to your plan's features is immediate. You can start using the paid-tier limits right away. No waiting period.</dd>
                </div>
                <div class="py-5">
                    <dt><RzButton Variant="ThemeVariant.Ghost" class="flex w-full items-center justify-between text-left text-sm font-medium hover:text-primary transition-colors" x-on:click="openFaq = openFaq === 1 ? null : 1" x-bind:aria-expanded="(openFaq === 1).toString()">Do my recipients need to sign up?<svg class="ml-4 h-4 w-4 shrink-0 text-muted-foreground transition-transform" x-bind:class="openFaq === 1 ? 'rotate-180' : ''" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></RzButton></dt>
                    <dd class="mt-3 pr-12 text-sm text-muted-foreground" x-show="openFaq === 1" x-cloak>No. Recipients download files without creating an account, regardless of your plan tier. Just share the link.</dd>
                </div>
                <div class="py-5">

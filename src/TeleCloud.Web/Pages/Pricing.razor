@page "/pricing"
@inject IHttpContextAccessor HttpContextAccessor

@using System.Security.Claims
@{
    var isAuthenticated = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true;
    var userName = HttpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.Name);
}

<PageTitle>Pricing — QuickShareCloud</PageTitle>

<div class="min-h-screen flex flex-col" x-data="{ billing: 'monthly' }" x-cloak>
    <header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-sm">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-4 sm:px-6 py-3.5 flex-wrap">
            <RzLink Href="/" Underline="false" class="flex items-center gap-2.5 text-foreground">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground text-sm font-bold">Q</span>
                <span class="text-sm font-semibold tracking-tight">QuickShareCloud</span>
            </RzLink>
            <RzNavigationMenu Label="Main" class="justify-end">
                <NavigationMenuList class="gap-1">
                    <NavigationMenuItem>
                        <NavigationMenuLink Href="/">Upload</NavigationMenuLink>
                    </NavigationMenuItem>
                    <NavigationMenuItem>
                        <NavigationMenuLink Href="/pricing">Pricing</NavigationMenuLink>
                    </NavigationMenuItem>
                    @if (isAuthenticated)
                    {
                        <NavigationMenuItem>
                            <NavigationMenuLink Href="/account">@userName</NavigationMenuLink>
                        </NavigationMenuItem>
                        <NavigationMenuItem>
                            <NavigationMenuLink Href="/logout">Logout</NavigationMenuLink>
                        </NavigationMenuItem>
                    }
                    else
                    {
                        <NavigationMenuItem>
                            <NavigationMenuLink Href="/login">Login</NavigationMenuLink>
                        </NavigationMenuItem>
                    }
                </NavigationMenuList>
            </RzNavigationMenu>
        </div>
    </header>

    <main class="flex-1 px-4 pb-16">
        <section class="max-w-4xl mx-auto pt-12 pb-12 text-center">
            <RzAnimatedGradientText Speed="@(1.5m)" ColorFrom="#5E6AD2" ColorTo="#8B93F8">
                <RzHeading Level="HeadingLevel.H1" class="text-3xl font-bold tracking-tight sm:text-4xl">
                    You've got the ideas,<br class="sm:hidden" /> we've got the
                    <RzHighlighter Action="HighlighterAction.Underline" Color="#5E6AD2" StrokeWidth="3" AnimationDuration="@(800)" StartOnView="true">plans</RzHighlighter>
                </RzHeading>
            </RzAnimatedGradientText>
            <RzParagraph ProseWidth="ProseWidth.Comfortable" class="mt-4 text-base text-muted-foreground mx-auto sm:text-lg">
                Whether you're sending big files for fun or delivering work for clients — keep creative projects moving forward with QuickShareCloud.
            </RzParagraph>

            <div class="mt-10 flex items-center justify-center"
                 x-on:rz:tabs-change="billing = $event.detail.value">
                <RzTabs DefaultValue="monthly">
                    <TabsList class="inline-flex items-center rounded-full border border-border bg-muted/40 p-1">
                        <TabsTrigger Value="monthly"
                                    class="rounded-full px-5 py-2 text-sm font-medium transition-colors data-[state=active]:bg-primary data-[state=active]:text-primary-foreground data-[state=active]:shadow-sm data-[state=inactive]:text-muted-foreground">
                            Monthly
                        </TabsTrigger>
                        <TabsTrigger Value="yearly"
                                    class="rounded-full px-5 py-2 text-sm font-medium transition-colors data-[state=active]:bg-primary data-[state=active]:text-primary-foreground data-[state=active]:shadow-sm data-[state=inactive]:text-muted-foreground">
                            Yearly
                        </TabsTrigger>
                    </TabsList>
                    <TabsContent Value="monthly" />
                    <TabsContent Value="yearly" />
                </RzTabs>
            </div>
        </section>

        @* TIER CARDS *@
        <section class="max-w-5xl mx-auto grid gap-6 lg:grid-cols-3 lg:items-start">
            @* Free *@
            <RzCard class="flex flex-col">
                <CardContent class="p-6 sm:p-8 flex flex-col flex-1">
                    <RzHeading Level="HeadingLevel.H3" class="text-lg font-semibold">Free</RzHeading>
                    <RzParagraph class="mt-1 text-sm text-muted-foreground">Perfect for occasional users or anyone exploring QuickShareCloud for the first time.</RzParagraph>
                    <RzParagraph class="mt-1 text-xs text-muted-foreground">For individual, non-commercial use only</RzParagraph>
                    <div class="mt-5"><span class="text-4xl font-bold">$0</span></div>
                    <RzParagraph class="mt-1 text-sm text-muted-foreground">Enjoy QuickShareCloud for free</RzParagraph>
                    <div class="mt-6 space-y-2 text-sm flex-1">
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Share and receive up to <strong>3 GB</strong> / month</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent><strong>10</strong> transfers per month</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Transfer expiry up to <strong>3 days</strong></ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Data encryption</ItemContent>
                        </RzItem>
                    </div>
                    <div class="mt-8">
                        <RzButton Variant="ThemeVariant.Default" class="w-full" x-on:click="window.location.href='/'">Get Started</RzButton>
                    </div>
                </CardContent>
            </RzCard>

            @* Starter *@
            <RzCard class="flex flex-col">
                <CardContent class="p-6 sm:p-8 flex flex-col flex-1">
                    <RzHeading Level="HeadingLevel.H3" class="text-lg font-semibold">Starter</RzHeading>
                    <RzParagraph class="mt-1 text-sm text-muted-foreground">Share and receive up to 300 GB / month.</RzParagraph>
                    <RzParagraph class="mt-1 text-xs text-muted-foreground">For individual use only</RzParagraph>
                    <div class="mt-5">
                        <span x-show="billing === 'monthly'" class="text-4xl font-bold">$8</span>
                        <span x-show="billing === 'yearly'" class="text-4xl font-bold">$77</span>
                        <span x-show="billing === 'monthly'" class="text-sm text-muted-foreground">/month</span>
                        <span x-show="billing === 'yearly'" class="text-sm text-muted-foreground">/year</span>
                    </div>
                    <RzParagraph x-show="billing === 'monthly'" class="mt-1 text-sm text-muted-foreground">Billed monthly</RzParagraph>
                    <RzParagraph x-show="billing === 'yearly'" class="mt-1 text-sm text-muted-foreground">$6.42/mo billed annually</RzParagraph>
                    <div class="mt-6 space-y-2 text-sm flex-1">
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Share and receive up to <strong>300 GB</strong> / month</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent><strong>10</strong> transfers per month</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Transfer expiry up to <strong>3 days</strong></ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Password-protected transfers</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Custom wallpaper backgrounds</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Data encryption</ItemContent>
                        </RzItem>
                    </div>
                    <div class="mt-8">
                        <RzButton Variant="ThemeVariant.Primary" class="w-full" x-on:click="window.location.href='/checkout?tier=starter'">Subscribe</RzButton>
                    </div>
                </CardContent>
            </RzCard>

            @* Ultimate (Most Popular) *@
            <RzCard class="flex flex-col relative overflow-hidden border-primary border-2 lg:scale-105">
                <RzShineBorder BorderWidth="1" Duration="8" ShineColors='@(new[] { "#5E6AD2", "#8B93F8" })' />
                <RzBadge Variant="ThemeVariant.Primary" class="absolute -top-3 left-1/2 -translate-x-1/2 z-10">Most Popular</RzBadge>

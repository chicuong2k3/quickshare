                    <RzHeading Level="HeadingLevel.H3" class="text-lg font-semibold">Ultimate</RzHeading>
                    <RzParagraph class="mt-1 text-sm text-muted-foreground">The ultimate choice for power users who send big files all day, every day.</RzParagraph>
                    <RzParagraph class="mt-1 text-xs text-muted-foreground">For individual use only</RzParagraph>
                    <div class="mt-5">
                        <span x-show="billing === 'monthly'" class="text-4xl font-bold">$23</span>
                        <span x-show="billing === 'yearly'" class="text-4xl font-bold">$221</span>
                        <span x-show="billing === 'monthly'" class="text-sm text-muted-foreground">/month</span>
                        <span x-show="billing === 'yearly'" class="text-sm text-muted-foreground">/year</span>
                    </div>
                    <RzParagraph x-show="billing === 'monthly'" class="mt-1 text-sm text-muted-foreground">Billed monthly</RzParagraph>
                    <RzParagraph x-show="billing === 'yearly'" class="mt-1 text-sm text-muted-foreground">$18.42/mo billed annually</RzParagraph>
                    <div class="mt-6 space-y-2 text-sm flex-1">
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent><strong>Unlimited</strong> transfer volume</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent><strong>Unlimited</strong> transfers per month</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent><strong>Unlimited</strong> transfer expiration</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Custom branding per transfer</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Recover expired transfers</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Automatic malware scanning</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia>
                                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </ItemMedia>
                            <ItemContent>Sell files and receive payment</ItemContent>
                        </RzItem>
                    </div>
                    <div class="mt-8">
                        <RzButton Variant="ThemeVariant.Primary" class="w-full" x-on:click="window.location.href='/checkout?tier=ultimate'">Subscribe</RzButton>
                    </div>
                </CardContent>
            </RzCard>
        </section>

        @* FEATURE COMPARISON TABLE *@

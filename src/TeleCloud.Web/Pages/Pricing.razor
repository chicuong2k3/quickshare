                        <TableRow><td colspan="4" class="pt-6 pb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Team Features</td></TableRow>
                        <TableRow><td class="py-3 pr-4">Shared branding</td><td colspan="3" class="py-3 px-4 text-center"><RzBadge Variant="ThemeVariant.Default" Soft="true">Coming Soon</RzBadge></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Invite team members</td><td colspan="3" class="py-3 px-4 text-center"><RzBadge Variant="ThemeVariant.Default" Soft="true">Coming Soon</RzBadge></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Shared storage</td><td colspan="3" class="py-3 px-4 text-center"><RzBadge Variant="ThemeVariant.Default" Soft="true">Coming Soon</RzBadge></td></TableRow>
                        <TableRow><td class="py-3 pr-4">Centralized billing</td><td colspan="3" class="py-3 px-4 text-center"><RzBadge Variant="ThemeVariant.Default" Soft="true">Coming Soon</RzBadge></td></TableRow>
                    </TableBody>
                </RzTable>
            </div>
        </section>

        @* FAQ — Alpine.js collapsible *@
        <section class="bg-muted/30 mt-24 py-16 sm:py-20">
            <div class="mx-auto max-w-3xl px-4">
                <div class="text-center">
                    <RzAvatar Size="Size.Medium" class="mx-auto mb-4 bg-primary/10 text-primary">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
                    </RzAvatar>
                    <RzHeading Level="HeadingLevel.H2" class="text-2xl font-bold tracking-tight">Frequently asked questions</RzHeading>
                    <RzParagraph class="mt-2 text-muted-foreground">Everything you need to know about QuickShareCloud</RzParagraph>
                </div>
                <RzAccordion Type="AccordionType.Single" class="mt-10">
                    @foreach (var (q, a) in faqs)
                    {
                        <AccordionItem>
                            <AccordionTrigger>@q</AccordionTrigger>
                            <AccordionContent>
                                <p class="text-sm text-muted-foreground">@a</p>
                            </AccordionContent>
                        </AccordionItem>
                    }
                </RzAccordion>
            </div>
        </section>
    </main>
</div>

@code {
    private static readonly (string Question, string Answer)[] faqs = new[]
    {
        ("What happens after I sign up and pay?", "Access to your plan's features is immediate. You can start using the paid-tier limits right away. No waiting period."),
        ("Do my recipients need to sign up?", "No. Recipients download files without creating an account, regardless of your plan tier. Just share the link."),
        ("Can I receive bigger transfers from anyone?", "Senders are limited by their own plan's limits. Your plan does not affect what others can send to you. All files are capped at 2 GB."),
        ("What payment methods can I use?", "Credit/debit cards and PayPal are accepted. The checkout flow will guide you through available options."),
        ("What happens if I go over my storage limit?", "On Free and Starter plans, transfers will be blocked once the monthly limit is reached until the next billing cycle. Ultimate has no volume limits."),
        ("What can I do with a Free plan?", "Share and receive up to 3 GB/month across 10 transfers. Files expire after up to 3 days. Includes data encryption and basic sharing — no account required."),
        ("How do I cancel?", "Cancel anytime from your account settings. Your paid features remain active until the end of the current billing period. No refunds for partial months."),
        ("Can I trust QuickShareCloud? How safe is it?", "Files are transferred over encrypted connections. Password protection is available on Starter and Ultimate plans. We never access your file contents."),
    };
}

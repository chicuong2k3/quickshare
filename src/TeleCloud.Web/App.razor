<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="QuickShareCloud — anonymous temporary file sharing with auto-expiry." />
    <title>QuickShareCloud</title>

    @* Compiled Tailwind 4 + RizzyUI ArcticTheme CSS (built via npm run build:css). *@
    <link rel="stylesheet" href="/css/app.css" />

    @* Standard Blazor head outlet (RizzyUI 0.9.2-alpha ships no RzHeadOutlet component;
       Alpine.js + RizzyUI scripts are injected server-side by app.UseRizzy() middleware). *@
    <HeadOutlet />

    @* RizzyUI theme provider: emits the Arctic CSS variables. *@
    <RzThemeProvider />
</head>
<body class="min-h-screen bg-background text-foreground antialiased overflow-x-hidden">
    <Routes />
    @* Vendored client-side libraries (no external/CDN call at runtime).
       Alpine.js CSP build auto-bootstraps; upload.js registers its Alpine component
       via window.addEventListener('alpine:init', ...). *@
    <script src="/lib/alpine/alpine.min.js" defer></script>
    <script src="/lib/qrcode/qrcode.min.js"></script>
    <script src="/js/upload.js"></script>
</body>
</html>

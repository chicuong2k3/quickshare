@layout MainLayout
@page "/account"
@attribute [Authorize]
@inject IQuickShareApi Api
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Config

@{
    var apiBase = (Config["QuickShare:ApiBaseUrl"] ?? "http://localhost:59155").TrimEnd('/');
}

<PageTitle>Account — QuickShareCloud</PageTitle>

<script>window.ZAPDROP_CONFIG = { apiBaseUrl: "@apiBase" };</script>

<div id="account-app" class="page">

    @* ── Profile Card ── *@
    <HtmxFragment>
    <div id="profile-card" class="db-card">
        <div class="db-card__body">
            <div class="profile">
                <div class="avatar-wrap" onclick="document.getElementById('avatarFile').click()">
                    @if (!string.IsNullOrEmpty(avatar))
                    {
                        <img id="avatarPreview" class="avatar-img" src="@avatar" alt="@name" />
                    }
                    else
                    {
                        <div id="avatarInitial" class="avatar-initial">@name[..1].ToUpper()</div>
                        <img id="avatarPreview" class="hidden avatar-img" src="" alt="@name" />
                    }
                    <div class="avatar-overlay">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    </div>
                </div>
                <h2 class="db-h2" style="margin-top: 1.25rem">@name</h2>
                <p class="db-p db-text-muted" style="margin-top: 0.25rem">@email</p>
                <span class="db-badge db-badge--updated" style="margin-top: 0.75rem">@provider &middot; @plan</span>
            </div>

            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="db-alert db-alert--error" style="margin-top: 1.5rem" role="alert">@formError</div>
            }

            <form class="form" hx-post="/account" hx-target="#profile-card" hx-select="#profile-card" hx-swap="outerHTML" hx-encoding="multipart/form-data" hx-indicator="#profile-save-spinner" hx-disabled-elt="#name, #avatarFile, button[type=submit]" onpost="@HandleUpdateProfile">
                <div class="form-inner">
                    <label class="db-field">
                        <span class="db-label">Display name</span>
                        <input id="name" name="name" type="text" required value="@name" class="db-field__input db-input" />
                    </label>

                    <div>
                        <input id="avatarFile" name="avatar" type="file" accept="image/*" class="sr-only" onchange="previewAvatar(event)" />
                    </div>

                    <button type="submit" class="db-btn db-btn--primary profile-save-btn" style="width: 100%" data-ai-action="profile.save.submit">
                        <span class="btn-text">Save changes</span>
                        <span id="profile-save-spinner" class="htmx-indicator btn-spinner"></span>
                    </button>
                </div>
            </form>

            <div class="logout-row">
                <a href="/logout" hx-boost="false" class="db-btn db-btn--ghost" style="width: 100%; display: flex; align-items: center; justify-content: center">Sign out</a>
            </div>
        </div>
    </div>
    </HtmxFragment>

    @* ── Branding Card ── *@
    <div class="db-card" id="branding-card">
        <div class="db-card__body">
            <div class="section-head">
                <div class="section-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M12 1v2 M12 21v2 M4.22 4.22l1.42 1.42 M18.36 18.36l1.42 1.42 M1 12h2 M21 12h2 M4.22 19.78l1.42-1.42 M18.36 5.64l1.42-1.42" />
                    </svg>
                </div>
                <div>
                    <h3 class="db-h3">Delivery Branding</h3>
                    <p class="db-p db-text-muted">Customise how recipients see your deliveries.</p>
                </div>
            </div>

            <div id="branding-loading" class="db-text-center" style="padding: 2.5rem 0">
                <div class="db-spinner db-spinner--lg"></div>
                <p class="db-p db-text-muted" style="margin-top: 0.75rem">Loading deliveries&hellip;</p>
            </div>
            <div id="branding-empty" class="branding-empty" style="display:none">No deliveries yet. Send a file first to brand it.</div>
            <div id="branding-list" style="display:none"></div>
        </div>
    </div>
</div>

<script src="/js/account.js"></script>

@code {
    private string name = "Unknown";
    private string email = string.Empty;
    private string avatar = string.Empty;
    private string plan = "free";
    private string provider = "unknown";
    private string? formError;

    [SupplyParameterFromForm(Name = "name")]
    private string? FormName { get; set; }

    [SupplyParameterFromForm(Name = "avatar")]
    private IFormFile? FormAvatar { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await Api.GetMyProfileAsync();
            if (profile is not null)
            {
                name = profile.Name;
                email = profile.Email;
                avatar = profile.AvatarUrl;
                plan = profile.Plan;
            }
        }
        catch { }
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null) 
        { 
            provider = httpContext.User?.FindFirstValue(AuthConstants.ProviderClaimType) ?? "unknown"; 
            formError = httpContext.Request.Query["error"].FirstOrDefault(); 
        }
    }

    private async Task HandleUpdateProfile()
    {
        formError = null;
        var newName = FormName?.Trim();
        if (string.IsNullOrWhiteSpace(newName)) 
        { 
            formError = "Name is required"; 
            return; 
        }
        string? avatarBase64 = null;
        if (FormAvatar is { Length: > 0 })
        {
            if (FormAvatar.Length > 5 * 1024 * 1024) 
            { 
                formError = "Image must be under 5 MB"; 
                return; 
            }
            using var ms = new MemoryStream();
            await FormAvatar.CopyToAsync(ms);
            avatarBase64 = $"data:{FormAvatar.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        ProfileResponse? profile;
        try
        {
            profile = await Api.UpdateMyProfileAsync(new UpdateProfileRequest(newName, avatarBase64));
        }
        catch
        {
            formError = "Failed to update profile";
            return;
        }
        name = newName;
        avatar = profile?.AvatarUrl ?? string.Empty;

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            var identity = httpContext.User.Identities.First();
            var claims = identity.Claims.Where(c => c.Type != ClaimTypes.Name).ToList();
            claims.Add(new Claim(ClaimTypes.Name, newName));
            var newPrincipal = new ClaimsPrincipal(new ClaimsIdentity(claims, identity.AuthenticationType));
            await httpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, newPrincipal);

            httpContext.Response.Headers["HX-Trigger"] = "profileUpdated";
        }
    }
}

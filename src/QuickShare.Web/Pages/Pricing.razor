@page "/pricing"
@inject IHttpContextAccessor HttpContextAccessor

@using System.Security.Claims
@{
    var isAuthenticated = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true;
    var userName = HttpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.Name);
}

<PageTitle>Pricing — QuickShareCloud</PageTitle>

<div class="min-h-screen flex flex-col bg-gradient-to-b from-[#fcfbf8] to-[#f6f4ed] text-foreground" x-data="{ billing: 'monthly' }" x-cloak>
    <header class="absolute inset-x-0 top-0 z-50">
        <div class="flex items-center justify-between px-8 py-6">
            <RzLink Href="/" Underline="false" class="flex items-center gap-3 text-foreground/80 hover:text-foreground transition-colors">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-foreground/10 text-foreground/70 text-xs font-bold">Q</span>
                <span class="text-sm font-semibold tracking-tight">QuickShareCloud</span>
            </RzLink>
            <nav class="flex items-center gap-2">
                <RzLink Href="/" Underline="false" class="rounded-full px-5 py-2 text-sm font-medium text-foreground/70 hover:text-foreground hover:bg-foreground/5 transition-all">Send</RzLink>
                <RzLink Href="/pricing" Underline="false" class="rounded-full px-5 py-2 text-sm font-medium bg-foreground/10 text-foreground transition-all">Pricing</RzLink>
                @if (isAuthenticated)
                {
                    <RzLink Href="/files" Underline="false" class="rounded-full px-5 py-2 text-sm font-medium text-foreground/70 hover:text-foreground hover:bg-foreground/5 transition-all">Files</RzLink>
                    <RzLink Href="/account" Underline="false" class="rounded-full px-5 py-2 text-sm font-medium text-foreground/70 hover:text-foreground hover:bg-foreground/5 transition-all">@userName</RzLink>
                    <RzLink Href="/logout" Underline="false" class="rounded-full px-5 py-2 text-sm font-medium text-foreground/70 hover:text-foreground hover:bg-foreground/5 transition-all">Sign out</RzLink>
                }
                else
                {
                    <RzLink Href="/login" Underline="false" class="rounded-full px-5 py-2 text-sm font-medium text-foreground/70 hover:text-foreground hover:bg-foreground/5 transition-all">Sign in</RzLink>
                }
            </nav>
        </div>
    </header>

    <main class="flex-1 px-6 pb-32 pt-32 sm:px-8">
        <section class="max-w-4xl mx-auto pt-12 pb-16 text-center">
            <RzHeading Level="HeadingLevel.H1" class="text-4xl font-extrabold tracking-tight sm:text-5xl">
                Simple pricing,<br class="sm:hidden" /> unlimited sending
            </RzHeading>
            <RzParagraph class="mt-5 text-lg text-muted-foreground mx-auto max-w-xl">
                Pick the plan that fits your workflow. All plans include end-to-end encryption.
            </RzParagraph>

            <div class="mt-12 flex items-center justify-center"
                 x-on:rz:tabs-change="billing = $event.detail.value">
                <RzTabs DefaultValue="monthly">
                    <TabsList class="inline-flex items-center rounded-full border border-border/60 bg-background p-1 shadow-sm">
                        <TabsTrigger Value="monthly"
                                    class="rounded-full px-6 py-2.5 text-sm font-medium transition-all data-[state=active]:bg-foreground data-[state=active]:text-background data-[state=active]:shadow-sm data-[state=inactive]:text-muted-foreground">
                            Monthly
                        </TabsTrigger>
                        <TabsTrigger Value="yearly"
                                    class="rounded-full px-6 py-2.5 text-sm font-medium transition-all data-[state=active]:bg-foreground data-[state=active]:text-background data-[state=active]:shadow-sm data-[state=inactive]:text-muted-foreground">
                            Yearly <span class="ml-1.5 text-xs text-accent-foreground">Save 20%</span>
                        </TabsTrigger>
                    </TabsList>
                    <TabsContent Value="monthly" />
                    <TabsContent Value="yearly" />
                </RzTabs>
            </div>
        </section>

        @* TIER CARDS *@
        <section class="max-w-5xl mx-auto grid gap-8 lg:grid-cols-3 lg:items-stretch">
            @* Free *@
            <RzCard class="flex flex-col shadow-sm">
                <CardContent class="p-10 flex flex-col flex-1">
                    <RzHeading Level="HeadingLevel.H3" class="text-xl font-semibold">Free</RzHeading>
                    <RzParagraph class="mt-2 text-sm text-muted-foreground">Perfect for occasional sharing.</RzParagraph>
                    <div class="mt-8"><span class="text-5xl font-bold">$0</span></div>
                    <RzParagraph class="mt-2 text-sm text-muted-foreground">Free forever</RzParagraph>
                    <div class="mt-10 space-y-4 text-sm flex-1">
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent>Up to <strong>200 MB</strong> per file</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent><strong>3 GB</strong> / month</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent><strong>10</strong> transfers per month</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent>Files expire after <strong>3 days</strong></ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent>End-to-end encryption</ItemContent>
                        </RzItem>
                    </div>
                    <div class="mt-10">
                        <RzButton Variant="ThemeVariant.Default" class="w-full rounded-2xl py-3.5 text-sm font-semibold shadow-sm" x-on:click="window.location.href='/'">Get started</RzButton>
                    </div>
                </CardContent>
            </RzCard>

            @* Starter *@
            <RzCard class="flex flex-col shadow-sm">
                <CardContent class="p-10 flex flex-col flex-1">
                    <RzHeading Level="HeadingLevel.H3" class="text-xl font-semibold">Starter</RzHeading>
                    <RzParagraph class="mt-2 text-sm text-muted-foreground">For creators and freelancers.</RzParagraph>
                    <div class="mt-8">
                        <span x-show="billing === 'monthly'" class="text-5xl font-bold">$8</span>
                        <span x-show="billing === 'yearly'" class="text-5xl font-bold">$77</span>
                        <span class="text-sm text-muted-foreground">/month</span>
                    </div>
                    <RzParagraph x-show="billing === 'monthly'" class="mt-2 text-sm text-muted-foreground">Billed monthly</RzParagraph>
                    <RzParagraph x-show="billing === 'yearly'" class="mt-2 text-sm text-muted-foreground">$6.42/mo billed annually</RzParagraph>
                    <div class="mt-10 space-y-4 text-sm flex-1">
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent>Up to <strong>750 MB</strong> per file</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent><strong>300 GB</strong> / month</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent><strong>50</strong> transfers per month</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent>Files expire after <strong>7 days</strong></ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent>Password protection</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent>Custom backgrounds</ItemContent>
                        </RzItem>
                    </div>
                    <div class="mt-10">
                        <RzButton Variant="ThemeVariant.Primary" class="w-full rounded-2xl py-3.5 text-sm font-semibold shadow-sm" x-on:click="window.location.href='/checkout?tier=starter'">Subscribe</RzButton>
                    </div>
                </CardContent>
            </RzCard>

            @* Ultimate *@
            <RzCard class="flex flex-col shadow-md ring-1 ring-foreground/10 relative overflow-hidden">
                <RzBadge Variant="ThemeVariant.Primary" class="absolute -top-3 left-1/2 -translate-x-1/2 z-10 rounded-full px-4 py-1 text-xs font-medium">Most Popular</RzBadge>
                <CardContent class="p-10 flex flex-col flex-1">
                    <RzHeading Level="HeadingLevel.H3" class="text-xl font-semibold">Ultimate</RzHeading>
                    <RzParagraph class="mt-2 text-sm text-muted-foreground">For power users who send big files daily.</RzParagraph>
                    <div class="mt-8">
                        <span x-show="billing === 'monthly'" class="text-5xl font-bold">$23</span>
                        <span x-show="billing === 'yearly'" class="text-5xl font-bold">$221</span>
                        <span class="text-sm text-muted-foreground">/month</span>
                    </div>
                    <RzParagraph x-show="billing === 'monthly'" class="mt-2 text-sm text-muted-foreground">Billed monthly</RzParagraph>
                    <RzParagraph x-show="billing === 'yearly'" class="mt-2 text-sm text-muted-foreground">$18.42/mo billed annually</RzParagraph>
                    <div class="mt-10 space-y-4 text-sm flex-1">
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent>Up to <strong>1.5 GB</strong> per file</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent><strong>Unlimited</strong> volume &amp; transfers</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent><strong>Unlimited</strong> expiry</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent>Custom branding</ItemContent>
                        </RzItem>
                        <RzItem Size="Size.Small">
                            <ItemMedia><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></ItemMedia>
                            <ItemContent>Malware scanning</ItemContent>
                        </RzItem>
                    </div>
                    <div class="mt-10">
                        <RzButton Variant="ThemeVariant.Primary" class="w-full rounded-2xl py-3.5 text-sm font-semibold shadow-md" x-on:click="window.location.href='/checkout?tier=ultimate'">Subscribe</RzButton>
                    </div>
                </CardContent>
            </RzCard>
        </section>

        @* FAQ *@
        <section class="max-w-3xl mx-auto mt-32">
            <div class="text-center">
                <RzHeading Level="HeadingLevel.H2" class="text-3xl font-bold tracking-tight">Frequently asked questions</RzHeading>
                <RzParagraph class="mt-4 text-lg text-muted-foreground">Everything you need to know about QuickShareCloud</RzParagraph>
            </div>
            <div class="mt-12">
                <RzAccordion Type="AccordionType.Single">
                    @foreach (var (q, a) in faqs)
                    {
                        <AccordionItem>
                            <AccordionTrigger>@q</AccordionTrigger>
                            <AccordionContent>
                                <RzParagraph class="pb-4 text-muted-foreground">@a</RzParagraph>
                            </AccordionContent>
                        </AccordionItem>
                    }
                </RzAccordion>
            </div>
        </section>
    </main>

    <footer class="px-8 py-8 text-center text-xs text-muted-foreground/80">
        <p>QuickShareCloud &mdash; send files, not friction.</p>
        <nav class="flex items-center justify-center gap-6 mt-3">
            <RzLink Href="/" Underline="false" class="text-muted-foreground/80 hover:text-foreground transition-colors">Send</RzLink>
            <RzLink Href="/login" Underline="false" class="text-muted-foreground/80 hover:text-foreground transition-colors">Sign in</RzLink>
        </nav>
    </footer>
</div>

@code {
    private static readonly (string Question, string Answer)[] faqs = new[]
    {
        ("What file size limits apply?", "Free: 200 MB per file. Starter: 750 MB per file. Ultimate: 1.5 GB per file."),
        ("Do my recipients need to sign up?", "No. Recipients download files without creating an account. Just share the link."),
        ("What payment methods can I use?", "Credit/debit cards and PayPal are accepted."),
        ("What happens if I go over my limit?", "On Free and Starter plans, transfers are blocked until the next billing cycle. Ultimate has no limits."),
        ("How do I cancel?", "Cancel anytime from your account settings. Paid features remain until the billing period ends."),
        ("Is QuickShareCloud secure?", "Files are transferred over encrypted connections. We never access your file contents."),
    };
}

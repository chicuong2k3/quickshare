@layout MainLayout
@page "/files"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using QuickShare.Shared.Models
@inject IHttpClientFactory ClientFactory
@inject IConfiguration Config
@inject IHttpContextAccessor HttpContextAccessor

@{
    var apiBase = (Config["QuickShare:ApiBaseUrl"] ?? "http://localhost:59155").TrimEnd('/');
}

<PageTitle>Files — QuickShareCloud</PageTitle>

<div class="flex-1" x-data="filesPage()" x-cloak>
    <main class="flex-1 px-6 pb-24 pt-32 sm:px-8">
        <div class="mx-auto max-w-5xl">
            @* ===== PAGE HEADING ===== *@
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
                        @(SelectedFolder is not null ? SelectedFolder.Name : "All files")
                    </h1>
                    <p class="mt-1 text-sm text-muted-foreground">
                        @(SelectedFolder is not null
                            ? $"Files in {SelectedFolder.Name}"
                            : "Browse all your uploaded files")
                    </p>
                </div>

                @* ===== SEARCH ===== *@
                <div class="w-full sm:w-72">
                    <form method="get" action="/files"
                          hx-trigger="input changed delay:500ms"
                          hx-target="#files-list"
                          hx-swap="outerHTML"
                          hx-push-url="true"
                          class="relative">
                        @if (!string.IsNullOrEmpty(FolderId))
                        {
                            <input type="hidden" name="folderId" value="@FolderId" />
                        }
                        <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.35-4.35" />
                        </svg>
                        <input type="text"
                               name="search"
                               placeholder="Search files&hellip;"
                               value="@SearchTerm"
                               class="w-full rounded-2xl border border-border/60 bg-background pl-11 pr-10 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm"
                               aria-label="Search files" />
                        @if (!string.IsNullOrEmpty(SearchTerm))
                        {
                            <button type="button"
                                    onclick="window.location.href='/files@(string.IsNullOrEmpty(FolderId) ? "" : "?folderId=" + Uri.EscapeDataString(FolderId))'"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full p-1 text-muted-foreground/50 hover:text-foreground transition-colors"
                                    aria-label="Clear search">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18" />
                                    <line x1="6" y1="6" x2="18" y2="18" />
                                </svg>
                            </button>
                        }
                    </form>
                </div>
            </div>

            @* ===== USAGE STATISTICS DASHBOARD (Story 1.9) ===== *@
            <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div class="rounded-2xl border border-border/30 bg-card p-5 shadow-sm">
                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Files</p>
                    <p class="mt-2 text-2xl font-bold text-foreground">@(Stats?.TotalFiles ?? 0)</p>
                </div>
                <div class="rounded-2xl border border-border/30 bg-card p-5 shadow-sm">
                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Storage used</p>
                    <p class="mt-2 text-2xl font-bold text-foreground">@FormatBytes(Stats?.TotalSize ?? 0)</p>
                </div>
                <div class="rounded-2xl border border-border/30 bg-card p-5 shadow-sm">
                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Plan</p>
                    <p class="mt-2 text-2xl font-bold text-foreground">@(Stats?.Plan ?? "Free")</p>
                </div>
                <div class="rounded-2xl border border-border/30 bg-card p-5 shadow-sm">
                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Folders</p>
                    <p class="mt-2 text-2xl font-bold text-foreground">@(Folders?.Count ?? 0)</p>
                </div>
            </div>

            @* ===== FOLDERS STRIP ===== *@
            <div class="mt-10">
                @if (Folders is not null && Folders.Count == 0)
                {
                    <div class="flex items-center justify-between gap-3 rounded-2xl border border-dashed border-border/40 bg-background/50 px-6 py-5 text-sm text-muted-foreground">
                        <div class="flex items-center gap-3">
                            <svg class="h-5 w-5 shrink-0 text-muted-foreground/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
                            </svg>
                            <span>No folders yet. Create one to organize your files.</span>
                        </div>
                        <button type="button"
                                x-on:click="openCreateFolder()"
                                class="inline-flex items-center gap-1.5 rounded-full bg-foreground px-4 py-2 text-xs font-semibold text-background shadow-sm hover:opacity-90 transition-opacity">
                            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="12" y1="5" x2="12" y2="19" />
                                <line x1="5" y1="12" x2="19" y2="12" />
                            </svg>
                            New Folder
                        </button>
                    </div>
                }
                else if (Folders is not null)
                {
                    <div class="flex flex-wrap items-center gap-2" role="list" aria-label="Folders">
                        @* "All Files" pill *@
                        <a href="/files@(string.IsNullOrEmpty(SearchTerm) ? "" : "?search=" + Uri.EscapeDataString(SearchTerm))"
                           role="listitem"
                           class="@GetFolderPillClass(null)">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="3" width="22" height="18" rx="2" ry="2" />
                                <circle cx="8.5" cy="8.5" r="1.5" />
                                <polyline points="21 15 16 10 5 21" />
                            </svg>
                            All Files
                        </a>

                        @foreach (var folder in Folders)
                        {
                            <div class="relative group/pill" role="listitem"
                                 x-on:dragover.prevent="onDragOver($event, '@folder.Id')"
                                 x-on:dragenter="onDragEnter('@folder.Id')"
                                 x-on:dragleave="onDragLeave('@folder.Id')"
                                 x-on:drop.prevent="onDrop($event, '@folder.Id')"
                                 x-bind:class="{
                                     'ring-2 ring-primary/40 bg-primary/5 border-primary/40 rounded-full': dragOverFolderId === '@folder.Id'
                                 }">
                                <a href="@GetFolderUrl(folder.Id)"
                                   class="@GetFolderPillClass(folder.Id)">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
                                    </svg>
                                    <span>@folder.Name</span>
                                    @if (folder.FileCount > 0)
                                    {
                                        <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 rounded-full bg-foreground/10 px-1.5 text-[10px] font-semibold text-foreground/70" title="@folder.FileCount file@(folder.FileCount != 1 ? "s" : "")">@folder.FileCount</span>
                                    }
                                </a>
                                @* Action buttons (visible on hover) *@
                                @if (folder.Name != "/")
                                {
                                    <div class="absolute -right-1 -top-1 flex gap-0.5">
                                        @* Rename *@
                                        <button type="button"
                                                x-on:click="openRenameFolder('@folder.Id', '@folder.Name.Replace("'", "\\'")')"
                                                class="flex h-5 w-5 items-center justify-center rounded-l-full bg-background border border-border/60 opacity-0 shadow-sm transition-all group-hover/pill:opacity-100 hover:bg-muted hover:border-border"
                                                aria-label="Rename @folder.Name"
                                                title="Rename folder">
                                            <svg class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                                            </svg>
                                        </button>
                                        @* Delete *@
                                        <button type="button"
                                                x-on:click="openDeleteFolder('@folder.Id', '@folder.Name.Replace("'", "\\'")')"
                                                class="flex h-5 w-5 items-center justify-center rounded-r-full bg-background border border-l-0 border-border/60 opacity-0 shadow-sm transition-all group-hover/pill:opacity-100 hover:bg-destructive/10 hover:border-destructive/30"
                                                aria-label="Delete @folder.Name"
                                                title="Delete folder">
                                            <svg class="h-3 w-3 text-muted-foreground group-hover/pill:text-destructive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M3 6h18" />
                                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                                                <line x1="10" y1="11" x2="10" y2="17" />
                                                <line x1="14" y1="11" x2="14" y2="17" />
                                            </svg>
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        @* New Folder Pill *@
                        <button type="button"
                                x-on:click="openCreateFolder()"
                                class="inline-flex items-center gap-1.5 rounded-full border-2 border-dashed border-border/40 px-4 py-2.5 text-sm font-medium text-muted-foreground/70 hover:text-foreground hover:border-primary/50 hover:bg-primary/5 transition-all"
                                aria-label="Create new folder">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="12" y1="5" x2="12" y2="19" />
                                <line x1="5" y1="12" x2="19" y2="12" />
                            </svg>
                            New
                        </button>
                    </div>
                }
            </div>

            @* ===== FILES SECTION ===== *@
            <HtmxFragment>
            <div id="files-list" class="mt-8">
                @if (RenderState == FilesRenderState.Loading)
                {
                    <div class="space-y-4">
                        @for (var i = 0; i < 4; i++)
                        {
                            <div class="flex animate-pulse items-center gap-4 rounded-2xl border border-border/30 bg-card p-5 shadow-sm">
                                <div class="h-12 w-12 shrink-0 rounded-xl bg-muted"></div>
                                <div class="flex-1 space-y-2">
                                    <div class="h-4 w-3/5 rounded-md bg-muted"></div>
                                    <div class="h-3 w-1/4 rounded-md bg-muted"></div>
                                </div>
                                <div class="h-3 w-20 rounded-md bg-muted"></div>
                            </div>
                        }
                    </div>
                }
                else if (RenderState == FilesRenderState.Error)
                {
                    <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                        <div class="p-12 text-center">
                            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-destructive/8 text-destructive">
                                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" />
                                    <line x1="12" y1="8" x2="12" y2="12" />
                                    <line x1="12" y1="16" x2="12.01" y2="16" />
                                </svg>
                            </div>
                            <h3 class="mt-5 text-lg font-semibold">Couldn&rsquo;t load files</h3>
                            <p class="mt-2 text-sm text-muted-foreground">There was a problem fetching your files. Please try again.</p>
                            <a href="/files"
                                    class="mt-8 inline-flex items-center justify-center rounded-2xl bg-foreground px-6 py-3 text-sm font-semibold text-background shadow-sm hover:bg-foreground/90 transition">
                                Retry
                            </a>
                        </div>
                    </div>
                }
                else if (FileItems is null || FileItems.Count == 0)
                {
                    @* ===== EMPTY STATE ===== *@
                    <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                        <div class="p-16 text-center">
                            <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-primary/8 text-primary">
                                <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                    <line x1="9" y1="13" x2="15" y2="13" />
                                    <line x1="12" y1="10" x2="12" y2="16" />
                                </svg>
                            </div>
                            <h2 class="mt-6 text-xl font-semibold">
                                @(SelectedFolder is not null ? $"No files in {SelectedFolder.Name}" : "No files yet")
                            </h2>
                            <p class="mt-2 text-sm text-muted-foreground max-w-sm mx-auto">
                                @(SelectedFolder is not null
                                    ? "This folder is empty. Upload a file and place it here to get started."
                                    : "Upload your first file and it will appear here. Drag & drop or click to browse.")
                            </p>
                            @if (!string.IsNullOrEmpty(SearchTerm))
                            {
                                <p class="mt-4 text-sm text-muted-foreground">
                                    No files matching &ldquo;@SearchTerm&rdquo;.
                                    <a href="/files" class="text-primary hover:text-primary/80">Clear search</a>
                                </p>
                            }
                            <a href="/"
                                    class="mt-8 inline-flex items-center justify-center gap-2 rounded-2xl bg-foreground px-6 py-3.5 text-sm font-semibold text-background shadow-sm hover:bg-foreground/90 transition">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                    <polyline points="17 8 12 3 7 8" />
                                    <line x1="12" y1="3" x2="12" y2="15" />
                                </svg>
                                Upload a file
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    @* ===== FILE LIST ===== *@
                    <div class="space-y-2" role="list" aria-label="Files">
                        @foreach (var file in FileItems)
                        {
                            <div role="listitem"
                                 draggable="true"
                                 x-on:dragstart="onDragStart($event, '@file.Id')"
                                 x-on:dragend="onDragEnd()"
                                 x-bind:class="{ 'opacity-40 border-dashed border-primary/40': draggedFileId === '@file.Id' }"
                                 class="group flex items-center gap-4 rounded-2xl border border-border/30 bg-card p-4 shadow-sm transition-all hover:border-border/60 hover:shadow-md sm:gap-5 sm:p-5 cursor-grab active:cursor-grabbing">
                                @* File icon *@
                                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary/6 text-primary/70">
                                    @FileIcon(file.ContentType)
                                </div>

                                @* File info *@
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm font-medium text-foreground/90" title="@file.Filename">@file.Filename</p>
                                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                        <span>@FormatBytes(file.Size)</span>
                                        <span class="hidden sm:inline">&middot;</span>
                                        <span class="hidden sm:inline">@file.ContentType</span>
                                        <span>&middot;</span>
                                        <span>@FormatDate(file.CreatedAt)</span>
                                        @if (file.Tags.Length > 0)
                                        {
                                            <span>&middot;</span>
                                            <span class="truncate max-w-[120px]" title="@string.Join(", ", file.Tags)">@string.Join(", ", file.Tags)</span>
                                        }
                                    </div>
                                </div>

                                @* Folder badge *@
                                @if (SelectedFolder is null && !string.IsNullOrEmpty(file.FolderName))
                                {
                                    <span class="hidden shrink-0 rounded-full bg-muted/60 px-3 py-1 text-xs font-medium text-muted-foreground sm:inline-flex items-center gap-1.5">
                                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
                                        </svg>
                                        @file.FolderName
                                    </span>
                                }

                                @* Download action *@
                                <a href="@GetFileDownloadUrl(file.Id)"
                                   class="flex shrink-0 items-center justify-center rounded-xl p-2.5 text-muted-foreground/50 hover:bg-primary/8 hover:text-primary transition-all"
                                   aria-label="Download @file.Filename"
                                   title="Download file">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                        <polyline points="7 10 12 15 17 10" />
                                        <line x1="12" y1="15" x2="12" y2="3" />
                                    </svg>
                                </a>
                            </div>
                        }
                    </div>

                    @* ===== FILE COUNT FOOTER ===== *@
                    <p class="mt-6 text-center text-xs text-muted-foreground/70">
                        Showing @FileItems.Count file@(FileItems.Count != 1 ? "s" : "")
                        @if (TotalCount > FileItems.Count)
                        {
                            <text> of @TotalCount</text>
                        }
                    </p>
                }
            </div>
            </HtmxFragment>

        </div>
    </main>

    @* ===== CREATE FOLDER MODAL (inside x-data scope) ===== *@
    <div x-show="createOpen"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-[100] flex items-center justify-center bg-black/30 backdrop-blur-sm px-6"
         x-on:click.self="createOpen = false"
         style="display: none;"
         aria-modal="true"
         role="dialog"
         aria-label="Create new folder">
        <div class="w-full max-w-sm"
             x-on:click.stop
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 scale-100"
             x-transition:leave-end="opacity-0 scale-95">
            <div class="rounded-xl border bg-card text-card-foreground shadow-xl">
                <div class="p-8">
                    <div class="flex items-center justify-between">
                        <h3 class="text-lg font-semibold">New folder</h3>
                        <button type="button"
                                x-on:click="createOpen = false"
                                class="rounded-full p-1.5 text-muted-foreground/60 hover:text-foreground hover:bg-muted/50 transition-colors"
                                aria-label="Close">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                        </button>
                    </div>

                    <div class="mt-6">
                        <label for="create-folder-name" class="block text-sm font-medium text-foreground/80 mb-1.5">Folder name</label>
                        <input id="create-folder-name"
                               type="text"
                               x-model="createName"
                               x-ref="createNameInput"
                               placeholder="e.g. Projects, Photos, Documents"
                               maxlength="255"
                               class="w-full rounded-2xl border border-border/60 bg-background px-5 py-3.5 text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm"
                               x-on:keydown.enter.prevent="submitCreateFolder()" />
                    </div>

                    <div x-show="createError" class="mt-3 text-sm text-destructive" x-text="createError"></div>

                    <div class="mt-6 flex items-center gap-3">
                        <button type="button"
                                x-on:click="createOpen = false"
                                class="flex-1 rounded-2xl border border-border/60 px-5 py-3 text-sm font-medium text-muted-foreground hover:bg-muted/30 hover:text-foreground transition-all">
                            Cancel
                        </button>
                        <button type="button"
                                x-on:click="submitCreateFolder()"
                                x-bind:disabled="!createName.trim()"
                                x-bind:class="createName.trim() ? 'bg-foreground text-background hover:opacity-90 cursor-pointer' : 'bg-muted text-muted-foreground/50 cursor-not-allowed'"
                                class="flex-1 rounded-2xl px-5 py-3 text-sm font-semibold shadow-sm transition-all">
                            <span x-show="!createLoading">Create folder</span>
                            <span x-show="createLoading" class="inline-flex items-center gap-2">
                                <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                                </svg>
                                Creating&hellip;
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ===== RENAME FOLDER MODAL (inside x-data scope) ===== *@
    <div x-show="renameOpen"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-[100] flex items-center justify-center bg-black/30 backdrop-blur-sm px-6"
         x-on:click.self="renameOpen = false"
         style="display: none;"
         aria-modal="true"
         role="dialog"
         aria-label="Rename folder">
        <div class="w-full max-w-sm"
             x-on:click.stop
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100"
             x-transition:leave="transition ease-in duration-150"

@* Alpine.js data initialization (registered globally via alpine:init) *@
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('filesPage', () => ({
            // Create folder
            createOpen: false,
            createName: '',
            createLoading: false,
            createError: '',

            // Drag-and-drop
            draggedFileId: null,
            dragOverFolderId: null,

            // Rename folder
            renameOpen: false,
            renameId: '',
            renameName: '',
            renameLoading: false,
            renameError: '',

            // Delete folder
            deleteOpen: false,
            deleteId: '',
            deleteName: '',
            deleteLoading: false,
            deleteError: '',

            // Toast
            toast: { show: false, message: '', type: 'success' },

            // --- DRAG AND DROP ---
            onDragStart(event, fileId) {
                this.draggedFileId = fileId;
                event.dataTransfer.effectAllowed = 'move';
                event.dataTransfer.setData('text/plain', fileId);
            },

            onDragEnd() {
                this.draggedFileId = null;
                this.dragOverFolderId = null;
            },

            onDragOver(event, folderId) {
                event.dataTransfer.dropEffect = 'move';
            },

            onDragEnter(folderId) {
                this.dragOverFolderId = folderId;
            },

            onDragLeave(folderId) {
                if (this.dragOverFolderId === folderId) {
                    this.dragOverFolderId = null;
                }
            },

            async onDrop(event, folderId) {
                this.dragOverFolderId = null;
                const fileId = this.draggedFileId || event.dataTransfer.getData('text/plain');
                this.draggedFileId = null;

                if (!fileId || !folderId) return;

                try {
                    const response = await fetch('@apiBase/api/files/' + fileId + '/folder', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ fileId: fileId, targetFolderId: folderId })
                    });

                    if (response.ok) {
                        this.showToast('Moved to folder', 'success');
                        setTimeout(() => {
                            window.location.href = '/files' + (window.location.search || '');
                        }, 600);
                    } else {
                        const text = await response.text();
                        let msg = 'Failed to move file';
                        try {
                            const err = JSON.parse(text);
                            msg = err.message || err.title || msg;
                        } catch (_) { }
                        this.showToast(msg, 'error');
                    }
                } catch (_) {
                    this.showToast('Network error. Please try again.', 'error');
                }
            },

            showToast(message, type = 'success') {
                this.toast = { show: true, message, type };
                if (type === 'success') {
                    setTimeout(() => { this.toast.show = false; }, 4000);
                }
            },

            // --- CREATE FOLDER ---
            openCreateFolder() {
                this.createName = '';
                this.createError = '';
                this.createLoading = false;
                this.createOpen = true;
                this.$nextTick(() => {
                    if (this.$refs.createNameInput) {
                        this.$refs.createNameInput.focus();
                    }
                });
            },

            async submitCreateFolder() {
                const name = this.createName.trim();
                if (!name) return;

                this.createLoading = true;
                this.createError = '';

                try {
                    const response = await fetch('@apiBase/api/folders', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ name })
                    });

                    if (response.ok) {
                        window.location.href = '/files';
                    } else {
                        const text = await response.text();
                        let msg = 'Failed to create folder';
                        try {
                            const err = JSON.parse(text);
                            msg = err.message || err.title || msg;
                        } catch (_) { }
                        this.createError = msg;
                        this.createLoading = false;
                    }
                } catch (_) {
                    this.createError = 'Network error. Please try again.';
                    this.createLoading = false;
                }
            },

            // --- DELETE FOLDER ---
            openDeleteFolder(id, name) {
                this.deleteId = id;
                this.deleteName = name;
                this.deleteError = '';
                this.deleteLoading = false;
                this.deleteOpen = true;
            },

            async submitDeleteFolder() {
                if (!this.deleteId) return;

                this.deleteLoading = true;
                this.deleteError = '';

                try {
                    const response = await fetch('@apiBase/api/folders/' + this.deleteId, {
                        method: 'DELETE',
                        credentials: 'include'
                    });

                    if (response.ok) {
                        // If we're viewing the deleted folder, go back to all files
                        const currentFolder = new URLSearchParams(window.location.search).get('folderId');
                        if (currentFolder === this.deleteId) {
                            window.location.href = '/files';
                        } else {
                            window.location.href = '/files' + (window.location.search || '');
                        }
                    } else {
                        const text = await response.text();
                        let msg = 'Failed to delete folder';
                        try {
                            const err = JSON.parse(text);
                            msg = err.message || err.title || msg;
                        } catch (_) { }
                        this.deleteError = msg;
                        this.deleteLoading = false;
                    }
                } catch (_) {
                    this.deleteError = 'Network error. Please try again.';
                    this.deleteLoading = false;
                }
            },

            // --- RENAME FOLDER ---
            openRenameFolder(id, name) {
                this.renameId = id;
                this.renameName = name;
                this.renameError = '';
                this.renameLoading = false;
                this.renameOpen = true;
                this.$nextTick(() => {
                    if (this.$refs.renameNameInput) {
                        this.$refs.renameNameInput.focus();
                        this.$refs.renameNameInput.select();
                    }
                });
            },

            async submitRenameFolder() {
                const name = this.renameName.trim();
                if (!name || !this.renameId) return;

                this.renameLoading = true;
                this.renameError = '';

                try {
                    const response = await fetch('@apiBase/api/folders/' + this.renameId, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ id: this.renameId, name })
                    });

                    if (response.ok) {
                        window.location.href = '/files' + (window.location.search || '');
                    } else {
                        const text = await response.text();
                        let msg = 'Failed to rename folder';
                        try {
                            const err = JSON.parse(text);
                            msg = err.message || err.title || msg;
                        } catch (_) { }
                        this.renameError = msg;
                        this.renameLoading = false;
                    }
                } catch (_) {
                    this.renameError = 'Network error. Please try again.';
                    this.renameLoading = false;
                }
            }
        }));
    });
</script>

@code {
    private const int PageSize = 50;

    [SupplyParameterFromQuery]
    public string? FolderId { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    private string SearchTerm => Search ?? "";
    private List<FolderDto>? Folders { get; set; }
    private List<FileDto>? FileItems { get; set; }
    private FolderDto? SelectedFolder { get; set; }
    private int TotalCount { get; set; }
    private UsageStats? Stats { get; set; }
    private FilesRenderState RenderState { get; set; } = FilesRenderState.Loading;

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    protected override async Task OnInitializedAsync()
    {
        var client = ClientFactory.CreateClient(ApiClient.Name);

        try
        {
            // Fetch folders
            var foldersResponse = await client.GetAsync("/api/folders?pageSize=100");
            if (foldersResponse.IsSuccessStatusCode)
            {
                await using var foldersStream = await foldersResponse.Content.ReadAsStreamAsync();
                var foldersResult = await JsonSerializer.DeserializeAsync<PagedResultDto<FolderDto>>(foldersStream, JsonOptions);
                Folders = foldersResult?.Items ?? [];
            }
            else
            {
                Folders = [];
            }

            // Fetch selected folder info if folderId is specified
            if (!string.IsNullOrEmpty(FolderId) && Guid.TryParse(FolderId, out var folderGuid))
            {
                var folderInfoResponse = await client.GetAsync($"/api/folders/{folderGuid}");
                if (folderInfoResponse.IsSuccessStatusCode)
                {
                    await using var folderStream = await folderInfoResponse.Content.ReadAsStreamAsync();
                    SelectedFolder = await JsonSerializer.DeserializeAsync<FolderDto>(folderStream, JsonOptions);
                }
            }

            // Fetch files
            var fileUrl = BuildFilesUrl();
            var filesResponse = await client.GetAsync(fileUrl);
            if (filesResponse.IsSuccessStatusCode)
            {
                await using var filesStream = await filesResponse.Content.ReadAsStreamAsync();
                var filesResult = await JsonSerializer.DeserializeAsync<PagedResultDto<FileDto>>(filesStream, JsonOptions);
                FileItems = filesResult?.Items ?? [];
                TotalCount = filesResult?.TotalCount ?? FileItems.Count;
            }
            else
            {
                FileItems = [];
                TotalCount = 0;
            }

            // Fetch profile for plan name
            try
            {
                var profileResponse = await client.GetAsync("/api/account/profile");
                if (profileResponse.IsSuccessStatusCode)
                {
                    await using var profileStream = await profileResponse.Content.ReadAsStreamAsync();
                    var profile = await JsonSerializer.DeserializeAsync<ProfileResponse>(profileStream, JsonOptions);
                    if (profile is not null)
                    {
                        Stats = new UsageStats(
                            TotalFiles: TotalCount,
                            TotalSize: FileItems?.Sum(f => f.Size) ?? 0,
                            Plan: profile.Plan ?? "Free"
                        );
                    }
                }
            }
            catch
            {
                // Profile fetch is optional; stats just won't show plan
            }

            if (Stats is null)
            {
                Stats = new UsageStats(
                    TotalFiles: TotalCount,
                    TotalSize: FileItems?.Sum(f => f.Size) ?? 0,
                    Plan: "Free"
                );
            }

            RenderState = FilesRenderState.Loaded;
        }
        catch
        {
            RenderState = FilesRenderState.Error;
        }
    }

    private string BuildFilesUrl()
    {
        var parts = new List<string> { $"/api/files?pageSize={PageSize}" };

        if (!string.IsNullOrEmpty(FolderId) && Guid.TryParse(FolderId, out _))
            parts.Add($"folderId={Uri.EscapeDataString(FolderId)}");

        if (!string.IsNullOrWhiteSpace(SearchTerm))
            parts.Add($"search={Uri.EscapeDataString(SearchTerm)}");

        return string.Join("&", parts);
    }

    private string GetFolderUrl(Guid folderId)
    {
        var url = $"/files?folderId={folderId}";
        if (!string.IsNullOrWhiteSpace(SearchTerm))
            url += $"&search={Uri.EscapeDataString(SearchTerm)}";
        return url;
    }

    private string GetFolderPillClass(Guid? folderId)
    {
        var isActive = folderId switch
        {
            null => string.IsNullOrEmpty(FolderId),
            _ => string.Equals(FolderId, folderId.ToString(), StringComparison.OrdinalIgnoreCase)
        };

        var baseClass = "inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-all ";

        return isActive
            ? baseClass + "bg-foreground text-background shadow-sm"
            : baseClass + "bg-card text-muted-foreground border border-border/40 hover:border-border/80 hover:text-foreground shadow-sm";
    }

    private string GetFileDownloadUrl(Guid fileId)
    {
        var apiBase = (Config["QuickShare:ApiBaseUrl"] ?? "http://localhost:59155").TrimEnd('/');
        return $"{apiBase}/api/files/{fileId}/download";
    }

    private static MarkupString FileIcon(string contentType)
    {
        var key = (contentType ?? "").ToLowerInvariant();
        var svg = key switch
        {
            var s when s.StartsWith("image/") => IconSvg("M21 15V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9 M3 16l5-5 4 4 3-3 4 4 M16 19h6 M19 16v6"),
            var s when s.StartsWith("video/") => IconSvg("m22 8-6 4 6 4V8Z M14 6H4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2Z"),
            var s when s.StartsWith("audio/") => IconSvg("M9 18V5l12-2v13 M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"),
            "application/pdf" => IconSvg("M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M9 13h6 M9 17h6"),
            var s when s.Contains("zip") || s.Contains("compressed") || s.Contains("tar") || s.Contains("rar") || s.Contains("7z") => IconSvg("M21 8v13H3V8 M1 3h22v5H1z M10 12h4"),
            var s when s.Contains("text/") || s.Contains("application/json") || s.Contains("application/xml") || s.Contains("application/javascript") || s.Contains("application/typescript") => IconSvg("M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"),
            _ => IconSvg("M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6"),
        };
        return new MarkupString(svg);
    }

    private static string IconSvg(string d) =>
        $"<svg class=\"h-6 w-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{d}\"/></svg>";

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        var magnitude = (int)Math.Floor(Math.Log(bytes, 1024));
        if (magnitude >= units.Length) magnitude = units.Length - 1;
        var size = bytes / Math.Pow(1024, magnitude);
        return magnitude == 0 ? $"{bytes} B" : $"{size:F1} {units[magnitude]}";
    }

    private static string FormatDate(DateTime date) => date.ToLocalTime().ToString("MMM d, yyyy");

    private enum FilesRenderState { Loading, Loaded, Error }

    // --- DTOs ---

    private sealed record UsageStats(int TotalFiles, long TotalSize, string Plan);

    private sealed record FolderDto(Guid Id, string Name, DateTime CreatedAt, int FileCount = 0);

    private sealed record FileDto(
        Guid Id,
        string Filename,
        string ContentType,
        long Size,
        Guid FolderId,
        string FolderName,
        string[] Tags,
        DateTime CreatedAt
    );

    private sealed record PagedResultDto<T>(List<T> Items, int TotalCount, int Page, int PageSize);
}
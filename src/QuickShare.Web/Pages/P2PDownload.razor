@layout MainLayout
@page "/p2p/d/{ShareCode}"
@inject IConfiguration Config

@code {
    [Parameter]
    public string ShareCode { get; set; } = string.Empty;
}

@{
    var apiBase = (Config["QuickShare:ApiBaseUrl"] ?? "http://localhost:59155").TrimEnd('/');
    var shareCode = ShareCode;
}

<PageTitle>QuickShareCloud — P2P download</PageTitle>

<script>window.ZAPDROP_CONFIG = { apiBaseUrl: "@apiBase", shareCode: "@shareCode" };</script>

<div class="page">
    <div class="card db-card">
        <div class="db-card__body">

            @* CHECKING *@
            <section id="p2pd-checking" class="section">
                <div class="db-spinner"></div>
                <p class="db-p" style="margin-top: 1.25rem">Connecting to sender&hellip;</p>
            </section>

            @* PIN REQUIRED *@
            <section id="p2pd-pin" class="section hidden">
                <div class="icon --primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </div>
                <h1 class="db-h2" style="font-size: 1.25rem">PIN required</h1>
                <p class="db-p" style="margin-top: 0.5rem">This file is protected. Enter the PIN to decrypt.</p>
                <div style="margin-top: 1.5rem">
                    <input id="p2pd-pin-input" type="text" class="input" placeholder="Enter PIN" />
                </div>
                <button id="p2pd-pin-btn" class="db-btn db-btn--primary" style="margin-top: 1.5rem" onclick="p2pDownload.submitPin()">
                    <span id="p2pd-pin-text">Start download</span>
                </button>
            </section>

            @* READY *@
            <section id="p2pd-ready" class="hidden">
                <div class="file-row">
                    <div class="file-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
                        </svg>
                    </div>
                    <div style="min-width: 0; flex: 1">
                        <h1 id="p2pd-filename" class="db-h1" style="font-size: 1.25rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"></h1>
                        <p class="db-p" id="p2pd-filesize" style="margin-top: 0.375rem"></p>
                    </div>
                </div>
                <div style="margin-top: 2.5rem">
                    <button id="p2pd-dl-btn" class="db-btn db-btn--primary" style="width: 100%" onclick="p2pDownload.startDownload()" data-ai-action="p2p.receive.download">
                        <span id="p2pd-dl-text">Download directly</span>
                    </button>
                </div>
                <p style="margin-top: 1rem; font-size: 0.75rem; color: var(--color-muted-foreground); text-align: center">Direct peer-to-peer transfer &middot; encrypted &middot; no server copy</p>
            </section>

            @* TRANSFERRING *@
            <section id="p2pd-transfer" class="section--compact hidden">
                <div class="db-spinner"></div>
                <h1 id="p2pd-transfer-name" class="db-h2" style="margin-top: 1.5rem; font-size: 1.25rem"></h1>
                <p class="db-p" id="p2pd-transfer-progress" style="margin-top: 0.75rem"></p>
                <div class="progress"><div id="p2pd-progress-bar" class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div></div>
                <button class="db-btn db-btn--ghost" style="margin-top: 2rem" onclick="p2pDownload.cancelDownload()">Cancel</button>
            </section>

            @* COMPLETE *@
            <section id="p2pd-complete" class="section hidden">
                <div class="icon --primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                </div>
                <h1 class="db-h2" style="font-size: 1.25rem">Download complete</h1>
                <p class="db-p" id="p2pd-complete-name" style="margin-top: 0.5rem"></p>
                <a href="/" class="db-btn db-btn--primary" style="margin-top: 2rem">Send a file</a>
            </section>

            @* WAITING *@
            <section id="p2pd-waiting" class="section hidden">
                <div class="db-spinner"></div>
                <h1 class="db-h2" style="margin-top: 1.5rem; font-size: 1.25rem">Waiting for sender</h1>
                <p class="db-p" style="margin-top: 0.5rem">The sender is not online. Your download will start automatically when they connect.</p>
            </section>

            @* ERROR *@
            <section id="p2pd-error" class="section hidden">
                <div class="icon --danger">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                </div>
                <h1 class="db-h2" style="font-size: 1.25rem">Connection unavailable</h1>
                <p class="db-p" id="p2pd-error-msg" style="margin-top: 0.5rem"></p>
                <a id="p2pd-fallback" class="db-btn db-btn--primary hidden" style="margin-top: 2rem" href="#">Download from server instead</a>
            </section>

        </div>
    </div>
</div>

<script src="/js/p2p/signaling.js"></script>
<script src="/js/p2p/peerConnection.js"></script>
<script src="/js/p2p/fileReceiver.js"></script>
<script src="/js/p2p/encryption.js"></script>
<script src="/js/p2p/download.js"></script>

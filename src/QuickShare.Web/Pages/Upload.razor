@layout MainLayout
@page "/"
@inject IConfiguration Config
@inject IHttpContextAccessor HttpContextAccessor

@{
    var apiBase = (Config["QuickShare:ApiBaseUrl"] ?? "http://localhost:59155").TrimEnd('/');
}

<PageTitle>QuickShareCloud — send a file in seconds</PageTitle>

<div class="flex-1" x-data="uploadPage()" x-cloak>
    <script>
        window.ZAPDROP_CONFIG = { apiBaseUrl: "@apiBase" };
    </script>

    <main class="flex flex-1 items-center justify-center px-6 pb-20 pt-32">
        <div class="w-full max-w-2xl">

            <input type="file" name="file" class="sr-only" aria-label="Choose a file to upload" />

            @* ===== IDLE / DRAGGING ===== *@
            <section x-show="isIdle || isDragging" class="text-center">

                <h1 class="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl">
                    <span x-show="isIdle">Send <span class="bg-gradient-to-r from-primary via-accent to-primary bg-clip-text text-transparent">anything</span></span>
                    <span x-show="isDragging">Drop your file</span>
                </h1>
                <p class="mt-4 text-lg text-muted-foreground max-w-lg mx-auto">
                    <span x-show="isIdle">200 MB per file &middot; sign in to unlock higher limits</span>
                    <span x-show="isDragging">Release to start the transfer</span>
                </p>

                <div class="mt-16">
                    <div x-on:dragover.prevent="onDragOver($event)"
                         x-on:dragenter.prevent="onDragOver($event)"
                         x-on:dragleave.prevent="onDragLeave($event)"
                         x-on:drop.prevent="onDrop($event)"
                         x-bind:class="draggingActive ? 'border-primary bg-primary/[0.08] scale-[1.01]' : 'border-muted-foreground/25 bg-card hover:border-primary/50 hover:bg-muted/20'"
                         class="mx-auto flex cursor-pointer flex-col items-center gap-6 rounded-[2rem] border-2 border-dashed px-16 py-20 transition-all duration-300 shadow-sm"
                         x-on:click="triggerFileInput()">
                        <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                            <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <polyline points="17 8 12 3 7 8" />
                                <line x1="12" y1="3" x2="12" y2="15" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-lg font-semibold text-foreground/90">
                                <span x-show="isIdle">Drag &amp; drop your files here</span>
                                <span x-show="isDragging">Drop it here</span>
                            </p>
                            <p class="mt-2 text-sm text-muted-foreground">
                                <span x-show="isIdle">or <kbd>Ctrl</kbd>+<kbd>V</kbd> to paste, or click to browse</span>
                            </p>
                        </div>
                    </div>
                </div>

                @* Encryption toggle *@
                <div class="mt-8 flex items-center justify-center gap-3">
                    <button type="button"
                            x-on:click="encryptionEnabled = !encryptionEnabled"
                            x-bind:class="encryptionEnabled
                                ? 'bg-primary/10 text-primary border-primary/30 shadow-sm'
                                : 'border-border/60 text-muted-foreground hover:border-border hover:text-foreground'"
                            class="inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium transition-all"
                            aria-label="Toggle end-to-end encryption">
                        <span x-show="!encryptionEnabled" class="flex items-center gap-2">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                            Encrypt
                        </span>
                        <span x-show="encryptionEnabled" class="flex items-center gap-2">
                            <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                <circle cx="12" cy="16" r="1" />
                            </svg>
                            End-to-end encrypted
                        </span>
                    </button>
                </div>

                @* Expiry selector *@
                <div class="mt-8 flex items-center justify-center gap-4" role="radiogroup" aria-label="Expiry duration">
                    <span class="text-sm text-muted-foreground">Expires in</span>
                    <div class="inline-flex rounded-full border border-border/60 bg-background p-1 shadow-sm">
                        <button type="button"
                                role="radio" aria-checked="true"
                                x-bind:aria-checked="(expiry === '24h').toString()"
                                x-bind:class="expiry === '24h' ? 'bg-foreground text-background shadow-sm' : 'text-muted-foreground hover:text-foreground'"
                                class="rounded-full px-6 py-2 text-sm font-medium transition-all"
                                x-on:click="selectExpiry('24h')">24 hours</button>
                        <button type="button"
                                role="radio"
                                x-bind:aria-checked="(expiry === '7d').toString()"
                                x-bind:class="expiry === '7d' ? 'bg-foreground text-background shadow-sm' : 'text-muted-foreground hover:text-foreground'"
                                class="rounded-full px-6 py-2 text-sm font-medium transition-all"
                                x-on:click="selectExpiry('7d')">7 days</button>
                    </div>
                </div>

                <div role="alert" x-show="pasteTip" x-transition class="mt-6">
                    No image found in clipboard.
                </div>
            </section>

            @* ===== UPLOADING ===== *@
            <section x-show="isUploading" class="text-center">
                <div class="mx-auto animate-spin rounded-full border-2 border-primary border-t-transparent" style="width: 48px; height: 48px"></div>
                <h1 class="mt-8 text-2xl font-semibold" x-text="filename"></h1>
                <p class="mt-3 text-base text-muted-foreground" x-text="progressLabel"></p>

                @* Encryption indicator *@
                <div x-show="encryptionEnabled" class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-primary/8 px-4 py-1.5 text-xs font-medium text-primary">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        <circle cx="12" cy="16" r="1" />
                    </svg>
                    Encrypted
                </div>

                @* Progress bar *@
                <div class="mt-8 mx-auto max-w-xs">
                    <div class="h-1.5 w-full rounded-full bg-muted/60 overflow-hidden">
                        <div class="h-full rounded-full bg-foreground transition-all duration-300 ease-out"
                             x-bind:style="'width: ' + progress + '%'"></div>
                    </div>
                </div>

                <button type="button" class="mt-10 rounded-full px-8 py-3 text-sm" x-on:click="cancelUpload()">
                    Cancel
                </button>
            </section>

            @* ===== SUCCESS ===== *@
            <section x-show="isSuccess" class="text-center">
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-primary/8 text-primary">
                    <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                </div>
                <h1 class="mt-6 text-2xl font-semibold">Your file is ready</h1>
                <p class="mt-2 text-base text-muted-foreground" x-text="filename"></p>

                <div class="mt-10 max-w-md mx-auto">
                    <label for="share-link" class="block text-left text-xs font-medium text-muted-foreground mb-2">Share link</label>
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <input id="share-link" type="text" readonly
                               x-model="link"
                               class="w-full flex-1 rounded-2xl border border-border/60 bg-background px-5 py-3.5 text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm"
                               aria-label="Share link" />
                        <button type="button" aria-label="Copy share link"
                                x-on:click="copyLink('#share-link')"
                                class="rounded-2xl px-6 py-3.5 text-sm font-semibold bg-foreground text-background hover:bg-foreground/90 transition-all">
                            <span x-show="!copied">Copy link</span>
                            <span x-show="copied">Copied!</span>
                        </button>
                    </div>
                    <p class="mt-3 text-xs text-muted-foreground" x-text="expiryLabel"></p>
                </div>

                @* QR code *@
                <div id="qrcode" class="mt-8 flex justify-center"></div>

                @* Encryption indicator in success *@
                <div x-show="encryptionEnabled" class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-primary/8 px-4 py-1.5 text-xs font-medium text-primary">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        <circle cx="12" cy="16" r="1" />
                    </svg>
                    Encrypted &middot; the key is in the link, not on our servers
                </div>

                <button type="button" class="mt-8 text-sm font-medium" x-on:click="reset()">
                    Send another file
                </button>
            </section>

            @* ===== ERROR ===== *@
            <section x-show="isError" class="text-center">
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-destructive/8 text-destructive">
                    <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                </div>
                <h1 class="mt-6 text-2xl font-semibold">Upload failed</h1>
                <p class="mt-2 text-base text-muted-foreground" x-text="error || 'An unknown error occurred.'"></p>
                <button type="button" class="mt-10 rounded-full px-8 py-3 text-sm font-semibold" x-on:click="reset()">
                    Try again
                </button>
            </section>

        </div>
    </main>
</div>
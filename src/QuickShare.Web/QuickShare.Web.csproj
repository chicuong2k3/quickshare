<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>QuickShare.Web</RootNamespace>
    <AssemblyName>QuickShare.Web</AssemblyName>
    <UserSecretsId>819eee24-9412-484c-aee1-18a6a6b229d7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickShare.Shared\QuickShare.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
  <PackageReference Include="Htmxor" Version="1.0.0-beta.1.24" />
  <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
  <PackageReference Include="Refit" Version="8.0.0" />
  <PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />
  </ItemGroup>

  <Target Name="CopyScopedCss" AfterTargets="Build">
    <Copy SourceFiles="$(IntermediateOutputPath)scopedcss\bundle\QuickShare.Web.styles.css"
          DestinationFolder="$(ProjectDir)wwwroot\css" />
  </Target>

  </Project>

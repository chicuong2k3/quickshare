<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="QuickShareCloud — secure temporary file sharing with auto-expiry." />
    <title>QuickShareCloud</title>

    <meta name="color-scheme" content="dark" />

    @* Sora — artistic geometric sans, variable weight 100–800 *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@100..800&display=swap" rel="stylesheet" />

    @* DAUB anti-FOUC: set theme before CSS loads *@
    <script>
        (function() {
            try {
                var theme = window.localStorage.getItem('db-theme') || 'dark';
                var scheme = window.localStorage.getItem('db-scheme') || 'dark';
                document.documentElement.setAttribute('data-theme', scheme === 'dark' ? 'dark' : theme);
            } catch (e) {}
        })();
    </script>

    @* DAUB CSS *@
    <link rel="stylesheet" href="https://daub.dev/daub.css" />

    @* HTMX head outlet for enhanced navigation *@
    <HtmxHeadOutlet />
    <HeadOutlet />
</head>
<body hx-boost="true">
    <Routes />

    <script src="https://daub.dev/daub.js"></script>
    <script src="/lib/qrcode/qrcode.min.js"></script>
    <script src="/js/upload.js"></script>
</body>
</html>
